# .gitattributes — enforce consistent line endings and text/binary
# classification across the repo. CI diffs are much easier to read when a
# CRLF Windows edit on one line does not change the whole file.

# Default: LF, UTF-8, no whitespace trimming on save.
*           text=auto eol=lf encoding=utf-8

# Shell scripts must stay executable and LF.
*.sh        text eol=lf
gradlew     text eol=lf
gradlew.bat text eol=crlf

# Windows batch: CRLF is the only thing that runs.
*.bat       text eol=crlf

# Java / Kotlin: LF.
*.java      text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf

# XML resources and manifests: LF; the AAPT2 build will re-normalise anyway.
*.xml       text eol=lf
*.gradle    text eol=lf

# Markdown: LF, with a hard rule that docs are not auto-converted to PDF.
*.md        text eol=lf

# Properties / env / config: LF.
*.properties text eol=lf
*.toml       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf

# Generated by CodeAssist, the gradle-to-toml bridge, or AGP. Treat as
# generated: do not merge-resolve them by hand.
app/build.gradle     linguist-generated=true
app/proguard-rules.pro linguist-generated=false  # hand-written
app/module.toml      linguist-generated=false  # hand-written, the source of truth

# Images and binary assets: never touch.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.icns   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.aar    binary
*.aab    binary
*.apk    binary
*.jar    binary
*.keystore binary
*.jks    binary
*.pem    binary
*.p12    binary
*.der    binary
*.dex    binary
*.so     binary
*.a      binary
*.o      binary
