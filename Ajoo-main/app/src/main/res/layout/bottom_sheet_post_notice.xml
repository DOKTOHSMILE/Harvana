<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/sheet_root"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/linear9"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="8dp"
		android:background="?attr/colorSurface"
		android:gravity="center_horizontal">
		<View
			android:id="@+id/view10"
			android:layout_width="40dp"
			android:layout_height="4dp"
			android:background="@color/colorCardStroke" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear11"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="24dp"
		android:orientation="vertical"
		android:paddingHorizontal="24dp">
		<TextView
			android:id="@+id/textview10"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:text="Post a Notice"
			android:textSize="20sp"
			android:textStyle="bold"
			android:focusable="false" />
		<TextView
			android:id="@+id/textview11"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:layout_marginBottom="16dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="Every member sees this in the group's activity feed."
			android:textSize="13.5sp"
			android:focusable="false" />
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview5"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="12dp"
			app:cardBackgroundColor="@color/colorSurfaceRaised"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeWidth="1dp"
			app:strokeColor="@color/colorCardStroke">
			<EditText
				android:id="@+id/et_notice_title"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:background="@android:color/transparent"
				android:textColor="@color/colorTextPrimary"
				android:hint="Title"
				android:imeOptions="actionNext"
				android:textSize="14.5sp"
				android:paddingHorizontal="16dp"
				android:focusable="true"
				android:focusableInTouchMode="true"
				android:maxLines="1" />
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview6"
			android:layout_width="match_parent"
			android:layout_height="140dp"
			android:layout_marginBottom="20dp"
			app:cardBackgroundColor="@color/colorSurfaceRaised"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeWidth="1dp"
			app:strokeColor="@color/colorCardStroke">
			<EditText
				android:id="@+id/et_notice_body"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="16dp"
				android:background="@android:color/transparent"
				android:gravity="top"
				android:textColor="@color/colorTextPrimary"
				android:hint="Message"
				android:textSize="14.5sp"
				android:inputType="textMultiLine"
				android:focusable="true"
				android:focusableInTouchMode="true" />
		</com.google.android.material.card.MaterialCardView>
		<LinearLayout
			android:id="@+id/linear12"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_notice_cancel"
				android:layout_width="0dp"
				android:layout_height="52dp"
				android:text="Cancel"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimary"
				android:layout_weight="1"
				android:layout_marginEnd="8dp"
				app:backgroundTint="@color/colorSurfaceRaised"
				app:cornerRadius="16dp"
				app:elevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke"
				android:textAllCaps="false" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_notice_post"
				android:layout_width="0dp"
				android:layout_height="52dp"
				android:text="Post"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextOnAccent"
				android:layout_weight="1"
				android:layout_marginStart="8dp"
				app:backgroundTint="@color/colorAccent"
				app:cornerRadius="16dp"
				app:elevation="0dp"
				android:textAllCaps="false" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
