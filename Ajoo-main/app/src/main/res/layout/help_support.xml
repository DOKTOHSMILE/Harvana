<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/appBarColor"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		android:overScrollMode="never"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/linear52"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="20dp"
			android:orientation="vertical">
			<TextView
				android:id="@+id/textview61"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Help &amp; Support"
				android:textSize="22sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimary" />
			<TextView
				android:id="@+id/textview62"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="24dp"
				android:text="Answers to common questions, or reach us directly."
				android:textColor="@color/colorTextSecondary"
				android:textSize="13.5sp"
				android:lineSpacingExtra="3dp" />
			<TextView
				android:id="@+id/textview63"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				android:text="FREQUENTLY ASKED"
				android:textStyle="bold"
				android:textColor="@color/colorTextTertiary"
				android:textSize="10.5sp"
				android:layout_marginStart="4dp"
				android:letterSpacing="0.06" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview12"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="24dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear53"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear54"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="18dp"
						android:orientation="vertical">
						<TextView
							android:id="@+id/textview64"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="How does a rotating savings circle work\?"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14.5sp" />
						<TextView
							android:id="@+id/textview65"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="Every member contributes a fixed amount on a set schedule. Each cycle, one member receives the full pooled amount, rotating until everyone has been paid out once."
							android:textSize="13sp"
							android:textColor="@color/colorTextSecondary"
							android:lineSpacingExtra="3dp" />
					</LinearLayout>
					<View
						android:id="@+id/view55"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="@color/colorDivider"
						android:layout_marginStart="18dp" />
					<LinearLayout
						android:id="@+id/linear56"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="18dp"
						android:orientation="vertical">
						<TextView
							android:id="@+id/textview66"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="What is my trust score\?"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14.5sp" />
						<TextView
							android:id="@+id/textview67"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="A reputation score based on your payment history across groups. Paying on time raises it; missed or late payments lower it. Other members can see it before accepting you into a group."
							android:textSize="13sp"
							android:textColor="@color/colorTextSecondary"
							android:lineSpacingExtra="3dp" />
					</LinearLayout>
					<View
						android:id="@+id/view57"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="@color/colorDivider"
						android:layout_marginStart="18dp" />
					<LinearLayout
						android:id="@+id/linear58"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="18dp"
						android:orientation="vertical">
						<TextView
							android:id="@+id/textview68"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="What is HARV and how do I get more\?"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14.5sp" />
						<TextView
							android:id="@+id/textview69"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="HARV (HARV) is Harvana's own token, used for contributions and payouts inside the app. You can deposit into your wallet, or mine HARV directly using the separate Harvana Node Miner app."
							android:textSize="13sp"
							android:textColor="@color/colorTextSecondary"
							android:lineSpacingExtra="3dp" />
					</LinearLayout>
					<View
						android:id="@+id/view59"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="@color/colorDivider"
						android:layout_marginStart="18dp" />
					<LinearLayout
						android:id="@+id/linear60"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="18dp"
						android:orientation="vertical">
						<TextView
							android:id="@+id/textview70"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="What happens if I miss a payment\?"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14.5sp" />
						<TextView
							android:id="@+id/textview71"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="Your group's own rules and penalty bylaws apply — check Harvana Rules &amp; Guidelines from a group's settings for its specific terms. Missed payments also affect your trust score."
							android:textSize="13sp"
							android:textColor="@color/colorTextSecondary"
							android:lineSpacingExtra="3dp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview72"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				android:text="CONTACT US"
				android:textStyle="bold"
				android:textColor="@color/colorTextTertiary"
				android:textSize="10.5sp"
				android:layout_marginStart="4dp"
				android:letterSpacing="0.06" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview13"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/rowContactEmail"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:background="?attr/selectableItemBackground"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:focusable="true">
					<LinearLayout
						android:id="@+id/linear61"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/textview73"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Email Support"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14.5sp" />
						<TextView
							android:id="@+id/tvSupportEmail"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:text="support\@harvana.app"
							android:textSize="13sp"
							android:textColor="@color/colorAccent" />
					</LinearLayout>
					<ImageView
						android:id="@+id/imageview47"
						android:layout_width="16dp"
						android:layout_height="16dp"
						android:src="@drawable/ic_arrow_right"
						android:scaleType="centerInside"
						app:tint="@color/colorTextTertiary" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
