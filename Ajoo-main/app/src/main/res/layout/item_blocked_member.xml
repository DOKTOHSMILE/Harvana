<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="8dp"
		app:cardBackgroundColor="@color/colorSurfaceRaised"
		app:cardCornerRadius="14dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorCardStroke">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="12dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/tvAvatarInitials"
				android:focusable="false"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:background="@drawable/bg_settings_icon_badge"
				android:gravity="center_horizontal|center_vertical"
				android:text="S1"
				android:textSize="13sp"
				android:textStyle="bold"
				android:textColor="@color/colorAccent" />
			<TextView
				android:id="@+id/tvMemberDetails"
				android:focusable="false"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="Slot 1"
				android:textSize="13sp"
				android:textColor="@color/colorTextPrimary"
				android:layout_weight="1"
				android:layout_marginStart="12dp"
				android:ellipsize="middle"
				android:maxLines="1" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btnUnblock"
				android:layout_width="wrap_content"
				android:layout_height="36dp"
				android:text="Unblock"
				android:textSize="12sp"
				style="@style/Widget.MaterialComponents.Button.OutlinedButton"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:textAllCaps="false"
				app:cornerRadius="10dp"
				app:strokeColor="@color/colorCardStroke" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
