<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="0dp">
	<LinearLayout
		android:id="@+id/linear13"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear10"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<ImageView
				android:id="@+id/notif_icon"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:padding="3dp"
				android:src="@drawable/ic_coin_harv"
				android:scaleType="centerInside"
				android:focusable="false" />
			<LinearLayout
				android:id="@+id/linear11"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_weight="1"
				android:layout_marginStart="10dp">
				<TextView
					android:id="@+id/notif_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="Mining · 0 H/s"
					android:textSize="15sp"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary"
					android:focusable="false" />
				<TextView
					android:id="@+id/notif_subtitle"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="Harvana block miner"
					android:textSize="12sp"
					android:textColor="@color/colorTextDark"
					android:focusable="false" />
			</LinearLayout>
			<TextView
				android:id="@+id/notif_badge"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="8dp"
				android:paddingTop="3dp"
				android:paddingRight="8dp"
				android:paddingBottom="3dp"
				android:text="LIVE"
				android:textSize="10sp"
				android:textStyle="bold"
				android:textColor="@color/colorSurface"
				android:focusable="false" />
		</LinearLayout>
		<ProgressBar
			android:id="@+id/notif_hash_bar"
			android:layout_width="match_parent"
			android:layout_height="8dp"
			android:indeterminate="false"
			style="?android:progressBarStyleHorizontal"
			android:focusable="false"
			android:progressTint="@color/colorAccent"
			android:progressBackgroundTint="@color/colorSurfaceRaised" />
		<LinearLayout
			android:id="@+id/linear12"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/notif_shares"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="Shares  0"
				android:textSize="12sp"
				android:textColor="@color/colorTextPrimary"
				android:layout_weight="1"
				android:focusable="false" />
			<TextView
				android:id="@+id/notif_battery"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:text="Battery  —"
				android:textSize="12sp"
				android:textColor="@color/colorTextPrimary"
				android:layout_weight="1"
				android:focusable="false" />
			<TextView
				android:id="@+id/notif_mode"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="Solo"
				android:textSize="12sp"
				android:textStyle="bold"
				android:textColor="@color/colorAccent"
				android:layout_weight="1"
				android:gravity="end"
				android:focusable="false" />
		</LinearLayout>
		<TextView
			android:id="@+id/notif_btn_stop"
			android:layout_width="match_parent"
			android:layout_height="40dp"
			android:background="@color/colorAccent"
			android:gravity="center_horizontal|center_vertical"
			android:text="Stop mining"
			android:textSize="14sp"
			android:textStyle="bold"
			android:textColor="@color/colorQrBackground"
			android:focusable="false" />
	</LinearLayout>
</LinearLayout>
