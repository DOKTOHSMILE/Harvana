<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/card_my_trade_item"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="10dp"
		app:cardBackgroundColor="@color/colorP2pSurface"
		app:cardCornerRadius="20dp"
		app:cardElevation="0dp"
		app:strokeColor="@color/colorP2pBorder"
		app:strokeWidth="1dp">
		<LinearLayout
			android:id="@+id/my_trade_item_container"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear270"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/tv_my_trade_type"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="BUY HARV"
					android:textSize="10sp"
					android:textStyle="bold"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_my_trade_status"
					android:layout_width="wrap_content"
					android:layout_height="27dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="ONGOING"
					android:textSize="8sp"
					android:textStyle="bold"
					android:focusable="false"
					android:layout_marginStart="9dp"
					android:paddingStart="9dp"
					android:paddingEnd="9dp" />
				<LinearLayout
					android:id="@+id/linear277"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:orientation="horizontal"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/tv_my_trade_menu"
					android:layout_width="38dp"
					android:layout_height="38dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="⋮"
					android:textSize="21sp"
					android:textColor="@color/colorP2pTextPrimary"
					android:focusable="false" />
			</LinearLayout>
			<TextView
				android:id="@+id/tv_my_trade_order_id"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="Order #HARV-82F41"
				android:textSize="10sp"
				android:focusable="false" />
			<LinearLayout
				android:id="@+id/linear271"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="15dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/tv_my_trade_avatar"
					android:layout_width="38dp"
					android:layout_height="38dp"
					android:background="@color/colorP2pSurfaceAlt"
					android:gravity="center_horizontal|center_vertical"
					android:text="J"
					android:textSize="14sp"
					android:textStyle="bold"
					android:focusable="false" />
				<LinearLayout
					android:id="@+id/linear272"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1"
					android:layout_marginStart="10dp">
					<TextView
						android:id="@+id/tv_my_trade_counterparty"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="John Doe"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="@color/colorP2pTextPrimary"
						android:focusable="false" />
					<TextView
						android:id="@+id/tv_my_trade_counterparty_meta"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="3dp"
						android:text="Seller • Trust 94%"
						android:textSize="10sp"
						android:focusable="false" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear273"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="15dp"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear274"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/textview158"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="HARV amount"
						android:textSize="10sp"
						android:focusable="false" />
					<TextView
						android:id="@+id/tv_my_trade_harv"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="3dp"
						android:text="40.00 HARV"
						android:textSize="15sp"
						android:textStyle="bold"
						android:textColor="@color/colorP2pTextPrimary"
						android:focusable="false" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear275"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/textview159"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Fiat value"
						android:textSize="10sp"
						android:focusable="false" />
					<TextView
						android:id="@+id/tv_my_trade_fiat"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="3dp"
						android:text="₦50,000"
						android:textSize="15sp"
						android:textStyle="bold"
						android:textColor="@color/colorP2pTextPrimary"
						android:focusable="false" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/layout_my_trade_state"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:padding="12dp"
				android:background="@color/colorP2pSurfaceAlt"
				android:orientation="vertical">
				<TextView
					android:id="@+id/tv_my_trade_state_title"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Current status"
					android:textSize="11sp"
					android:textStyle="bold"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_my_trade_state_description"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="Waiting for payment confirmation."
					android:textSize="10sp"
					android:focusable="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear276"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="11dp"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/tv_my_trade_date"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="Sep 15, 2026 • 09:18"
					android:textSize="10sp"
					android:layout_weight="1"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_my_trade_tx_state"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Escrow active"
					android:textSize="10sp"
					android:textStyle="bold"
					android:focusable="false" />
			</LinearLayout>
			<View
				android:id="@+id/view277"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:layout_marginTop="13dp"
				android:background="@color/colorP2pBorder" />
			<TextView
				android:id="@+id/tv_my_trade_open"
				android:layout_width="match_parent"
				android:layout_height="43dp"
				android:layout_marginTop="5dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="Open Trade"
				android:textSize="11sp"
				android:textStyle="bold"
				android:focusable="false" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
