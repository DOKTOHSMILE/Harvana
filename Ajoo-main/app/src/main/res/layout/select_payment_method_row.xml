<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/row_payment_method_option"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/selectableItemBackground"
	android:clickable="true"
	android:focusable="true"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:padding="16dp">
	<TextView
		android:id="@+id/tv_payment_option_icon"
		android:focusable="false"
		android:layout_width="36dp"
		android:layout_height="36dp"
		android:gravity="center_horizontal|center_vertical"
		android:text="B"
		android:textStyle="bold"
		android:textColor="@color/colorP2pTextPrimary"
		android:textSize="13.5sp"
		android:backgroundTint="@color/colorP2pSurfaceAlt" />
	<TextView
		android:id="@+id/tv_payment_option_label"
		android:focusable="false"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:text="Bank Transfer"
		android:textColor="@color/colorP2pTextPrimary"
		android:layout_weight="1"
		android:textSize="14.5sp"
		android:layout_marginStart="14dp" />
	<FrameLayout
		android:id="@+id/frame_layout25"
		android:layout_width="22dp"
		android:layout_height="22dp">
		<View
			android:id="@+id/view_payment_option_check_bg"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@drawable/bg_checkbox_unselected" />
		<ImageView
			android:id="@+id/iv_payment_option_check"
			android:focusable="false"
			android:layout_width="14dp"
			android:layout_height="14dp"
			android:src="@drawable/icon_check_round"
			android:scaleType="centerInside"
			android:layout_gravity="center_horizontal|center_vertical"
			android:visibility="gone"
			app:tint="@color/colorTextOnAccent" />
	</FrameLayout>
</LinearLayout>
