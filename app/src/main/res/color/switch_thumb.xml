<?xml version="1.0" encoding="utf-8"?>
<!-- Every switch in the app: the knob is the accent colour when on, plain white (light grey at night) when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/colorCardStroke"/>
    <item android:state_checked="true" android:color="@color/colorAccent"/>
    <item android:color="@color/colorSwitchThumbOff"/>
</selector>
