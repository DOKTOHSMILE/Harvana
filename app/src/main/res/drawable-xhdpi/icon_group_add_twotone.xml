<?xml version="1.0" encoding="utf-8"?>
<!-- Harvana icon: line at rest; pressed, selected, checked or activated it fills in one colour with depth (see icon_group_add_twotone_on). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="140" android:exitFadeDuration="220">
    <item android:state_pressed="true" android:drawable="@drawable/icon_group_add_twotone_on"/>
    <item android:state_checked="true" android:drawable="@drawable/icon_group_add_twotone_on"/>
    <item android:state_selected="true" android:drawable="@drawable/icon_group_add_twotone_on"/>
    <item android:state_activated="true" android:drawable="@drawable/icon_group_add_twotone_on"/>
    <item android:drawable="@drawable/icon_group_add_twotone_line"/>
</selector>
