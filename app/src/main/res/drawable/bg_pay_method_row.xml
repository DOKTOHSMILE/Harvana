<?xml version="1.0" encoding="utf-8"?>
<!-- A payment account row: surface card; chosen (activated) rows get the soft accent fill and an accent edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_activated="true">
		<shape android:shape="rectangle">
			<solid android:color="@color/colorAccentSoft" />
			<stroke android:width="1.5dp" android:color="@color/colorAccent" />
			<corners android:radius="14dp" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<solid android:color="@color/colorSurfaceAlt" />
			<stroke android:width="1dp" android:color="@color/colorCardStroke" />
			<corners android:radius="14dp" />
		</shape>
	</item>
</selector>
