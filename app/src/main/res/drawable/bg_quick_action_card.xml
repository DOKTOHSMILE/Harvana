<?xml version="1.0" encoding="utf-8"?>
<!-- Home's Send / Receive / P2P: the same compact button as the Assets screen (teal in the dark theme). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/colorAccentRipple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorActionSurface" />
            <stroke android:width="1dp" android:color="@color/colorActionStroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
