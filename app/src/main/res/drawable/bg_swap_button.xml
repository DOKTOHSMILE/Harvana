<?xml version="1.0" encoding="utf-8"?>
<!-- Swap: the Review Swap button (enabled mint, disabled muted). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_enabled="false">
		<shape android:shape="rectangle">
			<solid android:color="@color/swapDisabled" />
			<corners android:radius="26dp" />
		</shape>
	</item>
	<item>
		<ripple android:color="#33FFFFFF">
			<item>
				<shape android:shape="rectangle">
					<gradient android:angle="0" android:startColor="@color/swapAccent" android:endColor="@color/swapAccentSoft" />
					<corners android:radius="26dp" />
				</shape>
			</item>
		</ripple>
	</item>
</selector>
