<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces Material's password eye with Harvana's own: open eye while the password shows, crossed eye while it is hidden. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/icon_visibility_twotone_line"/>
    <item android:drawable="@drawable/icon_visibility_off_twotone_line"/>
</selector>
