<?xml version="1.0" encoding="utf-8"?>
<!-- The Gift icon: the HARV coin drawn as lines only (nothing filled). An outer ring, a thin inner ring and the outlined "H", the same shapes
     as ic_coin_harv. Drawn in one colour so it follows the tint on the button (accent). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
    <!-- outer ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M12,1.75a10.25,10.25 0 1,0 0.001,0z" />
    <!-- thin inner ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="0.8"
        android:strokeAlpha="0.7"
        android:pathData="M12,3.6a8.4,8.4 0 1,0 0.001,0z" />
    <!-- H, outline only -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineJoin="round"
        android:pathData="M7.6,7.2h2.5v3.5h3.8V7.2h2.5v9.6h-2.5v-3.5h-3.8v3.5H7.6z" />
</vector>
