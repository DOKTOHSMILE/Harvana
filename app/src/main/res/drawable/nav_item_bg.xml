<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background when the tab is SELECTED (a pill kept 4dp in from the sides, so the end tabs are never cut by the screen edge) -->
    <item android:state_checked="true">
        <inset android:insetLeft="4dp"
               android:insetRight="4dp"
               android:insetTop="5dp"
               android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/colorAccentSoft" />
                <corners android:radius="10dp" />
            </shape>
        </inset>
    </item>
    
    <!-- Background when the tab is NOT SELECTED -->
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>