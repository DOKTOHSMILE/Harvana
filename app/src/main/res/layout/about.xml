<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay"
		app:elevation="0dp"
		android:stateListAnimator="@null">
		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/appBarColor"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		android:overScrollMode="never"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/linear44"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="32dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear45"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="32dp"
				android:paddingBottom="24dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical">
				<com.google.android.material.imageview.ShapeableImageView
					android:id="@+id/imageview40"
					android:layout_width="120dp"
					android:layout_height="120dp"
					android:scaleType="fitCenter"
					android:src="@drawable/ic_launcher"
					android:contentDescription="Harvana logo" />
				<TextView
					android:id="@+id/textview46"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:text="Harvana"
					android:textSize="22sp"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary" />
				<TextView
					android:id="@+id/tvAppVersion"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="Version 1.0"
					android:textColor="@color/colorTextTertiary"
					android:textSize="13sp" />
				<TextView
					android:id="@+id/textview47"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="Harvana brings the West African rotating-savings circle — Ajo, Osusu, Adashe — onto a transparent, verifiable ledger, so every contribution and payout is visible to the people who trust each other with it."
					android:textColor="@color/colorTextSecondary"
					android:textSize="14sp"
					android:lineSpacingExtra="3dp"
					android:paddingStart="32dp"
					android:paddingEnd="32dp" />
			</LinearLayout>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview7"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="@color/colorSurface"
				android:layout_marginStart="16dp"
				android:layout_marginEnd="16dp"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear46"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/rowPrivacyPolicy"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="18dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:focusable="true">
						<TextView
							android:id="@+id/textview48"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Privacy Policy"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:textSize="15sp" />
						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/imageview41"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/ic_arrow_right"
							android:scaleType="centerInside"
							app:tint="@color/colorTextTertiary" android:duplicateParentState="true" />
					</LinearLayout>
					<com.google.android.material.divider.MaterialDivider
						android:id="@+id/view47"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginStart="18dp"
	app:dividerColor="@color/colorDivider"/>
					<LinearLayout
						android:id="@+id/rowTermsOfService"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="18dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:focusable="true">
						<TextView
							android:id="@+id/textview49"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Terms of Service"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:textSize="15sp" />
						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/imageview42"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/ic_arrow_right"
							android:scaleType="centerInside"
							app:tint="@color/colorTextTertiary" android:duplicateParentState="true" />
					</LinearLayout>
					<com.google.android.material.divider.MaterialDivider
						android:id="@+id/view48"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginStart="18dp"
	app:dividerColor="@color/colorDivider"/>
					<LinearLayout
						android:id="@+id/rowOpenSourceLicenses"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="18dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:focusable="true">
						<TextView
							android:id="@+id/textview50"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Open Source Licenses"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:textSize="15sp" />
						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/imageview43"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/ic_arrow_right"
							android:scaleType="centerInside"
							app:tint="@color/colorTextTertiary" android:duplicateParentState="true" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview51"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="© 2026 Harvana. Built for community savings circles."
				android:textColor="@color/colorTextTertiary"
				android:textSize="12sp" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
