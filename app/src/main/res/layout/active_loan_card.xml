<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview27"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		android:layout_marginHorizontal="4dp"
		android:layout_marginVertical="6dp"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorCardStroke">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="14dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal" android:minHeight="50dp">
				<TextView
					android:id="@+id/textview2"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="User full name (You)"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary"
					android:layout_weight="1"
					android:textSize="16sp"
					android:focusable="false" />
				<TextView
					android:id="@+id/textview3"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="4dp"
					android:paddingBottom="4dp"
					android:background="@color/colorAccentSoft"
					android:text="Active"
					android:textSize="11sp"
					android:textStyle="bold"
					android:textColor="@color/colorAccent"
					android:paddingStart="10dp"
					android:paddingEnd="10dp"
					android:focusable="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textview1"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="Reason - duration(8 weeks)"
					android:textColor="@color/colorTextSecondary"
					android:layout_weight="1"
					android:textSize="13sp"
					android:focusable="false" />
				<TextView
					android:id="@+id/textview6"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Next due:"
					android:textSize="12sp"
					android:textColor="@color/colorTextTertiary"
					android:paddingEnd="4dp"
					android:focusable="false" />
				<TextView
					android:id="@+id/textview7"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Feb 2, 2026"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary"
					android:textSize="13sp"
					android:focusable="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:gravity="center_vertical"
				android:orientation="horizontal" android:minHeight="50dp">
				<TextView
					android:id="@+id/textview4"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="Repaid ₦0 out of ₦0"
					android:textColor="@color/colorTextSecondary"
					android:layout_weight="1"
					android:textSize="13sp"
					android:focusable="false" />
				<TextView
					android:id="@+id/textview5"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="60%"
					android:textStyle="bold"
					android:textColor="@color/colorAccent"
					android:textSize="13sp"
					android:focusable="false" />
			</LinearLayout>
			<com.google.android.material.progressindicator.LinearProgressIndicator
				android:id="@+id/progressbar1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:progress="60"
				android:indeterminate="false"
				app:trackThickness="6dp"
				app:trackCornerRadius="3dp"
				app:indicatorColor="@color/colorAccent"
				app:trackColor="@color/colorSurfaceAlt"
				android:focusable="false" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
