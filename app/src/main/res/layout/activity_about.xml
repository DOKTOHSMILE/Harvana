<?xml version="1.0" encoding="utf-8"?>
<!-- About Harvana: what it is, what it does, how money is kept safe, the mission, who made it, legal and help. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="16dp"
		android:paddingEnd="16dp"
		android:paddingBottom="32dp">

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="18dp"
			app:cardElevation="0dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:padding="16dp">

				<ImageView
					android:layout_width="72dp"
					android:layout_height="72dp"
					android:contentDescription="Harvana"
					android:src="@drawable/ic_harv_glow_logo" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Harvana"
					android:textColor="@color/colorTextPrimary"
					android:textSize="26sp"
					android:textStyle="bold" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:text="Save together. Trade fairly. Own your money."
					android:textColor="@color/colorTextSecondary"
					android:textSize="14sp" />

				<TextView
					android:id="@+id/tv_about_version"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="8dp"
					android:textColor="@color/colorTextTertiary"
					android:textSize="12sp" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="6dp"
					android:text="Created by Capital Oracle Projects"
					android:textColor="@color/colorAccent"
					android:textSize="13sp"
					android:textStyle="bold" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingStart="4dp"
			android:paddingTop="18dp"
			android:paddingBottom="6dp"
			android:text="What Harvana is"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="18dp"
			app:cardElevation="0dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="16dp">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:lineSpacingMultiplier="1.15"
					android:text="Harvana is a community money app built on its own blockchain, the Harvana Protocol. It brings together the things people already do with money among friends, family and colleagues, saving together, lending, buying and selling, and makes them safe, open and fair, with every naira and every coin accounted for on the chain."
					android:textColor="@color/colorTextSecondary"
					android:textSize="14sp" />

			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingStart="4dp"
			android:paddingTop="18dp"
			android:paddingBottom="6dp"
			android:text="What you can do"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="18dp"
			app:cardElevation="0dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="12dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="6dp"
					android:paddingBottom="6dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_wallet_line"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Multi-chain wallet"
							android:textColor="@color/colorTextPrimary"
							android:textSize="15sp"
							android:textStyle="bold" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:lineSpacingMultiplier="1.15"
							android:text="HARV, Bitcoin, Ethereum, BNB, Solana, Tron, Litecoin, Dogecoin, Pi and more, all from one recovery phrase."
							android:textColor="@color/colorTextSecondary"
							android:textSize="13sp" />
					</LinearLayout>
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="6dp"
					android:paddingBottom="6dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_coin_stable"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Stable coins"
							android:textColor="@color/colorTextPrimary"
							android:textSize="15sp"
							android:textStyle="bold" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:lineSpacingMultiplier="1.15"
							android:text="hUSD, hNGN, hEUR and other currencies: money that keeps its value, sent instantly to anyone on Harvana."
							android:textColor="@color/colorTextSecondary"
							android:textSize="13sp" />
					</LinearLayout>
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="6dp"
					android:paddingBottom="6dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_groups_line"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Savings groups"
							android:textColor="@color/colorTextPrimary"
							android:textSize="15sp"
							android:textStyle="bold" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:lineSpacingMultiplier="1.15"
							android:text="Rotating circles (ajo, esusu, susu), shared savings goals and group loans, with the rules enforced on the chain."
							android:textColor="@color/colorTextSecondary"
							android:textSize="13sp" />
					</LinearLayout>
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="6dp"
					android:paddingBottom="6dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/icon_handshake_outline_line"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="P2P market"
							android:textColor="@color/colorTextPrimary"
							android:textSize="15sp"
							android:textStyle="bold" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:lineSpacingMultiplier="1.15"
							android:text="Buy and sell with people near you. The coins sit in escrow until the seller confirms they were paid."
							android:textColor="@color/colorTextSecondary"
							android:textSize="13sp" />
					</LinearLayout>
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="6dp"
					android:paddingBottom="6dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_tx_stake_line"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Staking"
							android:textColor="@color/colorTextPrimary"
							android:textSize="15sp"
							android:textStyle="bold" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:lineSpacingMultiplier="1.15"
							android:text="Lock HARV to help secure the network and earn rewards, plus a share of stable-coin fees."
							android:textColor="@color/colorTextSecondary"
							android:textSize="13sp" />
					</LinearLayout>
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="6dp"
					android:paddingBottom="6dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_tx_stake_reward_line"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Mining"
							android:textColor="@color/colorTextPrimary"
							android:textSize="15sp"
							android:textStyle="bold" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:lineSpacingMultiplier="1.15"
							android:text="Earn HARV by helping produce blocks with the Harvana miner."
							android:textColor="@color/colorTextSecondary"
							android:textSize="13sp" />
					</LinearLayout>
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="6dp"
					android:paddingBottom="6dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_school_line"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Learn and Discover"
							android:textColor="@color/colorTextPrimary"
							android:textSize="15sp"
							android:textStyle="bold" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:lineSpacingMultiplier="1.15"
							android:text="Guides, news and communities to help you use money well."
							android:textColor="@color/colorTextSecondary"
							android:textSize="13sp" />
					</LinearLayout>
				</LinearLayout>

			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingStart="4dp"
			android:paddingTop="18dp"
			android:paddingBottom="6dp"
			android:text="How your money is kept safe"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="18dp"
			app:cardElevation="0dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="16dp">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:lineSpacingMultiplier="1.15"
					android:text="• Your keys stay on your phone. Your recovery phrase never leaves it, and nobody at Harvana can move your money.\n• Group money and P2P trades are held in escrow on the chain and released only by the rules everyone agreed to.\n• Every transaction pays a small tFare, like any other blockchain, so the network stays secure and can\'t be flooded.\n• Stable coins are backed one for one by the same currency held in a vault, and the reserves can be checked by anyone."
					android:textColor="@color/colorTextSecondary"
					android:textSize="14sp" />

			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingStart="4dp"
			android:paddingTop="18dp"
			android:paddingBottom="6dp"
			android:text="Our mission"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="18dp"
			app:cardElevation="0dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="16dp">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:lineSpacingMultiplier="1.15"
					android:text="To give every person a fair, transparent way to save, borrow and grow money together, in their own currency, from their own phone, without needing a bank to trust them first."
					android:textColor="@color/colorTextSecondary"
					android:textSize="14sp" />

			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingStart="4dp"
			android:paddingTop="18dp"
			android:paddingBottom="6dp"
			android:text="Who made Harvana"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="18dp"
			app:cardElevation="0dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="16dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Capital Oracle Projects"
					android:textColor="@color/colorTextPrimary"
					android:textSize="16sp"
					android:textStyle="bold" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:lineSpacingMultiplier="1.15"
					android:text="Harvana, the Harvana Protocol blockchain, the node and the miner are designed and built by Capital Oracle Projects, an independent fintech studio building open, community-first financial tools."
					android:textColor="@color/colorTextSecondary"
					android:textSize="14sp" />

			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingStart="4dp"
			android:paddingTop="18dp"
			android:paddingBottom="6dp"
			android:text="Legal and help"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="18dp"
			app:cardElevation="0dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="14dp">

				<LinearLayout
					android:id="@+id/row_about_privacy"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:background="?android:attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="12dp"
					android:paddingBottom="12dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_shield_line"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp"
						android:paddingEnd="8dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Privacy policy"
							android:textColor="@color/colorTextPrimary"
							android:textSize="15sp"
							android:textStyle="bold" />
					</LinearLayout>

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_arrow_right"
						app:tint="@color/colorAccent" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:layout_marginStart="48dp"
					android:alpha="0.2"
					android:background="@color/colorTextTertiary" />

				<LinearLayout
					android:id="@+id/row_about_terms"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:background="?android:attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="12dp"
					android:paddingBottom="12dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_gavel_line"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp"
						android:paddingEnd="8dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Terms of service"
							android:textColor="@color/colorTextPrimary"
							android:textSize="15sp"
							android:textStyle="bold" />
					</LinearLayout>

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_arrow_right"
						app:tint="@color/colorAccent" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:layout_marginStart="48dp"
					android:alpha="0.2"
					android:background="@color/colorTextTertiary" />

				<LinearLayout
					android:id="@+id/row_about_help"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:background="?android:attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="12dp"
					android:paddingBottom="12dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_help_line"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp"
						android:paddingEnd="8dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Help and support"
							android:textColor="@color/colorTextPrimary"
