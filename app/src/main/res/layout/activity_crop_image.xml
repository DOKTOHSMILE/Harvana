<?xml version="1.0" encoding="utf-8"?>
<!-- Crop a picture: the crop frame full screen on black, Cancel and the title on top, the hint and Use photo at the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#FF000000">

	<com.harvana.app.utils.CropView
		android:id="@+id/crop_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="16dp"
		android:paddingTop="14dp"
		android:paddingEnd="16dp"
		android:paddingBottom="10dp">

		<TextView
			android:id="@+id/crop_cancel"
			android:layout_width="64dp"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:gravity="center_vertical"
			android:text="Cancel"
			android:textColor="#FFFFFFFF"
			android:textSize="15sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/crop_title"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:gravity="center"
			android:text="Crop"
			android:textColor="#FFFFFFFF"
			android:textSize="16sp"
			android:textStyle="bold" />

		<Space
			android:layout_width="64dp"
			android:layout_height="1dp" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:gravity="center_horizontal"
		android:orientation="vertical"
		android:paddingStart="24dp"
		android:paddingTop="10dp"
		android:paddingEnd="24dp"
		android:paddingBottom="24dp">

		<TextView
			android:id="@+id/crop_hint"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingBottom="12dp"
			android:textColor="#FFB6BDC8"
			android:textSize="13sp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/crop_use"
			style="@style/HarvanaButton"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:enabled="false"
			android:text="Use photo" />
	</LinearLayout>

	<ProgressBar
		android:id="@+id/crop_busy"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_gravity="center" />
</FrameLayout>
