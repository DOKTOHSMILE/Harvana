<?xml version="1.0" encoding="utf-8"?>
<!-- Edit profile: cover, photo, About you (editable), Fixed details (table rows), links to the contact card and privacy, Save. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="16dp"
		android:paddingEnd="16dp"
		android:paddingBottom="28dp">

		<LinearLayout
			android:id="@+id/edit_profile_loading"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical" />

		<TextView
			android:id="@+id/tv_edit_profile_error"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textColor="@color/colorError"
			android:textSize="14sp"
			android:visibility="gone" />

		<LinearLayout
			android:id="@+id/edit_profile_content"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone">

			<FrameLayout
				android:id="@+id/profile_cover_frame"
				android:layout_width="match_parent"
				android:layout_height="140dp"
				android:background="@drawable/bg_cover_fallback">

				<ImageView
					android:id="@+id/iv_profile_cover"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:contentDescription="Cover"
					android:scaleType="centerCrop" />

				<ProgressBar
					android:id="@+id/profile_cover_busy"
					android:layout_width="36dp"
					android:layout_height="36dp"
					android:layout_gravity="center"
					android:visibility="gone" />
			</FrameLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:orientation="horizontal">

				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_profile_cover_change"
					style="@style/HarvanaButton.Outlined"
					android:layout_width="wrap_content"
					android:layout_height="40dp"
					android:minWidth="0dp"
					android:text="Change cover"
					android:textSize="12sp"
					app:icon="@drawable/icon_image_twotone_line" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_profile_cover_remove"
					style="@style/HarvanaButton.Outlined"
					android:layout_width="wrap_content"
					android:layout_height="40dp"
					android:layout_marginStart="8dp"
					android:minWidth="0dp"
					android:text="Remove"
					android:textSize="12sp"
					android:visibility="gone" />
			</LinearLayout>

			<TextView
				android:id="@+id/tv_profile_cover_status"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="6dp"
				android:textColor="@color/colorTextSecondary"
				android:textSize="12sp" />

			<FrameLayout
				android:layout_width="104dp"
				android:layout_height="104dp"
				android:layout_gravity="center_horizontal"
				android:layout_marginTop="14dp">

				<TextView
					android:id="@+id/tv_profile_initials"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/bg_circle_accent"
					android:gravity="center"
					android:textColor="@color/colorTextOnAccent"
					android:textSize="34sp"
					android:textStyle="bold" />

				<ImageView
					android:id="@+id/iv_profile_photo"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:contentDescription="Profile photo"
					android:scaleType="centerCrop" />

				<ProgressBar
					android:id="@+id/profile_photo_busy"
					android:layout_width="36dp"
					android:layout_height="36dp"
					android:layout_gravity="center"
					android:visibility="gone" />
			</FrameLayout>

			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_profile_photo_change"
				style="@style/HarvanaButton.Outlined"
				android:layout_width="wrap_content"
				android:layout_height="40dp"
				android:layout_gravity="center_horizontal"
				android:layout_marginTop="12dp"
				android:minWidth="0dp"
				android:text="Change photo"
				android:textSize="12sp"
				app:icon="@drawable/icon_image_twotone_line" />

			<TextView
				android:id="@+id/tv_profile_photo_status"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal"
				android:paddingTop="6dp"
				android:paddingBottom="16dp"
				android:textColor="@color/colorTextSecondary"
				android:textSize="12sp" />

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="14dp"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeColor="@color/colorCardStroke"
			app:strokeWidth="1dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="16dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="About you"
					android:textColor="@color/colorTextPrimary"
					android:textSize="16sp"
					android:textStyle="bold" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="14dp"
					android:paddingBottom="4dp"
					android:text="First name"
					android:textColor="@color/colorTextSecondary"
					android:textSize="13sp" />

				<EditText
					android:id="@+id/et_profile_first"
					android:layout_width="match_parent"
					android:layout_height="50dp"
					android:background="@drawable/bg_field_surface"
					android:hint="First name"
					android:inputType="text|textCapWords"
					android:paddingStart="14dp"
					android:paddingEnd="14dp"
					android:singleLine="true"
					android:textColor="@color/colorTextPrimary"
					android:textColorHint="@color/colorTextTertiary" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="14dp"
					android:paddingBottom="4dp"
					android:text="Last name"
					android:textColor="@color/colorTextSecondary"
					android:textSize="13sp" />

				<EditText
					android:id="@+id/et_profile_last"
					android:layout_width="match_parent"
					android:layout_height="50dp"
					android:background="@drawable/bg_field_surface"
					android:hint="Last name"
					android:inputType="text|textCapWords"
					android:paddingStart="14dp"
					android:paddingEnd="14dp"
					android:singleLine="true"
					android:textColor="@color/colorTextPrimary"
					android:textColorHint="@color/colorTextTertiary" />

				<TextView
					android:id="@+id/tv_profile_name_locked"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:drawableStart="@drawable/icon_lock_round_line"
					android:drawablePadding="6dp"
					android:paddingTop="8dp"
					android:text="Name confirmed by an identity check"
					android:textColor="@color/colorTextTertiary"
					android:textSize="12sp"
					android:visibility="gone" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="14dp"
					android:paddingBottom="4dp"
					android:text="Occupation"
					android:textColor="@color/colorTextSecondary"
					android:textSize="13sp" />

				<EditText
					android:id="@+id/et_profile_job"
					android:layout_width="match_parent"
					android:layout_height="50dp"
					android:background="@drawable/bg_field_surface"
					android:hint="Occupation"
					android:inputType="text|textCapSentences"
					android:paddingStart="14dp"
					android:paddingEnd="14dp"
					android:singleLine="true"
					android:textColor="@color/colorTextPrimary"
					android:textColorHint="@color/colorTextTertiary" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="14dp"
					android:paddingBottom="4dp"
					android:text="Home address"
					android:textColor="@color/colorTextSecondary"
					android:textSize="13sp" />

				<EditText
					android:id="@+id/et_profile_address"
					android:layout_width="match_parent"
					android:layout_height="50dp"
					android:background="@drawable/bg_field_surface"
					android:hint="Home address"
					android:inputType="text|textCapWords"
					android:paddingStart="14dp"
					android:paddingEnd="14dp"
					android:singleLine="true"
					android:textColor="@color/colorTextPrimary"
					android:textColorHint="@color/colorTextTertiary" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="14dp"
					android:paddingBottom="4dp"
					android:text="City"
					android:textColor="@color/colorTextSecondary"
					android:textSize="13sp" />

				<EditText
					android:id="@+id/et_profile_city"
					android:layout_width="match_parent"
					android:layout_height="50dp"
					android:background="@drawable/bg_field_surface"
					android:hint="City"
					android:inputType="text|textCapWords"
					android:paddingStart="14dp"
					android:paddingEnd="14dp"
					android:singleLine="true"
					android:textColor="@color/colorTextPrimary"
					android:textColorHint="@color/colorTextTertiary" />

			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="14dp"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeColor="@color/colorCardStroke"
			app:strokeWidth="1dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="16dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Fixed details"
					android:textColor="@color/colorTextPrimary"
					android:textSize="16sp"
					android:textStyle="bold" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginEnd="12dp"
						android:importantForAccessibility="no"
						android:src="@drawable/icon_flag_round_line"
						app:tint="@color/colorTextSecondary" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Country"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13sp" />

					<TextView
						android:id="@+id/tv_profile_country"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="12dp"
						android:layout_weight="1"
						android:gravity="end"
						android:textColor="@color/colorTextPrimary"
						android:textIsSelectable="true"
						android:textSize="14sp"
						android:textStyle="bold" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:alpha="0.14"
					android:background="@color/colorTextTertiary" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginEnd="12dp"
						android:importantForAccessibility="no"
						android:src="@drawable/icon_flag_round_line"
						app:tint="@color/colorTextSecondary" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="State"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13sp" />

					<TextView
						android:id="@+id/tv_profile_state"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="12dp"
						android:layout_weight="1"
						android:gravity="end"
						android:textColor="@color/colorTextPrimary"
						android:textIsSelectable="true"
						android:textSize="14sp"
						android:textStyle="bold" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:alpha="0.14"
					android:background="@color/colorTextTertiary" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginEnd="12dp"
						android:importantForAccessibility="no"
						android:src="@drawable/icon_alternate_email_twotone_line"
						app:tint="@color/colorTextSecondary" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Email"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13sp" />

					<TextView
						android:id="@+id/tv_profile_email"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="12dp"
						android:layout_weight="1"
						android:gravity="end"
						android:textColor="@color/colorTextPrimary"
						android:textIsSelectable="true"
						android:textSize="14sp"
						android:textStyle="bold" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:alpha="0.14"
					android:background="@color/colorTextTertiary" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginEnd="12dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_calendar"
						app:tint="@color/colorTextSecondary" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Date of birth"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13sp" />

					<TextView
						android:id="@+id/tv_profile_dob"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="12dp"
						android:layout_weight="1"
						android:gravity="end"
						android:textColor="@color/colorTextPrimary"
						android:textIsSelectable="true"
						android:textSize="14sp"
						android:textStyle="bold" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:alpha="0.14"
					android:background="@color/colorTextTertiary" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginEnd="12dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_shield_line"
						app:tint="@color/colorTextSecondary" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Harvana ID"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13sp" />

					<TextView
						android:id="@+id/tv_profile_pid"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="12dp"
						android:layout_weight="1"
						android:gravity="end"
						android:textColor="@color/colorTextPrimary"
						android:textIsSelectable="true"
						android:textSize="14sp"
						android:textStyle="bold" />
				</LinearLayout>

			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="14dp"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeColor="@color/colorCardStroke"
			app:strokeWidth="1dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="14dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Also on your profile"
					android:textColor="@color/colorTextPrimary"
					android:textSize="16sp"
					android:textStyle="bold" />

				<LinearLayout
					android:id="@+id/row_profile_contact_card"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:background="?android:attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="12dp"
					android:paddingBottom="12dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/icon_person_outline_outline_line"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp"
						android:paddingEnd="8dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="My contact card"
							android:textColor="@color/colorTextPrimary"
							android:textSize="15sp"
							android:textStyle="bold" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:paddingTop="2dp"
							android:text="Username, phone and chat links"
							android:textColor="@color/colorTextSecondary"
							android:textSize="12.5sp" />
					</LinearLayout>

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_arrow_right"
						app:tint="@color/colorAccent" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:layout_marginStart="48dp"
					android:alpha="0.2"
					android:background="@color/colorTextTertiary" />

				<LinearLayout
					android:id="@+id/row_profile_privacy"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:background="?android:attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingTop="12dp"
					android:paddingBottom="12dp">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_visibility_line"
						app:tint="@color/colorAccent" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical"
						android:paddingStart="12dp"
						android:paddingEnd="8dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Profile privacy"
							android:textColor="@color/colorTextPrimary"
							android:textSize="15sp"
							android:textStyle="bold" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:paddingTop="2dp"
							android:text="Bio, age and city"
							android:textColor="@color/colorTextSecondary"
							android:textSize="12.5sp" />
					</LinearLayout>

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_arrow_right"
						app:tint="@color/colorAccent" />
				</LinearLayout>

			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_profile_save"
				style="@style/HarvanaButton"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:enabled="false"
				android:text="Save changes" />
		</LinearLayout>
	</LinearLayout>
</ScrollView>
