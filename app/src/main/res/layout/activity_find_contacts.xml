<?xml version="1.0" encoding="utf-8"?>
<!-- Find friends from contacts: search, then contacts on Harvana (Follow) and the rest (Invite). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground"
	android:orientation="vertical">

	<EditText
		android:id="@+id/et_find_contacts_search"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:layout_marginStart="16dp"
		android:layout_marginTop="10dp"
		android:layout_marginEnd="16dp"
		android:layout_marginBottom="6dp"
		android:background="@drawable/bg_search_pill_stroke"
		android:drawableStart="@drawable/icon_search_24"
		android:drawablePadding="10dp"
		android:hint="Search your contacts"
		android:inputType="text"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:singleLine="true"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary"
		app:drawableTint="@color/colorTextTertiary" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/rv_find_contacts"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:paddingStart="16dp"
		android:paddingTop="4dp"
		android:paddingEnd="16dp"
		android:paddingBottom="24dp"
		app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
