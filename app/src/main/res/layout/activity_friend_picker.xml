<?xml version="1.0" encoding="utf-8"?>
<!-- Add friends to a group: search, a status line, the list of friends, then Select all and Add. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground"
	android:orientation="vertical">

	<EditText
		android:id="@+id/et_friend_picker_search"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:layout_marginStart="12dp"
		android:layout_marginTop="8dp"
		android:layout_marginEnd="12dp"
		android:background="@drawable/bg_field_surface"
		android:drawableStart="@drawable/icon_search_24"
		android:drawablePadding="8dp"
		android:hint="Search friends or type @username"
		android:inputType="text"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:singleLine="true"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary"
		app:drawableTint="@color/colorTextTertiary" />

	<TextView
		android:id="@+id/tv_friend_picker_hint"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="16dp"
		android:paddingTop="8dp"
		android:paddingEnd="16dp"
		android:paddingBottom="4dp"
		android:textColor="@color/colorTextSecondary"
		android:textSize="12sp" />

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<LinearLayout
			android:id="@+id/friend_picker_list"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:paddingBottom="12dp" />
	</ScrollView>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/colorSurface"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="12dp"
		android:paddingTop="8dp"
		android:paddingEnd="12dp"
		android:paddingBottom="8dp">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_friend_picker_all"
			style="@style/HarvanaButton.Outlined"
			android:layout_width="wrap_content"
			android:layout_height="52dp"
			android:text="Select all" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_friend_picker_add"
			style="@style/HarvanaButton"
			android:layout_width="0dp"
			android:layout_height="52dp"
			android:layout_marginStart="8dp"
			android:layout_weight="1"
			android:text="Add" />
	</LinearLayout>
</LinearLayout>
