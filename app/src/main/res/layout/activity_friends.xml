<?xml version="1.0" encoding="utf-8"?>
<!-- Friends: tabs (Friends, Following, Followers, Referrals, Blocked), ways to add people, search, the count, then the list. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="14dp"
		android:paddingTop="10dp"
		android:paddingEnd="14dp"
		android:paddingBottom="14dp">

		<HorizontalScrollView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:scrollbars="none">

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/chip_friends_0"
					android:layout_width="wrap_content"
					android:layout_height="38dp"
					android:layout_marginEnd="8dp"
					android:background="@drawable/bg_chip_off"
					android:gravity="center"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:text="Friends"
					android:textColor="@color/colorTextPrimary"
					android:textSize="14sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/chip_friends_1"
					android:layout_width="wrap_content"
					android:layout_height="38dp"
					android:layout_marginEnd="8dp"
					android:background="@drawable/bg_chip_off"
					android:gravity="center"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:text="Following"
					android:textColor="@color/colorTextPrimary"
					android:textSize="14sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/chip_friends_2"
					android:layout_width="wrap_content"
					android:layout_height="38dp"
					android:layout_marginEnd="8dp"
					android:background="@drawable/bg_chip_off"
					android:gravity="center"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:text="Followers"
					android:textColor="@color/colorTextPrimary"
					android:textSize="14sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/chip_friends_3"
					android:layout_width="wrap_content"
					android:layout_height="38dp"
					android:layout_marginEnd="8dp"
					android:background="@drawable/bg_chip_off"
					android:gravity="center"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:text="Referrals"
					android:textColor="@color/colorTextPrimary"
					android:textSize="14sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/chip_friends_4"
					android:layout_width="wrap_content"
					android:layout_height="38dp"
					android:layout_marginEnd="8dp"
					android:background="@drawable/bg_chip_off"
					android:gravity="center"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:text="Blocked"
					android:textColor="@color/colorTextPrimary"
					android:textSize="14sp"
					android:textStyle="bold" />

			</LinearLayout>
		</HorizontalScrollView>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/btn_friends_username"
				android:layout_width="0dp"
				android:layout_height="44dp"
				android:layout_marginEnd="8dp"
				android:layout_weight="1"
				android:background="@drawable/bg_pill_outline_accent"
				android:drawableStart="@drawable/icon_alternate_email_twotone_line"
				android:drawablePadding="6dp"
				android:gravity="center"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:text="Username"
				android:textColor="@color/colorAccent"
				android:textSize="13.5sp"
				android:textStyle="bold"
				app:drawableTint="@color/colorAccent" />

			<TextView
				android:id="@+id/btn_friends_contacts"
				android:layout_width="0dp"
				android:layout_height="44dp"
				android:layout_marginEnd="8dp"
				android:layout_weight="1"
				android:background="@drawable/bg_pill_outline_accent"
				android:drawableStart="@drawable/icon_person_outline_outline_line"
				android:drawablePadding="6dp"
				android:gravity="center"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:text="Contacts"
				android:textColor="@color/colorAccent"
				android:textSize="13.5sp"
				android:textStyle="bold"
				app:drawableTint="@color/colorAccent" />

			<TextView
				android:id="@+id/btn_friends_invite"
				android:layout_width="0dp"
				android:layout_height="44dp"
				android:layout_marginEnd="0dp"
				android:layout_weight="1"
				android:background="@drawable/bg_pill_outline_accent"
				android:drawableStart="@drawable/ic_pf_share"
				android:drawablePadding="6dp"
				android:gravity="center"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:text="Invite"
				android:textColor="@color/colorAccent"
				android:textSize="13.5sp"
				android:textStyle="bold"
				app:drawableTint="@color/colorAccent" />

		</LinearLayout>

		<EditText
			android:id="@+id/et_friends_search"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:layout_marginTop="12dp"
			android:background="@drawable/bg_search_pill_stroke"
			android:drawableStart="@drawable/icon_search_24"
			android:drawablePadding="8dp"
			android:hint="Search friends"
			android:inputType="text"
			android:paddingStart="16dp"
			android:paddingEnd="16dp"
			android:singleLine="true"
			android:textColor="@color/colorTextPrimary"
			android:textColorHint="@color/colorTextTertiary"
			android:textSize="15sp"
			app:drawableTint="@color/colorTextTertiary" />

		<TextView
			android:id="@+id/tv_friends_count"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingStart="2dp"
			android:paddingTop="18dp"
			android:paddingBottom="6dp"
			android:textColor="@color/colorTextPrimary"
			android:textSize="20sp"
			android:textStyle="bold" />

		<LinearLayout
			android:id="@+id/friends_referral_head"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical" />

		<LinearLayout
			android:id="@+id/friends_list"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical" />
	</LinearLayout>
</ScrollView>
