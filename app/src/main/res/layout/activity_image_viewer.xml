<?xml version="1.0" encoding="utf-8"?>
<!-- A picture full screen on black: the zoomable picture, a spinner while it loads, the close button top left. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#FF000000">

	<view
		android:id="@+id/image_viewer_zoom"
		class="com.harvana.app.utils.ImageViewerActivity$ZoomView"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<ProgressBar
		android:id="@+id/image_viewer_busy"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_gravity="center" />

	<ImageView
		android:id="@+id/image_viewer_close"
		android:layout_width="44dp"
		android:layout_height="44dp"
		android:layout_gravity="top|start"
		android:layout_marginStart="12dp"
		android:layout_marginTop="36dp"
		android:background="#66000000"
		android:contentDescription="Close"
		android:padding="11dp"
		android:src="@drawable/ic_close"
		app:tint="#FFFFFFFF" />
</FrameLayout>
