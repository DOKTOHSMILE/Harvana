<?xml version="1.0" encoding="utf-8"?>
<!-- Choose asset: a search field, then every coin (Harvana's stable coins right under HARV). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground"
	android:orientation="vertical"
	android:paddingStart="16dp"
	android:paddingTop="16dp"
	android:paddingEnd="16dp">

	<EditText
		android:id="@+id/et_pick_asset_search"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:background="@drawable/bg_field_surface"
		android:drawableStart="@drawable/icon_search_24"
		android:drawablePadding="10dp"
		android:hint="Search name, ticker or network"
		android:imeOptions="actionSearch"
		android:inputType="text"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:singleLine="true"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary"
		app:drawableTint="@color/colorTextTertiary" />

	<TextView
		android:id="@+id/tv_pick_asset_empty"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="16dp"
		android:text="No coin matches that."
		android:textColor="@color/colorTextSecondary"
		android:visibility="gone" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/rv_pick_asset"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
