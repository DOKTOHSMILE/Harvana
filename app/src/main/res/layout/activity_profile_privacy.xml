<?xml version="1.0" encoding="utf-8"?>
<!-- Profile privacy: what I choose to show, what is always public, what is never shown. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="4dp"
		android:paddingEnd="16dp"
		android:paddingBottom="28dp">

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeColor="@color/colorCardStroke"
			app:strokeWidth="1dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="16dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingBottom="4dp"
					android:text="You choose"
					android:textColor="@color/colorTextPrimary"
					android:textSize="16sp"
					android:textStyle="bold" />

				<LinearLayout
					android:id="@+id/row_show_age"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="56dp"
					android:background="?android:attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/ic_person_line"
						app:tint="@color/colorAccent" />

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:paddingStart="12dp"
						android:text="Show my age"
						android:textColor="@color/colorTextPrimary"
						android:textSize="15sp"
						android:textStyle="bold" />

					<com.google.android.material.switchmaterial.SwitchMaterial
						android:id="@+id/sw_show_age"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:clickable="false"
						android:focusable="false" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/row_show_city"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="56dp"
					android:background="?android:attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="@drawable/bg_icon_circle_accent_soft"
						android:importantForAccessibility="no"
						android:padding="8dp"
						android:src="@drawable/icon_flag_round_line"
						app:tint="@color/colorAccent" />

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:paddingStart="12dp"
						android:text="Show my city"
						android:textColor="@color/colorTextPrimary"
						android:textSize="15sp"
						android:textStyle="bold" />

					<com.google.android.material.switchmaterial.SwitchMaterial
						android:id="@+id/sw_show_city"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:clickable="false"
						android:focusable="false" />
				</LinearLayout>

				<com.google.android.material.textfield.TextInputLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:hint="Short bio (public)"
					app:counterEnabled="true"
					app:counterMaxLength="140">

					<com.google.android.material.textfield.TextInputEditText
						android:id="@+id/et_profile_bio"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="top|start"
						android:inputType="textMultiLine|textCapSentences"
						android:minLines="2"
						android:textColor="@color/colorTextPrimary" />
				</com.google.android.material.textfield.TextInputLayout>

				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_privacy_save"
					android:layout_width="match_parent"
					android:layout_height="52dp"
					android:layout_marginTop="16dp"
					android:enabled="false"
					android:text="Save"
					android:textAllCaps="false" />

				<TextView
					android:id="@+id/tv_privacy_status"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="8dp"
					android:textColor="@color/colorTextSecondary"
					android:textSize="12.5sp" />

			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeColor="@color/colorCardStroke"
			app:strokeWidth="1dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="16dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingBottom="4dp"
					android:text="Always public"
					android:textColor="@color/colorTextPrimary"
					android:textSize="16sp"
					android:textStyle="bold" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_check_circle_line"
						app:tint="@color/colorSuccess" />

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:paddingStart="12dp"
						android:text="Trust score"
						android:textColor="@color/colorTextPrimary"
						android:textSize="14sp" />
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_check_circle_line"
						app:tint="@color/colorSuccess" />

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:paddingStart="12dp"
						android:text="Country and state"
						android:textColor="@color/colorTextPrimary"
						android:textSize="14sp" />
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_check_circle_line"
						app:tint="@color/colorSuccess" />

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:paddingStart="12dp"
						android:text="Groups and loans (counts)"
						android:textColor="@color/colorTextPrimary"
						android:textSize="14sp" />
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_check_circle_line"
						app:tint="@color/colorSuccess" />

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:paddingStart="12dp"
						android:text="Badges"
						android:textColor="@color/colorTextPrimary"
						android:textSize="14sp" />
				</LinearLayout>

			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeColor="@color/colorCardStroke"
			app:strokeWidth="1dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="16dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingBottom="4dp"
					android:text="Never shown"
					android:textColor="@color/colorTextPrimary"
					android:textSize="16sp"
					android:textStyle="bold" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_block_line"
						app:tint="@color/colorError" />

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:paddingStart="12dp"
						android:text="Amounts"
						android:textColor="@color/colorTextPrimary"
						android:textSize="14sp" />
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_block_line"
						app:tint="@color/colorError" />

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:paddingStart="12dp"
						android:text="Group names"
						android:textColor="@color/colorTextPrimary"
						android:textSize="14sp" />
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_block_line"
						app:tint="@color/colorError" />

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:paddingStart="12dp"
						android:text="Date of birth, phone, email, address"
						android:textColor="@color/colorTextPrimary"
						android:textSize="14sp" />
				</LinearLayout>

			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_privacy_preview"
			style="@style/Widget.MaterialComponents.Button.OutlinedButton"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:layout_marginTop="16dp"
			android:text="See how my profile looks to others"
			android:textAllCaps="false" />
	</LinearLayout>
</ScrollView>
