<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:elevation="0dp"
		android:stateListAnimator="@null">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/appBarColor"
            app:title="Harvana Protocol"
            app:popupTheme="@style/AppTheme.PopupOverlay" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/staking_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CUSTOM PILL TABS -->
            <LinearLayout
                android:id="@+id/staking_pill"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_tab_container"
                android:orientation="horizontal"
                android:padding="4dp">
                <TextView
                    android:id="@+id/tab_stake"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Staking"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:background="@drawable/bg_tab_active" />
                <TextView
                    android:id="@+id/tab_positions"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="My Positions"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextMuted"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- ========================================== -->
            <!-- PAGE 1: STAKING OVERVIEW                   -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/page_stake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <!-- Header Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/colorCardStroke"
                    app:strokeWidth="1dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/lbl_ts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Staked"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:id="@+id/tv_overview_staked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 HARV"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/lbl_ts"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:id="@+id/tv_daily_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="~ +0.00% Today"
                            android:textColor="@color/colorSuccess"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            app:layout_constraintTop_toBottomOf="@id/tv_overview_staked"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <LinearLayout
                            android:id="@+id/row_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            app:layout_constraintTop_toBottomOf="@id/tv_daily_pct">
                            
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Unclaimed Rewards"
                                    android:textColor="@color/colorTextMuted"
                                    android:textSize="12sp"/>
                                <TextView
                                    android:id="@+id/tv_overview_unclaimed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 HARV"
                                    android:textColor="@color/colorTextPrimary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Est. APY"
                                    android:textColor="@color/colorTextMuted"
                                    android:textSize="12sp"/>
                                <TextView
                                    android:id="@+id/tv_apy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--%"
                                    android:textColor="@color/colorTextPrimary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_pool"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="● Staking active   0 stakers · 0 HARV per block"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="11sp"
                            app:layout_constraintTop_toBottomOf="@id/row_stats"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/img_app_logo"/>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/img_app_logo"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:contentDescription="Harvana"
                            android:src="@drawable/ic_coin_harv"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:alpha="0.4"
                            android:rotation="30"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chart Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/colorCardStroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Rewards Overview"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                            <TextView android:id="@+id/chip_1d" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1D" android:textColor="@color/colorTextMuted" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:textSize="10sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/chip_3d" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3D" android:textColor="@color/colorTextMuted" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:textSize="10sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/chip_7d" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7D" android:textColor="@color/colorBackground" android:background="@drawable/bg_pill_orange" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:textSize="10sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/chip_1m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1M" android:textColor="@color/colorTextMuted" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:textSize="10sp"/>
                            <TextView android:id="@+id/chip_3m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3M" android:textColor="@color/colorTextMuted" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:textSize="10sp"/>
                            <TextView android:id="@+id/chip_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALL" android:textColor="@color/colorTextMuted" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:textSize="10sp"/>
                        </LinearLayout>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/reward_chart"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stake Form -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/colorCardStroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Stake Asset"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Earn protocol rewards while securing the network."
                            android:textColor="@color/colorTextMuted"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Amount"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_dark"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_amount"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@null"
                                android:inputType="numberDecimal"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="18sp"
                                android:hint="0.00"/>
                            
                            <!-- Dropdown Spinner for Coin -->
                            <com.harvana.app.ui.MaterialSpinner
                                android:id="@+id/spAsset"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:backgroundTint="#FFFFFF"
                                android:layout_marginEnd="8dp"/>
                            
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_max"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MAX"
                                android:textColor="@color/colorSuccess"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:textStyle="bold"
                                android:textSize="12sp"
	app:backgroundTint="#1A00FFA3"
	android:textAllCaps="false"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_available"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Available 0.00 HARV"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Lock period"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"/>

                        <!-- Lock Duration Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_lock_free"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/colorSurfaceAlt"
                                app:strokeColor="@color/colorAccent"
                                app:strokeWidth="1dp"
                                app:cardCornerRadius="8dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:gravity="center">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Free" android:textColor="@color/colorTextPrimary" android:textSize="13sp" android:textStyle="bold"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1x · until you unstake" android:textColor="@color/colorTextMuted" android:textSize="10sp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_lock_7"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cardBackgroundColor="@color/colorSurfaceAlt"
                                app:strokeColor="@color/colorCardStroke"
                                app:strokeWidth="1dp"
                                app:cardCornerRadius="8dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:gravity="center">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7 days" android:textColor="@color/colorTextPrimary" android:textSize="13sp" android:textStyle="bold"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.25x weight" android:textColor="@color/colorTextMuted" android:textSize="10sp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_lock_30"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cardBackgroundColor="@color/colorSurfaceAlt"
                                app:strokeColor="@color/colorCardStroke"
                                app:strokeWidth="1dp"
                                app:cardCornerRadius="8dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:gravity="center">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30 days" android:textColor="@color/colorTextPrimary" android:textSize="13sp" android:textStyle="bold"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.75x weight" android:textColor="@color/colorTextMuted" android:textSize="10sp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_lock_90"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cardBackgroundColor="@color/colorSurfaceAlt"
                                app:strokeColor="@color/colorCardStroke"
                                app:strokeWidth="1dp"
                                app:cardCornerRadius="8dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:gravity="center">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="90 days" android:textColor="@color/colorTextPrimary" android:textSize="13sp" android:textStyle="bold"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2.5x weight" android:textColor="@color/colorTextMuted" android:textSize="10sp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <com.google.android.material.imageview.ShapeableImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_coin_harv"/>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estimated rewards" android:textColor="@color/colorTextMuted" android:textSize="12sp"/>
                                <TextView android:id="@+id/tv_est_reward_input" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="~ 0.0000 HARV / Term" android:textColor="@color/colorSuccess" android:textSize="12sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_stake"
                            android:tag="payment_button"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="24dp"
                            android:text="Stake HARV"
                            android:textAllCaps="false"
                            android:textColor="#000000"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/colorAccent" />
                            
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- PAGE 2: MY POSITIONS                       -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/page_positions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <!-- Detailed Portfolio Header -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/colorCardStroke"
                    app:strokeWidth="1dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/lbl_port"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Staking Portfolio"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:id="@+id/tv_pos_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 HARV"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/lbl_port"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:id="@+id/tv_pos_daily_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="~ +0.015% Daily"
                            android:textColor="@color/colorSuccess"
                            android:textSize="12sp"
                            app:layout_constraintTop_toBottomOf="@id/tv_pos_total"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:layout_marginTop="24dp"
                            app:layout_constraintTop_toBottomOf="@id/tv_pos_daily_pct">

                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Total Staked" android:textColor="@color/colorTextMuted" android:textSize="12sp" android:layout_columnWeight="1"/>
                            <TextView android:id="@+id/tv_grid_total" android:layout_width="0dp" android:layout_height="wrap_content" android:text="0 HARV" android:textColor="@color/colorTextPrimary" android:textSize="12sp" android:gravity="end" android:layout_columnWeight="1"/>

                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Unclaimed" android:textColor="@color/colorTextMuted" android:textSize="12sp" android:layout_columnWeight="1" android:layout_marginTop="8dp"/>
                            <TextView android:id="@+id/tv_grid_unclaimed" android:layout_width="0dp" android:layout_height="wrap_content" android:text="0 HARV" android:textColor="@color/colorTextPrimary" android:textSize="12sp" android:gravity="end" android:layout_columnWeight="1" android:layout_marginTop="8dp"/>

                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="APR · APY" android:textColor="@color/colorTextMuted" android:textSize="12sp" android:layout_columnWeight="1" android:layout_marginTop="8dp"/>
                            <TextView android:id="@+id/tv_grid_apy" android:layout_width="0dp" android:layout_height="wrap_content" android:text="--%" android:textColor="@color/colorTextPrimary" android:textSize="12sp" android:gravity="end" android:layout_columnWeight="1" android:layout_marginTop="8dp"/>
                        </GridLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Claim Banner Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/colorAccent"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_claim_gradient"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Claim Rewards"
                                android:textColor="@color/colorTextPrimary"
                                android:textStyle="bold"
                                android:textSize="16sp"/>
                            <TextView
                                android:id="@+id/tv_claim_sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rewards unlock every 24 hours."
                                android:textColor="#E0E0E0"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_claim"
                            android:tag="payment_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Claim Now"
                            android:textAllCaps="false"
                            android:textColor="#000000"
                            app:cornerRadius="20dp"
                            app:backgroundTint="@color/colorAccent"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Live / Closed switch keeps the page short -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_live_closed"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/toggle_height"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_tab_container"
                    app:tabGravity="fill"
                    app:tabIndicator="@drawable/bg_toggle_indicator"
                    app:tabIndicatorColor="@color/colorAccent"
                    app:tabIndicatorFullWidth="true"
                    app:tabIndicatorGravity="stretch"
                    app:tabMode="fixed"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabSelectedTextColor="@color/colorTextOnAccent"
                    app:tabTextAppearance="@style/Harvana.Tab"
                    app:tabTextColor="@color/colorTextSecondary" />

                <LinearLayout
                    android:id="@+id/live_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_live_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="No live stakes yet. Stake HARV on the Staking tab and each stake appears here."
                        android:textColor="@color/colorTextMuted"
                        android:textSize="13sp"
                        android:visibility="gone"/>
                    <!-- one card per stake, added in code -->
                    <LinearLayout
                        android:id="@+id/stakes_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="32dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/closed_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                <!-- Unbonding Queue -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unbonding &amp; Withdrawals"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tv_unbond_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● 0 In Progress"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="12sp"
                        android:layout_marginLeft="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/unbonding_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="32dp"
                    android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
