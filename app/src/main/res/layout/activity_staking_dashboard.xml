<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundMain">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Harvanna Protocol"
            app:titleTextColor="#FFFFFF"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CUSTOM PILL TABS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_tab_container"
                android:orientation="horizontal"
                android:padding="4dp"
                app:boxCornerRadius="24dp">
                <TextView
                    android:id="@+id/tab_stake"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Staking"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_active" />
                <TextView
                    android:id="@+id/tab_positions"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="My Positions"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextMuted"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- ========================================== -->
            <!-- PAGE 1: STAKING OVERVIEW (Image 1)         -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/page_stake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <!-- Header Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/colorSurfaceDark"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/colorStrokeBase"
                    app:strokeWidth="1dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/lbl_ts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Staked"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                        
                        <TextView
                            android:id="@+id/tv_overview_staked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0000 HARV"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/lbl_ts"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:id="@+id/tv_daily_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="~ +0.018% Daily Fluctuating"
                            android:textColor="@color/colorSuccessNeon"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            app:layout_constraintTop_toBottomOf="@id/tv_overview_staked"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:id="@+id/lbl_unclaimed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unclaimed Rewards"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"
                            android:layout_marginTop="16dp"
                            app:layout_constraintTop_toBottomOf="@id/tv_daily_pct"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:id="@+id/tv_overview_unclaimed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0000 HARV"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/lbl_unclaimed"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <!-- Giant Logo aligned to right -->
                        <ImageView
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:src="@drawable/ic_harv_glow_logo"
                            android:alpha="0.8"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chart Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/colorSurfaceDark"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/colorStrokeBase"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Rewards Overview"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                            <!-- Tiny chart filter pills -->
                            <TextView android:id="@+id/chip_7d" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7D" android:textColor="@color/colorBackgroundMain" android:background="@drawable/bg_pill_orange" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:textSize="10sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/chip_1m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1M" android:textColor="@color/colorTextMuted" android:layout_marginLeft="8dp" android:textSize="10sp"/>
                            <TextView android:id="@+id/chip_3m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3M" android:textColor="@color/colorTextMuted" android:layout_marginLeft="8dp" android:textSize="10sp"/>
                            <TextView android:id="@+id/chip_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALL" android:textColor="@color/colorTextMuted" android:layout_marginLeft="8dp" android:textSize="10sp"/>
                        </LinearLayout>
                        
                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/reward_chart"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stake Form -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/colorSurfaceDark"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/colorStrokeBase"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Stake HARV"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Earn protocol rewards continuously."
                            android:textColor="@color/colorTextMuted"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Amount"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"/>
                        
                        <!-- Dark Input Field -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_dark"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">
                            <EditText
                                android:id="@+id/et_amount"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@null"
                                android:inputType="numberDecimal"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:hint="0.00"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HARV"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:layout_marginEnd="16dp"/>
                            <TextView
                                android:id="@+id/btn_max"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MAX"
                                android:textColor="@color/colorSuccessNeon"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_available"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Available 0.00 HARV"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"/>

                        <!-- Type Box -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface_light"
                            android:padding="12dp"
                            android:layout_marginTop="16dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Liquid (24-hour cooldown)"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Stake Weight: 1x (Liquid)"
                                android:textColor="@color/colorTextMuted"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_stake"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="24dp"
                            android:text="Stake HARV"
                            android:textAllCaps="false"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/colorHarvOrange" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- PAGE 2: MY POSITIONS (Image 2)             -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/page_positions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <!-- Detailed Portfolio Header -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/colorSurfaceDark"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/colorStrokeBase"
                    app:strokeWidth="1dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/lbl_port"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Staking Portfolio"
                            android:textColor="@color/colorTextMuted"
                            android:textSize="12sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                        
                        <TextView
                            android:id="@+id/tv_pos_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0000 HARV"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/lbl_port"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:id="@+id/tv_pos_daily_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="~ +0.015% Daily"
                            android:textColor="@color/colorSuccessNeon"
                            android:textSize="12sp"
                            app:layout_constraintTop_toBottomOf="@id/tv_pos_total"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <!-- Info Grid -->
                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:layout_marginTop="24dp"
                            app:layout_constraintTop_toBottomOf="@id/tv_pos_daily_pct">
                            
                            <TextView android:text="Total Staked" android:textColor="@color/colorTextMuted" android:textSize="12sp" android:layout_columnWeight="1"/>
                            <TextView android:id="@+id/tv_grid_total" android:text="0.0000 HARV" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="end" android:layout_columnWeight="1"/>

                            <TextView android:text="Unclaimed" android:textColor="@color/colorTextMuted" android:textSize="12sp" android:layout_columnWeight="1" android:layout_marginTop="8dp"/>
                            <TextView android:id="@+id/tv_grid_unclaimed" android:text="0.0000 HARV" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="end" android:layout_columnWeight="1" android:layout_marginTop="8dp"/>

                            <TextView android:text="Pool APY" android:textColor="@color/colorTextMuted" android:textSize="12sp" android:layout_columnWeight="1" android:layout_marginTop="8dp"/>
                            <TextView android:id="@+id/tv_grid_apy" android:text="--%" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="end" android:layout_columnWeight="1" android:layout_marginTop="8dp"/>
                        </GridLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Claim Banner Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/colorHarvOrange"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_claim_gradient"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Claim Rewards"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="16sp"/>
                            <TextView
                                android:id="@+id/tv_claim_sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rewards unlock every 24 hours."
                                android:textColor="#E0E0E0"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_claim"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Claim Now"
                            android:textAllCaps="false"
                            android:textColor="#000000"
                            app:cornerRadius="20dp"
                            app:backgroundTint="@color/colorHarvOrange"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Active Positions -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Staking Positions"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="24dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/active_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/colorSurfaceDark"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/colorStrokeBase"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Active (Earning)"
                            android:textColor="@color/colorSuccessNeon"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_badge_green"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_harv_coin" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginLeft="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="HARV"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Harvanna Token"
                                    android:textColor="@color/colorTextMuted"
                                    android:textSize="12sp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Staked Amount"
                                    android:textColor="@color/colorTextMuted"
                                    android:textSize="12sp"/>
                                <TextView
                                    android:id="@+id/tv_active_amount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0.0000 HARV"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorStrokeBase" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:text="Stake Type" android:textColor="@color/colorTextMuted" android:textSize="12sp"/>
                                <TextView android:text="Liquid (1x Weight)" android:textColor="#FFFFFF" android:textSize="13sp" android:layout_marginTop="2dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:text="Est. Monthly Reward" android:textColor="@color/colorTextMuted" android:textSize="12sp"/>
                                <TextView android:id="@+id/tv_active_monthly" android:text="~ 0.00 HARV" android:textColor="#FFFFFF" android:textSize="13sp" android:layout_marginTop="2dp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_active_unstake"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="[Unstake]"
                            android:textAllCaps="false"
                            android:textColor="@color/colorHarvOrange"
                            app:strokeColor="@color/colorStrokeBase"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dynamic Unbonding List Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unbonding &amp; Withdrawals"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tv_unbond_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● 0 In Progress"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="12sp"
                        android:layout_marginLeft="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/unbonding_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="32dp"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Nav Placeholder (to match image) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="@color/colorSurfaceDark"
        android:orientation="horizontal"
        android:elevation="8dp">
        <!-- Add your BottomNavigationView here -->
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
