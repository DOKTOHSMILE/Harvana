<?xml version="1.0" encoding="utf-8"?>
<!-- Swap: you pay (amount, coin, balance, Max), flip, you get, the figures table, Swap, your swaps, the pools. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="16dp"
		android:paddingEnd="16dp"
		android:paddingBottom="24dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/bg_card_surface_18"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingTop="14dp"
			android:paddingEnd="16dp"
			android:paddingBottom="14dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="You pay"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<EditText
					android:id="@+id/et_swap_amount"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:background="@null"
					android:hint="0"
					android:inputType="numberDecimal"
					android:singleLine="true"
					android:textSize="26sp"
					android:textStyle="bold" />

				<LinearLayout
					android:id="@+id/swap_chip_from"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_pill_background"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="10dp"
					android:paddingTop="6dp"
					android:paddingEnd="12dp"
					android:paddingBottom="6dp">

					<ImageView
						android:id="@+id/iv_swap_from"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:importantForAccessibility="no" />

					<TextView
						android:id="@+id/tv_swap_from"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingStart="6dp"
						android:paddingEnd="2dp"
						android:textColor="@color/colorTextPrimary"
						android:textSize="15sp"
						android:textStyle="bold" />

					<ImageView
						android:layout_width="18dp"
						android:layout_height="18dp"
						android:importantForAccessibility="no"
						android:src="@drawable/icon_arrow_drop_down_round"
						app:tint="@color/colorTextSecondary" />
				</LinearLayout>

			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/tv_swap_balance"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="Balance: …"
					android:textColor="@color/colorTextTertiary"
					android:textSize="12sp" />

				<TextView
					android:id="@+id/tv_swap_max"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minHeight="36dp"
					android:gravity="center_vertical"
					android:paddingStart="8dp"
					android:text="Max"
					android:textColor="@color/colorAccent"
					android:textSize="13sp"
					android:textStyle="bold" />
			</LinearLayout>
		</LinearLayout>

		<ImageView
			android:id="@+id/iv_swap_flip"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="4dp"
			android:layout_marginBottom="4dp"
			android:background="@drawable/bg_icon_circle_accent_soft"
			android:contentDescription="Swap the two sides"
			android:padding="8dp"
			android:src="@drawable/ic_app_swap" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/bg_card_surface_18"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingTop="14dp"
			android:paddingEnd="16dp"
			android:paddingBottom="14dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="You get (estimate)"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/tv_swap_out"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="0"
					android:textColor="@color/colorTextPrimary"
					android:textSize="26sp"
					android:textStyle="bold" />

				<LinearLayout
					android:id="@+id/swap_chip_to"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_pill_background"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="10dp"
					android:paddingTop="6dp"
					android:paddingEnd="12dp"
					android:paddingBottom="6dp">

					<ImageView
						android:id="@+id/iv_swap_to"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:importantForAccessibility="no" />

					<TextView
						android:id="@+id/tv_swap_to"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingStart="6dp"
						android:paddingEnd="2dp"
						android:textColor="@color/colorTextPrimary"
						android:textSize="15sp"
						android:textStyle="bold" />

					<ImageView
						android:layout_width="18dp"
						android:layout_height="18dp"
						android:importantForAccessibility="no"
						android:src="@drawable/icon_arrow_drop_down_round"
						app:tint="@color/colorTextSecondary" />
				</LinearLayout>

			</LinearLayout>
		</LinearLayout>

		<TextView
			android:id="@+id/tv_swap_problem"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingStart="6dp"
			android:paddingTop="10dp"
			android:paddingEnd="6dp"
			android:paddingBottom="4dp"
			android:textColor="@color/colorWarning"
			android:textSize="12sp" />

		<LinearLayout
			android:id="@+id/swap_details"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:orientation="vertical" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_swap"
			style="@style/HarvanaButton"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:layout_marginTop="8dp"
			android:enabled="false"
			android:text="Swap" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingStart="4dp"
			android:paddingTop="22dp"
			android:paddingBottom="6dp"
			android:text="Your swaps"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />

		<LinearLayout
			android:id="@+id/swap_orders"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/bg_card_surface_18"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingTop="8dp"
			android:paddingEnd="16dp"
			android:paddingBottom="8dp" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingStart="4dp"
			android:paddingTop="22dp"
			android:paddingBottom="6dp"
			android:text="Pools"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />

		<LinearLayout
			android:id="@+id/swap_pools"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/bg_card_surface_18"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingTop="8dp"
			android:paddingEnd="16dp"
			android:paddingBottom="8dp" />

	</LinearLayout>
</ScrollView>
