<?xml version="1.0" encoding="utf-8"?>
<!-- Total saved: the total in the chosen currency, then by coin, by group, loans and by kind of group. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="8dp"
		android:paddingEnd="16dp"
		android:paddingBottom="32dp">

		<LinearLayout
			android:id="@+id/total_saved_loading"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical" />

		<LinearLayout
			android:id="@+id/total_saved_content"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone">

			<TextView
				android:id="@+id/tv_total_saved_label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:letterSpacing="0.06"
				android:textColor="@color/colorTextSecondary"
				android:textSize="12sp"
				android:textStyle="bold" />

			<TextView
				android:id="@+id/tv_total_saved_amount"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingTop="4dp"
				android:paddingBottom="2dp"
				android:textColor="@color/colorTextPrimary"
				android:textSize="34sp"
				android:textStyle="bold" />

			<TextView
				android:id="@+id/tv_total_saved_counts"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp" />

			<LinearLayout
				android:id="@+id/total_saved_by_coin"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical" />

			<LinearLayout
				android:id="@+id/total_saved_groups_section"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:orientation="vertical">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:letterSpacing="0.06"
					android:paddingStart="4dp"
					android:text="BY GROUP"
					android:textColor="@color/colorTextTertiary"
					android:textSize="11sp"
					android:textStyle="bold" />

				<LinearLayout
					android:id="@+id/total_saved_groups"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical" />
			</LinearLayout>

			<LinearLayout
				android:id="@+id/total_saved_loans"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:orientation="vertical" />

			<LinearLayout
				android:id="@+id/total_saved_kinds"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:orientation="vertical" />
		</LinearLayout>
	</LinearLayout>
</ScrollView>
