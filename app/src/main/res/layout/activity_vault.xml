<?xml version="1.0" encoding="utf-8"?>
<!-- Mint a coin with HARV: your vault (locked, owed, cover, can mint, HARV price), the four actions, then vaults under the line. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="16dp"
		android:paddingEnd="16dp"
		android:paddingBottom="24dp">

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="18dp"
			app:cardElevation="0dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="16dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingBottom="4dp"
					android:text="Your vault"
					android:textColor="@color/colorTextPrimary"
					android:textSize="15sp"
					android:textStyle="bold" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginEnd="12dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_harv_coin" />

					<TextView
						android:id="@+id/tv_vault_locked_label"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="HARV locked"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13sp" />

					<TextView
						android:id="@+id/tv_vault_locked"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1.4"
						android:gravity="end"
						android:text="…"
						android:textColor="@color/colorTextPrimary"
						android:textIsSelectable="true"
						android:textSize="14sp"
						android:textStyle="bold" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:alpha="0.14"
					android:background="@color/colorTextTertiary" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginEnd="12dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_coin_stable" />

					<TextView
						android:id="@+id/tv_vault_owed_label"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Owed"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13sp" />

					<TextView
						android:id="@+id/tv_vault_owed"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1.4"
						android:gravity="end"
						android:text="…"
						android:textColor="@color/colorTextPrimary"
						android:textIsSelectable="true"
						android:textSize="14sp"
						android:textStyle="bold" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:alpha="0.14"
					android:background="@color/colorTextTertiary" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginEnd="12dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_shield_line" />

					<TextView
						android:id="@+id/tv_vault_cover_label"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Cover"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13sp" />

					<TextView
						android:id="@+id/tv_vault_cover"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1.4"
						android:gravity="end"
						android:text="…"
						android:textColor="@color/colorTextPrimary"
						android:textIsSelectable="true"
						android:textSize="14sp"
						android:textStyle="bold" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:alpha="0.14"
					android:background="@color/colorTextTertiary" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginEnd="12dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_tx_stake_line" />

					<TextView
						android:id="@+id/tv_vault_can_mint_label"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="You can mint now"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13sp" />

					<TextView
						android:id="@+id/tv_vault_can_mint"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1.4"
						android:gravity="end"
						android:text="…"
						android:textColor="@color/colorTextPrimary"
						android:textIsSelectable="true"
						android:textSize="14sp"
						android:textStyle="bold" />
				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:alpha="0.14"
					android:background="@color/colorTextTertiary" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="50dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginEnd="12dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_pie_chart" />

					<TextView
						android:id="@+id/tv_vault_price_label"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="HARV price"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13sp" />

					<TextView
						android:id="@+id/tv_vault_price"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1.4"
						android:gravity="end"
						android:text="…"
						android:textColor="@color/colorTextPrimary"
						android:textIsSelectable="true"
						android:textSize="14sp"
						android:textStyle="bold" />
				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:orientation="horizontal">

					<com.google.android.material.button.MaterialButton
						android:id="@+id/btn_vault_lock"
						style="@style/HarvanaButton"
						android:layout_width="0dp"
						android:layout_height="52dp"
						android:layout_marginEnd="4dp"
						android:layout_weight="1"
						android:text="Lock HARV"
						app:icon="@drawable/icon_lock_round_line" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/btn_vault_mint"
						style="@style/HarvanaButton"
						android:layout_width="0dp"
						android:layout_height="52dp"
						android:layout_marginStart="4dp"
						android:layout_weight="1"
						android:text="Mint"
						app:icon="@drawable/ic_coin_stable" />

				</LinearLayout>

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:orientation="horizontal">

					<com.google.android.material.button.MaterialButton
						android:id="@+id/btn_vault_repay"
						style="@style/HarvanaButton"
						android:layout_width="0dp"
						android:layout_height="52dp"
						android:layout_marginEnd="4dp"
						android:layout_weight="1"
						android:text="Repay"
						app:icon="@drawable/ic_check_circle_line" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/btn_vault_withdraw"
						style="@style/HarvanaButton"
						android:layout_width="0dp"
						android:layout_height="52dp"
						android:layout_marginStart="4dp"
						android:layout_weight="1"
						android:text="Take HARV back"
						app:icon="@drawable/ic_wallet_line" />

				</LinearLayout>
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingStart="4dp"
			android:paddingTop="18dp"
			android:paddingBottom="6dp"
			android:text="Vaults under the line"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />

		<LinearLayout
			android:id="@+id/vault_risky"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/bg_card_surface_18"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingTop="8dp"
			android:paddingEnd="16dp"
			android:paddingBottom="8dp" />
	</LinearLayout>
</ScrollView>
