<?xml version="1.0" encoding="utf-8"?>
<!-- Confirm your email: the address, status, "I have confirmed", "Resend", and "Use a different account". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground"
	android:gravity="center_horizontal"
	android:orientation="vertical"
	android:paddingStart="24dp"
	android:paddingTop="72dp"
	android:paddingEnd="24dp"
	android:paddingBottom="24dp">

	<ImageView
		android:layout_width="64dp"
		android:layout_height="64dp"
		android:background="@drawable/bg_icon_circle_accent_soft"
		android:importantForAccessibility="no"
		android:padding="16dp"
		android:src="@drawable/icon_alternate_email_twotone_line"
		app:tint="@color/colorAccent" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:text="Confirm your email"
		android:textColor="@color/colorTextPrimary"
		android:textSize="24sp"
		android:textStyle="bold" />

	<TextView
		android:id="@+id/tv_verify_body"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:paddingTop="12dp"
		android:paddingBottom="24dp"
		android:textColor="@color/colorTextTertiary"
		android:textSize="14sp" />

	<TextView
		android:id="@+id/tv_verify_state"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:paddingBottom="12dp"
		android:textColor="@color/colorTextTertiary"
		android:textSize="13sp" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/btn_verify_confirmed"
		style="@style/HarvanaButton"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:layout_marginTop="10dp"
		android:text="I have confirmed my email" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/btn_verify_resend"
		style="@style/HarvanaButton.Tonal"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:layout_marginTop="10dp"
		android:text="Resend confirmation email" />

	<TextView
		android:id="@+id/tv_verify_other_account"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:minHeight="48dp"
		android:gravity="center"
		android:paddingTop="20dp"
		android:paddingBottom="8dp"
		android:text="Use a different account"
		android:textColor="@color/colorAccent"
		android:textSize="14sp" />
</LinearLayout>
