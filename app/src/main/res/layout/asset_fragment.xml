<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@android:color/transparent"
	android:id="@+id/_main">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/app_bar_layout2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@android:color/transparent"
		app:elevation="0dp"
		android:stateListAnimator="@null">
		<com.google.android.material.appbar.CollapsingToolbarLayout
			android:id="@+id/collapsingtoolbar2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:contentScrim="@color/colorSurface"
			app:layout_scrollFlags="scroll|enterAlways|snap">
			<LinearLayout
				android:id="@+id/linear2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="14dp"
				android:paddingBottom="14dp"
				android:background="@android:color/transparent"
				android:orientation="vertical"
				android:paddingStart="20dp"
				android:paddingEnd="20dp"
				app:layout_collapseMode="parallax">
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview_switch_wallet"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="6dp"
					app:cardBackgroundColor="@color/darkFaint10"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<LinearLayout
						android:id="@+id/linear_switch_wallet"
						android:layout_width="150dp"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:background="@color/darkFaint10"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/imageview6"
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:layout_marginRight="5dp"
							android:src="@drawable/icon_account_balance_wallet_outline_"
							android:scaleType="centerInside"
							android:tint="@color/colorTextTertiary" android:duplicateParentState="true" />
						<TextView
							android:id="@+id/tv_active_wallet_label"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="My Wallet"
							android:textSize="15sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:singleLine="true"
							android:layout_weight="1" />
						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/imageview3"
							android:layout_width="28dp"
							android:layout_height="28dp"
							android:padding="5dp"
							android:src="@drawable/icon_visibility_twotone_line"
							android:scaleType="centerInside"
							app:tint="@color/colorTextTertiary" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<LinearLayout
					android:id="@+id/linear7"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="70dp"
					android:layout_marginBottom="100dp"
					android:gravity="top"
					android:orientation="vertical"
					android:layout_gravity="center_horizontal|center_vertical">
					<TextView
						android:id="@+id/textview10"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="TOTAL BALANCE"
						android:textSize="10sp"
						android:textColor="@color/colorTextSecondary" />
					<LinearLayout
						android:id="@+id/linear54"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:layout_weight="1">
						<TextView
							android:id="@+id/tv_fiat_value"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:text="NGN 0.00"
							android:textSize="32sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:singleLine="true" />
						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/imageview4"
							android:layout_width="30dp"
							android:layout_height="match_parent"
							android:padding="6dp"
							android:src="@drawable/icon_visibility_twotone_line"
							android:scaleType="centerInside"
							app:tint="@color/colorTextTertiary" />
					</LinearLayout>
				</LinearLayout>
				<!-- Same actions, order and icons as Home's wallet card (Send, Receive, Swap, P2P), then Web3. Five fit
				     a 360dp phone with the icon above the label. -->
				<LinearLayout
					android:id="@+id/linear3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview2"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginStart="0dp"
						android:layout_marginEnd="4dp"
						android:contentDescription="Send"
						app:cardBackgroundColor="@color/colorActionSurface"
						app:cardCornerRadius="12dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorActionStroke"
						app:strokeWidth="1dp">
						<LinearLayout
							android:id="@+id/linear5"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center"
							android:minHeight="56dp"
							android:orientation="vertical"
							android:paddingStart="2dp"
							android:paddingTop="8dp"
							android:paddingEnd="2dp"
							android:paddingBottom="8dp">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview2"
								android:layout_width="20dp"
								android:layout_height="20dp"
								android:duplicateParentState="true"
								android:importantForAccessibility="no"
								android:scaleType="centerInside"
								android:src="@drawable/ic_action_send"
								app:tint="@color/colorAccent" />
							<TextView
								android:id="@+id/textview5"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:ellipsize="end"
								android:fontFamily="sans-serif-medium"
								android:maxLines="1"
								android:text="Send"
								android:textColor="@color/colorTextPrimary"
								android:textSize="12sp" />
						</LinearLayout>
					</com.google.android.material.card.MaterialCardView>
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview1"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginStart="4dp"
						android:layout_marginEnd="4dp"
						android:contentDescription="Receive"
						app:cardBackgroundColor="@color/colorActionSurface"
						app:cardCornerRadius="12dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorActionStroke"
						app:strokeWidth="1dp">
						<LinearLayout
							android:id="@+id/linear4"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center"
							android:minHeight="56dp"
							android:orientation="vertical"
							android:paddingStart="2dp"
							android:paddingTop="8dp"
							android:paddingEnd="2dp"
							android:paddingBottom="8dp">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview1"
								android:layout_width="20dp"
								android:layout_height="20dp"
								android:duplicateParentState="true"
								android:importantForAccessibility="no"
								android:scaleType="centerInside"
								android:src="@drawable/ic_action_receive"
								app:tint="@color/colorAccent" />
							<TextView
								android:id="@+id/textview4"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:ellipsize="end"
								android:fontFamily="sans-serif-medium"
								android:maxLines="1"
								android:text="Receive"
								android:textColor="@color/colorTextPrimary"
								android:textSize="12sp" />
						</LinearLayout>
					</com.google.android.material.card.MaterialCardView>
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/card_swap"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginStart="4dp"
						android:layout_marginEnd="4dp"
						android:contentDescription="Swap"
						app:cardBackgroundColor="@color/colorActionSurface"
						app:cardCornerRadius="12dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorActionStroke"
						app:strokeWidth="1dp">
						<LinearLayout
							android:id="@+id/linear_swap"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center"
							android:minHeight="56dp"
							android:orientation="vertical"
							android:paddingStart="2dp"
							android:paddingTop="8dp"
							android:paddingEnd="2dp"
							android:paddingBottom="8dp">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/iv_swap"
								android:layout_width="20dp"
								android:layout_height="20dp"
								android:duplicateParentState="true"
								android:importantForAccessibility="no"
								android:scaleType="centerInside"
								android:src="@drawable/ic_action_swap"
								app:tint="@color/colorAccent" />
							<TextView
								android:id="@+id/tv_swap"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:ellipsize="end"
								android:fontFamily="sans-serif-medium"
								android:maxLines="1"
								android:text="Swap"
								android:textColor="@color/colorTextPrimary"
								android:textSize="12sp" />
						</LinearLayout>
					</com.google.android.material.card.MaterialCardView>
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview3"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginStart="4dp"
						android:layout_marginEnd="4dp"
						android:contentDescription="P2P"
						app:cardBackgroundColor="@color/colorActionSurface"
						app:cardCornerRadius="12dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorActionStroke"
						app:strokeWidth="1dp">
						<LinearLayout
							android:id="@+id/linear6"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center"
							android:minHeight="56dp"
							android:orientation="vertical"
							android:paddingStart="2dp"
							android:paddingTop="8dp"
							android:paddingEnd="2dp"
							android:paddingBottom="8dp">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview5"
								android:layout_width="20dp"
								android:layout_height="20dp"
								android:duplicateParentState="true"
								android:importantForAccessibility="no"
								android:scaleType="centerInside"
								android:src="@drawable/ic_action_buy"
								app:tint="@color/colorAccent" />
							<TextView
								android:id="@+id/textview6"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:ellipsize="end"
								android:fontFamily="sans-serif-medium"
								android:maxLines="1"
								android:text="P2P"
								android:textColor="@color/colorTextPrimary"
								android:textSize="12sp" />
						</LinearLayout>
					</com.google.android.material.card.MaterialCardView>
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/card_discover"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginStart="4dp"
						android:layout_marginEnd="0dp"
						android:contentDescription="Web3"
						app:cardBackgroundColor="@color/colorActionSurface"
						app:cardCornerRadius="12dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorActionStroke"
						app:strokeWidth="1dp">
						<LinearLayout
							android:id="@+id/linear_discover"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center"
							android:minHeight="56dp"
							android:orientation="vertical"
							android:paddingStart="2dp"
							android:paddingTop="8dp"
							android:paddingEnd="2dp"
							android:paddingBottom="8dp">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/iv_discover"
								android:layout_width="20dp"
								android:layout_height="20dp"
								android:duplicateParentState="true"
								android:importantForAccessibility="no"
								android:scaleType="centerInside"
								android:src="@drawable/ic_web3"
								app:tint="@color/colorAccent" />
							<TextView
								android:id="@+id/tv_discover"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:ellipsize="end"
								android:fontFamily="sans-serif-medium"
								android:maxLines="1"
								android:text="Web3"
								android:textColor="@color/colorTextPrimary"
								android:textSize="12sp" />
						</LinearLayout>
					</com.google.android.material.card.MaterialCardView>
				</LinearLayout>
			</LinearLayout>
		</com.google.android.material.appbar.CollapsingToolbarLayout>
		<com.google.android.material.tabs.TabLayout
			android:id="@+id/tablayout1"
			android:layout_width="match_parent"
			android:layout_height="@dimen/toggle_height"
			android:layout_marginLeft="70dp"
			android:layout_marginRight="70dp"
			android:background="@android:color/transparent"
			app:tabGravity="fill"
			app:tabIndicatorColor="@color/colorAccent"
			app:tabIndicatorHeight="3dp"
			app:tabMode="fixed"
			app:tabSelectedTextColor="@color/colorTextPrimaryWhite"
			app:tabTextAppearance="@style/Harvana.Tab"
			app:tabTextColor="@color/colorTextTertiary" />
	</com.google.android.material.appbar.AppBarLayout>
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview16"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_marginLeft="10dp"
		android:layout_marginTop="14dp"
		android:layout_marginRight="10dp"
		android:layout_marginBottom="10dp"
		app:cardBackgroundColor="@color/colorSurface"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorCardStroke"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<androidx.viewpager2.widget.ViewPager2
			android:id="@+id/viewpager1"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@android:color/transparent" />
	</com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
