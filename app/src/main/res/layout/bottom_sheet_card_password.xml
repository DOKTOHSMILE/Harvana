<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="20dp"
	android:background="@color/colorSurface">
	<View
		android:id="@+id/view10"
		android:layout_width="40dp"
		android:layout_height="4dp"
		android:layout_marginBottom="16dp"
		android:background="@color/colorCardStroke"
		android:layout_gravity="center_horizontal" />
	<TextView
		android:id="@+id/textview7"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Enter this card's password"
		android:textSize="17sp"
		android:textStyle="bold"
		android:focusable="false" />
	<TextView
		android:id="@+id/textview8"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:text="Only the password set when this card was created will unlock it."
		android:textSize="13sp"
		android:focusable="false" />
	<com.google.android.material.textfield.TextInputLayout
		android:id="@+id/textinputlayout4"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp">
		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/et_card_sentence"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textSize="12sp"
			android:inputType="textMultiLine"
			android:focusable="true"
			android:focusableInTouchMode="true"
			android:minLines="2" />
	</com.google.android.material.textfield.TextInputLayout>
	<TextView
		android:id="@+id/tv_card_sentence_error"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:textSize="13sp"
		android:focusable="false"
		android:visibility="gone" />
	<com.google.android.material.button.MaterialButton
		android:id="@+id/btn_unlock_card"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="8dp"
		android:text="Unlock"
		android:textSize="12sp"
		android:textColor="@color/colorTextOnAccent"
		android:backgroundTint="@color/colorAccent" />
</LinearLayout>
