<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/sheet_root"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/linear5"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingLeft="24dp"
		android:paddingTop="12dp"
		android:paddingRight="24dp"
		android:paddingBottom="24dp"
		android:background="@android:color/transparent"
		android:orientation="vertical">
		<View
			android:id="@+id/view3"
			android:layout_width="40dp"
			android:layout_height="4dp"
			android:layout_marginBottom="20dp"
			android:background="@color/colorCardStroke"
			android:layout_gravity="center_horizontal" />
		<TextView
			android:id="@+id/tv_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			android:text="Create Your Ajoo Wallet"
			android:textSize="20sp"
			android:textStyle="bold"
			android:focusable="false" />
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			app:cardBackgroundColor="@color/colorSurfaceRaised"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeWidth="1dp"
			app:strokeColor="@color/colorCardStroke">
			<LinearLayout
				android:id="@+id/linear4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/imageview2"
					android:layout_width="22dp"
					android:layout_height="22dp"
					android:scaleType="centerInside"
					android:src="@android:drawable/ic_dialog_alert"
					android:focusable="false"
					android:layout_marginEnd="12dp"
					app:tint="@color/colorWarningDark" />
				<TextView
					android:id="@+id/textview3"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="I acknowledge that this wallet interacts with a live blockchain network. All transactions involve real assets and cannot be reversed."
					android:textSize="13sp"
					android:textStyle="bold"
					android:layout_weight="1"
					android:focusable="false"
					android:lineSpacingExtra="2dp" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<TextView
			android:id="@+id/textview4"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="24dp"
			android:text="This generates your unique Ajoocoin address to securely manage your AJC balance and make wallet-based contributions. This wallet is fully non-custodial: you have absolute control over your private keys, and Ajoo never holds or has access to your funds."
			android:textSize="13.5sp"
			android:focusable="false"
			android:lineSpacingExtra="4dp" />
		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_generate_wallet"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:layout_marginBottom="8dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="Generate Wallet"
			android:textSize="15sp"
			android:textStyle="bold"
			android:textColor="@color/colorTextOnAccent"
			android:textAllCaps="false"
			app:backgroundTint="@color/colorAccent"
			app:cornerRadius="16dp"
			app:elevation="0dp" />
		<TextView
			android:id="@+id/tv_cancel"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="12dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="Cancel"
			android:textStyle="bold"
			android:textSize="14.5sp"
			android:focusable="false" />
	</LinearLayout>
</LinearLayout>
