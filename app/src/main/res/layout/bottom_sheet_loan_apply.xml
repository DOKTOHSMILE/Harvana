<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/linear3"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="8dp"
		android:background="?attr/colorSurface"
		android:gravity="center_horizontal">
		<View
			android:id="@+id/view_apply_handle"
			android:layout_width="40dp"
			android:layout_height="4dp"
			android:background="@color/colorCardStroke" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear4"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="24dp">
		<TextView
			android:id="@+id/tv_apply_title"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Apply for a Loan"
			android:textSize="20sp"
			android:textStyle="bold"
			android:focusable="false" />
		<TextView
			android:id="@+id/tv_apply_subtitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:layout_marginBottom="16dp"
			android:text="Group wallet has — available."
			android:textSize="13.5sp"
			android:focusable="false" />
	</LinearLayout>
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll_apply"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true"
		android:overScrollMode="never"
		android:clipToPadding="false">
		<LinearLayout
			android:id="@+id/linear5"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="24dp"
			android:orientation="vertical"
			android:paddingHorizontal="24dp">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="20dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke">
				<LinearLayout
					android:id="@+id/linear6"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview4"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="HOW GROUP LOANS WORK"
						android:textStyle="bold"
						android:textSize="10.5sp"
						android:letterSpacing="0.06"
						android:focusable="false" />
					<LinearLayout
						android:id="@+id/linear32"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview30"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Interest rate"
							android:layout_weight="1"
							android:textSize="13.5sp"
							android:focusable="false" />
						<TextView
							android:id="@+id/tv_apply_interest_line"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="—"
							android:textStyle="bold"
							android:textSize="13.5sp"
							android:focusable="false" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear33"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview31"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Est. network fee"
							android:layout_weight="1"
							android:textSize="13.5sp"
							android:focusable="false" />
						<TextView
							android:id="@+id/tv_apply_fee_estimate"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="—"
							android:textStyle="bold"
							android:textSize="13.5sp"
							android:focusable="false" />
					</LinearLayout>
					<View
						android:id="@+id/view34"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="@color/colorDivider"
						android:layout_marginVertical="12dp" />
					<TextView
						android:id="@+id/tv_apply_duration_line"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="No fixed repayment date — interest accrues on the outstanding balance for as long as the loan stays open. The sooner it's repaid, the less it costs in total."
						android:textSize="12sp"
						android:lineSpacingExtra="2dp"
						android:focusable="false" />
					<TextView
						android:id="@+id/tv_apply_consequence_line"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:text="An unpaid loan reduces how much the group wallet has available for other members until it's repaid."
						android:textSize="12sp"
						android:lineSpacingExtra="2dp"
						android:focusable="false" />
					<TextView
						android:id="@+id/tv_apply_fee_note"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:text="The network fee above is deducted from the principal you receive, not billed on top."
						android:textSize="11.5sp"
						android:focusable="false" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview5"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="AMOUNT (HARV)"
				android:textStyle="bold"
				android:textSize="10.5sp"
				android:letterSpacing="0.06"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview5"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke">
				<EditText
					android:id="@+id/et_apply_amount"
					android:layout_width="match_parent"
					android:layout_height="52dp"
					android:background="@android:color/transparent"
					android:gravity="center_vertical"
					android:textSize="15sp"
					android:textColor="@color/colorTextPrimary"
					android:hint="0.0000"
					android:inputType="numberDecimal"
					android:focusable="true"
					android:focusableInTouchMode="true"
					android:paddingHorizontal="16dp" />
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview7"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="I PLAN TO REPAY IN (PERIODS)"
				android:textStyle="bold"
				android:textSize="10.5sp"
				android:letterSpacing="0.06"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview7"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke">
				<EditText
					android:id="@+id/et_apply_periods"
					android:layout_width="match_parent"
					android:layout_height="52dp"
					android:background="@android:color/transparent"
					android:gravity="center_vertical"
					android:text="1"
					android:textSize="15sp"
					android:textColor="@color/colorTextPrimary"
					android:hint="1"
					android:inputType="number"
					android:focusable="true"
					android:focusableInTouchMode="true"
					android:maxLength="3"
					android:paddingHorizontal="16dp" />
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview_calc"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke">
				<LinearLayout
					android:id="@+id/linear22"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/tv_apply_calc_empty"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Enter an amount to see what you'll owe."
						android:textStyle="bold"
						android:textSize="13.5sp"
						android:focusable="false" />
					<LinearLayout
						android:id="@+id/layout_apply_calc_rows"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:visibility="gone">
						<TextView
							android:id="@+id/tv_apply_calc_after"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="8dp"
							android:text="After 1 month"
							android:textSize="12sp"
							android:focusable="false" />
						<LinearLayout
							android:id="@+id/linear35"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingVertical="4dp">
							<TextView
								android:id="@+id/textview32"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Principal"
								android:layout_weight="1"
								android:textSize="13.5sp"
								android:focusable="false" />
							<TextView
								android:id="@+id/tv_apply_calc_principal"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="—"
								android:textSize="13.5sp"
								android:focusable="false" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear36"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingVertical="4dp">
							<TextView
								android:id="@+id/textview33"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Interest"
								android:layout_weight="1"
								android:textSize="13.5sp"
								android:focusable="false" />
							<TextView
								android:id="@+id/tv_apply_calc_interest"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="—"
								android:textSize="13.5sp"
								android:focusable="false" />
						</LinearLayout>
						<View
							android:id="@+id/view37"
							android:layout_width="match_parent"
							android:layout_height="1dp"
							android:background="@color/colorDivider"
							android:layout_marginVertical="8dp" />
						<LinearLayout
							android:id="@+id/linear38"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingVertical="4dp">
							<TextView
								android:id="@+id/textview34"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="You'd owe"
								android:textSize="14sp"
								android:textStyle="bold"
								android:layout_weight="1"
								android:focusable="false" />
							<TextView
								android:id="@+id/tv_apply_calc_total"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="—"
								android:textSize="15sp"
								android:textStyle="bold"
								android:focusable="false" />
						</LinearLayout>
					</LinearLayout>
					<TextView
						android:id="@+id/tv_apply_warning"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:text="⚠ Estimate only — interest keeps accruing daily on whatever's still outstanding until you repay in full, not just up to your planned date above. Repaying later costs more."
						android:textSize="11.5sp"
						android:lineSpacingExtra="2dp"
						android:focusable="false" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview6"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="REASON (OPTIONAL)"
				android:textStyle="bold"
				android:textSize="10.5sp"
				android:letterSpacing="0.06"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview6"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke">
				<EditText
					android:id="@+id/et_apply_reason"
					android:layout_width="match_parent"
					android:layout_height="52dp"
					android:background="@android:color/transparent"
					android:gravity="center_vertical"
					android:textColor="@color/colorTextPrimary"
					android:hint="What's it for\\?"
					android:textSize="14.5sp"
					android:inputType="textCapSentences"
					android:focusable="true"
					android:focusableInTouchMode="true"
					android:maxLength="140"
					android:paddingHorizontal="16dp" />
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview8"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="DISBURSEMENT WALLET"
				android:textStyle="bold"
				android:textSize="10.5sp"
				android:letterSpacing="0.06"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_apply_disbursement_wallet"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="—"
				android:textSize="13.5sp"
				android:fontFamily="monospace"
				android:focusable="false" />
			<TextView
				android:id="@+id/textview35"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:text="If approved, principal minus the network fee is sent to this wallet."
				android:textSize="11.5sp"
				android:focusable="false" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
	<LinearLayout
		android:id="@+id/linear7"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="24dp"
		android:orientation="horizontal"
		android:paddingHorizontal="24dp">
		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_apply_cancel"
			android:layout_width="0dp"
			android:layout_height="52dp"
			android:text="Cancel"
			android:textSize="15sp"
			android:textStyle="bold"
			android:textColor="@color/colorTextPrimary"
			android:layout_weight="1"
			android:layout_marginEnd="8dp"
			app:backgroundTint="@color/colorSurfaceRaised"
			app:cornerRadius="16dp"
			app:elevation="0dp"
			app:strokeWidth="1dp"
			app:strokeColor="@color/colorCardStroke"
			android:textAllCaps="false" />
		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_apply_review"
			android:layout_width="0dp"
			android:layout_height="52dp"
			android:text="Review"
			android:textSize="15sp"
			android:textStyle="bold"
			android:textColor="@color/colorTextOnAccent"
			android:layout_weight="1"
			android:layout_marginStart="8dp"
			app:backgroundTint="@color/colorAccent"
			app:cornerRadius="16dp"
			app:elevation="0dp"
			android:textAllCaps="false" />
	</LinearLayout>
</LinearLayout>
