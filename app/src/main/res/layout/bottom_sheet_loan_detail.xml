<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/sheet_loan_detail_root"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/linear10"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="8dp"
		android:background="?attr/colorSurface"
		android:gravity="center_horizontal">
		<View
			android:id="@+id/view11"
			android:layout_width="40dp"
			android:layout_height="4dp"
			android:background="@color/colorCardStroke" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear13"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="16dp"
		android:background="?attr/colorSurface"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="24dp">
		<TextView
			android:id="@+id/textview13"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:text="Loan Details"
			android:textSize="20sp"
			android:textStyle="bold"
			android:layout_weight="1"
			android:focusable="false" />
		<TextView
			android:id="@+id/tv_loan_detail_status"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingTop="3dp"
			android:paddingBottom="3dp"
			android:background="@drawable/bg_chip_pending"
			android:text="ACTIVE"
			android:textSize="10sp"
			android:textStyle="bold"
			android:paddingStart="10dp"
			android:paddingEnd="10dp"
			android:focusable="false" />
		<TextView
			android:id="@+id/btn_loan_detail_close"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:text="✕"
			android:textSize="16sp"
			android:focusable="false"
			android:layout_marginStart="8dp" />
	</LinearLayout>
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true"
		android:overScrollMode="never"
		android:clipToPadding="false">
		<LinearLayout
			android:id="@+id/linear14"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="24dp"
			android:orientation="vertical"
			android:paddingHorizontal="24dp">
			<TextView
				android:id="@+id/textview14"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="BORROWER"
				android:textStyle="bold"
				android:textSize="10.5sp"
				android:letterSpacing="0.06"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_loan_detail_borrower"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:layout_marginBottom="16dp"
				android:text="—"
				android:textStyle="bold"
				android:textSize="15.5sp"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke">
				<LinearLayout
					android:id="@+id/linear15"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview15"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="12dp"
						android:text="Loan Breakdown"
						android:textSize="15sp"
						android:textStyle="bold"
						android:focusable="false" />
					<LinearLayout
						android:id="@+id/linear16"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingVertical="6dp">
						<TextView
							android:id="@+id/textview16"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Loan ID"
							android:layout_weight="1"
							android:textSize="13.5sp"
							android:focusable="false" />
						<TextView
							android:id="@+id/tv_loan_detail_id"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="—"
							android:textSize="13.5sp"
							android:fontFamily="monospace"
							android:focusable="false" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear17"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingVertical="6dp">
						<TextView
							android:id="@+id/textview17"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Disbursed"
							android:layout_weight="1"
							android:textSize="13.5sp"
							android:focusable="false" />
						<TextView
							android:id="@+id/tv_loan_detail_disbursed"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="—"
							android:textSize="13.5sp"
							android:focusable="false" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear18"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingVertical="6dp">
						<TextView
							android:id="@+id/textview18"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Loan Amount (Principal)"
							android:layout_weight="1"
							android:textSize="13.5sp"
							android:focusable="false" />
						<TextView
							android:id="@+id/tv_loan_detail_principal"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="—"
							android:textStyle="bold"
							android:textSize="13.5sp"
							android:focusable="false" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear19"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingVertical="6dp">
						<TextView
							android:id="@+id/textview19"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Interest Rate"
							android:layout_weight="1"
							android:textSize="13.5sp"
							android:focusable="false" />
						<TextView
							android:id="@+id/tv_loan_detail_rate"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="—"
							android:textSize="13.5sp"
							android:focusable="false" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear20"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingVertical="6dp">
						<TextView
							android:id="@+id/textview20"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Interest Accrued So Far"
							android:layout_weight="1"
							android:textSize="13.5sp"
							android:focusable="false" />
						<TextView
							android:id="@+id/tv_loan_detail_interest_accrued"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="—"
							android:textSize="13.5sp"
							android:focusable="false" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear21"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingVertical="6dp">
						<TextView
							android:id="@+id/textview21"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Total Repaid So Far"
							android:layout_weight="1"
							android:textSize="13.5sp"
							android:focusable="false" />
						<TextView
							android:id="@+id/tv_loan_detail_repaid"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="—"
							android:textSize="13.5sp"
							android:focusable="false" />
					</LinearLayout>
					<View
						android:id="@+id/view22"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="@color/colorDivider"
						android:layout_marginVertical="10dp" />
					<LinearLayout
						android:id="@+id/linear23"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingVertical="6dp">
						<TextView
							android:id="@+id/textview22"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Total Amount Owed Today"
							android:textSize="14sp"
							android:textStyle="bold"
							android:layout_weight="1"
							android:focusable="false" />
						<TextView
							android:id="@+id/tv_loan_detail_total_due"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="—"
							android:textSize="15sp"
							android:textStyle="bold"
							android:focusable="false" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview23"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				android:text="Repayment History"
				android:textSize="15sp"
				android:textStyle="bold"
				android:focusable="false" />
			<LinearLayout
				android:id="@+id/layout_loan_repayment_history"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical" />
			<TextView
				android:id="@+id/tv_loan_no_repayments"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="16dp"
				android:text="No repayments recorded yet."
				android:textSize="13.5sp"
				android:visibility="gone"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke">
				<LinearLayout
					android:id="@+id/linear24"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview24"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="6dp"
						android:text="How interest works here"
						android:textStyle="bold"
						android:textSize="13.5sp"
						android:focusable="false" />
					<TextView
						android:id="@+id/tv_loan_detail_explainer"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Interest accrues daily on whatever's still outstanding, at the rate shown above, for as long as this loan stays open — it doesn't stop or reset at any fixed date. Repaying sooner means less total interest; there's no early-repayment penalty and no separate fee for paying late, but the amount owed keeps growing the longer it's outstanding."
						android:textSize="12sp"
						android:lineSpacingExtra="3dp"
						android:focusable="false" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
