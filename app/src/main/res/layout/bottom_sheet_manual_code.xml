<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="20dp"
	android:background="@color/colorSurface">
	<View
		android:id="@+id/view11"
		android:layout_width="40dp"
		android:layout_height="4dp"
		android:layout_marginBottom="16dp"
		android:background="@color/colorCardStroke"
		android:layout_gravity="center_horizontal" />
	<TextView
		android:id="@+id/textview9"
		android:focusable="false"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Enter the backup code"
		android:textSize="18sp"
		android:textStyle="bold"
		android:textColor="@color/colorTextPrimary" />
	<TextView
		android:id="@+id/textview10"
		android:focusable="false"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:text="The code printed on the back of your card, below the QR code. Digits only — spaces are fine."
		android:textSize="13sp"
		android:textColor="@color/colorTextSecondary" />
	<com.google.android.material.textfield.TextInputLayout
		android:id="@+id/textinputlayout5"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp">
		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/et_manual_code"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textSize="14sp"
			android:inputType="number"
			android:minLines="3"
			android:fontFamily="monospace"
			android:focusable="true"
			android:focusableInTouchMode="true" />
	</com.google.android.material.textfield.TextInputLayout>
	<TextView
		android:id="@+id/tv_manual_code_error"
		android:focusable="false"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:textSize="13sp"
		android:visibility="gone" />
	<com.google.android.material.button.MaterialButton
		android:id="@+id/btn_continue_manual_code"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="8dp"
		android:text="Continue"
		android:textSize="14sp"
		android:textStyle="bold"
		android:textColor="@color/colorTextOnAccent"
		android:backgroundTint="@color/colorAccent" />
</LinearLayout>
