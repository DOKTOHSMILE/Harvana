								android:id="@+id/iv_detail_avatar"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:src="@drawable/ic_coin_harv"
								android:scaleType="centerInside"
								android:focusable="false"
								android:visibility="gone" />
							<TextView
								android:id="@+id/tv_detail_initials"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:gravity="center_horizontal|center_vertical"
								android:text="M"
								android:textSize="26sp"
								android:textStyle="bold"
								android:focusable="false" />
						</FrameLayout>
					</com.google.android.material.card.MaterialCardView>
					<TextView
						android:id="@+id/tv_detail_name"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="Member"
						android:textSize="18sp"
						android:textStyle="bold"
						android:focusable="false" />
					<TextView
						android:id="@+id/tv_detail_role"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:background="@color/colorAccentSoft"
						android:text="Member"
						android:textSize="11sp"
						android:textStyle="bold"
						android:paddingHorizontal="12dp"
						android:paddingVertical="4dp"
						android:focusable="false" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview14"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				app:cardBackgroundColor="@color/colorSurfaceRaised"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke">
				<LinearLayout
					android:id="@+id/linear59"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="4dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview42"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingLeft="16dp"
						android:paddingTop="14dp"
						android:paddingRight="16dp"
						android:text="IN THIS GROUP"
						android:textStyle="bold"
						android:textSize="10.5sp"
						android:letterSpacing="0.06"
						android:focusable="false" />
					<LinearLayout
						android:id="@+id/linear60"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingHorizontal="16dp"
						android:paddingVertical="10dp">
						<ImageView
							android:id="@+id/imageview10"
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:src="@drawable/icon_groups_outline"
							android:scaleType="centerInside"
							android:focusable="false"
							app:tint="@color/colorAccent" />
						<LinearLayout
							android:id="@+id/linear61"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1"
							android:layout_marginStart="12dp">
							<TextView
								android:id="@+id/textview43"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Slot"
								android:textSize="11.5sp"
								android:focusable="false" />
							<TextView
								android:id="@+id/tv_detail_slot"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="—"
								android:textStyle="bold"
								android:textSize="14.5sp"
								android:focusable="false" />
						</LinearLayout>
					</LinearLayout>
					<View
						android:id="@+id/view62"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="@color/colorDivider"
						android:layout_marginStart="48dp" />
					<LinearLayout
