								android:textStyle="bold"
								android:textSize="14.5sp"
								android:focusable="false" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
