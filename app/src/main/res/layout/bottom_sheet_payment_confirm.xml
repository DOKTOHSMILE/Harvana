<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/sheet_root"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/linear38"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="8dp"
		android:background="?attr/colorSurface"
		android:gravity="center_horizontal">
		<View
			android:id="@+id/view39"
			android:layout_width="40dp"
			android:layout_height="4dp"
			android:background="@color/colorCardStroke" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear40"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="24dp"
		android:orientation="vertical"
		android:paddingHorizontal="24dp">
		<TextView
			android:id="@+id/tv_confirm_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:text="Confirm Payment"
			android:textSize="20sp"
			android:textStyle="bold"
			android:focusable="false" />
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview4"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeWidth="1dp"
			app:strokeColor="@color/colorCardStroke">
			<LinearLayout
				android:id="@+id/linear41"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="24dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical">
				<TextView
					android:id="@+id/tv_confirm_label"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="AMOUNT"
					android:textStyle="bold"
					android:textSize="10.5sp"
					android:letterSpacing="0.06"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_confirm_amount"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:text="0.0000 HARV"
					android:textSize="26sp"
					android:textStyle="bold"
					android:focusable="false" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<LinearLayout
			android:id="@+id/linear42"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear43"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingVertical="10dp">
				<TextView
					android:id="@+id/textview6"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="To"
					android:layout_weight="1"
					android:textSize="13.5sp"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_confirm_recipient"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="—"
					android:textSize="13.5sp"
					android:fontFamily="monospace"
					android:focusable="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/row_confirm_memo"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingVertical="10dp"
				android:visibility="gone">
				<TextView
					android:id="@+id/textview7"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="Memo"
					android:layout_weight="1"
					android:textSize="13.5sp"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_confirm_memo"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="13.5sp"
					android:focusable="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear44"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingVertical="10dp">
				<TextView
					android:id="@+id/textview8"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="Network fee"
					android:layout_weight="1"
					android:textSize="13.5sp"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_confirm_fee"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="—"
					android:textSize="13.5sp"
					android:focusable="false" />
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear45"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:orientation="horizontal">
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_confirm_cancel"
				android:layout_width="0dp"
				android:layout_height="52dp"
				android:text="Cancel"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimary"
				android:layout_weight="1"
				android:layout_marginEnd="8dp"
				app:backgroundTint="@color/colorSurfaceRaised"
				app:cornerRadius="16dp"
				app:elevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke"
				android:textAllCaps="false" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_confirm_send"
				android:layout_width="0dp"
				android:layout_height="52dp"
				android:text="Confirm &amp; Send"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextOnAccent"
				android:layout_weight="1"
				android:layout_marginStart="8dp"
				app:backgroundTint="@color/colorAccent"
				app:cornerRadius="16dp"
				app:elevation="0dp"
				android:textAllCaps="false" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
