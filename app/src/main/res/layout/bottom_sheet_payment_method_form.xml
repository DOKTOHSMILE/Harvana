<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="24dp"
	android:background="?attr/colorSurface">
	<TextView
		android:id="@+id/tvFormTitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Add Payment Method"
		android:textSize="20sp"
		android:textStyle="bold"
		android:textColor="@color/colorTextPrimary" />
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:layout_marginTop="20dp"
		android:padding="4dp"
		android:orientation="horizontal"
		android:backgroundTint="@color/colorSurfaceRaised">
		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnTypeBank"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:text="Bank"
			android:textStyle="bold"
			android:textColor="@color/colorTextOnAccent"
			android:layout_weight="1"
			android:textSize="14sp"
			android:backgroundTint="@color/colorAccent"
			android:textAllCaps="false" />
		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnTypeMobileMoney"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:background="@android:color/transparent"
			android:text="Mobile Money"
			android:textColor="@color/colorTextSecondary"
			android:layout_weight="1"
			android:textSize="14sp"
			android:textAllCaps="false" />
	</LinearLayout>
	<TextView
		android:id="@+id/textview1"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		android:layout_marginBottom="6dp"
		android:text="BANK NAME"
		android:textStyle="bold"
		android:textColor="@color/colorTextTertiary"
		android:textSize="11sp"
		android:layout_marginStart="4dp"
		android:letterSpacing="0.06" />
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeColor="@color/colorCardStroke"
		app:strokeWidth="1dp">
		<com.google.android.material.textfield.TextInputEditText
			android:textColorHint="@color/colorTextTertiary"
			android:singleLine="true"
			android:importantForAutofill="no"
			android:id="@+id/etPrimaryField"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:background="@android:color/transparent"
			android:textColor="@color/colorTextPrimary"
			android:hint="Bank name"
			android:textSize="15sp"
			android:inputType="textCapWords"
			android:paddingHorizontal="14dp" />
	</com.google.android.material.card.MaterialCardView>
	<TextView
		android:id="@+id/textview2"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="6dp"
		android:text="ACCOUNT NUMBER"
		android:textStyle="bold"
		android:textColor="@color/colorTextTertiary"
		android:textSize="11sp"
		android:layout_marginStart="4dp"
		android:letterSpacing="0.06" />
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeColor="@color/colorCardStroke"
		app:strokeWidth="1dp">
		<com.google.android.material.textfield.TextInputEditText
			android:textColorHint="@color/colorTextTertiary"
			android:singleLine="true"
			android:importantForAutofill="no"
			android:id="@+id/etAccountIdentifier"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:background="@android:color/transparent"
			android:textColor="@color/colorTextPrimary"
			android:hint="Account number"
			android:inputType="phone"
			android:textSize="15sp"
			android:paddingHorizontal="14dp" />
	</com.google.android.material.card.MaterialCardView>
	<TextView
		android:id="@+id/textview3"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="6dp"
		android:text="ACCOUNT HOLDER NAME"
		android:textStyle="bold"
		android:textColor="@color/colorTextTertiary"
		android:textSize="11sp"
		android:layout_marginStart="4dp"
		android:letterSpacing="0.06" />
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview3"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeColor="@color/colorCardStroke"
		app:strokeWidth="1dp">
		<com.google.android.material.textfield.TextInputEditText
			android:textColorHint="@color/colorTextTertiary"
			android:singleLine="true"
			android:importantForAutofill="no"
			android:id="@+id/etAccountName"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:background="@android:color/transparent"
			android:textColor="@color/colorTextPrimary"
			android:hint="Account holder name"
			android:textSize="15sp"
			android:inputType="textCapWords"
			android:paddingHorizontal="14dp" />
	</com.google.android.material.card.MaterialCardView>
	<TextView
		android:id="@+id/textview4"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="6dp"
		android:text="NICKNAME (OPTIONAL)"
		android:textStyle="bold"
		android:textColor="@color/colorTextTertiary"
		android:textSize="11sp"
		android:layout_marginStart="4dp"
		android:letterSpacing="0.06" />
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview4"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeColor="@color/colorCardStroke"
		app:strokeWidth="1dp">
		<com.google.android.material.textfield.TextInputEditText
			android:textColorHint="@color/colorTextTertiary"
			android:singleLine="true"
			android:importantForAutofill="no"
			android:id="@+id/etNickname"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:background="@android:color/transparent"
			android:textColor="@color/colorTextPrimary"
			android:hint="e.g. &quot;Personal account&quot;"
			android:textSize="15sp"
			android:paddingHorizontal="14dp" />
	</com.google.android.material.card.MaterialCardView>
	<LinearLayout
		android:id="@+id/linear2"
		android:clickable="true"
		android:focusable="true"
		android:minHeight="48dp"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:gravity="center_vertical"
		android:orientation="horizontal">
		<com.google.android.material.checkbox.MaterialCheckBox
			android:id="@+id/cbSetAsDefault"
			android:clickable="false"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="12sp"
			app:buttonTint="@color/colorAccent" />
		<TextView
			android:id="@+id/textview5"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:text="Set as default payment method"
			android:textColor="@color/colorTextSecondary"
			android:layout_weight="1"
			android:textSize="14sp"
			android:layout_marginStart="8dp" />
	</LinearLayout>
	<TextView
		android:id="@+id/tvFormError"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:textSize="13sp"
		android:textColor="@color/colorError"
		android:visibility="gone" />
	<com.google.android.material.button.MaterialButton
		android:id="@+id/btnSaveMethod"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:layout_marginTop="24dp"
		android:text="Save Payment Method"
		android:textSize="15sp"
		android:textStyle="bold"
		android:textColor="@color/colorTextOnAccent"
		android:textAllCaps="false"
		app:backgroundTint="@color/colorAccent"
		app:cornerRadius="12dp"
		app:elevation="0dp" />
</LinearLayout>
