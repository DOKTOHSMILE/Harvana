<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/sheet_root"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/linear16"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="8dp"
		android:background="?attr/colorSurface"
		android:gravity="center_horizontal">
		<View
			android:id="@+id/view17"
			android:layout_width="40dp"
			android:layout_height="4dp"
			android:background="@color/colorCardStroke" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear18"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="24dp"
		android:orientation="vertical"
		android:paddingHorizontal="24dp">
		<TextView
			android:id="@+id/textview13"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:text="Pending Payout Requests"
			android:textSize="20sp"
			android:textStyle="bold"
			android:focusable="false" />
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recycler_payout_requests"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:nestedScrollingEnabled="false"
			android:overScrollMode="never" />
		<TextView
			android:id="@+id/tv_payout_requests_empty"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="24dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="No pending payout requests."
			android:textSize="14sp"
			android:focusable="false"
			android:visibility="gone" />
	</LinearLayout>
</LinearLayout>
