<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="20dp"
	android:background="@color/colorSurface">
	<View
		android:id="@+id/view56"
		android:layout_width="40dp"
		android:layout_height="4dp"
		android:layout_marginBottom="16dp"
		android:background="@color/colorCardStroke"
		android:layout_gravity="center_horizontal" />
	<TextView
		android:id="@+id/textview2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="16dp"
		android:gravity="center_horizontal|center_vertical"
		android:text="Scan QR Code"
		android:textSize="20sp"
		android:textStyle="bold"
		android:textColor="@color/colorTextPrimary"
		android:focusable="false" />
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview37"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurfaceRaised"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorCardStroke">
		<com.budiyev.android.codescanner.CodeScannerView
			android:id="@+id/scanner_view"
			android:layout_width="match_parent"
			android:layout_height="320dp"
			app:frameColor="@color/colorAccent"
			app:frameCornersSize="40dp"
			app:frameCornersRadius="14dp"
			app:frameAspectRatioWidth="1"
			app:frameAspectRatioHeight="1"
			app:frameSize="0.75"
			app:autoFocusButtonColor="@android:color/white"
			app:autoFocusButtonVisible="true"
			app:flashButtonColor="@android:color/white"
			app:flashButtonVisible="true" />
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
