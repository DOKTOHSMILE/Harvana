<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/sheet_root"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/linear47"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="8dp"
		android:background="?attr/colorSurface"
		android:gravity="center_horizontal">
		<View
			android:id="@+id/view48"
			android:layout_width="40dp"
			android:layout_height="4dp"
			android:background="@color/colorCardStroke" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear49"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="24dp"
		android:orientation="vertical"
		android:paddingHorizontal="24dp">
		<TextView
			android:id="@+id/textview65"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:text="Report Member"
			android:textSize="20sp"
			android:textStyle="bold"
			android:focusable="false" />
		<TextView
			android:id="@+id/tv_report_target"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="Reporting: —"
			android:textSize="14sp"
			android:focusable="false" />
		<TextView
			android:id="@+id/textview66"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="A moderator reviews every report before it affects anything visible to other members. This flags it for review - it doesn't act immediately."
			android:textSize="12sp"
			android:focusable="false"
			android:lineSpacingExtra="2dp" />
		<TextView
			android:id="@+id/textview67"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:text="REASON"
			android:textStyle="bold"
			android:textSize="11sp"
			android:letterSpacing="0.06"
			android:focusable="false" />
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeWidth="1dp"
			app:strokeColor="@color/colorCardStroke">
			<com.harvana.app.ui.MaterialSpinner
				android:id="@+id/spinner_report_reason"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:background="@android:color/transparent"
				android:spinnerMode="dialog"
				android:theme="@style/WhiteSpinnerTheme"
				android:paddingStart="12dp"
				android:paddingEnd="12dp" />
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview61"
			android:layout_width="match_parent"
			android:layout_height="140dp"
			android:layout_marginTop="12dp"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeWidth="1dp"
			app:strokeColor="@color/colorCardStroke">
			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/et_report_details"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="16dp"
				android:background="@android:color/transparent"
				android:gravity="top"
				android:textColor="@color/colorTextPrimary"
				android:hint="What happened\\? Be specific - dates, amounts, what was promised vs what happened."
				android:textSize="15sp"
				android:inputType="textMultiLine|textCapSentences"
				android:focusable="true"
				android:focusableInTouchMode="true"
				android:importantForAutofill="no" />
		</com.google.android.material.card.MaterialCardView>
		<LinearLayout
			android:id="@+id/linear50"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:orientation="horizontal">
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_report_cancel"
				android:layout_width="0dp"
				android:layout_height="52dp"
				android:text="Cancel"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimary"
				android:layout_weight="1"
				android:layout_marginEnd="8dp"
				app:backgroundTint="@color/colorSurfaceRaised"
				app:cornerRadius="16dp"
				app:elevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke"
				android:textAllCaps="false" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_report_submit"
				android:layout_width="0dp"
				android:layout_height="52dp"
				android:text="Submit Report"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextOnAccent"
				android:layout_weight="1"
				android:layout_marginStart="8dp"
				app:backgroundTint="@color/colorError"
				app:cornerRadius="16dp"
				app:elevation="0dp"
				android:textAllCaps="false" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
