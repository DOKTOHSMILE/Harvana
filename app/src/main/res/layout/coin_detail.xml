<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/colorPrimary"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:id="@+id/_coordinator"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/colorBackground"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/linear3"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">
			<androidx.core.widget.NestedScrollView
				android:id="@+id/vscroll2"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:overScrollMode="never"
				android:fillViewport="true">
				<LinearLayout
					android:id="@+id/linear10"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="24dp"
					android:gravity="center_horizontal"
					android:orientation="vertical">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview1"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="24dp"
						app:cardBackgroundColor="@android:color/transparent"
						app:cardElevation="0dp"
						app:cardCornerRadius="360dp"
						app:strokeWidth="0dp">
						<ImageView
							android:id="@+id/img_coin_logo"
							android:layout_width="80dp"
							android:layout_height="80dp"
							android:src="@drawable/main_app_logo_1"
							android:scaleType="centerInside" />
					</com.google.android.material.card.MaterialCardView>
					<LinearLayout
						android:id="@+id/linear7"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:padding="4dp"
						android:gravity="center_horizontal"
						android:orientation="horizontal"
						android:layout_marginHorizontal="40dp">
						<TextView
							android:id="@+id/tv_coin_balance"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_horizontal|center_vertical"
							android:text="0 HARV"
							android:textSize="26sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:singleLine="true" />
					</LinearLayout>
					<TextView
						android:id="@+id/textview14"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="Total Balance"
						android:textSize="13sp"
						android:textColor="@color/colorTextSecondary" />
					<TextView
						android:id="@+id/textview15"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="24dp"
						android:text="WALLET ADDRESS"
						android:textStyle="bold"
						android:textColor="@color/colorTextTertiary"
						android:textSize="10.5sp"
						android:letterSpacing="0.06" />
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview4"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						app:cardBackgroundColor="@color/colorSurfaceRaised"
						app:cardCornerRadius="16dp"
						app:cardElevation="0dp"
						app:strokeWidth="1dp"
						app:strokeColor="@color/colorCardStroke">
						<TextView
							android:id="@+id/tv_wallet_address"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="16dp"
							android:gravity="center_vertical"
							android:text="Loading address..."
							android:textColor="@color/colorTextSecondary"
							android:textSize="13.5sp"
							android:fontFamily="monospace"
							android:textIsSelectable="true" />
					</com.google.android.material.card.MaterialCardView>
					<TextView
						android:id="@+id/textview2"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="24dp"
						android:layout_marginBottom="8dp"
						android:text="ABOUT AJOO COIN"
						android:textStyle="bold"
						android:textColor="@color/colorTextTertiary"
						android:gravity="start"
						android:textSize="10.5sp"
						android:letterSpacing="0.06" />
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview7"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:cardBackgroundColor="@color/colorSurfaceRaised"
						app:cardCornerRadius="16dp"
						app:cardElevation="0dp"
						app:strokeWidth="1dp"
						app:strokeColor="@color/colorCardStroke">
						<LinearLayout
							android:id="@+id/linear11"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="16dp"
							android:orientation="vertical">
							<TextView
								android:id="@+id/tv_coin_description"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:text="HARV is the native currency of Harvanna Protocol, powering group savings, lending, and transfers across every Harvanna group."
								android:textSize="13sp"
								android:textColor="@color/colorTextSecondary"
								android:gravity="start"
								android:lineSpacingExtra="3dp" />
						</LinearLayout>
					</com.google.android.material.card.MaterialCardView>
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview8"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="16dp"
						app:cardBackgroundColor="@color/colorSurfaceRaised"
						app:cardCornerRadius="16dp"
						app:cardElevation="0dp"
						app:strokeWidth="1dp"
						app:strokeColor="@color/colorCardStroke">
						<LinearLayout
							android:id="@+id/linear12"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="16dp"
							android:orientation="vertical">
							<LinearLayout
								android:id="@+id/row_current_supply"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal"
								android:paddingVertical="6dp">
								<TextView
									android:id="@+id/tv_stat_label_1"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="Current Supply"
									android:textColor="@color/colorTextTertiary"
									android:layout_weight="1"
									android:textSize="13.5sp"
									android:focusable="false" />
								<TextView
									android:id="@+id/tv_stat_value_1"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="—"
									android:textStyle="bold"
									android:textColor="@color/colorTextPrimary"
									android:textSize="13.5sp"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/row_max_supply"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal"
								android:paddingVertical="6dp">
								<TextView
									android:id="@+id/tv_stat_label_2"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="Max Supply"
									android:textColor="@color/colorTextTertiary"
									android:layout_weight="1"
									android:textSize="13.5sp"
									android:focusable="false" />
								<TextView
									android:id="@+id/tv_stat_value_2"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="—"
									android:textStyle="bold"
									android:textColor="@color/colorTextPrimary"
									android:textSize="13.5sp"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/row_circulating_supply"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal"
								android:paddingVertical="6dp">
								<TextView
									android:id="@+id/tv_stat_label_3"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="Circulating Supply"
									android:textColor="@color/colorTextTertiary"
									android:layout_weight="1"
									android:textSize="13.5sp"
									android:focusable="false" />
								<TextView
									android:id="@+id/tv_stat_value_3"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="—"
									android:textStyle="bold"
									android:textColor="@color/colorTextPrimary"
									android:textSize="13.5sp"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/row_total_holders"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal"
								android:paddingVertical="6dp">
								<TextView
									android:id="@+id/tv_stat_label_4"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="Total Holders"
									android:textColor="@color/colorTextTertiary"
									android:layout_weight="1"
									android:textSize="13.5sp"
									android:focusable="false" />
								<TextView
									android:id="@+id/tv_stat_value_4"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="—"
									android:textStyle="bold"
									android:textColor="@color/colorTextPrimary"
									android:textSize="13.5sp"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/row_block_height"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal"
								android:paddingVertical="6dp">
								<TextView
									android:id="@+id/tv_stat_label_5"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="Block Height"
									android:textColor="@color/colorTextTertiary"
									android:layout_weight="1"
									android:textSize="13.5sp"
									android:focusable="false" />
								<TextView
									android:id="@+id/tv_stat_value_5"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="—"
									android:textStyle="bold"
									android:textColor="@color/colorTextPrimary"
									android:textSize="13.5sp"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/row_block_reward"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal"
								android:paddingVertical="6dp">
								<TextView
									android:id="@+id/tv_stat_label_6"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="Block Reward"
									android:textColor="@color/colorTextTertiary"
									android:layout_weight="1"
									android:textSize="13.5sp"
									android:focusable="false" />
								<TextView
									android:id="@+id/tv_stat_value_6"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="—"
									android:textStyle="bold"
									android:textColor="@color/colorTextPrimary"
									android:textSize="13.5sp"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/row_halving"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal"
								android:paddingVertical="6dp">
								<TextView
									android:id="@+id/tv_stat_label_7"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="Next Halving"
									android:textColor="@color/colorTextTertiary"
									android:layout_weight="1"
									android:textSize="13.5sp"
									android:focusable="false" />
								<TextView
									android:id="@+id/tv_stat_value_7"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="—"
									android:textStyle="bold"
									android:textColor="@color/colorTextPrimary"
									android:textSize="13.5sp"
									android:focusable="false" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/row_network"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal"
								android:paddingVertical="6dp">
								<TextView
									android:id="@+id/tv_stat_label_8"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="Network"
									android:textColor="@color/colorTextTertiary"
									android:layout_weight="1"
									android:textSize="13.5sp"
									android:focusable="false" />
								<TextView
									android:id="@+id/tv_stat_value_8"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="—"
									android:textStyle="bold"
									android:textColor="@color/colorTextPrimary"
									android:textSize="13.5sp"
									android:focusable="false" />
							</LinearLayout>
						</LinearLayout>
					</com.google.android.material.card.MaterialCardView>
					<TextView
						android:id="@+id/tv_coin_info_note"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="Figures update from the live network and may lag a few seconds behind the chain tip."
						android:textColor="@color/colorTextTertiary"
						android:gravity="start"
						android:textSize="11.5sp"
						android:layout_marginHorizontal="4dp" />
				</LinearLayout>
			</androidx.core.widget.NestedScrollView>
			<LinearLayout
				android:id="@+id/layout_buttons"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:background="@color/colorSurface"
				android:orientation="horizontal"
				android:weightSum="2">
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_receive"
					android:layout_width="0dp"
					android:layout_height="52dp"
					android:text="Receive"
					android:textSize="15sp"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary"
					android:layout_weight="1"
					android:layout_marginEnd="8dp"
					app:backgroundTint="@color/colorSurfaceRaised"
					app:cornerRadius="16dp"
					app:elevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke"
					android:textAllCaps="false" />
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_send"
					android:layout_width="0dp"
					android:layout_height="52dp"
					android:text="Send"
					android:textSize="15sp"
					android:textStyle="bold"
					android:textColor="@color/colorTextOnAccent"
					android:layout_weight="1"
					android:layout_marginStart="8dp"
					app:backgroundTint="@color/colorAccent"
					app:cornerRadius="16dp"
					app:elevation="0dp"
					android:textAllCaps="false" />
			</LinearLayout>
		</LinearLayout>
	</androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
