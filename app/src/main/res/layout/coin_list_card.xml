<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/ll_asset_container"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<!-- One plain list row (60dp) with a thin divider under it: no card around each asset. -->
	<LinearLayout
		android:id="@+id/cardview1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="60dp"
		android:background="?attr/selectableItemBackground"
		android:clickable="true"
		android:focusable="true"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear7"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="60dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:paddingTop="4dp"
			android:paddingBottom="4dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview_logo"
				android:layout_width="38dp"
				android:layout_height="38dp"
				app:cardBackgroundColor="@color/colorSurfaceAlt"
				app:cardCornerRadius="360dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">
				<com.google.android.material.imageview.ShapeableImageView
					android:id="@+id/iv_asset_logo"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="0dp"
					android:src="@drawable/ic_coin_harv"
					android:scaleType="centerCrop"
					android:focusable="false" />
			</com.google.android.material.card.MaterialCardView>
			<LinearLayout
				android:id="@+id/ll_asset_details"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_weight="1"
				android:layout_marginStart="12dp">
				<TextView
					android:id="@+id/tv_asset_name"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Harvana Coin"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary"
					android:textSize="15sp"
					android:maxLines="1"
					android:ellipsize="end"
					android:focusable="false" />
				<LinearLayout
					android:id="@+id/linear6"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/tv_asset_balance"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="20.00"
						android:textColor="@color/colorTextPrimary"
						android:textSize="12sp"
						android:focusable="false" />
					<TextView
						android:id="@+id/tv_asset_symbol"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="+2.64%"
						android:textSize="11sp"
						android:textStyle="bold"
						android:textColor="@color/colorAccent"
						android:layout_weight="1"
						android:maxLines="1"
						android:focusable="false"
						android:paddingStart="6dp" />
					<TextView
						android:id="@+id/tv_asset_amount"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="₦ 0.00"
						android:textStyle="bold"
						android:textColor="@color/colorTextSecondary"
						android:textSize="12sp"
						android:focusable="false" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
		<View
			android:id="@+id/asset_divider"
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginStart="62dp"
			android:background="@color/colorCardStroke" />
	</LinearLayout>
</LinearLayout>
