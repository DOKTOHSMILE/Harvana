						app:cardCornerRadius="12dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorCardStroke"
						app:strokeWidth="1dp">
						<EditText
							android:id="@+id/et_first_name"
							android:layout_width="match_parent"
							android:layout_height="52dp"
							android:padding="12dp"
							android:background="@android:color/transparent"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14.5sp"
							android:inputType="textPersonName|textCapWords"
							android:importantForAutofill="no" />
					</com.google.android.material.card.MaterialCardView>
					<TextView
						android:id="@+id/textview53"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="6dp"
						android:text="Last Name"
						android:textStyle="bold"
						android:textColor="@color/colorTextPrimary"
						android:textSize="13.5sp" />
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview47"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="14dp"
						app:cardBackgroundColor="@color/colorSurfaceAlt"
						app:cardCornerRadius="12dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorCardStroke"
						app:strokeWidth="1dp">
						<EditText
							android:id="@+id/et_last_name"
							android:layout_width="match_parent"
							android:layout_height="52dp"
							android:padding="12dp"
							android:background="@android:color/transparent"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14.5sp"
							android:inputType="textPersonName|textCapWords"
							android:importantForAutofill="no" />
					</com.google.android.material.card.MaterialCardView>
					<TextView
						android:id="@+id/textview54"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="6dp"
						android:text="Date of Birth"
						android:textStyle="bold"
						android:textColor="@color/colorTextPrimary"
						android:textSize="13.5sp" />
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview48"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="20dp"
						app:cardBackgroundColor="@color/colorSurfaceAlt"
						app:cardCornerRadius="12dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorCardStroke"
						app:strokeWidth="1dp">
						<TextView
							android:id="@+id/tv_dob"
							android:layout_width="match_parent"
							android:layout_height="52dp"
							android:padding="12dp"
							android:gravity="center_vertical"
							android:text="Tap to select"
							android:textColor="@color/colorTextSecondary"
							android:textSize="14.5sp"
							android:focusable="true" />
					</com.google.android.material.card.MaterialCardView>
					<TextView
						android:id="@+id/textview55"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="12dp"
						android:text="CONTACT &amp; LOCATION"
						android:textStyle="bold"
						android:textColor="@color/colorTextTertiary"
						android:textSize="10.5sp"
						android:letterSpacing="0.06" />
					<TextView
						android:id="@+id/textview56"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="6dp"
						android:text="Email"
						android:textStyle="bold"
						android:textColor="@color/colorTextPrimary"
						android:textSize="13.5sp" />
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview49"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="14dp"
						app:cardBackgroundColor="@color/colorSurfaceAlt"
						app:cardCornerRadius="12dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorCardStroke"
						app:strokeWidth="1dp">
						<EditText
							android:id="@+id/et_email"
							android:layout_width="match_parent"
							android:layout_height="52dp"
							android:padding="12dp"
							android:background="@android:color/transparent"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14.5sp"
							android:inputType="textEmailAddress" />
					</com.google.android.material.card.MaterialCardView>
					<TextView
						android:id="@+id/textview57"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="6dp"
						android:text="Phone Number"
						android:textStyle="bold"
						android:textColor="@color/colorTextPrimary"
						android:textSize="13.5sp" />
