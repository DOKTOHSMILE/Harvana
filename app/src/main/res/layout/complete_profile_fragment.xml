						android:layout_height="wrap_content"
						android:layout_marginBottom="20dp"
						app:cardBackgroundColor="@color/colorSurfaceAlt"
						app:cardCornerRadius="12dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorCardStroke"
