<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@color/colorBackground"
	android:id="@+id/_main">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/app_bar_layout1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/colorBackground"
		android:theme="@style/AppTheme.AppBarOverlay"
		app:elevation="0dp"
		android:stateListAnimator="@null">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:background="?attr/appBarColor"
			android:layout_height="?attr/actionBarSize"
			app:popupTheme="@style/AppTheme.PopupOverlay"
			app:title="CreateAccessCard"
			app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />
	</com.google.android.material.appbar.AppBarLayout>
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="20dp"
			android:orientation="vertical">
			<TextView
				android:id="@+id/tvSubtitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="24dp"
				android:text="Backing up your personal wallet"
				android:textSize="14sp"
				android:textColor="?android:attr/textColorSecondary" />
			<TextView
				android:id="@+id/textview5"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:text="1. Choose Card Design"
				android:textSize="16sp"
				android:textStyle="bold" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="@color/whiteFaint10"
				app:cardCornerRadius="16dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke"
				app:cardElevation="0dp">
				<HorizontalScrollView
					android:id="@+id/hscroll3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:scrollbars="none"
					android:clipToPadding="false"
					android:paddingHorizontal="12dp">
					<LinearLayout
						android:id="@+id/linear3"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingTop="8dp"
						android:paddingBottom="8dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<ImageView
							android:id="@+id/swatch_classic"
							android:layout_width="70dp"
							android:layout_height="45dp"
							android:background="?attr/selectableItemBackgroundBorderless"
							android:src="@drawable/icon_credit_card_round"
							android:scaleType="centerInside"
							android:layout_marginEnd="16dp"
							android:focusable="true" />
						<ImageView
							android:id="@+id/swatch_obsidian"
							android:layout_width="70dp"
							android:layout_height="45dp"
							android:background="?attr/selectableItemBackgroundBorderless"
							android:src="@drawable/icon_credit_card_round"
							android:scaleType="centerInside"
							android:layout_marginEnd="16dp"
							android:focusable="true" />
						<ImageView
							android:id="@+id/swatch_gold"
							android:layout_width="70dp"
							android:layout_height="45dp"
							android:background="?attr/selectableItemBackgroundBorderless"
							android:src="@drawable/icon_credit_card_round"
							android:scaleType="centerInside"
							android:layout_marginEnd="16dp"
							android:focusable="true" />
						<ImageView
							android:id="@+id/swatch_oasis"
							android:layout_width="70dp"
							android:layout_height="45dp"
							android:background="?attr/selectableItemBackgroundBorderless"
							android:src="@drawable/icon_credit_card_round"
							android:scaleType="centerInside"
							android:layout_marginEnd="16dp"
							android:focusable="true" />
						<ImageView
							android:id="@+id/swatch_node"
							android:layout_width="70dp"
							android:layout_height="45dp"
							android:background="?attr/selectableItemBackgroundBorderless"
							android:src="@drawable/icon_credit_card_round"
							android:scaleType="centerInside"
							android:layout_marginEnd="16dp"
							android:focusable="true" />
						<ImageView
							android:id="@+id/swatch_cyber"
							android:layout_width="70dp"
							android:layout_height="45dp"
							android:background="?attr/selectableItemBackgroundBorderless"
							android:src="@drawable/icon_credit_card_round"
							android:scaleType="centerInside"
							android:layout_marginEnd="16dp"
							android:focusable="true" />
						<ImageView
							android:id="@+id/swatch_mint"
							android:layout_width="70dp"
							android:layout_height="45dp"
							android:background="?attr/selectableItemBackgroundBorderless"
							android:src="@drawable/icon_credit_card_round"
							android:scaleType="centerInside"
							android:focusable="true" />
					</LinearLayout>
				</HorizontalScrollView>
			</com.google.android.material.card.MaterialCardView>
			<HorizontalScrollView
				android:id="@+id/hscroll1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:clipToPadding="false"
				android:scrollbars="none">
				<LinearLayout
					android:id="@+id/linear4"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_margin="8dp"
						app:cardBackgroundColor="@android:color/transparent"
						app:cardCornerRadius="16dp"
						app:cardElevation="12dp">
						<ImageView
							android:id="@+id/iv_card_front"
							android:layout_width="360dp"
							android:layout_height="wrap_content"
							android:src="@drawable/default_image"
							android:scaleType="centerInside"
							android:adjustViewBounds="true"
							android:visibility="gone" />
					</com.google.android.material.card.MaterialCardView>
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview3"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_margin="8dp"
						app:cardBackgroundColor="@android:color/transparent"
						android:layout_marginStart="16dp"
						app:cardCornerRadius="16dp"
						app:cardElevation="12dp">
						<ImageView
							android:id="@+id/iv_card_back"
							android:layout_width="360dp"
							android:layout_height="wrap_content"
							android:src="@drawable/default_image"
							android:scaleType="centerInside"
							android:adjustViewBounds="true"
							android:visibility="gone" />
					</com.google.android.material.card.MaterialCardView>
				</LinearLayout>
			</HorizontalScrollView>
			<TextView
				android:id="@+id/textview1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="Swipe to see back ➔"
				android:textSize="12sp"
				android:textColor="?android:attr/textColorSecondary" />
			<TextView
				android:id="@+id/textview2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="32dp"
				android:text="2. Secure Your Backup"
				android:textSize="16sp"
				android:textStyle="bold" />
			<TextView
				android:id="@+id/textview3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="Set a decryption password. At least 24 characters. Not stored anywhere — if you lose this card and forget the password, your assets cannot be recovered."
				android:textSize="13sp"
				android:textColor="?android:attr/textColorSecondary"
				android:lineSpacingExtra="2dp" />
			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/textinputlayout1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				app:boxCornerRadiusTopStart="12dp"
				app:boxCornerRadiusTopEnd="12dp"
				app:boxCornerRadiusBottomStart="12dp"
				app:boxCornerRadiusBottomEnd="12dp"
				app:endIconMode="password_toggle">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/et_sentence"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textSize="14sp"
					android:hint="Enter a memorable sentence"
					android:lines="2"
					android:gravity="top|start"
					android:inputType="textPassword|textMultiLine"
					android:minLines="2" />
			</com.google.android.material.textfield.TextInputLayout>
			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/textinputlayout2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				app:boxCornerRadiusTopStart="12dp"
				app:boxCornerRadiusTopEnd="12dp"
				app:boxCornerRadiusBottomStart="12dp"
				app:boxCornerRadiusBottomEnd="12dp"
				app:endIconMode="password_toggle">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/et_confirm_sentence"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textSize="14sp"
					android:hint="Confirm your sentence"
					android:lines="2"
					android:gravity="top|start"
					android:inputType="textPassword|textMultiLine"
					android:minLines="2" />
			</com.google.android.material.textfield.TextInputLayout>
			<TextView
				android:id="@+id/tv_char_count"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:text="0 / 24 characters minimum"
				android:textSize="12sp"
				android:textColor="?android:attr/textColorSecondary" />
			<TextView
				android:id="@+id/tv_error"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:textSize="13sp"
				android:textColor="@android:color/holo_red_dark"
				android:visibility="gone" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_generate"
				android:layout_width="match_parent"
				android:layout_height="60dp"
				android:layout_marginTop="24dp"
				app:backgroundTint="@color/colorTeal"
				android:gravity="center_horizontal|center_vertical"
				android:text="GENERATE CARD"
				android:textSize="14sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimary"
				android:enabled="false"
				app:cornerRadius="12dp"
				style="@style/Widget.MaterialComponents.Button.OutlinedButton"
				app:strokeColor="@color/colorAccent" />
			<LinearLayout
				android:id="@+id/linear5"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:orientation="horizontal"
				android:weightSum="2">
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_save_images"
					android:layout_width="0dp"
					android:layout_height="56dp"
					app:backgroundTint="@color/colorInfo"
					android:gravity="center_horizontal|center_vertical"
					android:text="SAVE AS PNG"
					android:textSize="13sp"
					android:textColor="@color/colorTextPrimaryWhite"
					android:layout_weight="1"
					app:cornerRadius="12dp"
					style="@style/Widget.MaterialComponents.Button.OutlinedButton"
					android:layout_marginEnd="8dp"
					app:icon="@drawable/icon_image_twotone"
					android:visibility="gone" />
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_save_pdf"
					android:layout_width="0dp"
					android:layout_height="56dp"
					app:backgroundTint="@color/colorCyan"
					android:gravity="center_horizontal|center_vertical"
					android:text="SAVE AS PDF"
					android:textSize="13sp"
					android:textColor="@color/colorTextPrimaryWhite"
					android:layout_weight="1"
					app:cornerRadius="12dp"
					style="@style/Widget.MaterialComponents.Button.OutlinedButton"
					android:layout_marginStart="8dp"
					app:icon="@drawable/icon_picture_as_pdf_twotone"
					android:visibility="gone" />
			</LinearLayout>
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_done"
				android:layout_width="match_parent"
				android:layout_height="64dp"
				android:layout_marginTop="24dp"
				android:layout_marginBottom="32dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="FINISH BACKUP"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimaryWhite"
				app:cornerRadius="12dp"
				android:backgroundTint="@color/colorAccent"
				android:visibility="gone" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
