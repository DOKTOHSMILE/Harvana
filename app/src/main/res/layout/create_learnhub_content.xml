<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/appBarColor"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/colorBackground"
		android:fillViewport="true"
		android:overScrollMode="never"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/linear10"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="20dp"
			android:orientation="vertical">
			<TextView
				android:id="@+id/textview24"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="New Learn Hub Article"
				android:textSize="22sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimary"
				android:focusable="false" />
			<TextView
				android:id="@+id/textview25"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="24dp"
				android:text="Share community knowledge, finance trends, or investment insights with other members."
				android:textColor="@color/colorTextSecondary"
				android:textSize="13.5sp"
				android:focusable="false" />
			<TextView
				android:id="@+id/textview26"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="TITLE"
				android:textStyle="bold"
				android:textColor="@color/colorTextTertiary"
				android:textSize="10.5sp"
				android:layout_marginStart="4dp"
				android:letterSpacing="0.06"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview13"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurfaceRaised"
				app:cardCornerRadius="14dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<EditText
					android:id="@+id/et_learn_title"
					android:layout_width="match_parent"
					android:layout_height="50dp"
					android:background="@android:color/transparent"
					android:gravity="center_vertical"
					android:textColor="@color/colorTextPrimary"
					android:hint="e.g. How Rotating Savings Groups Work"
					android:textSize="14.5sp"
					android:inputType="textCapSentences"
					android:focusable="true"
					android:focusableInTouchMode="true"
					android:maxLength="120"
					android:paddingHorizontal="14dp" />
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview27"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="DESCRIPTION"
				android:textStyle="bold"
				android:textColor="@color/colorTextTertiary"
				android:textSize="10.5sp"
				android:layout_marginStart="4dp"
				android:letterSpacing="0.06"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview14"
				android:layout_width="match_parent"
				android:layout_height="240dp"
				android:layout_marginTop="6dp"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurfaceRaised"
				app:cardCornerRadius="14dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<EditText
					android:id="@+id/et_learn_description"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="14dp"
					android:background="@android:color/transparent"
					android:textSize="14sp"
					android:textColor="@color/colorTextPrimary"
					android:hint="Write your article. You can format it: **bold**, *italic*, ## heading, - list, &gt; quote."
					android:gravity="top|start"
					android:inputType="textMultiLine|textCapSentences"
					android:focusable="true"
					android:focusableInTouchMode="true"
					android:maxLength="8000" />
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview28"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="CATEGORY"
				android:textStyle="bold"
				android:textColor="@color/colorTextTertiary"
				android:textSize="10.5sp"
				android:layout_marginStart="4dp"
				android:letterSpacing="0.06"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview7"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurfaceRaised"
				app:cardCornerRadius="14dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<Spinner
					android:id="@+id/spinner_learn_category"
					android:layout_width="match_parent"
					android:layout_height="50dp"
					android:background="@android:color/transparent"
					android:spinnerMode="dialog"
					android:paddingHorizontal="10dp"
					android:theme="@style/WhiteSpinnerTheme" />
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview29"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="COVER IMAGE"
				android:textStyle="bold"
				android:textColor="@color/colorTextTertiary"
				android:textSize="10.5sp"
				android:layout_marginStart="4dp"
				android:letterSpacing="0.06"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_image_picker"
				android:layout_width="match_parent"
				android:layout_height="160dp"
				android:layout_marginTop="6dp"
				android:layout_marginBottom="8dp"
				app:cardBackgroundColor="@color/colorSurfaceRaised"
				app:cardCornerRadius="14dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<FrameLayout
					android:id="@+id/frame_layout2"
					android:layout_width="match_parent"
					android:layout_height="match_parent">
					<ImageView
						android:id="@+id/iv_learn_image_preview"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:src="@drawable/default_image"
						android:scaleType="centerCrop"
						android:visibility="gone" />
					<LinearLayout
						android:id="@+id/layout_image_placeholder"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical">
						<ImageView
							android:id="@+id/imageview2"
							android:layout_width="36dp"
							android:layout_height="36dp"
							android:scaleType="center"
							android:src="@android:drawable/ic_menu_gallery"
							app:tint="@color/colorTextTertiary" />
						<TextView
							android:id="@+id/textview30"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="8dp"
							android:text="Add a cover image (optional)"
							android:textSize="13sp"
							android:textColor="@color/colorTextSecondary"
							android:focusable="false" />
					</LinearLayout>
					<com.google.android.material.progressindicator.LinearProgressIndicator
						android:id="@+id/progress_image_upload"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_gravity="bottom"
						android:visibility="gone"
						app:indicatorColor="@color/colorAccent"
						app:trackThickness="4dp" />
				</FrameLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview31"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="OR PASTE AN IMAGE URL"
				android:textStyle="bold"
				android:textColor="@color/colorTextTertiary"
				android:textSize="10.5sp"
				android:layout_marginStart="4dp"
				android:focusable="false"
				android:letterSpacing="0.06" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview15"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:layout_marginBottom="4dp"
				app:cardBackgroundColor="@color/colorSurfaceRaised"
				app:cardCornerRadius="14dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<EditText
					android:id="@+id/et_learn_image_url"
					android:layout_width="match_parent"
					android:layout_height="50dp"
					android:background="@android:color/transparent"
					android:gravity="center_vertical"
					android:textSize="14sp"
					android:textColor="@color/colorTextPrimary"
					android:hint="https://…"
					android:inputType="textUri"
					android:focusable="true"
					android:focusableInTouchMode="true"
					android:maxLength="500"
					android:paddingHorizontal="14dp" />
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview32"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="24dp"
				android:text="Picking an image above fills this in once it uploads. A picture or a video is optional: you can post words only."
				android:textColor="@color/colorTextTertiary"
				android:textSize="11.5sp"
				android:layout_marginStart="4dp"
				android:focusable="false" />
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="4dp"
				android:layout_marginBottom="6dp"
				android:text="Video link (optional)"
				android:textColor="@color/colorTextPrimary"
				android:textSize="14sp"
				android:textStyle="bold"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="4dp"
				app:cardBackgroundColor="@color/colorSurfaceRaised"
				app:cardCornerRadius="14dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<EditText
					android:id="@+id/et_learn_video_url"
					android:layout_width="match_parent"
					android:layout_height="50dp"
					android:background="@android:color/transparent"
					android:gravity="center_vertical"
					android:textSize="14sp"
					android:textColor="@color/colorTextPrimary"
					android:hint="YouTube, Facebook, TikTok or Vimeo link"
					android:inputType="textUri"
					android:focusable="true"
					android:focusableInTouchMode="true"
					android:maxLength="300"
					android:paddingHorizontal="14dp" />
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/tv_learn_video_status"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="4dp"
				android:layout_marginBottom="24dp"
				android:text="Readers press play and the video streams from the site it is on. Nothing is uploaded or stored by Harvana."
				android:textColor="@color/colorTextTertiary"
				android:textSize="11.5sp"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_learn_error"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:textSize="13sp"
				android:textColor="@color/colorError"
				android:focusable="false"
				android:visibility="gone" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_learn_post"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:text="Post Article"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextOnAccent"
				android:textAllCaps="false"
				app:backgroundTint="@color/colorAccent"
				app:cornerRadius="14dp"
				app:elevation="0dp" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
