<?xml version="1.0" encoding="utf-8"?>
<!-- Create sell offer (CreateSellP2p...Activity + p2p/P2pOfferWizard). Generated from one template with the buy screen; ids are the wizard's. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/create_sell_offer_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground"
	android:orientation="vertical">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="8dp"
		android:paddingEnd="16dp">
		<ImageView
			android:id="@+id/iv_sell_offer_back"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="Back"
			android:padding="10dp"
			android:src="@drawable/ic_nav_back"
			app:tint="@color/colorTextPrimary" />
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="4dp"
			android:layout_weight="1"
			android:orientation="vertical">
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Create sell offer"
				android:textColor="@color/colorTextPrimary"
				android:textSize="19sp"
				android:textStyle="bold" />
			<TextView
				android:id="@+id/tv_sell_step_label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textColor="@color/colorTextTertiary"
				android:textSize="12sp" />
		</LinearLayout>
	</LinearLayout>
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingEnd="16dp"
			android:paddingBottom="24dp">

		<!-- ═══ Step 1: coin, amount, price, payment, settings, terms ═══ -->
		<LinearLayout
			android:id="@+id/panel_sell_step_1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<!-- Coin -->
			<LinearLayout
				android:id="@+id/row_sell_coin"
				android:layout_width="match_parent"
				android:layout_height="60dp"
				android:layout_marginTop="4dp"
				android:background="@drawable/bg_p2p_filter_pill"
				android:foreground="?attr/selectableItemBackground"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="14dp"
				android:paddingEnd="10dp">
				<ImageView
					android:id="@+id/iv_sell_coin"
					android:layout_width="34dp"
					android:layout_height="34dp"
					android:importantForAccessibility="no" />
				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="12dp"
					android:layout_weight="1"
					android:orientation="vertical">
					<TextView
						android:id="@+id/tv_sell_coin"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textColor="@color/colorTextPrimary"
						android:textSize="16sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_coin_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textColor="@color/colorTextTertiary"
						android:textSize="12sp" />
				</LinearLayout>
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Change"
					android:textColor="@color/colorAccent"
					android:textSize="13sp"
					android:textStyle="bold" />
				<ImageView
					android:layout_width="22dp"
					android:layout_height="22dp"
					android:importantForAccessibility="no"
					android:src="@drawable/icon_arrow_drop_down_round"
					app:tint="@color/colorAccent" />
			</LinearLayout>
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:layout_marginBottom="8dp"
				android:text="Amount"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp"
				android:textStyle="bold" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_amount"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="14dp">
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="56dp"
						android:background="@drawable/bg_p2p_segment"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingStart="14dp"
						android:paddingEnd="8dp">
						<EditText
							android:id="@+id/et_sell_amount"
							android:layout_width="0dp"
							android:layout_height="match_parent"
							android:layout_weight="1"
							android:background="@null"
							android:hint="0.00"
							android:importantForAutofill="no"
							android:inputType="numberDecimal"
							android:maxLines="1"
							android:textColor="@color/colorTextPrimary"
							android:textSize="20sp"
							android:textStyle="bold" />
						<TextView
							android:id="@+id/tv_sell_amount_unit"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginEnd="6dp"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14sp"
							android:textStyle="bold" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btn_sell_max"
							style="@style/Widget.MaterialComponents.Button.TextButton"
							android:layout_width="wrap_content"
							android:layout_height="40dp"
							android:insetTop="0dp"
							android:insetBottom="0dp"
							android:minWidth="0dp"
							android:text="Max"
							android:textAllCaps="false"
							android:textStyle="bold" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/layout_sell_available"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:orientation="horizontal">
						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="Available"
							android:textColor="@color/colorTextTertiary"
							android:textSize="12.5sp" />
						<TextView
							android:id="@+id/tv_sell_available_balance"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textColor="@color/colorTextPrimary"
							android:textSize="12.5sp"
							android:textStyle="bold" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/tv_sell_price_title"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:layout_marginBottom="8dp"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp"
				android:textStyle="bold" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_price"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="14dp">
					<com.google.android.material.button.MaterialButtonToggleGroup
						android:id="@+id/toggle_sell_pricing_mode"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:checkedButton="@+id/btn_sell_price_fixed"
						app:selectionRequired="true"
						app:singleSelection="true">
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btn_sell_price_fixed"
							style="@style/Widget.MaterialComponents.Button.OutlinedButton"
							android:layout_width="0dp"
							android:layout_height="44dp"
							android:layout_weight="1"
							android:text="Fixed"
							android:textAllCaps="false" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btn_sell_price_floating"
							style="@style/Widget.MaterialComponents.Button.OutlinedButton"
							android:layout_width="0dp"
							android:layout_height="44dp"
							android:layout_weight="1"
							android:text="Floating"
							android:textAllCaps="false" />
					</com.google.android.material.button.MaterialButtonToggleGroup>
					<LinearLayout
						android:id="@+id/group_sell_price_fixed"
						android:layout_width="match_parent"
						android:layout_height="56dp"
						android:layout_marginTop="12dp"
						android:background="@drawable/bg_p2p_segment"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingStart="14dp"
						android:paddingEnd="14dp">
						<EditText
							android:id="@+id/et_sell_price"
							android:layout_width="0dp"
							android:layout_height="match_parent"
							android:layout_weight="1"
							android:background="@null"
							android:hint="0.00"
							android:importantForAutofill="no"
							android:inputType="numberDecimal"
							android:maxLines="1"
							android:textColor="@color/colorTextPrimary"
							android:textSize="20sp"
							android:textStyle="bold" />
						<TextView
							android:id="@+id/tv_sell_price_currency"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14sp"
							android:textStyle="bold" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/group_sell_price_floating"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:orientation="vertical"
						android:visibility="gone">
						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="56dp"
							android:background="@drawable/bg_p2p_segment"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingStart="14dp"
							android:paddingEnd="14dp">
							<EditText
								android:id="@+id/et_sell_margin"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:layout_weight="1"
								android:background="@null"
								android:hint="0"
								android:importantForAutofill="no"
								android:inputType="numberDecimal|numberSigned"
								android:maxLines="1"
								android:textColor="@color/colorTextPrimary"
								android:textSize="20sp"
								android:textStyle="bold" />
							<TextView
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="% margin"
								android:textColor="@color/colorTextPrimary"
								android:textSize="14sp"
								android:textStyle="bold" />
						</LinearLayout>
						<TextView
							android:id="@+id/tv_sell_calculated_price"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="8dp"
							android:textColor="@color/colorAccent"
							android:textSize="13sp" />
					</LinearLayout>
					<TextView
						android:id="@+id/tv_sell_price_note"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:textColor="@color/colorTextPrimary"
						android:textSize="12.5sp" />
					<View
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="10dp"
						android:background="@color/colorCardStroke" />
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="You receive"
							android:textColor="@color/colorTextSecondary"
							android:textSize="14sp" />
						<TextView
							android:id="@+id/tv_sell_you_receive"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="\u2014"
							android:textColor="@color/colorTextPrimary"
							android:textSize="17sp"
							android:textStyle="bold" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:layout_marginBottom="8dp"
				android:text="Payment methods"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp"
				android:textStyle="bold" />
			<LinearLayout
				android:id="@+id/layout_sell_payment_methods"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_sell_edit_payment_methods"
				style="@style/Widget.MaterialComponents.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="40dp"
				android:text="Manage payment methods"
				android:textAllCaps="false" />
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:layout_marginBottom="8dp"
				android:text="Settings"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp"
				android:textStyle="bold" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_settings"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="0dp">
					<LinearLayout
						android:id="@+id/row_sell_trade_limit"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingStart="14dp"
						android:paddingEnd="8dp">
						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="Trade limit"
							android:textColor="@color/colorTextSecondary"
							android:textSize="14sp" />
						<TextView
							android:id="@+id/tv_sell_trade_limit_value"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text=""
							android:textColor="@color/colorTextPrimary"
							android:textSize="14sp"
							android:textStyle="bold" />
						<ImageView
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:layout_marginStart="4dp"
							android:importantForAccessibility="no"
							android:src="@drawable/icon_keyboard_arrow_right_round"
							app:tint="@color/colorTextTertiary" />
					</LinearLayout>
					<View
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="@color/colorCardStroke" />
					<LinearLayout
						android:id="@+id/row_sell_offer_duration"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingStart="14dp"
						android:paddingEnd="8dp">
						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="Offer duration"
							android:textColor="@color/colorTextSecondary"
							android:textSize="14sp" />
						<TextView
							android:id="@+id/tv_sell_offer_duration_value"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="7 days"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14sp"
							android:textStyle="bold" />
						<ImageView
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:layout_marginStart="4dp"
							android:importantForAccessibility="no"
							android:src="@drawable/icon_keyboard_arrow_right_round"
							app:tint="@color/colorTextTertiary" />
					</LinearLayout>
					<View
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="@color/colorCardStroke" />
					<LinearLayout
						android:id="@+id/row_sell_payment_window"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingStart="14dp"
						android:paddingEnd="8dp">
						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="Payment window"
							android:textColor="@color/colorTextSecondary"
							android:textSize="14sp" />
						<TextView
							android:id="@+id/tv_sell_payment_window_value"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="15 min"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14sp"
							android:textStyle="bold" />
						<ImageView
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:layout_marginStart="4dp"
							android:importantForAccessibility="no"
							android:src="@drawable/icon_keyboard_arrow_right_round"
							app:tint="@color/colorTextTertiary" />
					</LinearLayout>
					<View
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="@color/colorCardStroke" />
					<LinearLayout
						android:id="@+id/row_sell_min_account_age"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingStart="14dp"
						android:paddingEnd="8dp">
						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="Minimum account age"
							android:textColor="@color/colorTextSecondary"
							android:textSize="14sp" />
						<TextView
							android:id="@+id/tv_sell_min_account_age_value"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Any"
							android:textColor="@color/colorTextPrimary"
							android:textSize="14sp"
							android:textStyle="bold" />
						<ImageView
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:layout_marginStart="4dp"
							android:importantForAccessibility="no"
							android:src="@drawable/icon_keyboard_arrow_right_round"
							app:tint="@color/colorTextTertiary" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:layout_marginBottom="8dp"
				android:text="Terms"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp"
				android:textStyle="bold" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_terms"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="14dp">
					<EditText
						android:id="@+id/et_sell_terms"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="@null"
						android:gravity="top"
						android:hint="Optional"
						android:importantForAutofill="no"
						android:inputType="textMultiLine|textCapSentences"
						android:maxLength="500"
						android:minLines="3"
						android:textColor="@color/colorTextPrimary"
						android:textSize="14sp" />
					<TextView
						android:id="@+id/tv_sell_terms_counter"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="end"
						android:textColor="@color/colorTextTertiary"
						android:textSize="12sp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/tv_sell_step1_error"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:background="@drawable/bg_chip_overdue"
				android:padding="12dp"
				android:textColor="@color/colorError"
				android:textSize="13sp"
				android:visibility="gone" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_sell_deposit_harv_1"
				style="@style/Widget.MaterialComponents.Button.OutlinedButton"
				android:layout_width="match_parent"
				android:layout_height="50dp"
				android:layout_marginTop="8dp"
				android:text="Deposit"
				android:textAllCaps="false"
				android:visibility="gone"
				app:cornerRadius="12dp" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_preview_sell_offer"
				android:layout_width="match_parent"
				android:layout_height="54dp"
				android:layout_marginTop="16dp"
				android:text="Preview"
				android:textAllCaps="false"
				android:textSize="16sp"
				android:textStyle="bold"
				app:backgroundTint="@color/p2pSell"
				app:cornerRadius="14dp"
				android:textColor="@color/p2pOnSell" />
		</LinearLayout>

		<!-- ═══ Step 2: review ═══ -->
		<LinearLayout
			android:id="@+id/panel_sell_step_2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone">
			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
