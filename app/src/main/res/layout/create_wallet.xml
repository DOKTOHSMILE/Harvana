<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@color/colorBackground"
	android:id="@+id/_main">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/app_bar_layout4"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay"
		app:elevation="0dp">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:background="?attr/colorPrimary"
			android:layout_height="?attr/actionBarSize"
			app:title="CreateWallet"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/linear5"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="20dp"
			android:orientation="vertical">
			<TextView
				android:id="@+id/tv_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Your New Wallet Seed Phrase"
				android:textSize="20sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimary" />
			<TextView
				android:id="@+id/textview4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:layout_marginBottom="20dp"
				android:text="Write these 12 words down somewhere safe, in order. You'll need them — along with the backup card on the next screen — if you ever need to restore this wallet."
				android:textSize="14sp"
				android:textColor="@color/colorTextTertiary" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke">
				<LinearLayout
					android:id="@+id/linear6"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear7"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear8"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1"
							android:layout_marginEnd="8dp">
							<TextView
								android:id="@+id/tv_num_1"
								android:layout_width="24dp"
								android:layout_height="wrap_content"
								android:text="1."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_1"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear9"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1">
							<TextView
								android:id="@+id/tv_num_2"
								android:layout_width="24dp"
								android:layout_height="wrap_content"
								android:text="2."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_2"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear10"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear11"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1"
							android:layout_marginEnd="8dp">
							<TextView
								android:id="@+id/tv_num_3"
								android:layout_width="24dp"
								android:layout_height="wrap_content"
								android:text="3."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_3"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear12"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1">
							<TextView
								android:id="@+id/tv_num_4"
								android:layout_width="24dp"
								android:layout_height="wrap_content"
								android:text="4."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_4"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear13"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear14"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1"
							android:layout_marginEnd="8dp">
							<TextView
								android:id="@+id/tv_num_5"
								android:layout_width="24dp"
								android:layout_height="wrap_content"
								android:text="5."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_5"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear15"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1">
							<TextView
								android:id="@+id/tv_num_6"
								android:layout_width="24dp"
								android:layout_height="wrap_content"
								android:text="6."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_6"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear16"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear17"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1"
							android:layout_marginEnd="8dp">
							<TextView
								android:id="@+id/tv_num_7"
								android:layout_width="24dp"
								android:layout_height="wrap_content"
								android:text="7."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_7"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear18"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1">
							<TextView
								android:id="@+id/tv_num_8"
								android:layout_width="24dp"
								android:layout_height="wrap_content"
								android:text="8."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_8"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear19"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear20"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1"
							android:layout_marginEnd="8dp">
							<TextView
								android:id="@+id/tv_num_9"
								android:layout_width="24dp"
								android:layout_height="wrap_content"
								android:text="9."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_9"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear21"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1">
							<TextView
								android:id="@+id/tv_num_10"
								android:layout_width="28dp"
								android:layout_height="wrap_content"
								android:text="10."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_10"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear22"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear23"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1"
							android:layout_marginEnd="8dp">
							<TextView
								android:id="@+id/tv_num_11"
								android:layout_width="28dp"
								android:layout_height="wrap_content"
								android:text="11."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_11"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear24"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:layout_weight="1">
							<TextView
								android:id="@+id/tv_num_12"
								android:layout_width="28dp"
								android:layout_height="wrap_content"
								android:text="12."
								android:textSize="15sp"
								android:textColor="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/tv_word_12"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:layout_weight="1"
								android:fontFamily="monospace" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				app:cardBackgroundColor="@color/colorSurfaceAlt"
				app:cardCornerRadius="12dp">
				<LinearLayout
					android:id="@+id/linear25"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="14dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<CheckBox
						android:id="@+id/cb_agree"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="12sp" />
					<TextView
						android:id="@+id/textview5"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="I've written down these 12 words in order and stored them somewhere safe."
						android:textSize="13sp"
						android:textColor="@color/colorTextPrimary"
						android:layout_weight="1"
						android:layout_marginStart="8dp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_finish_setup"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:layout_marginTop="20dp"
				android:layout_marginBottom="20dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="Continue to Backup Card"
				android:textSize="12sp"
				android:textColor="@color/colorBackground"
				android:enabled="false"
				android:backgroundTint="@color/colorAccent" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
