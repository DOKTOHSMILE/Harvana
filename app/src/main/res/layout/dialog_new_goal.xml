<?xml version="1.0" encoding="utf-8"?>
<!-- Start a new goal: its name and target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingStart="20dp"
	android:paddingTop="8dp"
	android:paddingEnd="20dp">

	<EditText
		android:id="@+id/et_new_goal_name"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:background="@drawable/bg_field_surface"
		android:hint="Name of the new goal"
		android:inputType="textCapSentences"
		android:paddingStart="14dp"
		android:paddingEnd="14dp"
		android:singleLine="true"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary" />

	<EditText
		android:id="@+id/et_new_goal_target"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:layout_marginTop="10dp"
		android:background="@drawable/bg_field_surface"
		android:hint="Target amount"
		android:inputType="numberDecimal"
		android:paddingStart="14dp"
		android:paddingEnd="14dp"
		android:singleLine="true"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary" />
</LinearLayout>
