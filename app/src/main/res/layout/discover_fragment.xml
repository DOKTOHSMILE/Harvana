<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@android:color/transparent"
	android:id="@+id/_main">
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll6"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		android:overScrollMode="never">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@android:color/transparent"
			android:orientation="vertical">
			<TextView
				android:id="@+id/textview1"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="20dp"
				android:layout_marginTop="20dp"
				android:layout_marginRight="20dp"
				android:text="Discover Groups"
				android:textSize="28sp"
				android:textStyle="bold" />
			<TextView
				android:id="@+id/textview2"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="20dp"
				android:layout_marginTop="2dp"
				android:layout_marginRight="20dp"
				android:text="Find trustworthy savings circles near you"
				android:textSize="13sp" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview5"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="10dp"
				android:layout_marginTop="18dp"
				android:layout_marginRight="10dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardElevation="0dp"
				app:cardCornerRadius="16dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/whiteFaint10">
				<LinearLayout
					android:id="@+id/linear3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="14dp"
					android:orientation="vertical">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview2"
						android:layout_width="match_parent"
						android:layout_height="42dp"
						app:cardBackgroundColor="@color/colorSurfaceAlt"
						app:cardElevation="0dp"
						app:cardCornerRadius="12dp"
	app:strokeWidth="0dp">
						<LinearLayout
							android:id="@+id/linear49"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingStart="12dp"
							android:paddingEnd="12dp">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview4"
								android:layout_width="18dp"
								android:layout_height="18dp"
								android:scaleType="centerInside"
								android:src="@drawable/icon_search_twotone"
								app:tint="@color/colorTextTertiary" android:duplicateParentState="true" />
							<TextView
								android:id="@+id/tv_search"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:background="@android:color/transparent"
								android:gravity="center_vertical"
								android:text="Search group"
								android:textSize="14sp"
								android:layout_marginStart="8dp" />
						</LinearLayout>
					</com.google.android.material.card.MaterialCardView>
					<LinearLayout
						android:id="@+id/linear50"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/cardview1"
							android:layout_width="200dp"
							android:layout_height="36dp"
							app:cardBackgroundColor="@color/colorSurfaceAlt"
							android:layout_weight="1"
							app:cardElevation="0dp"
							app:cardCornerRadius="12dp"
	app:strokeWidth="0dp">
							<LinearLayout
								android:id="@+id/lr_select_location"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:gravity="center_vertical"
								android:orientation="horizontal"
								android:paddingStart="10dp"
								android:paddingEnd="10dp">
								<com.google.android.material.imageview.ShapeableImageView
									android:id="@+id/imageview1"
									android:layout_width="16dp"
									android:layout_height="16dp"
									android:src="@drawable/icon_location_on_outline"
									android:scaleType="centerInside"
									app:tint="@color/colorAccent" />
								<TextView
									android:id="@+id/textview3"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Global"
									android:textSize="13sp"
									android:textStyle="bold"
									android:singleLine="true"
									android:layout_marginStart="6dp" />
							</LinearLayout>
						</com.google.android.material.card.MaterialCardView>
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/cardview4"
							android:layout_width="wrap_content"
							android:layout_height="36dp"
							app:cardBackgroundColor="@color/colorSurfaceAlt"
							android:layout_weight="1"
							android:layout_marginStart="8dp"
							app:cardElevation="0dp"
							app:cardCornerRadius="12dp"
	app:strokeWidth="0dp">
							<com.google.android.material.checkbox.MaterialCheckBox
								android:id="@+id/cd_verified_only"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:background="@android:color/transparent"
								android:gravity="center_vertical"
								android:text="On network"
								android:textSize="12sp"
								android:textStyle="bold"
								android:paddingStart="6dp"
								android:paddingEnd="12dp" />
						</com.google.android.material.card.MaterialCardView>
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/cardview3"
							android:layout_width="100dp"
							android:layout_height="36dp"
							app:cardBackgroundColor="@color/colorSurfaceAlt"
							android:layout_weight="1"
							android:layout_marginStart="8dp"
							app:cardElevation="0dp"
							app:cardCornerRadius="12dp"
	app:strokeWidth="0dp">
							<com.harvana.app.ui.MaterialSpinner
								android:id="@+id/sp_sort"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:background="@android:color/transparent"
								android:spinnerMode="dropdown"
								android:paddingStart="4dp"
								android:paddingEnd="4dp"
								android:theme="@style/WhiteSpinnerTheme" />
						</com.google.android.material.card.MaterialCardView>
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview12"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_marginLeft="10dp"
				android:layout_marginTop="16dp"
				android:layout_marginRight="10dp"
				android:layout_marginBottom="10dp"
				app:cardBackgroundColor="@color/colorSurface"
				android:layout_weight="1"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/whiteFaint10">
				<ListView
					android:id="@+id/listview1"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:paddingLeft="5dp"
					android:paddingTop="8dp"
					android:paddingRight="5dp"
					android:paddingBottom="8dp"
					android:background="@android:color/transparent"
					android:choiceMode="none"
					android:clipToPadding="false"
					android:divider="@null"
					android:nestedScrollingEnabled="true"
					tools:listitem="@layout/discover_group_custom_view" />
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
