<?xml version="1.0" encoding="utf-8"?>
<!-- Create group, goal: coin, purpose (and how money leaves), target, who receives, expected members, suggested deposit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<TextView
		android:id="@+id/tv_step_title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textColor="@color/colorTextPrimary"
		android:textSize="22sp"
		android:textStyle="bold" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="16dp"
		android:paddingBottom="6dp"
		android:text="Stable coin for savings"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:textStyle="bold" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/btn_create_coin"
		style="@style/HarvanaButton.Outlined"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:gravity="start|center_vertical"
		android:text="Choose a coin"
		app:iconTint="@null" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="16dp"
		android:paddingBottom="6dp"
		android:text="What is the group saving for"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:textStyle="bold" />

	<com.google.android.material.button.MaterialButtonToggleGroup
		android:id="@+id/tg_create_purpose"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		app:selectionRequired="true"
		app:singleSelection="true">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/tg_create_purpose_0"
			style="@style/Harvana.Segment"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="50dp"
			android:text="One-off purchase or event"
			android:textSize="12.5sp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/tg_create_purpose_1"
			style="@style/Harvana.Segment"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="50dp"
			android:text="A cause the admin pays out"
			android:textSize="12.5sp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/tg_create_purpose_2"
			style="@style/Harvana.Segment"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="50dp"
			android:text="A project in stages"
			android:textSize="12.5sp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/tg_create_purpose_3"
			style="@style/Harvana.Segment"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="50dp"
			android:text="Emergency fund"
			android:textSize="12.5sp" />

	</com.google.android.material.button.MaterialButtonToggleGroup>

	<LinearLayout
		android:id="@+id/create_goal_rule"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical" />

	<TextView
		android:id="@+id/tv_create_target_label"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="16dp"
		android:paddingBottom="6dp"
		android:text="Target amount"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:textStyle="bold" />

	<EditText
		android:id="@+id/et_create_target"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="50dp"
		android:background="@drawable/bg_field_surface"
		android:hint="0.00"
		android:inputType="numberDecimal"
		android:paddingStart="14dp"
		android:paddingTop="12dp"
		android:paddingEnd="14dp"
		android:paddingBottom="12dp"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary"
		android:singleLine="true" />

	<LinearLayout
		android:id="@+id/create_beneficiary"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">

		<TextView
			android:id="@+id/tv_create_beneficiary_label"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingTop="16dp"
			android:paddingBottom="6dp"
			android:text="Who receives the money"
			android:textColor="@color/colorTextPrimary"
			android:textSize="13sp"
			android:textStyle="bold" />

		<com.google.android.material.button.MaterialButtonToggleGroup
			android:id="@+id/tg_create_beneficiary"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:selectionRequired="true"
			app:singleSelection="true">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/tg_create_beneficiary_0"
				style="@style/Harvana.Segment"
				android:layout_width="0dp"
				android:layout_height="50dp"
				android:layout_weight="1"
				android:text="Me, the admin"
				android:textSize="12.5sp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/tg_create_beneficiary_1"
				style="@style/Harvana.Segment"
				android:layout_width="0dp"
				android:layout_height="50dp"
				android:layout_weight="1"
				android:text="Another wallet"
				android:textSize="12.5sp" />

		</com.google.android.material.button.MaterialButtonToggleGroup>

		<EditText
			android:id="@+id/et_create_beneficiary"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="50dp"
			android:background="@drawable/bg_field_surface"
			android:hint="HV0x… full wallet address"
			android:inputType="text"
			android:paddingStart="14dp"
			android:paddingTop="12dp"
			android:paddingEnd="14dp"
			android:paddingBottom="12dp"
			android:textColor="@color/colorTextPrimary"
			android:textColorHint="@color/colorTextTertiary"
			android:layout_marginTop="8dp"
			android:singleLine="true"
			android:visibility="gone" />

	</LinearLayout>

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="16dp"
		android:paddingBottom="6dp"
		android:text="Expected number of members (optional)"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:textStyle="bold" />

	<EditText
		android:id="@+id/et_create_expected"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="50dp"
		android:background="@drawable/bg_field_surface"
		android:hint="e.g. 10"
		android:inputType="number"
		android:paddingStart="14dp"
		android:paddingTop="12dp"
		android:paddingEnd="14dp"
		android:paddingBottom="12dp"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary"
		android:singleLine="true" />

	<TextView
		android:id="@+id/tv_create_suggested_label"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="16dp"
		android:paddingBottom="6dp"
		android:text="Suggested deposit per member (optional)"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:textStyle="bold" />

	<EditText
		android:id="@+id/et_create_suggested"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="50dp"
		android:background="@drawable/bg_field_surface"
		android:hint="e.g. 20"
		android:inputType="numberDecimal"
		android:paddingStart="14dp"
		android:paddingTop="12dp"
		android:paddingEnd="14dp"
		android:paddingBottom="12dp"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary"
		android:singleLine="true" />
</LinearLayout>
