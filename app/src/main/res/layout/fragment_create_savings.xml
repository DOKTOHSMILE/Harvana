<?xml version="1.0" encoding="utf-8"?>
<!-- Create group, savings: coin, lending and interest per day, when savings can be taken out, expected members, suggested saving. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<TextView
		android:id="@+id/tv_step_title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textColor="@color/colorTextPrimary"
		android:textSize="22sp"
		android:textStyle="bold" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="16dp"
		android:paddingBottom="6dp"
		android:text="Stable coin for savings"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:textStyle="bold" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/btn_create_coin"
		style="@style/HarvanaButton.Outlined"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:gravity="start|center_vertical"
		android:text="Choose a coin"
		app:iconTint="@null" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="16dp"
		android:paddingBottom="6dp"
		android:text="Lending"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:textStyle="bold" />

	<com.google.android.material.switchmaterial.SwitchMaterial
		android:id="@+id/sw_create_loans"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="50dp"
		android:text="Members can borrow from the group's savings"
		android:textColor="@color/colorTextPrimary" />

	<TextView
		android:id="@+id/tv_create_interest_label"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="16dp"
		android:paddingBottom="6dp"
		android:text="Interest per day on a loan (0 to 5%)"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:textStyle="bold" />

	<EditText
		android:id="@+id/et_create_interest"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="50dp"
		android:background="@drawable/bg_field_surface"
		android:hint="e.g. 0.5"
		android:inputType="numberDecimal"
		android:paddingStart="14dp"
		android:paddingTop="12dp"
		android:paddingEnd="14dp"
		android:paddingBottom="12dp"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary"
		android:singleLine="true" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="16dp"
		android:paddingBottom="6dp"
		android:text="When can savings be taken out"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:textStyle="bold" />

	<com.google.android.material.button.MaterialButtonToggleGroup
		android:id="@+id/tg_create_withdraw"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:selectionRequired="true"
		app:singleSelection="true">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/tg_create_withdraw_0"
			style="@style/Harvana.Segment"
			android:layout_width="0dp"
			android:layout_height="50dp"
			android:layout_weight="1"
			android:text="Any time"
			android:textSize="12.5sp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/tg_create_withdraw_1"
			style="@style/Harvana.Segment"
			android:layout_width="0dp"
			android:layout_height="50dp"
			android:layout_weight="1"
			android:text="Only when the line ends"
			android:textSize="12.5sp" />

	</com.google.android.material.button.MaterialButtonToggleGroup>

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="16dp"
		android:paddingBottom="6dp"
		android:text="Expected number of members (optional)"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:textStyle="bold" />

	<EditText
		android:id="@+id/et_create_expected"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="50dp"
		android:background="@drawable/bg_field_surface"
		android:hint="e.g. 10"
		android:inputType="number"
		android:paddingStart="14dp"
		android:paddingTop="12dp"
		android:paddingEnd="14dp"
		android:paddingBottom="12dp"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary"
		android:singleLine="true" />

	<TextView
		android:id="@+id/tv_create_suggested_label"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="16dp"
		android:paddingBottom="6dp"
		android:text="Suggested daily saving (optional)"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:textStyle="bold" />

	<EditText
		android:id="@+id/et_create_suggested"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="50dp"
		android:background="@drawable/bg_field_surface"
		android:hint="e.g. 1"
		android:inputType="numberDecimal"
		android:paddingStart="14dp"
		android:paddingTop="12dp"
		android:paddingEnd="14dp"
		android:paddingBottom="12dp"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary"
		android:singleLine="true" />
</LinearLayout>
