<?xml version="1.0" encoding="utf-8"?>
<!-- Custom network: the trust warning, then Network name, RPC URL, Chain ID, Symbol, Block explorer URL, and Add. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="12dp"
		android:paddingEnd="16dp"
		android:paddingBottom="24dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/bg_notice_warning_stroke"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:padding="12dp">

			<ImageView
				android:layout_width="22dp"
				android:layout_height="22dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_warning_line"
				app:tint="@color/colorWarning" />

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="10dp"
				android:layout_weight="1"
				android:text="A network provider can lie about the state of the chain and record your activity. Only add networks you trust."
				android:textColor="@color/colorTextPrimary"
				android:textSize="12.5sp" />
		</LinearLayout>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:paddingBottom="6dp"
			android:text="Network name"
			android:textColor="@color/colorTextPrimary"
			android:textSize="14sp"
			android:textStyle="bold" />

		<EditText
			android:id="@+id/et_network_name"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:background="@drawable/bg_field_surface"
			android:hint="Network name (optional)"
			android:inputType="text"
			android:paddingStart="14dp"
			android:paddingEnd="14dp"
			android:singleLine="true"
			android:textColor="@color/colorTextPrimary"
			android:textColorHint="@color/colorTextTertiary"
			android:textSize="14sp" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:paddingBottom="6dp"
			android:text="RPC URL"
			android:textColor="@color/colorTextPrimary"
			android:textSize="14sp"
			android:textStyle="bold" />

		<EditText
			android:id="@+id/et_network_rpc"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:background="@drawable/bg_field_surface"
			android:hint="https://…"
			android:inputType="textUri"
			android:paddingStart="14dp"
			android:paddingEnd="14dp"
			android:singleLine="true"
			android:textColor="@color/colorTextPrimary"
			android:textColorHint="@color/colorTextTertiary"
			android:textSize="14sp" />

		<TextView
			android:id="@+id/tv_network_rpc_error"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="4dp"
			android:textColor="@color/colorError"
			android:textSize="12sp"
			android:visibility="gone" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:paddingBottom="6dp"
			android:text="Chain ID"
			android:textColor="@color/colorTextPrimary"
			android:textSize="14sp"
			android:textStyle="bold" />

		<EditText
			android:id="@+id/et_network_chain_id"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:background="@drawable/bg_field_surface"
			android:hint="Chain ID (e.g. 42161 or 0xa4b1)"
			android:inputType="text"
			android:paddingStart="14dp"
			android:paddingEnd="14dp"
			android:singleLine="true"
			android:textColor="@color/colorTextPrimary"
			android:textColorHint="@color/colorTextTertiary"
			android:textSize="14sp" />

		<TextView
			android:id="@+id/tv_network_chain_error"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="4dp"
			android:textColor="@color/colorError"
			android:textSize="12sp"
			android:visibility="gone" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:paddingBottom="6dp"
			android:text="Symbol"
			android:textColor="@color/colorTextPrimary"
			android:textSize="14sp"
			android:textStyle="bold" />

		<EditText
			android:id="@+id/et_network_symbol"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:background="@drawable/bg_field_surface"
			android:hint="Symbol (optional)"
			android:inputType="textCapCharacters"
			android:paddingStart="14dp"
			android:paddingEnd="14dp"
			android:singleLine="true"
			android:textColor="@color/colorTextPrimary"
			android:textColorHint="@color/colorTextTertiary"
			android:textSize="14sp" />

		<TextView
			android:id="@+id/tv_network_symbol_warning"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="4dp"
			android:textColor="@color/colorWarning"
			android:textSize="12sp"
			android:visibility="gone" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:paddingBottom="6dp"
			android:text="Block explorer URL"
			android:textColor="@color/colorTextPrimary"
			android:textSize="14sp"
			android:textStyle="bold" />

		<EditText
			android:id="@+id/et_network_explorer"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:background="@drawable/bg_field_surface"
			android:hint="Block explorer URL (optional)"
			android:inputType="textUri"
			android:paddingStart="14dp"
			android:paddingEnd="14dp"
			android:singleLine="true"
			android:textColor="@color/colorTextPrimary"
			android:textColorHint="@color/colorTextTertiary"
			android:textSize="14sp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_network_custom_add"
			style="@style/HarvanaButton"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:layout_marginTop="24dp"
			android:enabled="false"
			android:text="Add" />
	</LinearLayout>
</ScrollView>
