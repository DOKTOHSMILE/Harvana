<?xml version="1.0" encoding="utf-8"?>
<!-- Popular networks: search, then each network with its chain ID and coin, and Add. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:paddingStart="16dp"
	android:paddingTop="8dp"
	android:paddingEnd="16dp">

	<EditText
		android:id="@+id/et_networks_search"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:background="@drawable/bg_field_surface"
		android:drawableStart="@drawable/icon_search_24"
		android:drawablePadding="10dp"
		android:hint="Search network or chain ID"
		android:inputType="text"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:singleLine="true"
		android:textColor="@color/colorTextPrimary"
		android:textColorHint="@color/colorTextTertiary"
		app:drawableTint="@color/colorTextTertiary" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/rv_networks_popular"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_marginTop="8dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:paddingBottom="16dp"
		app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
