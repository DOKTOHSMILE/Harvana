<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay"
		app:elevation="0dp"
		android:stateListAnimator="@null">
		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/appBarColor"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<LinearLayout
		android:id="@+id/_coordinator"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:background="@color/colorBackground"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<androidx.core.widget.NestedScrollView
			android:id="@+id/vscroll_join_request"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:fillViewport="true"
			android:overScrollMode="never">
			<LinearLayout
				android:id="@+id/linear65"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:orientation="vertical">
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview33"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<LinearLayout
						android:id="@+id/linear66"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="20dp"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/linear67"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<com.google.android.material.card.MaterialCardView
								android:id="@+id/cardview34"
								android:layout_width="56dp"
								android:layout_height="56dp"
								app:cardBackgroundColor="@color/colorSurfaceAlt"
								app:cardCornerRadius="28dp"
								app:cardElevation="0dp"
	app:strokeWidth="0dp">
								<com.google.android.material.imageview.ShapeableImageView
									android:id="@+id/img_group_avatar"
									android:layout_width="28dp"
									android:layout_height="28dp"
									android:src="@drawable/icon_groups_3_round"
									android:scaleType="centerInside" />
							</com.google.android.material.card.MaterialCardView>
							<LinearLayout
								android:id="@+id/linear68"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_weight="1"
								android:layout_marginStart="14dp">
								<TextView
									android:id="@+id/tv_group_name"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Squad Matrix Savings Circle"
									android:textSize="18sp"
									android:textStyle="bold"
									android:textColor="@color/colorTextPrimary"
									android:ellipsize="end"
									android:maxLines="2" />
								<LinearLayout
									android:id="@+id/linear69"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginTop="4dp"
									android:gravity="center_vertical"
									android:orientation="horizontal">
									<com.google.android.material.imageview.ShapeableImageView
										android:id="@+id/imageview17"
										android:layout_width="13dp"
										android:layout_height="13dp"
										android:src="@drawable/icon_location_on_outline"
										android:scaleType="centerInside"
										app:tint="@color/colorTextTertiary" />
									<TextView
										android:id="@+id/tv_group_location"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:text="Sapele, Delta State"
										android:textSize="12sp"
										android:textColor="@color/colorTextSecondary"
										android:layout_marginStart="4dp" />
								</LinearLayout>
							</LinearLayout>
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear70"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="16dp"
							android:orientation="horizontal">
							<com.google.android.material.card.MaterialCardView
								android:id="@+id/cardview35"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								app:cardBackgroundColor="@color/colorSurfaceAlt"
								android:layout_marginEnd="8dp"
								app:cardCornerRadius="16dp"
								app:cardElevation="0dp"
								app:strokeWidth="0dp">
								<TextView
									android:id="@+id/tv_group_type"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Rotational Savings"
									android:textSize="11sp"
									android:textStyle="bold"
									android:textColor="@color/colorTextPrimary"
									android:paddingHorizontal="12dp"
									android:paddingVertical="6dp" />
							</com.google.android.material.card.MaterialCardView>
							<com.google.android.material.card.MaterialCardView
								android:id="@+id/card_health_badge"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								app:cardBackgroundColor="@color/colorSurfaceAlt"
								app:cardCornerRadius="16dp"
								app:cardElevation="0dp"
								app:strokeWidth="0dp">
								<LinearLayout
									android:id="@+id/linear71"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:gravity="center_vertical"
									android:orientation="horizontal"
									android:paddingHorizontal="12dp"
									android:paddingVertical="6dp">
									<View
										android:id="@+id/view72"
										android:layout_width="7dp"
										android:layout_height="7dp"
										android:background="@drawable/dot_pending" />
									<TextView
										android:id="@+id/tv_group_health"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:text="Healthy"
										android:textSize="11sp"
										android:textStyle="bold"
										android:textColor="@color/colorSuccess"
										android:layout_marginStart="6dp" />
								</LinearLayout>
							</com.google.android.material.card.MaterialCardView>
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/textview43"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:layout_marginBottom="8dp"
					android:text="ABOUT THIS GROUP"
					android:textStyle="bold"
					android:textColor="@color/colorTextTertiary"
					android:textSize="10.5sp"
					android:layout_marginStart="4dp"
					android:letterSpacing="0.06" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview36"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<TextView
						android:id="@+id/tv_group_description"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="18dp"
						android:text="A rotational savings circle for small business owners in Sapele. Every member contributes weekly, and the full pot rotates to one member each cycle until everyone has received a payout."
						android:textColor="@color/colorTextSecondary"
						android:textSize="13.5sp"
						android:lineSpacingExtra="3dp" />
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/textview44"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:layout_marginBottom="8dp"
					android:text="GROUP DETAILS"
					android:textStyle="bold"
					android:textColor="@color/colorTextTertiary"
					android:textSize="10.5sp"
					android:layout_marginStart="4dp"
					android:letterSpacing="0.06" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview37"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<LinearLayout
						android:id="@+id/linear73"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="18dp"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/linear74"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<TextView
								android:id="@+id/textview45"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Admin"
								android:textColor="@color/colorTextSecondary"
								android:layout_weight="1"
								android:textSize="13.5sp" />
							<TextView
								android:id="@+id/tv_join_admin_value"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Chidinma O."
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:textSize="13.5sp" />
						</LinearLayout>
						<com.google.android.material.divider.MaterialDivider
							android:id="@+id/view75"
							android:layout_width="match_parent"
							android:layout_height="1dp"
							android:layout_marginVertical="12dp"
	app:dividerColor="@color/colorDivider"/>
						<LinearLayout
							android:id="@+id/linear76"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<TextView
								android:id="@+id/textview46"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Members"
								android:textColor="@color/colorTextSecondary"
								android:layout_weight="1"
								android:textSize="13.5sp" />
							<TextView
								android:id="@+id/tv_join_members_value"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="14 / 20"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:textSize="13.5sp" />
						</LinearLayout>
						<com.google.android.material.divider.MaterialDivider
							android:id="@+id/view77"
							android:layout_width="match_parent"
							android:layout_height="1dp"
							android:layout_marginVertical="12dp"
	app:dividerColor="@color/colorDivider"/>
						<LinearLayout
							android:id="@+id/linear78"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<TextView
								android:id="@+id/textview47"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Group Created"
								android:textColor="@color/colorTextSecondary"
								android:layout_weight="1"
								android:textSize="13.5sp" />
							<TextView
								android:id="@+id/tv_join_created_value"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Feb 2026"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:textSize="13.5sp" />
						</LinearLayout>
						<com.google.android.material.divider.MaterialDivider
							android:id="@+id/view79"
							android:layout_width="match_parent"
							android:layout_height="1dp"
							android:layout_marginVertical="12dp"
	app:dividerColor="@color/colorDivider"/>
						<LinearLayout
							android:id="@+id/linear80"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<TextView
								android:id="@+id/textview48"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Current Cycle"
								android:textColor="@color/colorTextSecondary"
								android:layout_weight="1"
								android:textSize="13.5sp" />
							<TextView
								android:id="@+id/tv_join_cycle_value"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Cycle 6 of 20"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:textSize="13.5sp" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/textview49"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:layout_marginBottom="8dp"
					android:text="GROUP RULES"
					android:textStyle="bold"
					android:textColor="@color/colorTextTertiary"
					android:textSize="10.5sp"
					android:layout_marginStart="4dp"
					android:letterSpacing="0.06" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview38"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeColor="@color/colorCardStroke"
					app:strokeWidth="1dp">
					<LinearLayout
						android:id="@+id/layout_group_rules"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="18dp"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/linear81"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="12dp"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview18"
								android:layout_width="16dp"
								android:layout_height="16dp"
								android:layout_marginTop="2dp"
								android:src="@drawable/icon_check_circle_round"
								android:scaleType="centerInside"
								app:tint="@color/colorAccent" />
							<TextView
								android:id="@+id/textview50"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Weekly contribution of ₦5,000 is due every Monday by 6:00 PM."
								android:textColor="@color/colorTextSecondary"
								android:layout_weight="1"
								android:textSize="13.5sp"
								android:layout_marginStart="10dp"
								android:lineSpacingExtra="2dp" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear82"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="12dp"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview19"
								android:layout_width="16dp"
								android:layout_height="16dp"
								android:layout_marginTop="2dp"
								android:src="@drawable/icon_check_circle_round"
								android:scaleType="centerInside"
								app:tint="@color/colorAccent" />
							<TextView
								android:id="@+id/textview51"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Missing two consecutive contributions without notice may result in removal from the group."
								android:textColor="@color/colorTextSecondary"
								android:layout_weight="1"
								android:textSize="13.5sp"
								android:layout_marginStart="10dp"
								android:lineSpacingExtra="2dp" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear83"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="12dp"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview20"
								android:layout_width="16dp"
								android:layout_height="16dp"
								android:layout_marginTop="2dp"
								android:src="@drawable/icon_check_circle_round"
								android:scaleType="centerInside"
								app:tint="@color/colorAccent" />
							<TextView
								android:id="@+id/textview52"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Payout order is decided by the admin at the start of each cycle and shared with all members."
								android:textColor="@color/colorTextSecondary"
								android:layout_weight="1"
								android:textSize="13.5sp"
								android:layout_marginStart="10dp"
								android:lineSpacingExtra="2dp" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear84"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview21"
								android:layout_width="16dp"
								android:layout_height="16dp"
								android:layout_marginTop="2dp"
								android:src="@drawable/icon_check_circle_round"
								android:scaleType="centerInside"
								app:tint="@color/colorAccent" />
							<TextView
								android:id="@+id/textview53"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Leaving before completing a full cycle forfeits any pending payout for that cycle."
								android:textColor="@color/colorTextSecondary"
								android:layout_weight="1"
								android:textSize="13.5sp"
								android:layout_marginStart="10dp"
								android:lineSpacingExtra="2dp" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/textview54"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:layout_marginBottom="8dp"
					android:text="RECENT ACTIVITY"
					android:textStyle="bold"
					android:textColor="@color/colorTextTertiary"
					android:textSize="10.5sp"
					android:layout_marginStart="4dp"
					android:letterSpacing="0.06" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview39"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<LinearLayout
						android:id="@+id/layout_group_history"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="18dp"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/linear85"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="12dp"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview22"
								android:layout_width="15dp"
								android:layout_height="15dp"
								android:src="@drawable/icon_access_time_outline"
								android:scaleType="centerInside"
								app:tint="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/textview55"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Payout completed on schedule"
								android:textSize="13sp"
								android:textColor="@color/colorTextSecondary"
								android:layout_weight="1"
								android:layout_marginStart="10dp" />
							<TextView
								android:id="@+id/textview56"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="3d ago"
								android:textColor="@color/colorTextTertiary"
								android:textSize="11.5sp" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear86"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="12dp"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview23"
								android:layout_width="15dp"
								android:layout_height="15dp"
								android:src="@drawable/icon_access_time_outline"
								android:scaleType="centerInside"
								app:tint="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/textview57"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="New member joined the group"
								android:textSize="13sp"
								android:textColor="@color/colorTextSecondary"
								android:layout_weight="1"
								android:layout_marginStart="10dp" />
							<TextView
								android:id="@+id/textview58"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="6d ago"
								android:textColor="@color/colorTextTertiary"
								android:textSize="11.5sp" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear87"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview24"
								android:layout_width="15dp"
								android:layout_height="15dp"
								android:src="@drawable/icon_access_time_outline"
								android:scaleType="centerInside"
								app:tint="@color/colorTextTertiary" />
							<TextView
								android:id="@+id/textview59"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="All contributions received for current cycle"
								android:textSize="13sp"
								android:textColor="@color/colorTextSecondary"
								android:layout_weight="1"
								android:layout_marginStart="10dp" />
							<TextView
								android:id="@+id/textview60"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="1w ago"
								android:textColor="@color/colorTextTertiary"
								android:textSize="11.5sp" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/textview61"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:layout_marginBottom="8dp"
					android:text="MESSAGE TO ADMIN (OPTIONAL)"
					android:textStyle="bold"
					android:textColor="@color/colorTextTertiary"
					android:textSize="10.5sp"
					android:layout_marginStart="4dp"
					android:letterSpacing="0.06" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview40"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<com.google.android.material.textfield.TextInputEditText
						android:id="@+id/et_message_to_admin"
						android:layout_width="match_parent"
						android:layout_height="100dp"
						android:padding="16dp"
						android:background="@android:color/transparent"
						android:textColor="@color/colorTextPrimary"
						android:hint="Introduce yourself, or share why you'd like to join this group..."
						android:gravity="top|start"
						android:textSize="13.5sp"
						android:inputType="textMultiLine|textCapSentences"
						android:maxLength="300" />
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/tv_message_char_count"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="0 / 300"
					android:textColor="@color/colorTextTertiary"
					android:gravity="end"
					android:textSize="11.5sp" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview41"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<LinearLayout
						android:id="@+id/linear88"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="16dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<com.google.android.material.checkbox.MaterialCheckBox
							android:id="@+id/cb_agree_to_rules"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textSize="12sp"
							app:buttonTint="@color/colorAccent" />
						<TextView
							android:id="@+id/textview62"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="I have read and agree to follow this group's rules and contribution schedule."
							android:textSize="13sp"
							android:textColor="@color/colorTextSecondary"
							android:layout_weight="1"
							android:layout_marginStart="10dp" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/textview63"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:layout_marginBottom="8dp"
					android:gravity="center_horizontal"
					android:text="Your request will be reviewed by the group admin. You'll be notified once a decision is made."
					android:textColor="@color/colorTextTertiary"
					android:textSize="11.5sp" />
			</LinearLayout>
		</androidx.core.widget.NestedScrollView>
		<LinearLayout
			android:id="@+id/linear89"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:background="@color/colorSurface"
			android:orientation="horizontal">
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_cancel_join_request"
				android:layout_width="0dp"
				android:layout_height="52dp"
				android:text="Cancel"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextSecondary"
				android:layout_weight="1"
				android:layout_marginEnd="8dp"
				android:textAllCaps="false"
				app:backgroundTint="@color/colorSurfaceRaised"
				app:cornerRadius="14dp"
				app:elevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_send_join_request"
				android:layout_width="0dp"
				android:layout_height="52dp"
				android:text="Send Join Request"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextOnAccent"
				android:layout_weight="2"
				android:layout_marginStart="8dp"
				android:textAllCaps="false"
				app:backgroundTint="@color/colorAccent"
				app:cornerRadius="14dp"
				app:elevation="0dp" />
		</LinearLayout>
	</LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
