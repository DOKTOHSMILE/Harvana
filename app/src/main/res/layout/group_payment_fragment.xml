<androidx.core.widget.NestedScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true"
	android:overScrollMode="never"
	android:background="@color/colorBackground"
	android:id="@+id/_main">
	<LinearLayout
		android:id="@+id/linear126"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="20dp"
		android:orientation="vertical">
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/card_group_wallet"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeWidth="1dp"
			app:strokeColor="@color/colorCardStroke">
			<LinearLayout
				android:id="@+id/linear3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:orientation="vertical">
				<TextView
					android:id="@+id/textview7"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="GROUP WALLET"
					android:textStyle="bold"
					android:textSize="11sp"
					android:letterSpacing="0.06" />
				<TextView
					android:id="@+id/tv_group_wallet_balance"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:text="0.0000 HARV"
					android:textSize="22sp"
					android:textStyle="bold" />
				<TextView
					android:id="@+id/tv_group_wallet_ngn"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="≈ ₦0.00"
					android:textSize="13sp" />
				<LinearLayout
					android:id="@+id/panel_per_slot_amount"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:orientation="vertical"
					android:visibility="gone">
					<com.google.android.material.divider.MaterialDivider
						android:id="@+id/view27"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginBottom="14dp"
	app:dividerColor="@color/colorDivider"/>
					<LinearLayout
						android:id="@+id/linear28"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear29"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/textview2"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="PER SLOT AMOUNT"
								android:textStyle="bold"
								android:textSize="11sp"
								android:letterSpacing="0.06" />
							<TextView
								android:id="@+id/tv_per_slot_amount"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:text="0 HARV"
								android:textSize="15sp"
								android:textStyle="bold" />
						</LinearLayout>
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btn_edit_slot_amount"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:paddingTop="8dp"
							android:paddingBottom="8dp"
							android:text="Edit Amount"
							android:textSize="12sp"
							android:textStyle="bold"
							android:paddingStart="14dp"
							android:paddingEnd="14dp"
							android:backgroundTint="@color/colorAccent"
	android:textAllCaps="false"/>
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview23"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeWidth="1dp"
			app:strokeColor="@color/colorCardStroke">
			<LinearLayout
				android:id="@+id/linear127"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear128"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/tv_my_payment_label"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="MY PAYMENT · SLOT 1"
						android:textStyle="bold"
						android:textSize="11sp"
						android:letterSpacing="0.06" />
					<TextView
						android:id="@+id/tv_my_payment_amount"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:text="0 HARV"
						android:textSize="22sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_my_payment_due"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:text="Due —"
						android:textSize="13sp" />
				</LinearLayout>
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview24"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="@color/colorAccent"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke"
					app:cardCornerRadius="30dp">
					<com.google.android.material.button.MaterialButton
						android:id="@+id/btn_pay_now"
						android:tag="payment_button"
						android:layout_width="match_parent"
						android:layout_height="35dp"
						android:paddingLeft="16dp"
						android:paddingRight="16dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="Pay Now"
						android:textStyle="bold"
						android:textSize="13sp"
						android:backgroundTint="@color/colorAccent"
	android:textAllCaps="false"/>
				</com.google.android.material.card.MaterialCardView>
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<LinearLayout
			android:id="@+id/panel_type_board"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:padding="16dp"
			android:background="@color/colorSurface"
			android:orientation="vertical"
			android:visibility="gone">
			<TextView
				android:id="@+id/tv_type_board_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Payments"
				android:textSize="15sp"
				android:textStyle="bold" />
			<TextView
				android:id="@+id/tv_type_board_subtitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text=""
				android:textSize="13sp" />
			<LinearLayout
				android:id="@+id/layout_type_board"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:orientation="vertical" />
			<TextView
				android:id="@+id/tv_type_board_legend"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:text=""
				android:textSize="11sp" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/panel_fixed_days"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:padding="16dp"
			android:background="@color/colorSurface"
			android:orientation="vertical"
			android:visibility="gone">
			<TextView
				android:id="@+id/textview8"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Daily custody calendar (31 days)"
				android:textSize="14sp"
				android:textStyle="bold" />
			<TextView
				android:id="@+id/tv_fixed_progress"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="8dp"
				android:text="0 / 31 days"
				android:textSize="12sp" />
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recycler_fixed_days"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:nestedScrollingEnabled="false"
				android:overScrollMode="never" />
			<TextView
				android:id="@+id/textview9"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:text="Admin holds funds. Month end: 30 days returned to member, 1 day admin fee."
				android:textSize="11sp" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear129"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:gravity="center_vertical"
			android:orientation="horizontal" android:minHeight="58dp">
			<TextView
				android:id="@+id/textview72"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="THIS ROUND"
				android:textStyle="bold"
				android:layout_weight="1"
				android:textSize="11sp"
				android:letterSpacing="0.06" />
			<TextView
				android:id="@+id/tv_round_paid_count"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="0 / 0 paid"
				android:textSize="12sp" />
		</LinearLayout>
		<com.google.android.material.progressindicator.LinearProgressIndicator
			android:id="@+id/progress_round_paid"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			app:trackThickness="8dp"
			app:trackCornerRadius="30dp"
			app:indicatorColor="@color/colorAccent"
			app:trackColor="@color/colorSurfaceAlt" />
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recycler_payments"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:nestedScrollingEnabled="false"
			android:overScrollMode="never" />
		<TextView
			android:id="@+id/tv_payments_empty"
				android:drawableTop="@drawable/illus_empty_activity"
				android:drawablePadding="12dp"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="24dp"
			android:gravity="center"
			android:text="No payment records for this round yet."
			android:textSize="13sp"
			android:visibility="gone" />
	</LinearLayout>
</androidx.core.widget.NestedScrollView>
