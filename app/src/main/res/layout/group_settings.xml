<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay"
		app:elevation="0dp"
		android:stateListAnimator="@null">
		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/appBarColor"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:background="@color/colorSurface"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<androidx.core.widget.NestedScrollView
			android:id="@+id/vscroll2"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:overScrollMode="never"
			android:fillViewport="true">
			<LinearLayout
				android:id="@+id/linear39"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="12dp"
				android:paddingBottom="24dp"
				android:orientation="vertical"
				android:paddingHorizontal="16dp">
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardHero"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="@color/colorAccentSoft"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp">
					<LinearLayout
						android:id="@+id/linear40"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="20dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/imageview16"
							android:layout_width="56dp"
							android:layout_height="56dp"
							android:padding="14dp"
							android:src="@drawable/ic_groups"
							android:scaleType="center"
							android:backgroundTint="@color/colorAccentSoft"
							app:tint="@color/colorAccent" android:duplicateParentState="true" />
						<LinearLayout
							android:id="@+id/linear41"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1"
							android:layout_marginStart="16dp">
							<TextView
								android:id="@+id/textview56"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Type"
								android:textSize="11.5sp" />
							<LinearLayout
								android:id="@+id/linear42"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<com.google.android.material.imageview.ShapeableImageView
									android:id="@+id/ivHeroTypeIcon"
									android:layout_width="16dp"
									android:layout_height="16dp"
									android:src="@drawable/ic_type_circle"
									android:scaleType="centerInside"
									app:tint="@color/colorTextPrimary"
									android:layout_marginEnd="6dp" />
								<TextView
									android:id="@+id/tvHeroTypeName"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Rotating Pool"
									android:textSize="18sp"
									android:textStyle="bold" />
							</LinearLayout>
							<TextView
								android:id="@+id/tvHeroFrequency"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="8dp"
								android:text="Daily"
								android:textSize="11sp"
								android:textStyle="bold"
								android:textColor="@color/colorTextPrimary"
								android:paddingHorizontal="8dp"
								android:paddingVertical="4dp"
								android:backgroundTint="@color/colorAccentSoft" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview11"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<LinearLayout
						android:id="@+id/linear43"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/rowVisibility"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="16dp"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview17"
								android:layout_width="38dp"
								android:layout_height="38dp"
								android:padding="9dp"
								android:src="@drawable/ic_shield"
								android:scaleType="center"
								android:backgroundTint="@color/colorInfoSoft"
								app:tint="@color/colorInfo" android:duplicateParentState="true" />
							<LinearLayout
								android:id="@+id/linear44"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_weight="1"
								android:layout_marginStart="14dp">
								<TextView
									android:id="@+id/textview57"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Privacy"
									android:textStyle="bold"
									android:textSize="14.5sp" />
								<TextView
									android:id="@+id/textview58"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Visibility for this group"
									android:textSize="11.5sp" />
							</LinearLayout>
							<com.google.android.material.card.MaterialCardView
								android:id="@+id/cardview12"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								app:cardBackgroundColor="@color/colorSurfaceAlt"
								app:cardCornerRadius="8dp"
								app:cardElevation="0dp"
								app:strokeWidth="1dp"
								app:strokeColor="@color/colorCardStroke">
								<com.harvana.app.ui.MaterialSpinner
									android:id="@+id/spinVisibility"
									android:layout_width="120dp"
									android:layout_height="40dp"
									android:background="@android:color/transparent"
									android:spinnerMode="dropdown"
									android:paddingHorizontal="12dp" />
							</com.google.android.material.card.MaterialCardView>
						</LinearLayout>
						<com.google.android.material.divider.MaterialDivider
							android:id="@+id/view45"
							android:layout_width="match_parent"
							android:layout_height="1dp"
							android:layout_marginStart="68dp"
	app:dividerColor="@color/colorDivider"/>
						<LinearLayout
							android:id="@+id/linear46"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="16dp"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview18"
								android:layout_width="38dp"
								android:layout_height="38dp"
								android:padding="9dp"
								android:src="@drawable/icon_playlist_add_check_round"
								android:scaleType="centerInside"
								android:backgroundTint="@color/colorAccentSoft"
								app:tint="@color/colorAccent" />
							<LinearLayout
								android:id="@+id/linear47"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_weight="1"
								android:layout_marginStart="14dp">
								<TextView
									android:id="@+id/textview59"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Require approval to join"
									android:textStyle="bold"
									android:textSize="14.5sp" />
								<TextView
									android:id="@+id/textview60"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="New members must be approved by an admin."
									android:textSize="11.5sp" />
							</LinearLayout>
							<com.google.android.material.switchmaterial.SwitchMaterial
								android:id="@+id/switchApproval"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:textSize="12sp" />
						</LinearLayout>
						<com.google.android.material.divider.MaterialDivider
							android:id="@+id/view48"
							android:layout_width="match_parent"
							android:layout_height="1dp"
							android:layout_marginStart="68dp"
	app:dividerColor="@color/colorDivider"/>
						<LinearLayout
							android:id="@+id/linear49"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="16dp"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview19"
								android:layout_width="38dp"
								android:layout_height="38dp"
								android:padding="9dp"
								android:src="@drawable/ic_pf_person_add"
								android:scaleType="centerInside"
								android:backgroundTint="@color/colorAccentSoft"
								app:tint="@color/colorAccent" />
							<LinearLayout
								android:id="@+id/linear50"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_weight="1"
								android:layout_marginStart="14dp">
								<TextView
									android:id="@+id/textview61"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Members can invite"
									android:textStyle="bold"
									android:textSize="14.5sp" />
								<TextView
									android:id="@+id/textview62"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Allow members to invite others to this group."
									android:textSize="11.5sp" />
							</LinearLayout>
							<com.google.android.material.switchmaterial.SwitchMaterial
								android:id="@+id/switchInvite"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:textSize="12sp" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview13"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<LinearLayout
						android:id="@+id/linear51"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="16dp"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/linear52"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="12dp"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview20"
								android:layout_width="38dp"
								android:layout_height="38dp"
								android:padding="9dp"
								android:src="@drawable/ic_description"
								android:scaleType="centerInside"
								android:backgroundTint="@color/colorInfoSoft"
								app:tint="@color/colorInfo" android:duplicateParentState="true" />
							<LinearLayout
								android:id="@+id/linear53"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_weight="1"
								android:layout_marginStart="14dp">
								<TextView
									android:id="@+id/textview63"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="About"
									android:textStyle="bold"
									android:textSize="14.5sp" />
								<TextView
									android:id="@+id/textview64"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Description"
									android:textSize="11.5sp" />
							</LinearLayout>
						</LinearLayout>
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/cardview14"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							app:cardBackgroundColor="@color/colorSurfaceAlt"
							app:cardCornerRadius="12dp"
							app:cardElevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke">
							<com.google.android.material.textfield.TextInputEditText
								android:id="@+id/etDescription"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="16dp"
								android:background="@android:color/transparent"
								android:textSize="14sp"
								android:hint="Group description..."
								android:gravity="top|start"
								android:inputType="textMultiLine|textCapSentences"
								android:minHeight="80dp"
								android:maxLength="500" />
						</com.google.android.material.card.MaterialCardView>
						<TextView
							android:id="@+id/tvDescriptionCount"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="0/500"
							android:textSize="11sp"
							android:gravity="end" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview15"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<LinearLayout
						android:id="@+id/linear54"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/linear55"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="16dp"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/imageview21"
								android:layout_width="38dp"
								android:layout_height="38dp"
								android:padding="9dp"
								android:src="@drawable/ic_tx_contribution"
								android:scaleType="centerInside"
								android:backgroundTint="@color/colorAccentSoft"
								app:tint="@color/colorAccent" />
							<LinearLayout
								android:id="@+id/linear56"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_weight="1"
								android:layout_marginStart="14dp">
								<TextView
									android:id="@+id/textview65"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Contribution (HARV)"
									android:textStyle="bold"
									android:textSize="14.5sp" />
								<TextView
									android:id="@+id/textview66"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Amount required per member"
									android:textSize="11.5sp" />
							</LinearLayout>
							<com.google.android.material.card.MaterialCardView
								android:id="@+id/cardview16"
								android:layout_width="100dp"
								android:layout_height="wrap_content"
								app:cardBackgroundColor="@color/colorSurfaceAlt"
								app:cardCornerRadius="8dp"
								app:cardElevation="0dp"
								app:strokeWidth="1dp"
								app:strokeColor="@color/colorCardStroke">
								<com.google.android.material.textfield.TextInputEditText
									android:id="@+id/etContribution"
									android:layout_width="match_parent"
									android:layout_height="44dp"
									android:background="@android:color/transparent"
									android:gravity="center_vertical"
									android:inputType="numberDecimal"
									android:textSize="14.5sp"
									android:paddingHorizontal="12dp" />
							</com.google.android.material.card.MaterialCardView>
						</LinearLayout>
						<com.google.android.material.divider.MaterialDivider
							android:id="@+id/view57"
							android:layout_width="match_parent"
							android:layout_height="1dp"
							android:layout_marginStart="68dp"
	app:dividerColor="@color/colorDivider"/>
						<LinearLayout
							android:id="@+id/panel_rotating"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:visibility="gone">
							<LinearLayout
								android:id="@+id/rowManageRotating"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="16dp"
								android:background="?attr/selectableItemBackground"
								android:gravity="center_vertical"
								android:orientation="horizontal"
								android:focusable="true">
								<com.google.android.material.imageview.ShapeableImageView
									android:id="@+id/imageview22"
									android:layout_width="38dp"
									android:layout_height="38dp"
									android:padding="9dp"
									android:src="@drawable/ic_type_circle"
									android:scaleType="centerInside"
									android:backgroundTint="@color/colorAccentSoft"
									app:tint="@color/colorAccent" />
								<LinearLayout
									android:id="@+id/linear58"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:orientation="vertical"
									android:layout_weight="1"
									android:layout_marginStart="14dp">
									<TextView
										android:id="@+id/tvTypeSettingsTitle"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:text="Rotating Pool"
										android:textStyle="bold"
										android:textSize="14.5sp" />
									<TextView
										android:id="@+id/tvTypeSettingsSubtitle"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:text="Slots — · Round —"
										android:textSize="11.5sp" />
								</LinearLayout>
								<com.google.android.material.imageview.ShapeableImageView
									android:id="@+id/imageview23"
									android:layout_width="18dp"
									android:layout_height="18dp"
									android:src="@drawable/ic_arrow_right"
									android:scaleType="center"
									app:tint="@color/colorTextTertiary" android:duplicateParentState="true" />
							</LinearLayout>
							<com.google.android.material.divider.MaterialDivider
								android:id="@+id/view59"
								android:layout_width="match_parent"
								android:layout_height="1dp"
								android:layout_marginStart="68dp"
	app:dividerColor="@color/colorDivider"/>
							<LinearLayout
								android:id="@+id/linear60"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="16dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<com.google.android.material.imageview.ShapeableImageView
									android:id="@+id/imageview24"
									android:layout_width="38dp"
									android:layout_height="38dp"
									android:padding="9dp"
									android:src="@drawable/icon_access_time_outline"
									android:scaleType="centerInside"
									android:backgroundTint="@color/colorAccentSoft"
									app:tint="@color/colorAccent" />
								<LinearLayout
									android:id="@+id/linear61"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:orientation="vertical"
									android:layout_weight="1"
									android:layout_marginStart="14dp">
									<TextView
										android:id="@+id/textview67"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:text="Grace period (days)"
										android:textStyle="bold"
										android:textSize="14.5sp" />
									<TextView
										android:id="@+id/textview68"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:text="Time allowed for payment"
										android:textSize="11.5sp" />
								</LinearLayout>
								<com.google.android.material.card.MaterialCardView
									android:id="@+id/cardview17"
									android:layout_width="100dp"
									android:layout_height="wrap_content"
									app:cardBackgroundColor="@color/colorSurfaceAlt"
									app:cardCornerRadius="8dp"
									app:cardElevation="0dp"
									app:strokeWidth="1dp"
									app:strokeColor="@color/colorCardStroke">
									<com.google.android.material.textfield.TextInputEditText
										android:id="@+id/etGracePeriod"
										android:layout_width="match_parent"
										android:layout_height="44dp"
										android:background="@android:color/transparent"
										android:gravity="center_vertical"
										android:textSize="14.5sp"
										android:inputType="number"
										android:paddingHorizontal="12dp" />
								</com.google.android.material.card.MaterialCardView>
							</LinearLayout>
							<com.google.android.material.divider.MaterialDivider
								android:id="@+id/view62"
								android:layout_width="match_parent"
								android:layout_height="1dp"
								android:layout_marginStart="68dp"
	app:dividerColor="@color/colorDivider"/>
							<LinearLayout
								android:id="@+id/linear63"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="16dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<com.google.android.material.imageview.ShapeableImageView
									android:id="@+id/imageview25"
									android:layout_width="38dp"
									android:layout_height="38dp"
									android:padding="9dp"
									android:src="@drawable/ic_tx_fee"
									android:scaleType="centerInside"
									android:backgroundTint="@color/colorAccentSoft"
									app:tint="@color/colorAccent" />
								<LinearLayout
									android:id="@+id/linear64"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:orientation="vertical"
									android:layout_weight="1"
									android:layout_marginStart="14dp">
									<TextView
										android:id="@+id/textview69"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:text="Commission %"
										android:textStyle="bold"
										android:textSize="14.5sp" />
									<TextView
										android:id="@+id/textview70"
										android:layout_width="wrap_content"
