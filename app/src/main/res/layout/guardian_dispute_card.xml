<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview28"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		android:layout_marginHorizontal="4dp"
		android:layout_marginVertical="6dp"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorCardStroke">
		<LinearLayout
			android:id="@+id/linear35"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:orientation="vertical">
			<TextView
				android:id="@+id/tv_card_order_id"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textColor="@color/colorTextTertiary"
				android:textSize="12sp"
				android:fontFamily="monospace"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_card_amount"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:textSize="18sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimary"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_card_parties"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp"
				android:focusable="false" />
			<TextView
				android:id="@+id/textview48"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:text="REASON SUBMITTED"
				android:textStyle="bold"
				android:textColor="@color/colorTextTertiary"
				android:textSize="11sp"
				android:letterSpacing="0.06"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_card_reason"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:textColor="@color/colorTextPrimary"
				android:textSize="14sp"
				android:lineSpacingExtra="2dp"
				android:autoLink="web"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_card_sig_counts"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:textSize="12sp"
				android:textColor="@color/colorTextTertiary"
				android:focusable="false" />
			<LinearLayout
				android:id="@+id/linear36"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:orientation="horizontal">
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_card_release_buyer"
					android:layout_width="0dp"
					android:layout_height="44dp"
					android:text="Release to Buyer"
					android:textStyle="bold"
					android:textColor="@color/colorTextOnAccent"
					android:layout_weight="1"
					android:textSize="13sp"
					android:layout_marginEnd="6dp"
					app:backgroundTint="@color/colorAccent"
					app:cornerRadius="12dp"
					app:elevation="0dp"
					android:textAllCaps="false"
					android:focusable="false" />
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_card_return_seller"
					android:layout_width="0dp"
					android:layout_height="44dp"
					android:text="Return to Seller"
					android:textStyle="bold"
					android:textColor="@color/colorTextOnAccent"
					android:layout_weight="1"
					android:textSize="13sp"
					android:layout_marginStart="6dp"
					app:backgroundTint="@color/colorError"
					app:cornerRadius="12dp"
					app:elevation="0dp"
					android:textAllCaps="false"
					android:focusable="false" />
			</LinearLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
