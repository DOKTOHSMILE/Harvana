<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorPrimary"
	android:orientation="vertical">

	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:fillViewport="true"
		android:overScrollMode="never">

		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingTop="12dp"
			android:paddingEnd="16dp"
			android:paddingBottom="28dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:letterSpacing="0.04"
					android:text="HARVANA"
					android:textColor="@color/colorTextPrimary"
					android:textSize="28sp"
					android:textStyle="bold" />

				<ImageView
					android:id="@+id/btn_home_bell"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:background="?attr/selectableItemBackgroundBorderless"
					android:contentDescription="Notifications"
					android:padding="8dp"
					android:src="@drawable/icon_notifications_outline"
					app:tint="@color/colorTextPrimary" />

				<ImageView
					android:id="@+id/btn_home_more"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:layout_marginStart="2dp"
					android:background="?attr/selectableItemBackgroundBorderless"
					android:contentDescription="Menu"
					android:padding="8dp"
					android:src="@drawable/icon_more_vert_round"
					app:tint="@color/colorTextPrimary" />

				<com.google.android.material.imageview.ShapeableImageView
					android:id="@+id/iv_home_avatar"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:layout_marginStart="6dp"
					android:background="@color/colorSuccess"
					android:contentDescription="Profile"
					android:padding="8dp"
					android:scaleType="centerCrop"
					android:src="@drawable/icon_person_outline_outline_line"
					app:shapeAppearanceOverlay="@style/ShapeAppearance.Harvana.Circle"
					app:strokeColor="@color/colorSuccess"
					app:strokeWidth="0dp"
					app:tint="@color/colorTextOnAccent" />
			</LinearLayout>

			<TextView
				android:id="@+id/textview3"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:text="Welcome back,"
				android:textColor="@color/colorTextSecondary"
				android:textSize="16sp" />

			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_portfolio"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="18dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingTop="14dp"
					android:paddingBottom="0dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingStart="16dp"
						android:paddingEnd="12dp">

						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:letterSpacing="0.08"
							android:text="TOTAL PORTFOLIO"
							android:textColor="@color/colorTextSecondary"
							android:textSize="11sp" />

						<ImageView
							android:id="@+id/imageview61"
							android:layout_width="22dp"
							android:layout_height="22dp"
							android:contentDescription="Hide balances"
							android:src="@drawable/icon_visibility_twotone_line"
							app:tint="@color/colorSuccess" />

						<TextView
							android:id="@+id/tv_home_hide"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:paddingStart="4dp"
							android:paddingEnd="4dp"
							android:text="Hide"
							android:textColor="@color/colorSuccess"
							android:textSize="13sp"
							android:textStyle="bold" />
					</LinearLayout>

					<TextView
						android:id="@+id/tv_harv_balance"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginStart="16dp"
						android:layout_marginTop="6dp"
						android:layout_marginEnd="16dp"
						android:text="—"
						android:textColor="@color/colorTextPrimary"
						android:textSize="34sp"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/tv_home_change"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginStart="16dp"
						android:layout_marginTop="2dp"
						android:layout_marginEnd="16dp"
						android:textColor="@color/colorSuccess"
						android:textSize="13sp"
						android:visibility="gone" />

					<View
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="14dp"
						android:background="@color/colorCardStroke" />

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="@color/colorSurfaceAlt"
						android:orientation="horizontal"
						android:paddingStart="6dp"
						android:paddingTop="12dp"
						android:paddingEnd="6dp"
						android:paddingBottom="12dp">

						<LinearLayout
							android:id="@+id/home_coin_harv"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:background="?attr/selectableItemBackground"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingStart="4dp"
							android:paddingEnd="2dp">

							<ImageView
								android:layout_width="26dp"
								android:layout_height="26dp"
								android:contentDescription="HARV"
								android:src="@drawable/ic_coin_harv" />

							<LinearLayout
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_marginStart="6dp"
								android:layout_weight="1"
								android:orientation="vertical">

								<TextView
									android:id="@+id/tv_coin_harv"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="HARV —"
									android:textColor="@color/colorTextPrimary"
									android:textSize="12sp"
									android:textStyle="bold" />

								<TextView
									android:id="@+id/tv_coin_harv_fiat"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="—"
									android:textColor="@color/colorTextSecondary"
									android:textSize="11sp" />
							</LinearLayout>
						</LinearLayout>

						<LinearLayout
							android:id="@+id/home_coin_btc"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:background="?attr/selectableItemBackground"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingStart="4dp"
							android:paddingEnd="2dp">

							<ImageView
								android:layout_width="26dp"
								android:layout_height="26dp"
								android:contentDescription="BTC"
								android:src="@drawable/ic_coin_btc" />

							<LinearLayout
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_marginStart="6dp"
								android:layout_weight="1"
								android:orientation="vertical">

								<TextView
									android:id="@+id/tv_coin_btc"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="BTC —"
									android:textColor="@color/colorTextPrimary"
									android:textSize="12sp"
									android:textStyle="bold" />

								<TextView
									android:id="@+id/tv_coin_btc_fiat"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="—"
									android:textColor="@color/colorTextSecondary"
									android:textSize="11sp" />
							</LinearLayout>
						</LinearLayout>

						<LinearLayout
							android:id="@+id/home_coin_eth"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:background="?attr/selectableItemBackground"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingStart="4dp"
							android:paddingEnd="2dp">

							<ImageView
								android:layout_width="26dp"
								android:layout_height="26dp"
								android:contentDescription="ETH"
								android:src="@drawable/ic_coin_eth" />

							<LinearLayout
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_marginStart="6dp"
								android:layout_weight="1"
								android:orientation="vertical">

								<TextView
									android:id="@+id/tv_coin_eth"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="ETH —"
									android:textColor="@color/colorTextPrimary"
									android:textSize="12sp"
									android:textStyle="bold" />

								<TextView
									android:id="@+id/tv_coin_eth_fiat"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="—"
									android:textColor="@color/colorTextSecondary"
									android:textSize="11sp" />
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:orientation="horizontal">

				<LinearLayout
					android:id="@+id/btn_home_add"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_weight="1.2"
					android:background="@drawable/bg_home_action"
					android:clickable="true"
					android:contentDescription="Add Funds"
					android:focusable="true"
					android:gravity="center"
					android:orientation="horizontal"
					android:paddingStart="6dp"
					android:paddingEnd="6dp">

					<ImageView
						android:layout_width="15dp"
						android:layout_height="15dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_action_buy_line"
						app:tint="@color/colorTextOnAccent" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="4dp"
						android:ellipsize="end"
						android:maxLines="1"
						android:text="Add Funds"
						android:textColor="@color/colorTextOnAccent"
						android:textSize="12sp"
						android:textStyle="bold" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/btn_home_send"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_marginStart="8dp"
					android:layout_weight="1"
					android:background="@drawable/bg_home_action"
					android:clickable="true"
					android:contentDescription="Send"
					android:focusable="true"
					android:gravity="center"
					android:orientation="horizontal"
					android:paddingStart="6dp"
					android:paddingEnd="6dp">

					<ImageView
						android:layout_width="15dp"
						android:layout_height="15dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_action_send_line"
						app:tint="@color/colorTextOnAccent" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="4dp"
						android:ellipsize="end"
						android:maxLines="1"
						android:text="Send"
						android:textColor="@color/colorTextOnAccent"
						android:textSize="12sp"
						android:textStyle="bold" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/btn_home_transfer"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_marginStart="8dp"
					android:layout_weight="1.05"
					android:background="@drawable/bg_home_action"
					android:clickable="true"
					android:contentDescription="Transfer"
					android:focusable="true"
					android:gravity="center"
					android:orientation="horizontal"
					android:paddingStart="6dp"
					android:paddingEnd="6dp">

					<ImageView
						android:layout_width="15dp"
						android:layout_height="15dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_action_swap_line"
						app:tint="@color/colorTextOnAccent" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="3dp"
						android:ellipsize="end"
						android:maxLines="1"
						android:text="Transfer"
						android:textColor="@color/colorTextOnAccent"
						android:textSize="12sp"
						android:textStyle="bold" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/btn_home_receive"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_marginStart="8dp"
					android:layout_weight="1"
					android:background="@drawable/bg_home_action"
					android:clickable="true"
					android:contentDescription="Receive"
					android:focusable="true"
					android:gravity="center"
					android:orientation="horizontal"
					android:paddingStart="6dp"
					android:paddingEnd="6dp">

					<ImageView
						android:layout_width="15dp"
						android:layout_height="15dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_action_receive_line"
						app:tint="@color/colorTextOnAccent" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="3dp"
						android:ellipsize="end"
						android:maxLines="1"
						android:text="Receive"
						android:textColor="@color/colorTextOnAccent"
						android:textSize="12sp"
						android:textStyle="bold" />
				</LinearLayout>
			</LinearLayout>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:gravity="center"
				android:letterSpacing="0.12"
				android:text="QUICK ACTIONS"
				android:textColor="@color/colorTextSecondary"
				android:textSize="12sp" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:orientation="horizontal">

				<com.google.android.material.card.MaterialCardView
					android:id="@+id/qa_savings"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginEnd="6dp"
					android:layout_weight="1"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeColor="@color/colorCardStroke"
					app:strokeWidth="1dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:minHeight="76dp"
						android:orientation="horizontal"
						android:padding="12dp">

						<ImageView
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:background="@drawable/bg_home_icon_well"
							android:padding="9dp"
							android:src="@drawable/ic_type_savings_line"
							app:tint="@color/colorSuccess" />

						<LinearLayout
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginStart="10dp"
							android:layout_weight="1"
							android:orientation="vertical">

							<TextView
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="My Savings"
								android:textColor="@color/colorTextPrimary"
								android:textSize="14sp"
								android:textStyle="bold" />

							<TextView
								android:id="@+id/text_sub_saved"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="Circles you save in"
								android:textColor="@color/colorTextSecondary"
								android:textSize="11sp" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.card.MaterialCardView
					android:id="@+id/qa_groups"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="6dp"
					android:layout_weight="1"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeColor="@color/colorCardStroke"
					app:strokeWidth="1dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:minHeight="76dp"
						android:orientation="horizontal"
						android:padding="12dp">

						<ImageView
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:background="@drawable/bg_home_icon_well"
							android:padding="9dp"
							android:src="@drawable/ic_groups_line"
							app:tint="@color/colorSuccess" />

						<LinearLayout
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginStart="10dp"
							android:layout_weight="1"
							android:orientation="vertical">

							<TextView
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Groups"
								android:textColor="@color/colorTextPrimary"
								android:textSize="14sp"
								android:textStyle="bold" />

							<TextView
								android:id="@+id/text_sub_groups"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="Your circles"
								android:textColor="@color/colorTextSecondary"
								android:textSize="11sp" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:orientation="horizontal">

				<com.google.android.material.card.MaterialCardView
					android:id="@+id/qa_stake"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginEnd="6dp"
					android:layout_weight="1"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeColor="@color/colorCardStroke"
					app:strokeWidth="1dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:minHeight="76dp"
						android:orientation="horizontal"
						android:padding="12dp">

						<ImageView
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:background="@drawable/bg_home_icon_well"
							android:padding="9dp"
							android:src="@drawable/ic_tx_stake_line"
							app:tint="@color/colorSuccess" />

						<LinearLayout
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginStart="10dp"
							android:layout_weight="1"
							android:orientation="vertical">

							<TextView
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Stake HARV"
								android:textColor="@color/colorTextPrimary"
								android:textSize="14sp"
								android:textStyle="bold" />

							<TextView
								android:id="@+id/tv_stake_sub"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="Rewards the network"
								android:textColor="@color/colorTextSecondary"
								android:textSize="11sp" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.card.MaterialCardView
					android:id="@+id/qa_swap"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="6dp"
					android:layout_weight="1"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeColor="@color/colorCardStroke"
					app:strokeWidth="1dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:minHeight="76dp"
						android:orientation="horizontal"
						android:padding="12dp">

						<ImageView
							android:layout_width="40dp"
							android:layout_height="40dp"
							android:background="@drawable/bg_home_icon_well"
							android:padding="9dp"
							android:src="@drawable/ic_action_swap_line"
							app:tint="@color/colorSuccess" />

						<LinearLayout
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginStart="10dp"
							android:layout_weight="1"
							android:orientation="vertical">

							<TextView
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Swap Assets"
								android:textColor="@color/colorTextPrimary"
								android:textSize="14sp"
								android:textStyle="bold" />

							<TextView
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="HARV and stables"
								android:textColor="@color/colorTextSecondary"
								android:textSize="11sp" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
			</LinearLayout>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:letterSpacing="0.08"
				android:text="MY SAVINGS"
				android:textColor="@color/colorTextSecondary"
				android:textSize="12sp" />

			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingTop="12dp"
					android:paddingBottom="8dp">

					<TextView
						android:id="@+id/text_val_saved"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingStart="14dp"
						android:paddingEnd="14dp"
						android:text="—"
						android:textColor="@color/colorTextPrimary"
						android:textSize="16sp"
						android:textStyle="bold" />

					<LinearLayout
						android:id="@+id/home_savings_rows"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:orientation="vertical" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="22dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:letterSpacing="0.08"
					android:text="RECENT ACTIVITY"
					android:textColor="@color/colorTextSecondary"
					android:textSize="12sp" />

				<TextView
					android:id="@+id/btn_home_activity"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="4dp"
					android:text="View all"
					android:textColor="@color/colorSuccess"
					android:textSize="13sp"
					android:textStyle="bold" />
			</LinearLayout>

			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">

				<LinearLayout
					android:id="@+id/home_recent_tx"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingTop="4dp"
					android:paddingBottom="4dp" />
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
