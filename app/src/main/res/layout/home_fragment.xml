<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorPrimary"
	android:orientation="vertical">

	<!-- Pinned Top Toolbar (Stays fixed at the top while content scrolls) -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:background="@color/colorPrimary"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="16dp"
		android:paddingEnd="16dp">

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:fontFamily="sans-serif-black"
				android:letterSpacing="0.06"
				android:text="HARVANA"
				android:textColor="@color/colorTextPrimary"
				android:textSize="22sp"
				android:textStyle="bold" />

			<View
				android:layout_width="6dp"
				android:layout_height="6dp"
				android:layout_marginStart="6dp"
				android:layout_marginBottom="5dp"
				android:background="@drawable/bg_home_action" />
		</LinearLayout>

		<ImageView
			android:id="@+id/btn_home_scan"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="Scan"
			android:padding="9dp"
			android:src="@drawable/icon_qr_code_scanner_twotone"
			app:tint="@color/colorTextPrimary" />

		<ImageView
			android:id="@+id/btn_home_bell"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="Notifications"
			android:padding="9dp"
			android:src="@drawable/icon_notifications_outline"
			app:tint="@color/colorTextPrimary" />

		<ImageView
			android:id="@+id/btn_home_more"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:layout_marginStart="2dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="Menu"
			android:padding="9dp"
			android:src="@drawable/icon_more_vert_round"
			app:tint="@color/colorTextPrimary" />

		<com.google.android.material.imageview.ShapeableImageView
			android:id="@+id/iv_home_avatar"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:layout_marginStart="8dp"
			android:background="@color/colorSuccess"
			android:contentDescription="Profile"
			android:padding="7dp"
			android:scaleType="centerCrop"
			android:src="@drawable/icon_person_outline_outline_line"
			app:shapeAppearanceOverlay="@style/ShapeAppearance.Harvana.Circle"
			app:strokeColor="@color/colorCardStroke"
			app:strokeWidth="1dp"
			app:tint="@color/colorTextOnAccent" />
	</LinearLayout>

	<!-- Subtle Toolbar Bottom Hairline -->
	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@color/colorCardStroke" />

	<!-- Scrollable Dashboard Content -->
	<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
		android:id="@+id/home_refresh"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:fillViewport="true"
		android:overScrollMode="never">

		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingTop="8dp"
			android:paddingEnd="16dp"
			android:paddingBottom="36dp">

			<!-- Dynamic Date & Welcome Header -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">

				<TextView
					android:id="@+id/textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:fontFamily="sans-serif-medium"
					android:letterSpacing="0.06"
					android:textAllCaps="true"
					android:textColor="@color/colorTextTertiary"
					android:textSize="11sp" />

				<TextView
					android:id="@+id/textview3"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:fontFamily="sans-serif-medium"
					android:text="Welcome back,"
					android:textColor="@color/colorTextPrimary"
					android:textSize="19sp"
					android:textStyle="bold" />
			</LinearLayout>

			<!-- Total Portfolio Hero Card -->
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_portfolio"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="22dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingTop="18dp"
					android:paddingBottom="0dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingStart="18dp"
						android:paddingEnd="14dp">

						<LinearLayout
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:orientation="vertical">

							<TextView
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:fontFamily="sans-serif-medium"
								android:letterSpacing="0.1"
								android:text="TOTAL PORTFOLIO"
								android:textColor="@color/colorTextSecondary"
								android:textSize="11sp"
								android:textStyle="bold" />

							<TextView
								android:id="@+id/tv_local_currency_eqv"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="1dp"
								android:text="Total balance · all coins"
								android:textColor="@color/colorTextTertiary"
								android:textSize="11sp" />
						</LinearLayout>

						<LinearLayout
							android:layout_width="wrap_content"
							android:layout_height="30dp"
							android:background="@drawable/bg_home_quiet"
							android:gravity="center_vertical"
							android:orientation="horizontal"
							android:paddingStart="10dp"
							android:paddingEnd="10dp">

							<ImageView
								android:id="@+id/imageview61"
								android:layout_width="16dp"
								android:layout_height="16dp"
								android:contentDescription="Hide balances"
								android:src="@drawable/icon_visibility_twotone_line"
								app:tint="@color/colorAccent" />

							<TextView
								android:id="@+id/tv_home_hide"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginStart="5dp"
								android:text="Hide"
								android:textColor="@color/colorAccent"
								android:textSize="12sp"
								android:textStyle="bold" />
						</LinearLayout>
					</LinearLayout>

					<!-- Main Balance Figure -->
					<TextView
						android:id="@+id/tv_harv_balance"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginStart="18dp"
						android:layout_marginTop="10dp"
						android:layout_marginEnd="18dp"
						android:ellipsize="end"
						android:fontFamily="sans-serif-black"
						android:maxLines="1"
						android:text="—"
						android:textColor="@color/colorTextPrimary"
						android:textSize="34sp"
						android:textStyle="bold"
						app:autoSizeMaxTextSize="34sp"
						app:autoSizeMinTextSize="22sp"
						app:autoSizeStepGranularity="1sp"
						app:autoSizeTextType="uniform" />

					<TextView
						android:id="@+id/tv_home_change"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="18dp"
						android:layout_marginTop="4dp"
						android:layout_marginEnd="18dp"
						android:fontFamily="sans-serif-medium"
						android:textColor="@color/colorSuccess"
						android:textSize="12sp"
						android:textStyle="bold"
						android:visibility="gone" />

					<View
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="16dp"
						android:background="@color/colorCardStroke" />

					<!-- 3-Coin Ticker Strip -->
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="@color/colorSurfaceAlt"
						android:baselineAligned="false"
						android:minHeight="72dp"
						android:orientation="horizontal"
						android:paddingStart="4dp"
						android:paddingEnd="4dp">

						<!-- HARV -->
						<LinearLayout
							android:id="@+id/home_coin_harv"
							android:layout_width="0dp"
							android:layout_height="match_parent"
							android:layout_weight="1"
							android:clickable="true"
							android:focusable="true"
							android:foreground="?attr/selectableItemBackground"
							android:gravity="center_vertical"
							android:minHeight="72dp"
							android:orientation="horizontal"
							android:paddingStart="8dp"
							android:paddingTop="12dp"
							android:paddingEnd="6dp"
							android:paddingBottom="12dp">

							<ImageView
								android:layout_width="26dp"
								android:layout_height="26dp"
								android:clickable="false"
								android:contentDescription="HARV"
								android:focusable="false"
								android:src="@drawable/ic_coin_harv" />

							<LinearLayout
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_marginStart="7dp"
								android:layout_weight="1"
								android:clickable="false"
								android:focusable="false"
								android:orientation="vertical">

								<TextView
									android:id="@+id/tv_coin_harv"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="HARV —"
									android:textColor="@color/colorTextPrimary"
									android:textSize="12sp"
									android:textStyle="bold" />

								<TextView
									android:id="@+id/tv_coin_harv_fiat"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginTop="1dp"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="—"
									android:textColor="@color/colorTextSecondary"
									android:textSize="11sp" />
							</LinearLayout>
						</LinearLayout>

						<View
							android:layout_width="1dp"
							android:layout_height="match_parent"
							android:layout_marginTop="16dp"
							android:layout_marginBottom="16dp"
							android:background="@color/colorCardStroke" />

						<!-- BTC -->
						<LinearLayout
							android:id="@+id/home_coin_btc"
							android:layout_width="0dp"
							android:layout_height="match_parent"
							android:layout_weight="1"
							android:clickable="true"
							android:focusable="true"
							android:foreground="?attr/selectableItemBackground"
							android:gravity="center_vertical"
							android:minHeight="72dp"
							android:orientation="horizontal"
							android:paddingStart="8dp"
							android:paddingTop="12dp"
							android:paddingEnd="6dp"
							android:paddingBottom="12dp">

							<ImageView
								android:layout_width="26dp"
								android:layout_height="26dp"
								android:clickable="false"
								android:contentDescription="BTC"
								android:focusable="false"
								android:src="@drawable/ic_coin_btc" />

							<LinearLayout
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_marginStart="7dp"
								android:layout_weight="1"
								android:clickable="false"
								android:focusable="false"
								android:orientation="vertical">

								<TextView
									android:id="@+id/tv_coin_btc"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="BTC —"
									android:textColor="@color/colorTextPrimary"
									android:textSize="12sp"
									android:textStyle="bold" />

								<TextView
									android:id="@+id/tv_coin_btc_fiat"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginTop="1dp"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="—"
									android:textColor="@color/colorTextSecondary"
									android:textSize="11sp" />
							</LinearLayout>
						</LinearLayout>

						<View
							android:layout_width="1dp"
							android:layout_height="match_parent"
							android:layout_marginTop="16dp"
							android:layout_marginBottom="16dp"
							android:background="@color/colorCardStroke" />

						<!-- ETH -->
						<LinearLayout
							android:id="@+id/home_coin_eth"
							android:layout_width="0dp"
							android:layout_height="match_parent"
							android:layout_weight="1"
							android:clickable="true"
							android:focusable="true"
							android:foreground="?attr/selectableItemBackground"
							android:gravity="center_vertical"
							android:minHeight="72dp"
							android:orientation="horizontal"
							android:paddingStart="8dp"
							android:paddingTop="12dp"
							android:paddingEnd="6dp"
							android:paddingBottom="12dp">

							<ImageView
								android:layout_width="26dp"
								android:layout_height="26dp"
								android:clickable="false"
								android:contentDescription="ETH"
								android:focusable="false"
								android:src="@drawable/ic_coin_eth" />

							<LinearLayout
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_marginStart="7dp"
								android:layout_weight="1"
								android:clickable="false"
								android:focusable="false"
								android:orientation="vertical">

								<TextView
									android:id="@+id/tv_coin_eth"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="ETH —"
									android:textColor="@color/colorTextPrimary"
									android:textSize="12sp"
									android:textStyle="bold" />

								<TextView
									android:id="@+id/tv_coin_eth_fiat"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginTop="1dp"
									android:ellipsize="end"
									android:maxLines="1"
									android:text="—"
									android:textColor="@color/colorTextSecondary"
									android:textSize="11sp" />
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<!-- Primary Money Action Bar -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:orientation="horizontal">

				<LinearLayout
					android:id="@+id/btn_home_add"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_weight="1.2"
					android:background="@drawable/bg_home_action"
					android:clickable="true"
					android:contentDescription="Add Funds"
					android:focusable="true"
					android:gravity="center"
					android:orientation="horizontal"
					android:paddingStart="8dp"
					android:paddingEnd="8dp">

					<ImageView
						android:layout_width="16dp"
						android:layout_height="16dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_action_buy_line"
						app:tint="@color/colorTextOnAccent" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="5dp"
						android:ellipsize="end"
						android:maxLines="1"
						android:text="Add Funds"
						android:textColor="@color/colorTextOnAccent"
						android:textSize="12sp"
						android:textStyle="bold" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/btn_home_send"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_marginStart="8dp"
					android:layout_weight="1"
					android:background="@drawable/bg_home_action"
					android:clickable="true"
					android:contentDescription="Send"
					android:focusable="true"
					android:gravity="center"
					android:orientation="horizontal"
					android:paddingStart="8dp"
					android:paddingEnd="8dp">

					<ImageView
						android:layout_width="16dp"
						android:layout_height="16dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_action_send_line"
						app:tint="@color/colorTextOnAccent" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="5dp"
						android:ellipsize="end"
						android:maxLines="1"
						android:text="Send"
						android:textColor="@color/colorTextOnAccent"
						android:textSize="12sp"
						android:textStyle="bold" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/btn_home_transfer"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_marginStart="8dp"
					android:layout_weight="1.05"
					android:background="@drawable/bg_home_action"
					android:clickable="true"
					android:contentDescription="Transfer"
					android:focusable="true"
					android:gravity="center"
					android:orientation="horizontal"
					android:paddingStart="8dp"
					android:paddingEnd="8dp">

					<ImageView
						android:layout_width="16dp"
						android:layout_height="16dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_action_swap_line"
						app:tint="@color/colorTextOnAccent" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="4dp"
						android:ellipsize="end"
						android:maxLines="1"
						android:text="Transfer"
						android:textColor="@color/colorTextOnAccent"
						android:textSize="12sp"
						android:textStyle="bold" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/btn_home_receive"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_marginStart="8dp"
					android:layout_weight="1"
					android:background="@drawable/bg_home_action"
					android:clickable="true"
					android:contentDescription="Receive"
					android:focusable="true"
					android:gravity="center"
					android:orientation="horizontal"
					android:paddingStart="8dp"
					android:paddingEnd="8dp">

					<ImageView
						android:layout_width="16dp"
						android:layout_height="16dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_action_receive_line"
						app:tint="@color/colorTextOnAccent" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="4dp"
						android:ellipsize="end"
						android:maxLines="1"
						android:text="Receive"
						android:textColor="@color/colorTextOnAccent"
						android:textSize="12sp"
						android:textStyle="bold" />
				</LinearLayout>
			</LinearLayout>

			<!-- Quick actions and the savings figures, one card, no extra subtitles. -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:fontFamily="sans-serif-medium"
					android:letterSpacing="0.1"
					android:text="QUICK ACTIONS"
					android:textColor="@color/colorTextSecondary"
					android:textSize="11sp"
					android:textStyle="bold" />
				<View
					android:layout_width="0dp"
					android:layout_height="1dp"
					android:layout_marginStart="12dp"
					android:layout_weight="1"
					android:background="@color/colorCardStroke" />
			</LinearLayout>
			
			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="18dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingTop="4dp"
					android:paddingBottom="6dp">
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/qa_savings"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:background="?attr/selectableItemBackground"
							android:clickable="true"
							android:focusable="true"
							android:gravity="center_vertical"
							android:minHeight="44dp"
							android:orientation="horizontal"
							android:paddingStart="12dp"
							android:paddingTop="8dp"
							android:paddingEnd="8dp"
							android:paddingBottom="8dp">
							<ImageView
								android:layout_width="32dp"
								android:layout_height="32dp"
								android:background="@drawable/bg_home_icon_well"
								android:importantForAccessibility="no"
								android:padding="7dp"
								android:src="@drawable/ic_type_savings_line"
								app:tint="@color/colorAccent" />
							<TextView
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginStart="8dp"
								android:text="Savings"
								android:textColor="@color/colorTextPrimary"
								android:textSize="13sp"
								android:textStyle="bold" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/qa_groups"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:background="?attr/selectableItemBackground"
							android:clickable="true"
							android:focusable="true"
							android:gravity="center_vertical"
							android:minHeight="44dp"
							android:orientation="horizontal"
							android:paddingStart="8dp"
							android:paddingTop="8dp"
							android:paddingEnd="8dp"
							android:paddingBottom="8dp">
							<ImageView
								android:layout_width="32dp"
								android:layout_height="32dp"
								android:background="@drawable/bg_home_icon_well"
								android:importantForAccessibility="no"
								android:padding="7dp"
