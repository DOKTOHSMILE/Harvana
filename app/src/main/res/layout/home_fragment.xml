<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@android:color/transparent"
	android:id="@+id/_main">
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@android:color/transparent"
		android:fillViewport="true"
		android:overScrollMode="never">
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear194"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="22dp"
				android:paddingTop="18dp"
				android:paddingRight="22dp"
				android:paddingBottom="16dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear36"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/textview3"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:textSize="24sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/textview4"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:text="Here's what's happening in your circles today."
						android:textSize="13sp" />
				</LinearLayout>
				<TextView
					android:id="@+id/textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:textStyle="bold"
					android:gravity="end" />
			</LinearLayout>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview28"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:layout_marginLeft="10dp"
				android:layout_marginTop="15dp"
				android:layout_marginRight="10dp"
				android:layout_marginBottom="10dp"
				app:cardBackgroundColor="@color/colorSurfaceAlt"
				app:cardCornerRadius="28dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/whiteFaint10">
				<LinearLayout
					android:id="@+id/linear217"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:paddingLeft="5dp"
					android:paddingTop="16dp"
					android:paddingRight="5dp"
					android:paddingBottom="5dp"
					android:gravity="bottom"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear200"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:visibility="gone" />
					<LinearLayout
						android:id="@+id/layout_metric_grid"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/linear37"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="horizontal">
							<com.google.android.material.card.MaterialCardView
								android:id="@+id/card_total_saved"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_margin="4dp"
								app:cardBackgroundColor="@color/colorSurface"
								android:layout_weight="1"
								app:cardCornerRadius="14dp"
								app:cardElevation="0dp"
								app:strokeWidth="1dp"
								app:strokeColor="@color/whiteFaint10">
								<LinearLayout
									android:id="@+id/linear198"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:padding="14dp"
									android:orientation="vertical">
									<LinearLayout
										android:id="@+id/linear38"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:gravity="center_vertical"
										android:orientation="horizontal">
										<ImageView
											android:id="@+id/imageview58"
											android:layout_width="24dp"
											android:layout_height="24dp"
											android:padding="3dp"
											android:src="@drawable/ic_wallet"
											android:scaleType="centerInside"
											app:tint="@color/colorAccent" />
										<TextView
											android:id="@+id/textview205"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:text="TOTAL SAVED"
											android:textSize="10sp"
											android:textStyle="bold"
											android:layout_marginStart="6dp" />
									</LinearLayout>
									<LinearLayout
										android:id="@+id/linear219"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:layout_marginTop="8dp"
										android:orientation="vertical">
										<TextView
											android:id="@+id/text_val_saved"
											android:layout_width="match_parent"
											android:layout_height="wrap_content"
											android:padding="3dp"
											android:text="0 HARV"
											android:textSize="18sp"
											android:textStyle="bold"
											android:singleLine="true" />
										<TextView
											android:id="@+id/text_sub_saved"
											android:layout_width="match_parent"
											android:layout_height="wrap_content"
											android:text="No group savings yet"
											android:textSize="10sp" />
									</LinearLayout>
								</LinearLayout>
							</com.google.android.material.card.MaterialCardView>
							<com.google.android.material.card.MaterialCardView
								android:id="@+id/card_active_groups"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:layout_margin="4dp"
								app:cardBackgroundColor="@color/colorSurface"
								android:layout_weight="1"
								app:cardCornerRadius="14dp"
								app:cardElevation="0dp"
								app:strokeWidth="1dp"
								app:strokeColor="@color/whiteFaint10">
								<LinearLayout
									android:id="@+id/linear196"
									android:layout_width="match_parent"
									android:layout_height="match_parent"
									android:padding="14dp"
									android:orientation="vertical">
									<LinearLayout
										android:id="@+id/linear39"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:gravity="center_vertical"
										android:orientation="horizontal">
										<ImageView
											android:id="@+id/imageview57"
											android:layout_width="24dp"
											android:layout_height="24dp"
											android:padding="3dp"
											android:src="@drawable/ic_groups"
											android:scaleType="centerInside"
											app:tint="@color/colorTextSecondary" />
										<TextView
											android:id="@+id/textview204"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:text="ACTIVE GROUPS"
											android:textSize="10sp"
											android:textStyle="bold"
											android:layout_marginStart="6dp" />
									</LinearLayout>
									<LinearLayout
										android:id="@+id/linear218"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:layout_marginTop="8dp"
										android:orientation="vertical">
										<TextView
											android:id="@+id/text_val_groups"
											android:layout_width="match_parent"
											android:layout_height="wrap_content"
											android:padding="3dp"
											android:text="0"
											android:textSize="18sp"
											android:textStyle="bold" />
										<TextView
											android:id="@+id/text_sub_groups"
											android:layout_width="match_parent"
											android:layout_height="wrap_content"
											android:text="Join your first circle"
											android:textSize="10sp" />
									</LinearLayout>
								</LinearLayout>
							</com.google.android.material.card.MaterialCardView>
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear40"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="horizontal">
							<com.google.android.material.card.MaterialCardView
								android:id="@+id/card_trust_score"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:layout_margin="4dp"
								app:cardBackgroundColor="@color/colorSurface"
								android:layout_weight="1"
								app:cardCornerRadius="14dp"
								app:cardElevation="0dp"
								app:strokeWidth="1dp"
								app:strokeColor="@color/whiteFaint10">
								<LinearLayout
									android:id="@+id/linear201"
									android:layout_width="match_parent"
									android:layout_height="match_parent"
									android:padding="12dp"
									android:gravity="center_vertical"
									android:orientation="horizontal">
									<FrameLayout
										android:id="@+id/linear202"
										android:layout_width="48dp"
										android:layout_height="48dp">
										<ProgressBar
											android:id="@+id/ring_trust_score"
											android:layout_width="match_parent"
											android:layout_height="match_parent"
											android:indeterminate="false"
											style="?android:progressBarStyleHorizontal"
											android:progressDrawable="@drawable/trust_ring_progress" />
										<TextView
											android:id="@+id/text_val_trust"
											android:layout_width="match_parent"
											android:layout_height="match_parent"
											android:gravity="center_horizontal|center_vertical"
											android:text="—"
											android:textSize="12sp"
											android:textStyle="bold" />
									</FrameLayout>
									<LinearLayout
										android:id="@+id/linear215"
										android:layout_width="0dp"
										android:layout_height="wrap_content"
										android:orientation="vertical"
										android:layout_weight="1"
										android:layout_marginStart="10dp">
										<TextView
											android:id="@+id/textview206"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:text="TRUST SCORE"
											android:textSize="10sp"
											android:textStyle="bold" />
										<TextView
											android:id="@+id/text_sub_trust"
											android:layout_width="match_parent"
											android:layout_height="wrap_content"
											android:layout_marginTop="2dp"
											android:text="Build reputation"
											android:textSize="10sp" />
									</LinearLayout>
								</LinearLayout>
							</com.google.android.material.card.MaterialCardView>
							<com.google.android.material.card.MaterialCardView
								android:id="@+id/card_open_loans"
								android:layout_width="0dp"
								android:layout_height="match_parent"
								android:layout_margin="4dp"
								app:cardBackgroundColor="@color/colorSurface"
								android:layout_weight="1"
								app:cardCornerRadius="14dp"
								app:cardElevation="0dp"
								app:strokeWidth="1dp"
								app:strokeColor="@color/whiteFaint10">
								<LinearLayout
									android:id="@+id/linear203"
									android:layout_width="match_parent"
									android:layout_height="match_parent"
									android:padding="14dp"
									android:orientation="vertical">
									<LinearLayout
										android:id="@+id/linear41"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:gravity="center_vertical"
										android:orientation="horizontal">
										<ImageView
											android:id="@+id/imageview59"
											android:layout_width="24dp"
											android:layout_height="24dp"
											android:padding="3dp"
											android:src="@drawable/ic_receipt"
											android:scaleType="centerInside"
											app:tint="@color/colorTextSecondary" />
										<TextView
											android:id="@+id/textview207"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:text="OPEN LOANS"
											android:textSize="10sp"
											android:textStyle="bold"
											android:layout_marginStart="6dp" />
									</LinearLayout>
									<LinearLayout
										android:id="@+id/linear220"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:layout_marginTop="8dp"
										android:orientation="vertical">
										<TextView
											android:id="@+id/text_val_loans"
											android:layout_width="match_parent"
											android:layout_height="wrap_content"
											android:padding="3dp"
											android:text="0"
											android:textSize="18sp"
											android:textStyle="bold" />
										<TextView
											android:id="@+id/text_sub_loans"
											android:layout_width="match_parent"
											android:layout_height="wrap_content"
											android:text="No open loans"
											android:textSize="10sp" />
									</LinearLayout>
								</LinearLayout>
							</com.google.android.material.card.MaterialCardView>
						</LinearLayout>
					</LinearLayout>
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview1"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="18dp"
						app:cardBackgroundColor="@color/colorSurface"
						app:cardCornerRadius="20dp"
						app:cardElevation="0dp"
						app:strokeWidth="1dp"
						app:strokeColor="@color/whiteFaint10">
						<LinearLayout
							android:id="@+id/linear209"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:paddingTop="10dp"
							android:orientation="vertical">
							<LinearLayout
								android:id="@+id/linear210"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginLeft="20dp"
								android:layout_marginRight="20dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/textview212"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="Upcoming Payments"
									android:textSize="18sp"
									android:textStyle="bold"
									android:layout_weight="1" />
								<TextView
									android:id="@+id/textview6"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="All groups"
									android:textSize="13sp"
									android:textStyle="bold" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/linear_upcoming_payments"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="12dp"
								android:orientation="vertical" />
							<LinearLayout
								android:id="@+id/linear7"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginLeft="10dp"
								android:layout_marginRight="10dp"
								android:paddingTop="20dp"
								android:paddingBottom="10dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="vertical"
								android:visibility="visible">
								<ImageView
									android:id="@+id/imageview54"
									android:layout_width="36dp"
									android:layout_height="36dp"
									android:src="@drawable/ic_check_circle"
									android:scaleType="centerInside"
									app:tint="@color/colorAccent" />
								<TextView
									android:id="@+id/textview213"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginTop="10dp"
									android:text="No pending payments. You're all caught up!"
									android:textSize="13sp" />
							</LinearLayout>
						</LinearLayout>
					</com.google.android.material.card.MaterialCardView>
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview4"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="18dp"
						app:cardBackgroundColor="@color/darkFaint10"
						app:cardCornerRadius="20dp"
						app:cardElevation="0dp"
						app:strokeWidth="1dp"
						app:strokeColor="@color/colorAccent">
						<LinearLayout
							android:id="@+id/linear30"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="14dp"
							android:orientation="vertical">
							<LinearLayout
								android:id="@+id/linear42"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical">
								<LinearLayout
									android:id="@+id/linear206"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:gravity="center_vertical"
									android:orientation="horizontal"
									android:layout_gravity="center_vertical">
									<androidx.cardview.widget.CardView
										android:id="@+id/cardview27"
										android:layout_width="40dp"
										android:layout_height="40dp"
										android:layout_marginRight="10dp"
										app:cardBackgroundColor="@color/whiteFaint10"
										app:cardCornerRadius="360dp"
										app:cardElevation="0dp">
										<ImageView
											android:id="@+id/imageview53"
											android:layout_width="match_parent"
											android:layout_height="match_parent"
											android:padding="2dp"
											android:src="@drawable/ic_coin_harv"
											android:scaleType="fitCenter" />
									</androidx.cardview.widget.CardView>
									<LinearLayout
										android:id="@+id/linear207"
										android:layout_width="0dp"
										android:layout_height="wrap_content"
										android:orientation="vertical"
										android:layout_weight="1"
										android:layout_marginStart="12dp">
										<LinearLayout
											android:id="@+id/linear208"
											android:layout_width="match_parent"
											android:layout_height="wrap_content"
											android:orientation="vertical"
											android:layout_weight="1">
											<LinearLayout
												android:id="@+id/linear225"
												android:layout_width="match_parent"
												android:layout_height="wrap_content"
												android:gravity="center_vertical"
												android:orientation="horizontal"
												android:layout_weight="1">
												<TextView
													android:id="@+id/tv_harv_balance"
													android:layout_width="wrap_content"
													android:layout_height="wrap_content"
													android:gravity="center_vertical"
													android:text="0.00"
													android:textSize="22sp"
													android:textStyle="bold"
													android:textColor="@color/colorTextPrimary"
													android:singleLine="true"
													android:layout_gravity="center_horizontal|center_vertical"
													android:layout_weight="1" />
												<ImageView
													android:id="@+id/imageview61"
													android:layout_width="28dp"
													android:layout_height="28dp"
													android:padding="6dp"
													android:layout_margin="2dp"
													android:src="@drawable/icon_visibility_twotone"
													android:scaleType="centerInside"
													app:tint="@color/colorTextSecondary" />
											</LinearLayout>
											<TextView
												android:id="@+id/tv_local_currency_eqv"
												android:layout_width="wrap_content"
												android:layout_height="wrap_content"
												android:layout_marginTop="2dp"
												android:text="≈ —"
												android:textSize="12sp"
												android:textStyle="bold"
												android:singleLine="true"
												android:layout_gravity="bottom" />
										</LinearLayout>
									</LinearLayout>
								</LinearLayout>
							</LinearLayout>
							<TextView
								android:id="@+id/textview5"
								android:layout_width="0dp"
								android:layout_height="0dp"
								android:textSize="12sp"
								android:visibility="gone" />
							<LinearLayout
								android:id="@+id/linear221"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="8dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<LinearLayout
									android:id="@+id/linear223"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:padding="5dp"
									android:orientation="horizontal"
									android:layout_weight="1">
									<com.google.android.material.card.MaterialCardView
										android:id="@+id/cardview32"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										app:cardBackgroundColor="@color/whiteFaint10"
										android:layout_weight="1"
										app:cardCornerRadius="10dp"
										app:cardElevation="0dp"
										app:strokeWidth="1dp"
										app:strokeColor="@color/whiteFaint10">
										<LinearLayout
											android:id="@+id/linear222"
											android:layout_width="match_parent"
											android:layout_height="wrap_content"
											android:padding="6dp"
											android:gravity="center_horizontal|center_vertical"
											android:orientation="horizontal">
											<TextView
												android:id="@+id/textview220"
												android:layout_width="wrap_content"
												android:layout_height="wrap_content"
												android:paddingTop="5dp"
												android:paddingBottom="5dp"
												android:text="View Assets"
												android:textSize="12sp"
												android:textColor="@color/colorTextPrimary" />
											<ImageView
												android:id="@+id/imageview60"
												android:layout_width="20dp"
												android:layout_height="match_parent"
												android:paddingTop="5dp"
												android:paddingBottom="5dp"
												android:src="@drawable/ic_arrow_right"
												android:scaleType="centerInside"
												app:tint="@color/colorTextSecondary" />
										</LinearLayout>
									</com.google.android.material.card.MaterialCardView>
								</LinearLayout>
							</LinearLayout>
						</LinearLayout>
					</com.google.android.material.card.MaterialCardView>
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview2"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="18dp"
						app:cardBackgroundColor="@color/colorSurface"
						app:cardCornerRadius="20dp"
						app:cardElevation="0dp"
						app:strokeWidth="1dp"
						app:strokeColor="@color/whiteFaint10">
						<LinearLayout
							android:id="@+id/linear211"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:paddingTop="10dp"
							android:orientation="vertical">
							<LinearLayout
								android:id="@+id/linear212"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginLeft="20dp"
								android:layout_marginRight="20dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<ImageView
									android:id="@+id/imageview55"
									android:layout_width="24dp"
									android:layout_height="24dp"
									android:src="@drawable/ic_school"
									android:scaleType="centerInside"
									app:tint="@color/colorAccent" />
								<TextView
									android:id="@+id/textview214"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Learn Hub"
									android:textSize="18sp"
									android:textStyle="bold"
									android:layout_marginStart="10dp" />
							</LinearLayout>
