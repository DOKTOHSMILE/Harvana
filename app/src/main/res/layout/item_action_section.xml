<?xml version="1.0" encoding="utf-8"?>
<!-- A section heading in Actions & votes, with its count. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:paddingStart="4dp"
	android:paddingTop="22dp"
	android:paddingEnd="4dp">

	<TextView
		android:id="@+id/tv_action_section_title"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:textAllCaps="true"
		android:textColor="@color/colorTextTertiary"
		android:textSize="11.5sp"
		android:textStyle="bold" />

	<TextView
		android:id="@+id/tv_action_section_count"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="@drawable/bg_chip_muted"
		android:paddingStart="10dp"
		android:paddingTop="3dp"
		android:paddingEnd="10dp"
		android:paddingBottom="3dp"
		android:textColor="@color/colorAccent"
		android:textSize="11.5sp"
		android:textStyle="bold"
		android:visibility="gone" />
</LinearLayout>
