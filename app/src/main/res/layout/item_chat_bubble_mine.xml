<?xml version="1.0" encoding="utf-8"?>
<!-- A chat message (mine): the text, a payment proof picture if any, and the time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:layout_gravity="end"
	android:layout_marginStart="48dp"
	android:layout_marginTop="6dp"
	android:layout_marginEnd="0dp"
	android:background="@drawable/bg_chat_mine"
	android:orientation="vertical"
	android:paddingStart="12dp"
	android:paddingTop="8dp"
	android:paddingEnd="12dp"
	android:paddingBottom="8dp">

	<TextView
		android:id="@+id/tv_chat_text"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textColor="@color/colorTextOnAccent"
		android:textSize="14sp" />

	<ImageView
		android:id="@+id/iv_chat_picture"
		android:layout_width="200dp"
		android:layout_height="200dp"
		android:layout_marginTop="6dp"
		android:adjustViewBounds="true"
		android:contentDescription="Payment proof"
		android:scaleType="centerCrop"
		android:visibility="gone" />

	<TextView
		android:id="@+id/tv_chat_file"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:textColor="@color/colorTextOnAccent"
		android:textSize="13sp"
		android:textStyle="bold"
		android:visibility="gone" />

	<TextView
		android:id="@+id/tv_chat_time"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textColor="@color/colorTextOnAccentMuted"
		android:textSize="10sp" />
</LinearLayout>
