<?xml version="1.0" encoding="utf-8"?>
<!-- A compact label / value line inside a P2P card (order cards, trade summaries); a copy icon when the value copies. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:minHeight="26dp"
	android:orientation="horizontal">
	<TextView
		android:id="@+id/tv_kv_label"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:textColor="@color/colorTextTertiary"
		android:textSize="13sp" />
	<TextView
		android:id="@+id/tv_kv_value"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="end"
		android:maxWidth="230dp"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp" />
	<ImageView
		android:id="@+id/iv_kv_copy"
		android:layout_width="16dp"
		android:layout_height="16dp"
		android:layout_marginStart="6dp"
		android:contentDescription="Copy"
		android:src="@drawable/ic_copy"
		android:visibility="gone"
		app:tint="@color/colorTextTertiary" />
</LinearLayout>
