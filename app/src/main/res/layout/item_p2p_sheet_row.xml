<?xml version="1.0" encoding="utf-8"?>
<!-- One choice in a P2P sheet: badge or icon, title, subtitle, check when chosen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/selectableItemBackground"
	android:gravity="center_vertical"
	android:minHeight="50dp"
	android:orientation="horizontal"
	android:paddingStart="8dp"
	android:paddingEnd="8dp">
	<FrameLayout
		android:layout_width="40dp"
		android:layout_height="40dp">
		<TextView
			android:id="@+id/tv_row_badge"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@drawable/bg_p2p_avatar"
			android:gravity="center"
			android:textColor="@color/colorAccent"
			android:textSize="15sp"
			android:textStyle="bold" />
		<ImageView
			android:id="@+id/iv_row_icon"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:importantForAccessibility="no"
			android:visibility="gone" />
	</FrameLayout>
	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="12dp"
		android:layout_weight="1"
		android:orientation="vertical">
		<TextView
			android:id="@+id/tv_row_title"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />
		<TextView
			android:id="@+id/tv_row_subtitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:textColor="@color/colorTextSecondary"
			android:textSize="12.5sp" />
	</LinearLayout>
	<ImageView
		android:id="@+id/iv_row_check"
		android:layout_width="22dp"
		android:layout_height="22dp"
		android:importantForAccessibility="no"
		android:src="@drawable/ic_check_circle_on"
		android:visibility="gone"
		app:tint="@color/colorAccent" />
</LinearLayout>
