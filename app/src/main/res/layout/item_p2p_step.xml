<?xml version="1.0" encoding="utf-8"?>
<!-- One numbered step of a trade: number on a line, title, then the step's own content (filled in code). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal">
	<LinearLayout
		android:layout_width="28dp"
		android:layout_height="match_parent"
		android:gravity="center_horizontal"
		android:orientation="vertical">
		<TextView
			android:id="@+id/tv_step_number"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:background="@drawable/bg_p2p_step_dot"
			android:gravity="center"
			android:textColor="@color/colorTextOnAccent"
			android:textSize="12sp"
			android:textStyle="bold" />
		<View
			android:id="@+id/v_step_line"
			android:layout_width="2dp"
			android:layout_height="match_parent"
			android:layout_marginTop="4dp"
			android:background="@color/colorCardStroke" />
	</LinearLayout>
	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="10dp"
		android:layout_weight="1"
		android:orientation="vertical"
		android:paddingBottom="18dp">
		<TextView
			android:id="@+id/tv_step_title"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />
		<LinearLayout
			android:id="@+id/ll_step_content"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:orientation="vertical" />
	</LinearLayout>
</LinearLayout>
