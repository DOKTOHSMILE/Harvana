<?xml version="1.0" encoding="utf-8"?>
<!-- Swap: one coin of the pair, its dollar price and 24-hour change (when known). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="0dp"
	android:layout_height="wrap_content"
	android:layout_weight="1"
	android:background="@drawable/bg_swap_card"
	android:orientation="vertical"
	android:padding="12dp">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal">
		<ImageView
			android:id="@+id/iv_price_icon"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:importantForAccessibility="no" />
		<TextView
			android:id="@+id/tv_price_symbol"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="8dp"
			android:textColor="@color/swapText"
			android:textSize="14sp"
			android:textStyle="bold" />
	</LinearLayout>
	<TextView
		android:id="@+id/tv_price_usd"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:textColor="@color/swapText"
		android:textSize="16sp"
		android:textStyle="bold" />
	<TextView
		android:id="@+id/tv_price_change"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textColor="@color/swapTextSecondary"
		android:textSize="12sp" />
</LinearLayout>
