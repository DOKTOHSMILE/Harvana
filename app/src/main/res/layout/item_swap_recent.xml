<?xml version="1.0" encoding="utf-8"?>
<!-- Recent Swaps row: the two coins, the pair and amount paid, what was received, date, status. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/selectableItemBackground"
	android:gravity="center_vertical"
	android:minHeight="72dp"
	android:orientation="horizontal"
	android:paddingTop="10dp"
	android:paddingBottom="10dp">
	<FrameLayout
		android:layout_width="58dp"
		android:layout_height="36dp">
		<ImageView
			android:id="@+id/iv_swap_recent_from"
			android:layout_width="34dp"
			android:layout_height="34dp"
			android:importantForAccessibility="no" />
		<ImageView
			android:id="@+id/iv_swap_recent_to"
			android:layout_width="34dp"
			android:layout_height="34dp"
			android:layout_marginStart="22dp"
			android:importantForAccessibility="no" />
	</FrameLayout>
	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="8dp"
		android:layout_weight="1"
		android:orientation="vertical">
		<TextView
			android:id="@+id/tv_swap_recent_pair"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/swapText"
			android:textSize="14sp"
			android:textStyle="bold" />
		<TextView
			android:id="@+id/tv_swap_recent_paid"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/swapTextSecondary"
			android:textSize="12sp" />
	</LinearLayout>
	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="end"
		android:orientation="vertical">
		<TextView
			android:id="@+id/tv_swap_recent_got"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/swapText"
			android:textSize="13sp"
			android:textStyle="bold" />
		<TextView
			android:id="@+id/tv_swap_recent_when"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/swapTextSecondary"
			android:textSize="11sp" />
		<TextView
			android:id="@+id/tv_swap_recent_status"
			android:layout_width="wrap_content"
			android:layout_height="22dp"
			android:layout_marginTop="4dp"
			android:background="@drawable/bg_swap_pill"
			android:gravity="center"
			android:paddingStart="8dp"
			android:paddingEnd="8dp"
			android:textSize="11sp"
			android:textStyle="bold" />
	</LinearLayout>
</LinearLayout>
