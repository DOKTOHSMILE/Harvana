<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<!-- One plain list row (min 60dp) with a thin divider under it: no card around each transaction. -->
	<LinearLayout
		android:id="@+id/cardview1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="72dp"
		android:background="?attr/selectableItemBackground"
		android:clickable="true"
		android:focusable="true"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear13"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:paddingTop="4dp"
			android:paddingBottom="4dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview5"
				android:layout_width="44dp"
				android:layout_height="44dp"
				app:cardBackgroundColor="@color/colorSurfaceAlt"
				app:cardElevation="0dp"
				app:cardCornerRadius="360dp"
				app:strokeWidth="0dp">
				<!-- A plain ImageView: ShapeableImageView fixes its clip mask to the first padding, so a logo set later with
				     no padding was cut to a square inside the round card. The card clips the circle. -->
				<ImageView
					android:id="@+id/iv_tx_icon"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:src="@drawable/ic_action_receive"
					android:scaleType="centerInside"
					app:tint="@color/colorAccent"
					android:focusable="false" android:duplicateParentState="true" />
			</com.google.android.material.card.MaterialCardView>
			<LinearLayout
				android:id="@+id/linear11"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_weight="1"
				android:layout_marginStart="12dp">
				<TextView
					android:id="@+id/tv_tx_type"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Sent HARV"
					android:textStyle="bold"
					android:textSize="15sp"
					android:textColor="@color/colorTextPrimary"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_tx_address"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="To: HV0x7a8...91f"
					android:singleLine="true"
					android:textSize="12sp"
					android:textColor="@color/colorTextSecondary"
					android:focusable="false"
					android:ellipsize="middle" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear12"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:gravity="end"
				android:layout_marginStart="8dp">
				<TextView
					android:id="@+id/tv_tx_amount"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="- 50.00 HARV"
					android:textStyle="bold"
					android:textSize="14sp"
					android:textColor="@color/colorTextPrimary"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_tx_date"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="10 mins ago"
					android:textSize="11sp"
					android:textColor="@color/colorTextTertiary"
					android:focusable="false" />
			</LinearLayout>
		</LinearLayout>
		<View
			android:id="@+id/tx_divider"
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginStart="62dp"
			android:background="@color/colorCardStroke" />
	</LinearLayout>
</LinearLayout>
