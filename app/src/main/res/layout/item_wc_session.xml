<?xml version="1.0" encoding="utf-8"?>
<!-- One connected dApp: logo, name, site, networks, Disconnect. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="10dp"
	android:background="@drawable/bg_p2p_method_chip"
	android:gravity="center_vertical"
	android:minHeight="64dp"
	android:orientation="horizontal"
	android:padding="12dp">
	<ImageView
		android:id="@+id/wc_session_icon"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_marginEnd="12dp"
		android:contentDescription="dApp" />
	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">
		<TextView
			android:id="@+id/wc_session_name"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:maxLines="1"
			android:textColor="@color/colorTextPrimary"
			android:textSize="15sp"
			android:textStyle="bold" />
		<TextView
			android:id="@+id/wc_session_url"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textColor="@color/colorTextSecondary"
			android:textSize="12sp" />
		<TextView
			android:id="@+id/wc_session_networks"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textColor="@color/colorTextTertiary"
			android:textSize="11sp" />
	</LinearLayout>
	<com.google.android.material.button.MaterialButton
		android:id="@+id/wc_session_disconnect"
		style="@style/HarvanaButton.Outlined"
		android:layout_width="wrap_content"
		android:layout_height="44dp"
		android:text="Disconnect" />
</LinearLayout>
