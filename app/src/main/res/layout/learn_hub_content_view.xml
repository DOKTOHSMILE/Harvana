<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/card_view_container"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginLeft="4dp"
		android:layout_marginTop="6dp"
		android:layout_marginRight="4dp"
		android:layout_marginBottom="6dp"
		app:cardBackgroundColor="@color/colorSurface"
		app:cardCornerRadius="20dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorCardStroke"
		app:cardPreventCornerOverlap="true">
		<LinearLayout
			android:id="@+id/linear58"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<FrameLayout
				android:id="@+id/frame_layout59"
				android:layout_width="match_parent"
				android:layout_height="175dp">
				<ImageView
					android:id="@+id/imageview_cover"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@color/colorSurfaceAlt"
					android:src="@drawable/app_logo_transparent"
					android:scaleType="centerCrop"
					android:focusable="false" />
				<LinearLayout
					android:id="@+id/layoutBadgeWrapper"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_margin="14dp"
					android:background="@drawable/badge_pill_background"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_gravity="left|top"
					android:paddingHorizontal="12dp"
					android:paddingVertical="6dp">
					<TextView
						android:id="@+id/textview_badge"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Savings"
						android:textStyle="bold"
						android:textColor="@color/colorAccent"
						android:textSize="11.5sp"
						android:focusable="false" />
				</LinearLayout>
			</FrameLayout>
			<LinearLayout
				android:id="@+id/linear60"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="18dp"
				android:orientation="vertical">
				<TextView
					android:id="@+id/textview_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="How to 3x Your Osusu Returns in 2026"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary"
					android:textSize="16.5sp"
					android:focusable="false"
					android:lineSpacingMultiplier="1.15" />
				<TextView
					android:id="@+id/textview_desc"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:text="Proven strategies used by top performing circles in Lagos and Abuja. Backed by real data."
					android:textSize="13sp"
					android:textColor="@color/colorTextSecondary"
					android:maxLines="2"
					android:ellipsize="end"
					android:focusable="false"
					android:lineSpacingMultiplier="1.2" />
				<View
					android:id="@+id/view61"
					android:layout_width="match_parent"
					android:layout_height="12dp" />
				<LinearLayout
					android:id="@+id/linear62"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview_author"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="Chinedu O."
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="@color/colorAccent"
						android:layout_weight="1"
						android:focusable="false" />
					<TextView
						android:id="@+id/textview_views"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="1,240 views"
						android:textSize="12sp"
						android:textColor="@color/colorTextTertiary"
						android:focusable="false" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
