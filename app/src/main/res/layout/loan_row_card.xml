<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview43"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		android:layout_marginHorizontal="4dp"
		android:layout_marginVertical="6dp"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorCardStroke">
		<LinearLayout
			android:id="@+id/linear62"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear63"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/tv_loan_borrower"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="Member"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary"
					android:layout_weight="1"
					android:textSize="15sp"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_loan_status"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="3dp"
					android:paddingBottom="3dp"
					android:background="@drawable/bg_chip_pending"
					android:text="PENDING"
					android:textSize="10sp"
					android:textStyle="bold"
					android:paddingStart="10dp"
					android:paddingEnd="10dp"
					android:focusable="false" />
			</LinearLayout>
			<TextView
				android:id="@+id/tv_loan_amount"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:text="0 HARV"
				android:textSize="18sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimary"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_loan_meta"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:text="—"
				android:textColor="@color/colorTextTertiary"
				android:textSize="12sp"
				android:focusable="false" />
			<LinearLayout
				android:id="@+id/row_loan_admin_actions"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:orientation="horizontal"
				android:visibility="gone">
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_loan_reject"
					android:layout_width="0dp"
					android:layout_height="44dp"
					android:text="Reject"
					android:textStyle="bold"
					android:textColor="@color/colorTextSecondary"
					android:layout_weight="1"
					android:textSize="13sp"
					android:layout_marginEnd="6dp"
					app:backgroundTint="@color/colorSurfaceAlt"
					app:cornerRadius="12dp"
					app:elevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke"
					android:textAllCaps="false"
					android:focusable="false" />
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_loan_approve"
					android:layout_width="0dp"
					android:layout_height="44dp"
					android:text="Approve &amp; Disburse"
					android:textStyle="bold"
					android:textColor="@color/colorTextOnAccent"
					android:layout_weight="1"
					android:textSize="13sp"
					android:layout_marginStart="6dp"
					app:backgroundTint="@color/colorAccent"
					app:cornerRadius="12dp"
					app:elevation="0dp"
					android:textAllCaps="false"
					android:focusable="false" />
			</LinearLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
