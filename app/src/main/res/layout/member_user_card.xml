<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview25"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		android:layout_marginHorizontal="4dp"
		android:layout_marginVertical="6dp"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorCardStroke">
		<LinearLayout
			android:id="@+id/linear40"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear114"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="14dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<FrameLayout
					android:id="@+id/frame_layout115"
					android:layout_width="40dp"
					android:layout_height="40dp">
					<View
						android:id="@+id/view116"
						android:layout_width="match_parent"
						android:layout_height="match_parent" />
					<TextView
						android:id="@+id/tv_member_initials"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:gravity="center"
						android:text="A"
						android:textSize="14sp"
						android:textStyle="bold"
						android:textColor="#FFFFFFFF"
						android:focusable="false"
	android:background="@drawable/bg_avatar"/>
					<View
						android:id="@+id/dot_member_online"
						android:layout_width="8dp"
						android:layout_height="8dp"
						android:background="@drawable/dot_online"
						android:layout_gravity="bottom|end"
						android:visibility="gone" />
				</FrameLayout>
				<LinearLayout
					android:id="@+id/linear117"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1"
					android:layout_marginStart="12dp">
					<LinearLayout
						android:id="@+id/linear118"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/tv_member_name"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Member name"
							android:textSize="15sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:focusable="false"
							android:maxLines="1"
							android:ellipsize="end" />
						<TextView
							android:id="@+id/tv_member_role"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:paddingTop="2dp"
							android:paddingBottom="2dp"
							android:background="@drawable/bg_chip_admin"
							android:text="Admin"
							android:textSize="10sp"
							android:textStyle="bold"
							android:textColor="@color/colorAccent"
							android:paddingStart="8dp"
							android:paddingEnd="8dp"
							android:layout_marginStart="6dp"
							android:focusable="false"
							android:visibility="gone" />
					</LinearLayout>
					<TextView
						android:id="@+id/tv_member_wallet"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="HV0x…"
						android:textColor="@color/colorTextTertiary"
						android:textSize="11.5sp"
						android:focusable="false"
						android:maxLines="1"
						android:ellipsize="middle" />
				</LinearLayout>
				<TextView
					android:id="@+id/tv_member_balance"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="0 HARV"
					android:textSize="13sp"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary"
					android:layout_marginStart="8dp"
					android:focusable="false" />
				<com.google.android.material.imageview.ShapeableImageView
					android:id="@+id/btn_member_menu"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:src="@drawable/ic_more_vert"
					android:scaleType="centerInside"
					android:layout_marginStart="6dp"
					app:tint="@color/colorTextTertiary"
					android:focusable="false" android:duplicateParentState="true" />
			</LinearLayout>
			<com.google.android.material.divider.MaterialDivider
				android:id="@+id/view41"
				android:layout_width="match_parent"
				android:layout_height="1dp"
	app:dividerColor="@color/colorDivider"/>
			<LinearLayout
				android:id="@+id/linear42"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="14dp"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear43"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/textview6"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Slot"
						android:textSize="10sp"
						android:textColor="@color/colorTextTertiary"
						android:focusable="false" />
					<TextView
						android:id="@+id/tv_member_slot"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="Slot 1"
						android:textStyle="bold"
						android:textColor="@color/colorTextPrimary"
						android:textSize="12.5sp"
						android:focusable="false" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear44"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/textview7"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Contributions"
						android:textSize="10sp"
						android:textColor="@color/colorTextTertiary"
						android:focusable="false" />
					<TextView
						android:id="@+id/tv_member_contributions"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="—"
						android:textStyle="bold"
						android:textColor="@color/colorTextPrimary"
						android:textSize="12.5sp"
						android:focusable="false" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear45"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/textview8"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Status"
						android:textSize="10sp"
						android:textColor="@color/colorTextTertiary"
						android:focusable="false" />
					<TextView
						android:id="@+id/tv_member_status"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="3dp"
						android:paddingTop="2dp"
						android:paddingBottom="2dp"
						android:background="@drawable/bg_chip_paid"
						android:text="Active"
						android:textSize="10sp"
						android:textStyle="bold"
						android:paddingStart="8dp"
						android:paddingEnd="8dp"
						android:focusable="false" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
