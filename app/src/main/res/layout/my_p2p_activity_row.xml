<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/linear8"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		android:layout_marginHorizontal="4dp"
		android:layout_marginVertical="6dp"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorP2pBorder">
		<LinearLayout
			android:id="@+id/linear5"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear6"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal" android:minHeight="50dp">
				<TextView
					android:id="@+id/tv_myrow_role"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="BUYING"
					android:textStyle="bold"
					android:layout_weight="1"
					android:textSize="11sp"
					android:letterSpacing="0.06"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_myrow_status"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingTop="3dp"
					android:paddingBottom="3dp"
					android:background="@drawable/bg_chip_pending"
					android:text="OPEN"
					android:textSize="10sp"
					android:textStyle="bold"
					android:paddingHorizontal="10dp"
					android:focusable="false" />
			</LinearLayout>
			<TextView
				android:id="@+id/tv_myrow_amount"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:text="100.0000 HARV"
				android:textSize="18sp"
				android:textStyle="bold"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_myrow_total_price"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:text="₦65,000.00"
				android:textSize="14sp"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_myrow_counterparty"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="Seller: HV0x…"
				android:textSize="12sp"
				android:fontFamily="monospace"
				android:focusable="false" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
