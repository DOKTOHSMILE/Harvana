<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:id="@+id/_main">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@color/colorP2pSurfaceAlt"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:minHeight="56dp"
			android:paddingHorizontal="8dp">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview_select_coin_btn"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_margin="4dp"
				app:cardBackgroundColor="@color/darkFaint10"
				android:focusable="true"
				app:cardCornerRadius="30dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorP2pBorder">
				<LinearLayout
					android:id="@+id/linear7"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingLeft="12dp"
					android:paddingTop="8dp"
					android:paddingRight="12dp"
					android:paddingBottom="8dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<de.hdodenhof.circleimageview.CircleImageView
						android:id="@+id/circleimageview1"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:background="@android:color/transparent"
						android:src="@drawable/ic_coin_harv"
						app:civ_border_color="@color/colorInfo"
						app:civ_border_overlay="true"
						app:civ_border_width="2dp"
						app:civ_circle_background_color="@color/colorSurface" />
					<com.google.android.material.textview.MaterialTextView
						android:id="@+id/textview1"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="6dp"
						android:layout_marginRight="6dp"
						android:text="HARV"
						android:textSize="12sp"
						android:textStyle="bold" />
					<com.google.android.material.imageview.ShapeableImageView
						android:id="@+id/imageview4"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/icon_arrow_drop_down_round"
						android:scaleType="centerInside"
						android:layout_marginStart="2dp"
						app:tint="@color/colorP2pTextSecondary" android:duplicateParentState="true" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview_enter_amount"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_margin="4dp"
				app:cardBackgroundColor="@color/darkFaint10"
				android:focusable="true"
				app:cardCornerRadius="30dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorP2pBorder">
				<LinearLayout
					android:id="@+id/linear8"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingLeft="12dp"
					android:paddingTop="8dp"
					android:paddingRight="12dp"
					android:paddingBottom="8dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingHorizontal="12dp"
					android:paddingVertical="8dp">
					<com.google.android.material.textview.MaterialTextView
						android:id="@+id/textview2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="6dp"
						android:layout_marginRight="6dp"
						android:text="Amount"
						android:textSize="12sp"
						android:textStyle="bold" />
					<com.google.android.material.imageview.ShapeableImageView
						android:id="@+id/imageview5"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/icon_arrow_drop_down_round"
						android:scaleType="centerInside"
						android:layout_marginStart="4dp"
						app:tint="@color/colorP2pTextSecondary" android:duplicateParentState="true" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview_select_payment"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_margin="4dp"
				app:cardBackgroundColor="@color/darkFaint10"
				android:focusable="true"
				app:cardCornerRadius="30dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorP2pBorder">
				<LinearLayout
					android:id="@+id/linear9"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingLeft="12dp"
					android:paddingTop="8dp"
					android:paddingRight="12dp"
					android:paddingBottom="8dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<com.google.android.material.textview.MaterialTextView
						android:id="@+id/textview3"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="6dp"
						android:layout_marginRight="6dp"
						android:text="Payment"
						android:textSize="12sp"
						android:textStyle="bold" />
					<com.google.android.material.imageview.ShapeableImageView
						android:id="@+id/imageview6"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/icon_arrow_drop_down_round"
						android:scaleType="centerInside"
						android:layout_marginStart="4dp"
						app:tint="@color/colorP2pTextSecondary" android:duplicateParentState="true" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<Space
				android:id="@+id/space10"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1" />
			<com.google.android.material.imageview.ShapeableImageView
				android:id="@+id/imageview_filter_btn"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:padding="12dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:src="@drawable/icon_filter_alt_twotone"
				android:scaleType="centerInside"
				android:focusable="true" />
		</LinearLayout>
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recyclerview_fragment"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingTop="8dp"
			android:paddingBottom="16dp"
			android:clipToPadding="false"
			android:scrollbars="vertical"
			android:visibility="gone" />
		<LinearLayout
			android:id="@+id/layout_fragment_empty"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:padding="32dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:visibility="gone">
			<com.google.android.material.imageview.ShapeableImageView
				android:id="@+id/imageview7"
				android:layout_width="120dp"
				android:layout_height="120dp"
				android:src="@drawable/no_seller_white"
				android:scaleType="centerInside"
				android:tint="@color/colorP2pTextMuted" />
			<com.google.android.material.textview.MaterialTextView
				android:id="@+id/tv_fragment_empty_title"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="No listings yet"
				android:textSize="18sp"
				android:textStyle="bold" />
			<com.google.android.material.textview.MaterialTextView
				android:id="@+id/tv_fragment_empty_subtitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="Check back soon, or create your own offer."
				android:textSize="14sp" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_fragment_empty_cta"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:text="Become an Insured Trader"
				android:textSize="14sp"
				android:textStyle="bold"
				android:minHeight="48dp"
				android:visibility="gone"
				app:cornerRadius="24dp" />
		</LinearLayout>
	</LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
