<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay"
		app:elevation="0dp"
		android:stateListAnimator="@null">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/appBarColor"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/colorP2pBg"
		android:fillViewport="true"
		android:clipToPadding="false"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/buy_order_container"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="18dp"
			android:paddingBottom="32dp"
			android:orientation="vertical"
			android:paddingStart="20dp"
			android:paddingEnd="20dp">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/seller_card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:backgroundTint="@color/colorP2pSurface"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear51"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/seller_header"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<FrameLayout
							android:id="@+id/seller_avatar_container"
							android:layout_width="32dp"
							android:layout_height="32dp">
							<ImageView
								android:id="@+id/seller_avatar"
								android:layout_width="32dp"
								android:layout_height="32dp"
								android:background="@drawable/default_image"
								android:src="@drawable/default_image"
								android:scaleType="centerInside" />
							<TextView
								android:id="@+id/seller_initial"
								android:layout_width="32dp"
								android:layout_height="32dp"
								android:gravity="center"
								android:text="A"
								android:textSize="12sp"
								android:textStyle="bold"
	android:background="@drawable/bg_avatar"
	android:textColor="#FFFFFFFF"/>
						</FrameLayout>
						<LinearLayout
							android:id="@+id/seller_identity"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1"
							android:layout_marginStart="12dp">
							<LinearLayout
								android:id="@+id/linear52"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/seller_name"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Seller Name"
									android:textSize="15sp"
									android:textStyle="bold"
									android:ellipsize="end"
									android:maxLines="1" />
								<ImageView
									android:id="@+id/seller_verified"
									android:layout_width="16dp"
									android:layout_height="16dp"
									android:src="@drawable/ic_check_circle"
									android:scaleType="centerInside"
									android:layout_marginStart="5dp"
									android:visibility="gone" />
							</LinearLayout>
							<TextView
								android:id="@+id/seller_level"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="3dp"
								android:text="—"
								android:textSize="11sp" />
						</LinearLayout>
					</LinearLayout>
					<View
						android:id="@+id/view53"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="16dp"
						android:layout_marginBottom="15dp"
						android:background="@color/colorP2pBorder" />
					<LinearLayout
						android:id="@+id/seller_stats"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear54"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/seller_trust_score"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="—"
								android:textSize="14sp"
								android:textStyle="bold" />
							<TextView
								android:id="@+id/textview26"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="Trust score"
								android:textSize="10sp" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear55"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/seller_groups"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="12"
								android:textSize="14sp"
								android:textStyle="bold" />
							<TextView
								android:id="@+id/textview27"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="Groups"
								android:textSize="10sp" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear56"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/seller_completed_orders"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="126"
								android:textSize="14sp"
								android:textStyle="bold" />
							<TextView
								android:id="@+id/textview28"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:text="Completed"
								android:textSize="10sp" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/offer_card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:backgroundTint="@color/colorP2pSurface"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear57"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/offer_title"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Seller's offer"
						android:textSize="15sp"
						android:textStyle="bold" />
					<LinearLayout
						android:id="@+id/offer_price_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="16dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview29"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Price per HARV"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/offer_price"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="₦1,250.00"
							android:textSize="14sp"
							android:textStyle="bold" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/offer_available_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="11dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview30"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Available"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/offer_available"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="500 HARV"
							android:textSize="13sp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/offer_limits_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="11dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview31"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Order limits"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/offer_limits"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="10 – 500 HARV"
							android:textSize="13sp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/offer_payment_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="11dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview32"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Payment"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/offer_payment_methods"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Bank Transfer"
							android:textSize="13sp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/amount_section_title"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="How much HARV do you want\\\?"
				android:textSize="16sp"
				android:textStyle="bold" />
			<TextView
				android:id="@+id/amount_section_hint"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="10dp"
				android:text="Enter the amount of HARV you want to purchase."
				android:textSize="12sp" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/amount_input_card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:backgroundTint="@color/colorP2pSurfaceAlt"
				app:cardCornerRadius="18dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pAccent"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear58"
					android:layout_width="match_parent"
					android:layout_height="70dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="18dp"
					android:paddingEnd="18dp">
					<EditText
						android:id="@+id/amount_input"
						android:layout_width="0dp"
						android:layout_height="match_parent"
						android:background="@android:color/transparent"
						android:textSize="26sp"
						android:textStyle="bold"
						android:hint="0.00"
						android:inputType="numberDecimal"
						android:layout_weight="1"
						android:maxLines="1" />
					<TextView
						android:id="@+id/amount_currency"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="HARV"
						android:textSize="16sp"
						android:textStyle="bold" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<HorizontalScrollView
				android:id="@+id/quick_amount_scroll"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:scrollbars="none">
				<LinearLayout
					android:id="@+id/quick_amounts"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<com.google.android.material.button.MaterialButton
						android:id="@+id/quick_25"
						android:layout_width="wrap_content"
						android:layout_height="38dp"
						android:text="25 HARV"
						android:textSize="11sp"
						android:layout_marginEnd="8dp"
						android:textAllCaps="false"
						android:backgroundTint="@color/colorP2pSurface"
						app:cornerRadius="11dp"
						app:strokeColor="@color/colorP2pBorder"
						app:strokeWidth="1dp" />
					<com.google.android.material.button.MaterialButton
						android:id="@+id/quick_50"
						android:layout_width="wrap_content"
						android:layout_height="38dp"
						android:text="50 HARV"
						android:textSize="11sp"
						android:layout_marginEnd="8dp"
						android:textAllCaps="false"
						android:backgroundTint="@color/colorP2pSurface"
						app:cornerRadius="11dp"
						app:strokeColor="@color/colorP2pBorder"
						app:strokeWidth="1dp" />
					<com.google.android.material.button.MaterialButton
						android:id="@+id/quick_100"
						android:layout_width="wrap_content"
						android:layout_height="38dp"
						android:text="100 HARV"
						android:textSize="11sp"
						android:layout_marginEnd="8dp"
						android:textAllCaps="false"
						android:backgroundTint="@color/colorP2pSurface"
						app:cornerRadius="11dp"
						app:strokeColor="@color/colorP2pBorder"
						app:strokeWidth="1dp" />
					<com.google.android.material.button.MaterialButton
						android:id="@+id/quick_max"
						android:layout_width="wrap_content"
						android:layout_height="38dp"
						android:text="Max"
						android:textSize="11sp"
						android:textAllCaps="false"
						android:backgroundTint="@color/colorP2pSurface"
						app:cornerRadius="11dp"
						app:strokeColor="@color/colorP2pBorder"
						app:strokeWidth="1dp" />
				</LinearLayout>
			</HorizontalScrollView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/order_calculation_card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:layout_marginBottom="16dp"
				android:backgroundTint="@color/colorP2pSurface"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/order_calculation"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/calculation_title"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Order summary"
						android:textSize="15sp"
						android:textStyle="bold" />
					<LinearLayout
						android:id="@+id/calculation_quantity_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="16dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview33"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="HARV amount"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/calculation_harv"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="0.00 HARV"
							android:textSize="13sp"
							android:textStyle="bold" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/calculation_price_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="11dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview34"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Price"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/calculation_price"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="₦0.00 / HARV"
							android:textSize="13sp" />
					</LinearLayout>
					<View
						android:id="@+id/view59"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="15dp"
						android:layout_marginBottom="15dp"
						android:background="@color/colorP2pBorder" />
					<LinearLayout
						android:id="@+id/calculation_subtotal_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview35"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="You will pay"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/calculation_fiat"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="₦0.00"
							android:textSize="15sp"
							android:textStyle="bold" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/calculation_maker_fee_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="11dp"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:visibility="gone">
						<TextView
							android:id="@+id/textview36"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Maker fee"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/calculation_maker_fee"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="0.00 HARV"
							android:textSize="12sp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/calculation_network_fee_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="11dp"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:visibility="gone">
						<TextView
							android:id="@+id/textview37"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Network fee"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/calculation_network_fee"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="0.00 HARV"
							android:textSize="12sp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/calculation_receive_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview38"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="You receive"
							android:textSize="13sp"
							android:textStyle="bold"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/calculation_receive"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="0.00 HARV"
							android:textSize="16sp"
							android:textStyle="bold" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/validation_message"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:textSize="12sp"
				android:visibility="gone" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/create_order_button"
				android:layout_width="match_parent"
				android:layout_height="54dp"
				android:text="Buy HARV"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textAllCaps="false"
				android:backgroundTint="@color/colorP2pAccent"
				app:cornerRadius="15dp" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/escrow_card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:backgroundTint="@color/colorP2pSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear60"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="14dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/escrow_icon"
						android:layout_width="22dp"
						android:layout_height="22dp"
						android:src="@drawable/ic_info"
						android:scaleType="center"
						android:layout_marginEnd="10dp" />
					<LinearLayout
						android:id="@+id/linear61"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/escrow_title"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Protected by escrow"
							android:textSize="12sp"
							android:textStyle="bold" />
						<TextView
							android:id="@+id/escrow_description"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="The seller's HARV is secured through the escrow process. Release occurs only after the required conditions are satisfied and the blockchain transaction is verified."
							android:textSize="11sp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/security_note"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="Final price, limits, availability and fees are verified when the order is created."
				android:textSize="10sp" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
