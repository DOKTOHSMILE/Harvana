<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay"
		app:elevation="0dp"
		android:stateListAnimator="@null">
		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/appBarColor"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/colorP2pBg"
		android:fillViewport="true"
		android:clipToPadding="false"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/sell_order_root"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="16dp"
			android:paddingBottom="36dp"
			android:orientation="vertical"
			android:paddingStart="18dp"
			android:paddingEnd="18dp">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_available"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear193"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/linear194"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/textview111"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Available to sell"
							android:textSize="12sp" />
						<TextView
							android:id="@+id/tv_sell_available_harv"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="0.00 HARV"
							android:textSize="20sp"
							android:textStyle="bold" />
					</LinearLayout>
					<TextView
						android:id="@+id/tv_sell_max_hint"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="9dp"
						android:text="MAX"
						android:textSize="11sp"
						android:textStyle="bold" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_amount"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear195"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview112"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="I want to sell"
						android:textSize="16sp"
						android:textStyle="bold" />
					<LinearLayout
						android:id="@+id/linear196"
						android:layout_width="match_parent"
						android:layout_height="58dp"
						android:layout_marginTop="14dp"
						android:background="@color/colorP2pSurfaceAlt"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingStart="15dp"
						android:paddingEnd="15dp">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/et_sell_amount"
							android:layout_width="0dp"
							android:layout_height="match_parent"
							android:background="@android:color/transparent"
							android:textSize="22sp"
							android:textStyle="bold"
							android:hint="0.00"
							android:inputType="numberDecimal"
							android:layout_weight="1"
							android:maxLines="1" />
						<TextView
							android:id="@+id/textview113"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="HARV"
							android:textSize="14sp"
							android:textStyle="bold" />
					</LinearLayout>
					<TextView
						android:id="@+id/tv_sell_amount_error"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="7dp"
						android:textSize="11sp"
						android:visibility="gone" />
					<LinearLayout
						android:id="@+id/layout_sell_presets"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/tv_sell_preset_1"
							android:layout_width="0dp"
							android:layout_height="38dp"
							android:gravity="center_horizontal|center_vertical"
							android:text="10"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_preset_2"
							android:layout_width="0dp"
							android:layout_height="38dp"
							android:gravity="center_horizontal|center_vertical"
							android:text="25"
							android:textSize="12sp"
							android:layout_weight="1"
							android:layout_marginStart="6dp" />
						<TextView
							android:id="@+id/tv_sell_preset_3"
							android:layout_width="0dp"
							android:layout_height="38dp"
							android:gravity="center_horizontal|center_vertical"
							android:text="50"
							android:textSize="12sp"
							android:layout_weight="1"
							android:layout_marginStart="6dp" />
						<TextView
							android:id="@+id/tv_sell_preset_max"
							android:layout_width="0dp"
							android:layout_height="38dp"
							android:gravity="center_horizontal|center_vertical"
							android:text="Max"
							android:textSize="12sp"
							android:textStyle="bold"
							android:layout_weight="1"
							android:layout_marginStart="6dp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_price"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear197"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview114"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Your selling price"
						android:textSize="16sp"
						android:textStyle="bold" />
					<LinearLayout
						android:id="@+id/linear198"
						android:layout_width="match_parent"
						android:layout_height="58dp"
						android:layout_marginTop="14dp"
						android:background="@color/colorP2pSurfaceAlt"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingStart="15dp"
						android:paddingEnd="15dp">
						<TextView
							android:id="@+id/textview115"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="₦"
							android:textSize="20sp"
							android:textStyle="bold" />
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/et_sell_price"
							android:layout_width="0dp"
							android:layout_height="match_parent"
							android:background="@android:color/transparent"
							android:textSize="20sp"
							android:textStyle="bold"
							android:hint="0.00"
							android:inputType="numberDecimal"
							android:layout_weight="1"
							android:layout_marginStart="7dp"
							android:maxLines="1" />
						<TextView
							android:id="@+id/textview116"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="/ HARV"
							android:textSize="13sp" />
					</LinearLayout>
					<TextView
						android:id="@+id/tv_sell_price_hint"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="Set a price that buyers will see on your listing."
						android:textSize="11sp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_payment_method"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear199"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview117"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Payment method"
						android:textSize="16sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_payment_method_description"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="5dp"
						android:text="Choose where you want to receive the buyer's fiat payment."
						android:textSize="12sp" />
					<LinearLayout
						android:id="@+id/layout_sell_payment_account"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="15dp"
						android:padding="14dp"
						android:background="@color/colorP2pSurfaceAlt"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear200"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/tv_sell_bank_name"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Select payment account"
								android:textSize="14sp"
								android:textStyle="bold" />
							<TextView
								android:id="@+id/tv_sell_account_preview"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:text="No account selected"
								android:textSize="12sp" />
						</LinearLayout>
						<TextView
							android:id="@+id/tv_sell_change_account"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="CHANGE"
							android:textSize="10sp"
							android:textStyle="bold" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_preview"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear201"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview118"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Order preview"
						android:textSize="16sp"
						android:textStyle="bold" />
					<LinearLayout
						android:id="@+id/linear202"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="17dp"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview119"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="HARV amount"
							android:textSize="13sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_preview_harv"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="0.00 HARV"
							android:textSize="13sp"
							android:textStyle="bold" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear203"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview120"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Unit price"
							android:textSize="13sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_preview_price"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="₦0.00 / HARV"
							android:textSize="13sp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear204"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview121"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Gross fiat value"
							android:textSize="13sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_preview_gross"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="₦0.00"
							android:textSize="13sp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/row_sell_preview_fee"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview122"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Maker fee"
							android:textSize="13sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_preview_fee"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Calculated automatically"
							android:textSize="12sp" />
					</LinearLayout>
					<com.google.android.material.divider.MaterialDivider
						android:id="@+id/view205"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="16dp"
	app:dividerColor="@color/colorP2pBorder"/>
					<LinearLayout
						android:id="@+id/linear206"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview123"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Expected fiat"
							android:textSize="13sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_preview_receive"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="₦0.00"
							android:textSize="17sp"
							android:textStyle="bold" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_conditions"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear207"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview124"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Selling conditions"
						android:textSize="16sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_condition_limits"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="Minimum order: 0 HARV\nMaximum order: 0 HARV"
						android:textSize="12sp"
						android:lineSpacingExtra="4dp" />
					<TextView
						android:id="@+id/tv_sell_condition_window"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="9dp"
						android:text="Payment window: 30 minutes"
						android:textSize="12sp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_protection"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pAccent"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear208"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview125"
						android:layout_width="32dp"
						android:layout_height="32dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="✓"
						android:textSize="17sp"
						android:textStyle="bold" />
					<LinearLayout
						android:id="@+id/linear209"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:layout_marginStart="10dp">
						<TextView
							android:id="@+id/textview126"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Protected by blockchain escrow"
							android:textSize="13sp"
							android:textStyle="bold" />
						<TextView
							android:id="@+id/tv_sell_protection_description"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="When a trade is created, the required HARV is secured through the escrow process before the transaction proceeds."
							android:textSize="11sp"
							android:lineSpacingExtra="2dp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_create_sell_order"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:layout_marginTop="18dp"
				android:text="Create Sell Order"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textAllCaps="false"
				app:backgroundTint="@color/colorP2pAccent"
				app:cornerRadius="16dp" />
			<TextView
				android:id="@+id/tv_sell_order_note"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="9dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="Your order will become available to eligible buyers after validation."
				android:textSize="11sp" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
