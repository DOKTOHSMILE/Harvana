						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="Release txHash: —"
						android:textSize="12sp"
						android:ellipsize="middle"
						android:maxLines="1" />
					<TextView
