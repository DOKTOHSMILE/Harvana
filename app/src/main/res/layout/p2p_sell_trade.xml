<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay"
		app:elevation="0dp"
		android:stateListAnimator="@null">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/appBarColor"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/colorP2pBg"
		android:fillViewport="true"
		android:clipToPadding="false"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/sell_trade_root"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="16dp"
			android:paddingBottom="36dp"
			android:orientation="vertical"
			android:paddingStart="18dp"
			android:paddingEnd="18dp">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_action"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear134"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/tv_sell_action_title"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Waiting for buyer payment"
						android:textSize="18sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_action_description"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="7dp"
						android:text="The buyer must complete the fiat payment before you can confirm the trade."
						android:textSize="13sp"
						android:lineSpacingExtra="2dp" />
					<LinearLayout
						android:id="@+id/linear135"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="17dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview65"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Time remaining"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_timer"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="29:48"
							android:textSize="16sp"
							android:textStyle="bold" />
					</LinearLayout>
					<ProgressBar
						android:id="@+id/pb_sell_trade"
						android:layout_width="match_parent"
						android:layout_height="5dp"
						android:layout_marginTop="12dp"
						android:progress="50"
						android:indeterminate="false"
						style="?android:progressBarStyleHorizontal"
						android:progressTint="@color/colorP2pAccent" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_value"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear136"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview66"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Trade value"
						android:textSize="16sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_harv_amount"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="17dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="40.00 HARV"
						android:textSize="28sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_value_caption"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="3dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="HARV being sold"
						android:textSize="12sp" />
					<View
						android:id="@+id/view137"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:layout_marginTop="18dp"
						android:background="@color/colorP2pBorder" />
					<LinearLayout
						android:id="@+id/linear138"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview67"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Buyer pays"
							android:textSize="13sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_fiat_amount"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="₦50,000.00"
							android:textSize="15sp"
							android:textStyle="bold" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear139"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview68"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Price"
							android:textSize="13sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_price"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="₦1,250 / HARV"
							android:textSize="13sp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/row_sell_maker_fee"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview69"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Maker fee"
							android:textSize="13sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_maker_fee"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="0.50%"
							android:textSize="13sp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_buyer"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear140"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview70"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Buyer"
						android:textSize="16sp"
						android:textStyle="bold" />
					<LinearLayout
						android:id="@+id/linear141"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<FrameLayout
							android:id="@+id/frame_layout4"
							android:layout_width="40dp"
							android:layout_height="40dp">
							<TextView
								android:id="@+id/tv_sell_buyer_initial"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:background="@drawable/bg_avatar"
								android:gravity="center"
								android:text="\\\\?"
								android:textSize="15sp"
								android:textStyle="bold"
	android:textColor="#FFFFFFFF"/>
							<ImageView
								android:id="@+id/iv_sell_buyer_avatar"
								android:layout_width="40dp"
								android:layout_height="40dp"
								android:src="@drawable/default_image"
								android:scaleType="centerCrop"
								android:visibility="gone" />
						</FrameLayout>
						<LinearLayout
							android:id="@+id/linear142"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1"
							android:layout_marginStart="12dp">
							<LinearLayout
								android:id="@+id/linear143"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/tv_sell_buyer_name"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Buyer Name"
									android:textSize="15sp"
									android:textStyle="bold" />
								<ImageView
									android:id="@+id/iv_sell_buyer_verified"
									android:layout_width="17dp"
									android:layout_height="17dp"
									android:src="@drawable/icon_check_circle_round"
									android:scaleType="centerInside"
									android:layout_marginStart="5dp" />
							</LinearLayout>
							<TextView
								android:id="@+id/tv_sell_buyer_info"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="5dp"
								android:text="Verified buyer"
								android:textSize="12sp" />
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear144"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="15dp"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/tv_sell_buyer_trust"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Trust —"
							android:textSize="12sp"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_buyer_trades"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="12 completed trades"
							android:textSize="12sp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_escrow"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear145"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear146"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview71"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Blockchain escrow"
							android:textSize="16sp"
							android:textStyle="bold"
							android:layout_weight="1" />
						<TextView
							android:id="@+id/tv_sell_escrow_badge"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="SECURED"
							android:textSize="10sp"
							android:textStyle="bold" />
					</LinearLayout>
					<TextView
						android:id="@+id/tv_sell_escrow_description"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="9dp"
						android:text="Your HARV is protected by the escrow process while this trade is active."
						android:textSize="12sp"
						android:lineSpacingExtra="2dp" />
					<TextView
						android:id="@+id/textview72"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="15dp"
						android:text="Escrow txHash"
						android:textSize="11sp" />
					<TextView
						android:id="@+id/tv_sell_escrow_tx_hash"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:text="0x000000000000000000000000000000"
						android:textSize="12sp"
						android:ellipsize="middle"
						android:maxLines="1" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_payment"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear147"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview73"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Payment"
						android:textSize="16sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_payment_status"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="Waiting for buyer payment"
						android:textSize="15sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_payment_status_description"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="5dp"
						android:text="You will be notified when the buyer marks the payment as sent."
						android:textSize="12sp"
						android:lineSpacingExtra="2dp" />
					<LinearLayout
						android:id="@+id/layout_sell_payment_received"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="16dp"
						android:orientation="vertical"
						android:visibility="gone">
						<View
							android:id="@+id/view148"
							android:layout_width="match_parent"
							android:layout_height="1dp"
							android:background="@color/colorP2pBorder" />
						<TextView
							android:id="@+id/tv_sell_payment_received_amount"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="14dp"
							android:text="Payment marked: ₦50,000.00"
							android:textSize="15sp"
							android:textStyle="bold" />
						<TextView
							android:id="@+id/tv_sell_payment_reference"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="Reference: —"
							android:textSize="12sp" />
						<TextView
							android:id="@+id/tv_sell_payment_time"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="5dp"
							android:text="Marked paid: —"
							android:textSize="12sp" />
						<ImageView
							android:id="@+id/iv_sell_payment_proof"
							android:layout_width="match_parent"
							android:layout_height="190dp"
							android:layout_marginTop="14dp"
							android:background="@color/colorP2pSurfaceAlt"
							android:src="@drawable/default_image"
							android:scaleType="centerInside"
							android:visibility="gone" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_warning"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorAmber"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear149"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="15dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview74"
						android:layout_width="32dp"
						android:layout_height="32dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="!"
						android:textSize="18sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_warning"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="Do not confirm payment from a screenshot alone. Check your actual bank or payment account and verify the exact amount received."
						android:textSize="12sp"
						android:layout_weight="1"
						android:layout_marginStart="9dp"
						android:lineSpacingExtra="2dp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_action_button"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear150"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/tv_sell_action_button_title"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Confirm payment received"
						android:textSize="17sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_action_button_description"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:text="This action becomes available after the buyer marks the order as paid."
						android:textSize="12sp" />
					<CheckBox
						android:id="@+id/cb_sell_payment_confirm"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:text="I have independently verified the exact payment."
						android:textSize="13sp"
						android:visibility="gone" />
					<com.google.android.material.button.MaterialButton
						android:id="@+id/btn_sell_confirm_payment"
						android:layout_width="match_parent"
						android:layout_height="54dp"
						android:layout_marginTop="12dp"
						android:text="Confirm Payment Received"
						android:textSize="15sp"
						android:textStyle="bold"
						android:textAllCaps="false"
						android:visibility="gone"
						app:backgroundTint="@color/colorP2pAccent"
						app:cornerRadius="14dp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_sell_timeline"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorP2pBorder"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear151"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview75"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Trade progress"
						android:textSize="16sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_step_1"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="18dp"
						android:text="✓  Order created"
						android:textSize="13sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_step_2"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:text="✓  HARV secured in escrow"
						android:textSize="13sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_step_3"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:text="●  Buyer payment"
						android:textSize="13sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tv_sell_step_4"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:text="○  Seller confirmation"
						android:textSize="13sp" />
					<TextView
						android:id="@+id/tv_sell_step_5"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:text="○  Blockchain release"
						android:textSize="13sp" />
					<TextView
						android:id="@+id/tv_sell_step_6"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:text="○  Trade completed"
						android:textSize="13sp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
