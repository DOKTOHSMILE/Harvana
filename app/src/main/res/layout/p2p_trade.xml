<?xml version="1.0" encoding="utf-8"?>
<!-- An open order, buyer or seller (P2pBuyTradeActivity / P2pSellTradeActivity): status and countdown, trader with Chat,
     the order, numbered steps (pay / check, proof, confirm), escrow, timeline; actions in the bar at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground"
	android:orientation="vertical">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="8dp"
		android:paddingEnd="12dp">
		<ImageView
			android:id="@+id/iv_trade_back"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="Back"
			android:padding="10dp"
			android:src="@drawable/ic_nav_back"
			app:tint="@color/colorTextPrimary" />
		<Space
			android:layout_width="0dp"
			android:layout_height="1dp"
			android:layout_weight="1" />
		<TextView
			android:id="@+id/tv_trade_cancel"
			android:layout_width="wrap_content"
			android:layout_height="40dp"
			android:background="?attr/selectableItemBackground"
			android:gravity="center"
			android:paddingStart="10dp"
			android:paddingEnd="10dp"
			android:text="Cancel order"
			android:textColor="@color/colorTextSecondary"
			android:textSize="14sp"
			android:visibility="gone" />
		<ImageView
			android:id="@+id/iv_trade_refresh"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="Refresh"
			android:padding="10dp"
			android:src="@drawable/ic_refresh"
			app:tint="@color/colorTextPrimary" />
	</LinearLayout>

	<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
		android:id="@+id/refresh_trade"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">
		<ScrollView
			android:layout_width="match_parent"
			android:layout_height="match_parent">
			<LinearLayout
				android:id="@+id/ll_trade_body"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:paddingBottom="20dp">

				<!-- Status -->
				<TextView
					android:id="@+id/tv_trade_title"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/colorTextPrimary"
					android:textSize="24sp"
					android:textStyle="bold" />
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/tv_trade_timer_label"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13sp" />
					<TextView
						android:id="@+id/tv_trade_timer"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="6dp"
						android:fontFamily="monospace"
						android:textColor="@color/colorAmber"
						android:textSize="15sp"
						android:textStyle="bold" />
				</LinearLayout>
				<TextView
					android:id="@+id/tv_trade_banner"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:background="@drawable/bg_chip_pending"
					android:padding="12dp"
					android:textColor="@color/colorTextPrimary"
					android:textSize="13sp"
					android:visibility="gone" />

				<!-- Trader -->
				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeColor="@color/colorCardStroke"
					app:strokeWidth="1dp">
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:padding="14dp">
						<FrameLayout
							android:layout_width="42dp"
							android:layout_height="42dp">
							<TextView
								android:id="@+id/tv_trade_initial"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:background="@drawable/bg_p2p_avatar"
								android:gravity="center"
								android:text="?"
								android:textColor="@color/colorAccent"
								android:textSize="16sp"
								android:textStyle="bold" />
							<ImageView
								android:id="@+id/iv_trade_avatar"
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:importantForAccessibility="no"
								android:visibility="gone" />
						</FrameLayout>
						<LinearLayout
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginStart="12dp"
							android:layout_weight="1"
							android:orientation="vertical">
							<LinearLayout
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/tv_trade_name"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:ellipsize="end"
									android:maxWidth="170dp"
									android:maxLines="1"
									android:text="Trader"
									android:textColor="@color/colorTextPrimary"
									android:textSize="15sp"
									android:textStyle="bold" />
								<ImageView
									android:id="@+id/iv_trade_verified"
									android:layout_width="16dp"
									android:layout_height="16dp"
									android:layout_marginStart="4dp"
									android:importantForAccessibility="no"
									android:src="@drawable/ic_verified_small"
									android:visibility="gone"
									app:tint="@color/colorInfo" />
							</LinearLayout>
							<TextView
								android:id="@+id/tv_trade_role"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="2dp"
								android:textColor="@color/colorTextSecondary"
								android:textSize="12sp" />
						</LinearLayout>
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btn_trade_chat"
							android:layout_width="wrap_content"
							android:layout_height="40dp"
							android:insetTop="0dp"
							android:insetBottom="0dp"
							android:text="Chat"
							android:textAllCaps="false"
							android:textColor="@color/colorTextOnAccent"
							app:backgroundTint="@color/colorAccent"
							app:cornerRadius="10dp"
							app:icon="@drawable/ic_chat"
							app:iconSize="18dp"
							app:iconTint="@color/colorTextOnAccent" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<!-- The order -->
				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeColor="@color/colorCardStroke"
					app:strokeWidth="1dp">
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="14dp">
						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<ImageView
								android:id="@+id/iv_trade_coin"
								android:layout_width="24dp"
								android:layout_height="24dp"
								android:importantForAccessibility="no" />
							<TextView
								android:id="@+id/tv_trade_side"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_marginStart="8dp"
								android:layout_weight="1"
								android:textSize="16sp"
								android:textStyle="bold" />
							<TextView
								android:id="@+id/tv_trade_status"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:textSize="13sp"
								android:textStyle="bold" />
						</LinearLayout>
						<TextView
							android:id="@+id/tv_trade_fiat"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="8dp"
							android:textColor="@color/colorTextPrimary"
							android:textSize="26sp"
							android:textStyle="bold" />
						<LinearLayout
							android:id="@+id/ll_trade_order_rows"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:orientation="vertical" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<!-- Steps -->
				<LinearLayout
					android:id="@+id/ll_trade_steps"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:orientation="vertical" />

				<!-- Escrow -->
				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					app:cardBackgroundColor="@color/colorSurface"
					app:cardCornerRadius="16dp"
					app:cardElevation="0dp"
					app:strokeColor="@color/colorCardStroke"
					app:strokeWidth="1dp">
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="14dp">
						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<ImageView
								android:layout_width="20dp"
								android:layout_height="20dp"
								android:importantForAccessibility="no"
								android:src="@drawable/ic_shield"
								app:tint="@color/colorSuccess" />
							<TextView
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_marginStart="8dp"
								android:layout_weight="1"
								android:text="Escrow"
								android:textColor="@color/colorTextPrimary"
								android:textSize="14sp"
								android:textStyle="bold" />
							<TextView
								android:id="@+id/tv_trade_escrow_state"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:textSize="13sp"
								android:textStyle="bold" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/ll_trade_escrow_rows"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:orientation="vertical" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<LinearLayout
					android:id="@+id/order_limits"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:orientation="vertical"
					android:visibility="gone" />
				<LinearLayout
					android:id="@+id/order_events"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:orientation="vertical"
					android:visibility="gone" />
			</LinearLayout>
		</ScrollView>
	</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

	<LinearLayout
		android:id="@+id/bar_trade_actions"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/colorSurface"
		android:orientation="horizontal"
		android:paddingStart="16dp"
		android:paddingTop="10dp"
		android:paddingEnd="16dp"
		android:paddingBottom="14dp"
		android:visibility="gone">
		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_trade_secondary"
			style="@style/Widget.MaterialComponents.Button.OutlinedButton"
			android:layout_width="0dp"
			android:layout_height="54dp"
			android:layout_marginEnd="6dp"
			android:layout_weight="1"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:textAllCaps="false"
			android:visibility="gone"
			app:cornerRadius="14dp" />
		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_trade_primary"
			android:layout_width="0dp"
			android:layout_height="54dp"
			android:layout_marginStart="6dp"
			android:layout_weight="1.5"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:textAllCaps="false"
			android:textSize="15sp"
			android:textStyle="bold"
			android:visibility="gone"
			app:cornerRadius="14dp" />
	</LinearLayout>
</LinearLayout>
