<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview39"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		android:layout_marginHorizontal="4dp"
		android:layout_marginVertical="4dp"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorCardStroke">
		<LinearLayout
			android:id="@+id/linear136"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="14dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/tv_pay_initials"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:background="@drawable/bg_chip_muted"
				android:gravity="center_horizontal|center_vertical"
				android:text="M"
				android:textSize="13sp"
				android:textStyle="bold"
				android:textColor="@color/colorAccent"
				android:focusable="false" />
			<LinearLayout
				android:id="@+id/linear137"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_weight="1"
				android:layout_marginStart="12dp">
				<TextView
					android:id="@+id/tv_pay_name"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="Member"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary"
					android:textSize="14.5sp"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_pay_meta"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="Slot 1 · —"
					android:textColor="@color/colorTextTertiary"
					android:textSize="11.5sp"
					android:focusable="false" />
			</LinearLayout>
			<TextView
				android:id="@+id/tv_pay_amount"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="0 HARV"
				android:textSize="13sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimary"
				android:layout_marginStart="8dp"
				android:layout_marginEnd="8dp"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_pay_status"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingTop="3dp"
				android:paddingBottom="3dp"
				android:background="@drawable/bg_chip_pending"
				android:text="Pending"
				android:textSize="10sp"
				android:textStyle="bold"
				android:paddingStart="10dp"
				android:paddingEnd="10dp"
				android:focusable="false" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
