<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview45"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		android:layout_marginHorizontal="4dp"
		android:layout_marginVertical="6dp"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorCardStroke">
		<LinearLayout
			android:id="@+id/linear35"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear36"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/tv_payout_requester"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="Member"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary"
					android:layout_weight="1"
					android:textSize="14.5sp"
					android:focusable="false" />
				<TextView
					android:id="@+id/tv_payout_slot"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Slot —"
					android:textColor="@color/colorTextTertiary"
					android:textSize="11.5sp"
					android:focusable="false" />
			</LinearLayout>
			<TextView
				android:id="@+id/tv_payout_amount"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:text="0 HARV"
				android:textSize="18sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimary"
				android:focusable="false" />
			<TextView
				android:id="@+id/tv_payout_wallet"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:text="—"
				android:textColor="@color/colorTextSecondary"
				android:textSize="11.5sp"
				android:fontFamily="monospace"
				android:focusable="false" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_payout_approve"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:layout_marginTop="14dp"
				android:text="Approve &amp; Send"
				android:textSize="14sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextOnAccent"
				app:backgroundTint="@color/colorAccent"
				app:cornerRadius="16dp"
				app:elevation="0dp"
				android:textAllCaps="false"
				android:focusable="false" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
