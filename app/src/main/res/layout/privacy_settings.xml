<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay"
		app:elevation="0dp"
		android:stateListAnimator="@null">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/appBarColor"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll3"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		android:overScrollMode="never"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/linear83"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="20dp"
			android:orientation="vertical">
			<TextView
				android:id="@+id/textview92"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Privacy &amp; Visibility"
				android:textSize="22sp"
				android:textStyle="bold" />
			<TextView
				android:id="@+id/textview93"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="24dp"
				android:text="Control what other members of your circles can see about you."
				android:textSize="13.5sp"
				android:lineSpacingExtra="3dp" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview20"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear84"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/linear85"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/textview94"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Show Trust Score"
							android:textStyle="bold"
							android:textSize="14.5sp" />
						<TextView
							android:id="@+id/textview95"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="3dp"
							android:text="Let other members of your groups see your trust score"
							android:textSize="12.5sp"
							android:lineSpacingExtra="2dp" />
					</LinearLayout>
					<Switch
						android:id="@+id/switchShowTrustScore"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="12sp"
						android:layout_marginStart="12dp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview21"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear86"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/linear87"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/textview96"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Show My Groups"
							android:textStyle="bold"
							android:textSize="14.5sp" />
						<TextView
							android:id="@+id/textview97"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="3dp"
							android:text="Let people viewing your profile see which groups you're in"
							android:textSize="12.5sp"
							android:lineSpacingExtra="2dp" />
					</LinearLayout>
					<Switch
						android:id="@+id/switchShowGroups"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="12sp"
						android:layout_marginStart="12dp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview22"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear88"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/linear89"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/textview98"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Show Activity Status"
							android:textStyle="bold"
							android:textSize="14.5sp" />
						<TextView
							android:id="@+id/textview99"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="3dp"
							android:text="Let group members see when you were last active"
							android:textSize="12.5sp"
							android:lineSpacingExtra="2dp" />
					</LinearLayout>
					<Switch
						android:id="@+id/switchShowActivity"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="12sp"
						android:layout_marginStart="12dp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview23"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear90"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/linear91"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/textview100"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Allow Group Invites"
							android:textStyle="bold"
							android:textSize="14.5sp" />
						<TextView
							android:id="@+id/textview101"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="3dp"
							android:text="Let anyone invite you to a new savings group, not just people already in one of your groups"
							android:textSize="12.5sp"
							android:lineSpacingExtra="2dp" />
					</LinearLayout>
					<Switch
						android:id="@+id/switchAllowInvites"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="12sp"
						android:layout_marginStart="12dp" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview102"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="These preferences are saved and ready to be enforced, but the screens that display your profile, trust score, and groups to other members don't check them yet — that wiring is a separate, upcoming step."
				android:textSize="12sp"
				android:layout_marginStart="4dp"
				android:lineSpacingExtra="3dp" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
