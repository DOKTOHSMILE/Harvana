<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview33"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="@color/colorSurface"
		android:layout_marginHorizontal="4dp"
		android:layout_marginVertical="4dp"
		app:cardCornerRadius="16dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/colorCardStroke">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="12dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/rule_no_textview1"
				android:layout_width="28dp"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:text="1"
				android:textSize="12sp"
				android:textStyle="bold"
				android:textColor="@color/colorAccent"
				android:focusable="false" />
			<View
				android:id="@+id/linear2"
				android:layout_width="1dp"
				android:layout_height="24dp"
				android:background="@color/colorDivider"
				android:layout_marginHorizontal="8dp" />
			<TextView
				android:id="@+id/rules_textview2"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="TextView"
				android:textSize="13sp"
				android:textColor="@color/colorTextPrimary"
				android:layout_weight="1"
				android:focusable="false" />
			<com.google.android.material.imageview.ShapeableImageView
				android:id="@+id/imageview1"
				android:layout_width="28dp"
				android:layout_height="28dp"
				android:padding="4dp"
				android:src="@drawable/icon_delete_forever_baseline"
				android:scaleType="centerInside"
				android:layout_marginStart="8dp"
				app:tint="@color/colorTextTertiary"
				android:focusable="false" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
