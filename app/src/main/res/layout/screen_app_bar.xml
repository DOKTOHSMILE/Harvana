<?xml version="1.0" encoding="utf-8"?>
<!-- Shell for every screen that uses AppBar.setContent: the toolbar on top, the screen's own layout below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<androidx.appcompat.widget.Toolbar
		android:id="@+id/app_bar_toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:background="?attr/appBarColor"
		app:titleTextColor="?attr/onAppBarColor"
		app:subtitleTextColor="?attr/onAppBarColor" />

	<FrameLayout
		android:id="@+id/app_bar_body"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1" />
</LinearLayout>
