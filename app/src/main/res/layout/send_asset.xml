<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay"
		app:elevation="0dp"
		android:stateListAnimator="@null">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/appBarColor"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<LinearLayout
		android:id="@+id/_coordinator"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:background="@color/colorBackground"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<TextView
			android:id="@+id/tvSubtitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:layout_marginBottom="16dp"
			android:text="Transfer native coins or pegged stable assets on the HARV network."
			android:textColor="@color/colorTextSecondary"
			android:textSize="13.5sp"
			android:paddingHorizontal="20dp"
			android:focusable="false" />
		<androidx.core.widget.NestedScrollView
			android:id="@+id/vscroll3"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:paddingHorizontal="20dp"
			android:fillViewport="true"
			android:overScrollMode="never">
			<LinearLayout
				android:id="@+id/linear26"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="16dp"
				android:orientation="vertical">
				<TextView
					android:id="@+id/tvLabelAsset"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="SELECT ASSET"
					android:textStyle="bold"
					android:textColor="@color/colorTextTertiary"
					android:textSize="10.5sp"
					android:layout_marginStart="4dp"
					android:letterSpacing="0.06"
					android:focusable="false" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:layout_marginBottom="14dp"
					app:cardBackgroundColor="@color/colorSurfaceRaised"
					app:cardCornerRadius="14dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<Spinner
						android:id="@+id/spAsset"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:padding="8dp"
						android:background="@android:color/transparent"
						android:spinnerMode="dropdown"
						android:theme="@style/WhiteSpinnerTheme" />
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/tvLabelRecipient"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="RECIPIENT ADDRESS"
					android:textStyle="bold"
					android:textColor="@color/colorTextTertiary"
					android:textSize="10.5sp"
					android:layout_marginStart="4dp"
					android:letterSpacing="0.06"
					android:focusable="false" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:layout_marginBottom="14dp"
					app:cardBackgroundColor="@color/colorSurfaceRaised"
					app:cardCornerRadius="14dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<LinearLayout
						android:id="@+id/linear17"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingEnd="12dp">
						<EditText
							android:id="@+id/etRecipient"
							android:layout_width="0dp"
							android:layout_height="match_parent"
							android:background="@android:color/transparent"
							android:gravity="center_vertical"
							android:textSize="14sp"
							android:textColor="@color/colorTextPrimary"
							android:hint="HV0x..."
							android:layout_weight="1"
							android:inputType="textNoSuggestions"
							android:maxLength="50"
							android:paddingStart="14dp"
							android:fontFamily="monospace"
							android:focusable="true"
							android:focusableInTouchMode="true"
							android:cursorVisible="true" />
						<ImageView
							android:id="@+id/btnPaste"
							android:layout_width="22dp"
							android:layout_height="22dp"
							android:padding="2dp"
							android:src="@drawable/icon_content_paste_twotone"
							android:scaleType="centerInside"
							android:layout_marginStart="10dp"
							android:layout_marginEnd="6dp"
							app:tint="@color/colorTextSecondary"
							android:focusable="false" />
						<ImageView
							android:id="@+id/btnScan"
							android:layout_width="22dp"
							android:layout_height="22dp"
							android:padding="2dp"
							android:src="@drawable/icon_qr_code_scanner_twotone"
							android:scaleType="centerInside"
							android:layout_marginStart="6dp"
							android:layout_marginEnd="4dp"
							app:tint="@color/colorTextSecondary"
							android:focusable="false" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/tvLabelAmount"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="AMOUNT"
					android:textStyle="bold"
					android:textColor="@color/colorTextTertiary"
					android:textSize="10.5sp"
					android:layout_marginStart="4dp"
					android:letterSpacing="0.06"
					android:focusable="false" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:layout_marginBottom="8dp"
					app:cardBackgroundColor="@color/colorSurfaceRaised"
					app:cardCornerRadius="14dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<EditText
						android:id="@+id/etAmount"
						android:layout_width="match_parent"
						android:layout_height="50dp"
						android:background="@android:color/transparent"
						android:gravity="center_vertical"
						android:textSize="16sp"
						android:textColor="@color/colorTextPrimary"
						android:hint="0.00"
						android:inputType="numberDecimal"
						android:paddingStart="14dp"
						android:focusable="true"
						android:focusableInTouchMode="true"
						android:cursorVisible="true" />
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/tvLabelMemo"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="MEMO (OPTIONAL)"
					android:textStyle="bold"
					android:textColor="@color/colorTextTertiary"
					android:textSize="10.5sp"
					android:layout_marginStart="4dp"
					android:letterSpacing="0.06"
					android:focusable="false" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardviewMemo"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:layout_marginBottom="8dp"
					app:cardBackgroundColor="@color/colorSurfaceRaised"
					app:cardCornerRadius="14dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="@color/colorCardStroke">
					<EditText
						android:id="@+id/etMemo"
						android:layout_width="match_parent"
						android:layout_height="70dp"
						android:paddingTop="12dp"
						android:background="@android:color/transparent"
						android:textSize="14sp"
						android:textColor="@color/colorTextPrimary"
						android:hint="What's this for\?"
						android:inputType="text|textCapSentences"
						android:paddingStart="14dp"
						android:maxLength="200"
						android:importantForAutofill="no"
						android:focusable="true"
						android:focusableInTouchMode="true"
						android:cursorVisible="true" />
				</com.google.android.material.card.MaterialCardView>
				<LinearLayout
					android:id="@+id/linear2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="16dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/tvAvailable"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="Available: 0 HARV"
						android:textSize="12sp"
						android:textColor="@color/colorTextSecondary"
						android:layout_weight="1"
						android:layout_marginStart="4dp"
						android:focusable="false" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear27"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="4dp"
					android:orientation="vertical"
					android:layout_weight="1" />
				<LinearLayout
					android:id="@+id/linear18"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear19"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="6dp"
						android:orientation="horizontal">
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNum1"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="1"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:layout_marginEnd="4dp"
							app:backgroundTint="@color/colorSurfaceRaised"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNum2"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="2"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:layout_marginHorizontal="2dp"
							app:backgroundTint="@color/colorSurfaceRaised"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNum3"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="3"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:layout_marginStart="4dp"
							app:backgroundTint="@color/colorSurfaceRaised"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear20"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="6dp"
						android:orientation="horizontal">
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNum4"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="4"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:layout_marginEnd="4dp"
							app:backgroundTint="@color/colorSurfaceRaised"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNum5"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="5"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:layout_marginHorizontal="2dp"
							app:backgroundTint="@color/colorSurfaceRaised"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNum6"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="6"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:layout_marginStart="4dp"
							app:backgroundTint="@color/colorSurfaceRaised"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear21"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="6dp"
						android:orientation="horizontal">
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNum7"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="7"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:layout_marginEnd="4dp"
							app:backgroundTint="@color/colorSurfaceRaised"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNum8"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="8"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:layout_marginHorizontal="2dp"
							app:backgroundTint="@color/colorSurfaceRaised"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNum9"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="9"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:layout_marginStart="4dp"
							app:backgroundTint="@color/colorSurfaceRaised"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear22"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNumDot"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="."
							android:textSize="18sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:layout_marginEnd="4dp"
							app:backgroundTint="@color/colorSurfaceRaised"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNum0"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="0"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:layout_weight="1"
							android:layout_marginHorizontal="2dp"
							app:backgroundTint="@color/colorSurfaceRaised"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnNumDel"
							android:layout_width="0dp"
							android:layout_height="52dp"
							android:text="⌫"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="@color/colorError"
							android:layout_weight="1"
							android:layout_marginStart="4dp"
							app:backgroundTint="@color/colorSurfaceAlt"
							app:cornerRadius="12dp"
							app:elevation="0dp"
							app:strokeWidth="1dp"
							app:strokeColor="@color/colorCardStroke" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
		</androidx.core.widget.NestedScrollView>
		<LinearLayout
			android:id="@+id/linear4"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@color/colorSurface"
			android:orientation="horizontal"
			android:weightSum="2"
			android:paddingVertical="12dp"
			android:paddingHorizontal="20dp">
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btnCancel"
				android:layout_width="0dp"
				android:layout_height="52dp"
				android:text="Cancel"
				android:textStyle="bold"
				android:textColor="@color/colorWarning"
				android:layout_weight="1"
				android:textSize="14.5sp"
				android:layout_marginEnd="8dp"
				app:backgroundTint="@color/colorSurfaceRaised"
				app:cornerRadius="14dp"
				app:elevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/colorCardStroke"
				android:textAllCaps="false" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btnSend"
				android:layout_width="0dp"
				android:layout_height="52dp"
				android:text="Send Funds"
				android:textStyle="bold"
				android:textColor="@color/colorTextPrimaryWhite"
				android:layout_weight="1"
				android:textSize="14.5sp"
				android:layout_marginStart="8dp"
				app:backgroundTint="@color/colorAccent"
				app:cornerRadius="14dp"
				app:elevation="0dp"
				android:textAllCaps="false" />
		</LinearLayout>
	</LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
