<?xml version="1.0" encoding="utf-8"?>
<!-- Add a network: where the request comes from, the network's details, the warning, then Cancel and Approve. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingStart="20dp"
	android:paddingTop="16dp"
	android:paddingEnd="20dp"
	android:paddingBottom="20dp">

	<TextView
		android:id="@+id/tv_network_sheet_origin"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:layout_marginBottom="12dp"
		android:background="@drawable/bg_pill_outline"
		android:drawableStart="@drawable/ic_language_line"
		android:drawablePadding="6dp"
		android:paddingStart="12dp"
		android:paddingTop="6dp"
		android:paddingEnd="14dp"
		android:paddingBottom="6dp"
		android:textColor="@color/colorTextPrimary"
		android:textSize="13sp"
		android:visibility="gone" />

	<TextView
		android:id="@+id/tv_network_sheet_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:text="Add this network?"
		android:textColor="@color/colorTextPrimary"
		android:textSize="20sp"
		android:textStyle="bold" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="14dp"
		android:background="@drawable/bg_card_surface_stroke_alt"
		android:orientation="vertical"
		android:paddingStart="14dp"
		android:paddingTop="4dp"
		android:paddingEnd="14dp"
		android:paddingBottom="4dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="56dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<ImageView
				android:id="@+id/iv_network_sheet_icon"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_coin_generic" />

			<TextView
				android:id="@+id/tv_network_sheet_name"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_weight="1"
				android:textColor="@color/colorTextPrimary"
				android:textSize="16sp"
				android:textStyle="bold" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/tv_network_sheet_url_row"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="50dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginEnd="12dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_language_line"
				app:tint="@color/colorTextSecondary" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Network URL"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp" />

			<TextView
				android:id="@+id/tv_network_sheet_url"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_weight="1"
				android:gravity="end"
				android:textColor="@color/colorTextPrimary"
				android:textIsSelectable="true"
				android:textSize="14sp"
				android:textStyle="bold" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/tv_network_sheet_chain_id_row"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="50dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginEnd="12dp"
				android:importantForAccessibility="no"
				android:src="@drawable/icon_info_round_line"
				app:tint="@color/colorTextSecondary" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Chain ID"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp" />

			<TextView
				android:id="@+id/tv_network_sheet_chain_id"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_weight="1"
				android:gravity="end"
				android:textColor="@color/colorTextPrimary"
				android:textIsSelectable="true"
				android:textSize="14sp"
				android:textStyle="bold" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/tv_network_sheet_symbol_row"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="50dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginEnd="12dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_coin_stable"
				app:tint="@color/colorTextSecondary" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Currency symbol"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp" />

			<TextView
				android:id="@+id/tv_network_sheet_symbol"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_weight="1"
				android:gravity="end"
				android:textColor="@color/colorTextPrimary"
				android:textIsSelectable="true"
				android:textSize="14sp"
				android:textStyle="bold" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/tv_network_sheet_explorer_row"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="50dp"
			android:gravity="center_vertical"
			android:orientation="horizontal" 
			android:visibility="gone">

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginEnd="12dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_web3"
				app:tint="@color/colorTextSecondary" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Block explorer"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp" />

			<TextView
				android:id="@+id/tv_network_sheet_explorer"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_weight="1"
				android:gravity="end"
				android:textColor="@color/colorTextPrimary"
				android:textIsSelectable="true"
				android:textSize="14sp"
				android:textStyle="bold" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/tv_network_sheet_decimals_row"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="50dp"
			android:gravity="center_vertical"
			android:orientation="horizontal" 
			android:visibility="gone">

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginEnd="12dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_pie_chart"
				app:tint="@color/colorTextSecondary" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Decimals"
				android:textColor="@color/colorTextSecondary"
				android:textSize="13sp" />

			<TextView
				android:id="@+id/tv_network_sheet_decimals"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_weight="1"
				android:gravity="end"
				android:textColor="@color/colorTextPrimary"
				android:textIsSelectable="true"
				android:textSize="14sp"
				android:textStyle="bold" />
		</LinearLayout>

		<TextView
			android:id="@+id/tv_network_sheet_more"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:minHeight="44dp"
			android:gravity="center_vertical"
			android:text="View all details"
			android:textColor="@color/colorAccent"
			android:textSize="13sp"
			android:textStyle="bold" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/network_sheet_warning"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:background="@drawable/bg_notice_warning_stroke"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:padding="12dp">

		<ImageView
			android:layout_width="20dp"
			android:layout_height="20dp"
			android:importantForAccessibility="no"
			android:src="@drawable/ic_warning_line"
			app:tint="@color/colorWarning" />

		<TextView
			android:id="@+id/tv_network_sheet_warning"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="10dp"
			android:layout_weight="1"
			android:text="This network is not in the chain list. Check its details before you approve."
			android:textColor="@color/colorTextPrimary"
			android:textSize="12.5sp" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:orientation="horizontal">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_network_sheet_cancel"
			style="@style/HarvanaButton.Outlined"
			android:layout_width="0dp"
			android:layout_height="52dp"
			android:layout_marginEnd="6dp"
			android:layout_weight="1"
			android:text="Cancel" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_network_sheet_approve"
			style="@style/HarvanaButton"
			android:layout_width="0dp"
			android:layout_height="52dp"
			android:layout_marginStart="6dp"
			android:layout_weight="1"
			android:text="Approve" />
	</LinearLayout>
</LinearLayout>
