<?xml version="1.0" encoding="utf-8"?>
<!-- Asset selector: search, then every coin with its balance and whether it can be swapped now. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@color/swapCard"
	android:orientation="vertical"
	android:paddingStart="16dp"
	android:paddingTop="16dp"
	android:paddingEnd="16dp"
	android:paddingBottom="16dp">
	<TextView
		android:id="@+id/tv_swap_assets_title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Select an asset"
		android:textColor="@color/swapText"
		android:textSize="18sp"
		android:textStyle="bold" />
	<EditText
		android:id="@+id/et_swap_assets_search"
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:layout_marginTop="12dp"
		android:background="@drawable/bg_swap_field"
		android:hint="Search assets"
		android:importantForAutofill="no"
		android:inputType="text"
		android:paddingStart="14dp"
		android:paddingEnd="14dp"
		android:singleLine="true"
		android:textColor="@color/swapText"
		android:textColorHint="@color/swapTextSecondary"
		android:textSize="14sp" />
	<LinearLayout
		android:id="@+id/swap_assets_list"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:orientation="vertical" />
</LinearLayout>
