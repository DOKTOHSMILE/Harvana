<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay">
		<androidx.appcompat.widget.Toolbar
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/colorPrimary"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</com.google.android.material.appbar.AppBarLayout>
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/colorBackground"
		android:fillViewport="true"
		android:overScrollMode="never"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<LinearLayout
			android:id="@+id/linear16"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="20dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear17"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="24dp"
				android:gravity="center_horizontal"
				android:orientation="vertical">
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview1"
					android:layout_width="72dp"
					android:layout_height="72dp"
					app:cardBackgroundColor="@color/colorSurfaceRaised"
					app:cardCornerRadius="36dp"
					app:cardElevation="0dp"
					app:strokeColor="@color/colorCardStroke"
					app:strokeWidth="1dp">
					<ImageView
						android:id="@+id/img_status_icon"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="18dp"
						android:src="@drawable/icon_call_made_twotone"
						android:scaleType="centerInside"
						app:tint="@color/colorAccent"
						tools:ignore="ContentDescription" />
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/tv_tx_value"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:textSize="28sp"
					android:textStyle="bold"
					android:textColor="@color/colorTextPrimary" />
				<TextView
					android:id="@+id/tv_tx_status"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:textStyle="bold"
					android:textColor="@color/colorTextSecondary"
					android:textSize="11.5sp"
					android:letterSpacing="0.06"
					android:textAllCaps="true" />
			</LinearLayout>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview8"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear9"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview29"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="16dp"
						android:text="Routing"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="@color/colorTextPrimary" />
					<TextView
						android:id="@+id/textview30"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="FROM ADDRESS"
						android:textStyle="bold"
						android:textColor="@color/colorTextTertiary"
						android:textSize="10.5sp"
						android:letterSpacing="0.06" />
					<TextView
						android:id="@+id/tv_from_address"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="3dp"
						android:layout_marginBottom="16dp"
						android:background="?attr/selectableItemBackground"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13.5sp"
						android:focusable="true"
						android:fontFamily="monospace"
						android:textIsSelectable="true" />
					<TextView
						android:id="@+id/textview31"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="TO ADDRESS"
						android:textStyle="bold"
						android:textColor="@color/colorTextTertiary"
						android:textSize="10.5sp"
						android:letterSpacing="0.06" />
					<TextView
						android:id="@+id/tv_to_address"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="3dp"
						android:layout_marginBottom="16dp"
						android:background="?attr/selectableItemBackground"
						android:textColor="@color/colorTextSecondary"
						android:textSize="13.5sp"
						android:focusable="true"
						android:fontFamily="monospace"
						android:textIsSelectable="true" />
					<TextView
						android:id="@+id/textview40"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="MEMO / NOTE"
						android:textStyle="bold"
						android:textColor="@color/colorTextTertiary"
						android:textSize="10.5sp"
						android:letterSpacing="0.06" />
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview4"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						app:cardBackgroundColor="@color/colorSurfaceRaised"
						app:cardCornerRadius="14dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorCardStroke"
						app:strokeWidth="1dp">
						<TextView
							android:id="@+id/tv_memo"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="14dp"
							android:textColor="@color/colorTextPrimary"
							android:textSize="13.5sp"
							android:textIsSelectable="true" />
					</com.google.android.material.card.MaterialCardView>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview9"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear10"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview32"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="16dp"
						android:text="Network Data"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="@color/colorTextPrimary" />
					<LinearLayout
						android:id="@+id/linear20"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="12dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview33"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Network Fee"
							android:textColor="@color/colorTextSecondary"
							android:layout_weight="1"
							android:textSize="13.5sp" />
						<TextView
							android:id="@+id/tv_network_fee"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:textSize="13.5sp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear21"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="12dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview34"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Amount Burned"
							android:textColor="@color/colorTextSecondary"
							android:layout_weight="1"
							android:textSize="13.5sp" />
						<TextView
							android:id="@+id/tv_burn_amount"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textStyle="bold"
							android:textColor="@color/colorTextPrimary"
							android:textSize="13.5sp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear22"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview35"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Timestamp"
							android:textColor="@color/colorTextSecondary"
							android:layout_weight="1"
							android:textSize="13.5sp" />
						<TextView
							android:id="@+id/tv_timestamp"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textColor="@color/colorTextPrimary"
							android:textSize="13.5sp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview10"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="@color/colorSurface"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/colorCardStroke"
				app:strokeWidth="1dp">
				<LinearLayout
					android:id="@+id/linear11"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="18dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview36"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="16dp"
						android:text="Blockchain Details"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="@color/colorTextPrimary" />
					<TextView
						android:id="@+id/textview37"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="TRANSACTION HASH"
						android:textStyle="bold"
						android:textColor="@color/colorTextTertiary"
						android:textSize="10.5sp"
						android:letterSpacing="0.06" />
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview5"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:layout_marginBottom="16dp"
						app:cardBackgroundColor="@color/colorSurfaceRaised"
						app:cardCornerRadius="14dp"
						app:cardElevation="0dp"
						app:strokeColor="@color/colorCardStroke"
						app:strokeWidth="1dp">
						<TextView
							android:id="@+id/tv_tx_hash"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="14dp"
							android:background="?attr/selectableItemBackground"
							android:textColor="@color/colorTextSecondary"
							android:textSize="12.5sp"
							android:focusable="true"
							android:fontFamily="monospace"
							android:textIsSelectable="true" />
					</com.google.android.material.card.MaterialCardView>
					<LinearLayout
						android:id="@+id/linear24"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="12dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview38"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Block Number"
							android:textColor="@color/colorTextSecondary"
							android:layout_weight="1"
							android:textSize="13.5sp" />
						<TextView
							android:id="@+id/tv_block_number"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textColor="@color/colorTextPrimary"
							android:textSize="13.5sp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear_confirmations"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="12dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview_conf_label"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Confirmations"
							android:textColor="@color/colorTextSecondary"
							android:layout_weight="1"
							android:textSize="13.5sp" />
						<TextView
							android:id="@+id/tv_confirmations"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textColor="@color/colorTextPrimary"
							android:textSize="13.5sp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear25"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview39"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Nonce"
							android:textColor="@color/colorTextSecondary"
							android:layout_weight="1"
							android:textSize="13.5sp" />
						<TextView
							android:id="@+id/tv_nonce"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textColor="@color/colorTextPrimary"
							android:textSize="13.5sp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_export_transaction"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:layout_marginTop="8dp"
				android:text="Export Receipt"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/colorTextOnAccent"
				android:textAllCaps="false"
				app:backgroundTint="@color/colorAccent"
				app:cornerRadius="14dp"
				app:elevation="0dp" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
