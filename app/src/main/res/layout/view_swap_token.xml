<?xml version="1.0" encoding="utf-8"?>
<!-- Swap: the coin picker pill (icon, symbol, name, chevron). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="wrap_content"
	android:layout_height="52dp"
	android:background="@drawable/bg_swap_token"
	android:clickable="true"
	android:focusable="true"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:paddingStart="6dp"
	android:paddingEnd="8dp">
	<ImageView
		android:id="@+id/iv_swap_token"
		android:layout_width="34dp"
		android:layout_height="34dp"
		android:importantForAccessibility="no" />
	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="8dp"
		android:orientation="vertical">
		<TextView
			android:id="@+id/tv_swap_token_symbol"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/swapText"
			android:textSize="15sp"
			android:textStyle="bold" />
		<TextView
			android:id="@+id/tv_swap_token_name"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:maxLines="1"
			android:maxWidth="110dp"
			android:ellipsize="end"
			android:textColor="@color/swapTextSecondary"
			android:textSize="11sp" />
	</LinearLayout>
	<ImageView
		android:layout_width="18dp"
		android:layout_height="18dp"
		android:layout_marginStart="4dp"
		android:importantForAccessibility="no"
		android:src="@drawable/ic_swap_chevron" />
</LinearLayout>
