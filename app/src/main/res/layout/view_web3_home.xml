<?xml version="1.0" encoding="utf-8"?>
<!-- Web3 home (web3/Web3Home): search with the open-tabs count, Earn (Staking, Liquidity, Mining), dApps by category, Recent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingStart="16dp"
	android:paddingTop="12dp"
	android:paddingEnd="16dp"
	android:paddingBottom="24dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="50dp"
			android:layout_weight="1"
			android:background="@drawable/bg_pill_surface_alt"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="12dp"
			android:paddingEnd="12dp">

			<ImageView
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:importantForAccessibility="no"
				android:src="@drawable/icon_search_24"
				android:tint="@color/colorTextSecondary" />

			<EditText
				android:id="@+id/et_web3_search"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:background="@null"
				android:hint="Search or enter dApp URL"
				android:imeOptions="actionGo"
				android:inputType="textUri"
				android:paddingStart="8dp"
				android:singleLine="true"
				android:textSize="14sp" />
		</LinearLayout>

		<TextView
			android:id="@+id/tv_web3_tabs"
			android:layout_width="28dp"
			android:layout_height="28dp"
			android:layout_marginStart="12dp"
			android:layout_marginEnd="4dp"
			android:background="@drawable/bg_tab_count"
			android:contentDescription="Open tabs"
			android:gravity="center"
			android:textColor="@color/colorTextPrimary"
			android:textSize="12sp"
			android:textStyle="bold"
			android:visibility="gone" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/web3_earn_section"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:visibility="gone">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingTop="20dp"
			android:paddingBottom="8dp"
			android:text="Earn"
			android:textColor="@color/colorTextPrimary"
			android:textSize="17sp"
			android:textStyle="bold" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/bg_card_surface_stroke_alt"
			android:orientation="vertical">

			<LinearLayout
				android:id="@+id/row_web3_staking"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:minHeight="50dp"
				android:background="?android:attr/selectableItemBackground"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:padding="12dp">

				<ImageView
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_app_stake" />

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:paddingStart="12dp"
					android:text="Staking"
					android:textColor="@color/colorTextPrimary"
					android:textSize="15sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/tv_web3_staked"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="0 HARV"
					android:textColor="@color/colorTextSecondary"
					android:textSize="14sp" />
			</LinearLayout>

			<LinearLayout
				android:id="@+id/row_web3_liquidity"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:minHeight="50dp"
				android:background="?android:attr/selectableItemBackground"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:padding="12dp">

				<ImageView
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_app_liquidity" />

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:paddingStart="12dp"
					android:text="Liquidity"
					android:textColor="@color/colorTextPrimary"
					android:textSize="15sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/tv_web3_liquidity"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Harvana Swap"
					android:textColor="@color/colorTextSecondary"
					android:textSize="14sp" />
			</LinearLayout>

			<LinearLayout
				android:id="@+id/row_web3_mining"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:minHeight="50dp"
				android:background="?android:attr/selectableItemBackground"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:padding="12dp">

				<ImageView
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_app_mining" />

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:paddingStart="12dp"
					android:text="Mining"
					android:textColor="@color/colorTextPrimary"
					android:textSize="15sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/tv_web3_mining"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Harvana Node Miner"
					android:textColor="@color/colorTextSecondary"
					android:textSize="14sp" />
			</LinearLayout>

		</LinearLayout>
	</LinearLayout>

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="20dp"
		android:paddingBottom="8dp"
		android:text="Explore dApps"
		android:textColor="@color/colorTextPrimary"
		android:textSize="17sp"
		android:textStyle="bold" />

	<HorizontalScrollView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:scrollbars="none">

		<LinearLayout
			android:id="@+id/web3_chips"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal" />
	</HorizontalScrollView>

	<LinearLayout
		android:id="@+id/web3_dapps"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:background="@drawable/bg_card_surface_stroke_alt"
		android:orientation="vertical" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="20dp"
		android:paddingBottom="8dp"
		android:text="Recent"
		android:textColor="@color/colorTextPrimary"
		android:textSize="17sp"
		android:textStyle="bold" />

	<LinearLayout
		android:id="@+id/web3_recent"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/bg_card_surface_stroke_alt"
		android:orientation="vertical" />
</LinearLayout>
