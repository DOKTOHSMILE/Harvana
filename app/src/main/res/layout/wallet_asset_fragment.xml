<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/refresh_assets"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true">
	<!-- Bottom room: the main bottom bar is drawn over this page, and without it the last rows and "+ Add coins" sat behind the bar. -->
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="120dp"
		android:orientation="vertical">
		<TextView
			android:id="@+id/tv_no_wallet_hint"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_margin="32dp"
			android:gravity="center_horizontal"
			android:text="No wallet yet. Tap the wallet selector above to create or import one."
			android:textSize="14sp"
			android:textColor="@color/colorTextSecondary"
			android:visibility="gone" />
		<!-- Search: filters every row below (HARV, stable coins, other coins and the ones you added) by name or symbol. -->
		<!-- Search, and Add coins beside it. -->
		<LinearLayout
			android:id="@+id/row_asset_search"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:layout_marginEnd="12dp"
			android:layout_marginTop="10dp"
			android:layout_marginBottom="4dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/til_asset_search"
			android:layout_width="0dp"
			android:layout_height="44dp"
			android:layout_weight="1"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="12dp"
			app:cardElevation="0dp"
			app:strokeWidth="1dp"
			app:strokeColor="@color/colorCardStroke">
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:paddingStart="12dp"
				android:paddingEnd="8dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:layout_width="18dp"
					android:layout_height="18dp"
					android:src="@drawable/icon_search_24"
					app:tint="@color/colorTextSecondary" />
				<EditText
					android:id="@+id/et_asset_search"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:layout_marginStart="8dp"
					android:background="@android:color/transparent"
					android:hint="Search coins"
					android:imeOptions="actionSearch"
					android:inputType="text"
					android:maxLines="1"
					android:textSize="14sp"
					android:textColor="@color/colorTextPrimary"
					android:textColorHint="@color/colorTextTertiary" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/btn_add_coins"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:layout_marginStart="8dp"
			android:clickable="true"
			android:focusable="true"
			android:contentDescription="Add coins"
			app:cardBackgroundColor="@color/colorSurface"
			app:cardCornerRadius="12dp"
			app:cardElevation="0dp"
			app:strokeWidth="1dp"
			app:strokeColor="@color/colorCardStroke">
			<ImageView
				android:layout_width="22dp"
				android:layout_height="22dp"
				android:layout_gravity="center"
				android:src="@drawable/icon_add_circle_outline_round"
				app:tint="@color/colorAccent" />
		</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recyclerview1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:nestedScrollingEnabled="false"
			android:paddingBottom="4dp"
			tools:listitem="@layout/coin_list_card" />
		<LinearLayout
			android:id="@+id/husd_asset"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical" />
		<LinearLayout
			android:id="@+id/chain_assets"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical" />
		<LinearLayout
			android:id="@+id/custom_assets"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical" />
	</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
