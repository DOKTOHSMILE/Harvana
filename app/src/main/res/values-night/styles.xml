<?xml version="1.0" encoding="UTF-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="popupMenuStyle">@style/HarvanaPopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/HarvanaPopupMenu</item>
        <!-- every spinner list opens on the surface colour with palette text -->
        <item name="spinnerStyle">@style/HarvanaSpinner</item>
        <item name="materialButtonStyle">@style/HarvanaButton</item>
        <item name="materialButtonOutlinedStyle">@style/HarvanaButton.Outlined</item>
        <!-- one back arrow for every screen -->
        <item name="homeAsUpIndicator">@drawable/ic_nav_back</item>
        <!-- Plain TextViews (titles, subtitles) use the primary text colour instead of a washed-out default -->
        <item name="android:textViewStyle">@style/HarvanaTextView</item>
        <item name="appBarColor">@color/colorBackground</item>
        <item name="onAppBarColor">@color/colorTextPrimary</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorTextOnAccent</item>
        <item name="colorPrimaryVariant">@color/colorAccentDark</item>
        <item name="colorSecondaryVariant">@color/colorAccentDark</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorTextPrimaryWhite</item>
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="colorControlNormal">@color/colorControlNormal</item>
        <item name="colorControlHighlight">@color/colorAccentRipple</item>
        <item name="android:textColorHighlight">@color/colorAccentStroke</item>
        <item name="android:textColorLink">@color/colorAccentStrong</item>
        <item name="android:editTextColor">@color/colorTextPrimary</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <!-- colorPrimary MUST be the accent, never the surface. Mapping it
             to colorSurface made Material dialog/sheet button text identical
             to the background — Confirm / Cancel / I've Paid vanished. -->
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnPrimary">@color/colorTextOnAccent</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/colorTextTertiary</item>
        <item name="android:statusBarColor">?attr/appBarColor</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="alertDialogTheme">@style/HarvanaAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/HarvanaAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/HarvanaBottomSheetDialog</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <!-- text and icons follow the bar color (charcoal on orange by day, light on charcoal by night) -->
        <item name="android:textColorPrimary">?attr/onAppBarColor</item>
        <item name="android:textColorSecondary">?attr/onAppBarColor</item>
        <item name="colorControlNormal">?attr/onAppBarColor</item>
        <item name="colorOnSurface">?attr/onAppBarColor</item>
    </style>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="popupMenuStyle">@style/HarvanaPopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/HarvanaPopupMenu</item>
    </style>
    <style name="AppTheme.DebugActivity" parent="AppTheme" />

    <!-- One button look for the whole app: 12dp corners, 48dp tall, bold sentence-case text. Filled = accent, outlined = accent edge. -->
    <style name="HarvanaButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="android:textColor">@color/colorTextOnAccent</item>
    </style>

    <style name="HarvanaButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="strokeColor">@color/colorAccent</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/colorAccent</item>
    </style>

    <style name="HarvanaSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@color/colorSurface</item>
        <item name="android:dropDownSelector">@color/colorAccentRipple</item>
    </style>

    <style name="WhiteSpinnerTheme" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="colorControlNormal">@color/colorTextPrimary</item>
        <item name="spinnerStyle">@style/HarvanaSpinner</item>
    </style>

    <style name="HarvanaTextView" parent="android:Widget.TextView">
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <!-- Menus: a different shade from the page, with an edge and a soft shadow. -->
    <style name="HarvanaPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">10dp</item>
    </style>
</resources>
