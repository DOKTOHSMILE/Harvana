<?xml version="1.0" encoding="UTF-8"?>
<resources>

    <style name="ShapeAppearance.Harvana.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="popupMenuStyle">@style/HarvanaPopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/HarvanaPopupMenu</item>
        <!-- every spinner list opens on the surface colour with palette text -->
        <item name="spinnerStyle">@style/HarvanaSpinner</item>
        <!-- every round loading spinner is the Harvana loading icon (avd_harvana_loader) -->
        <item name="android:progressBarStyle">@style/Widget.Harvana.Loader</item>
        <item name="materialButtonStyle">@style/HarvanaButton</item>
        <!-- one switch look everywhere (on: accent knob and soft accent track; off: white knob, grey track) -->
        <item name="switchStyle">@style/Harvana.Switch</item>
        <!-- every toolbar: the same bold 20sp title, 13sp subtitle and spacing as the standard header -->
        <item name="toolbarStyle">@style/Harvana.Toolbar</item>
        <item name="materialButtonOutlinedStyle">@style/HarvanaButton.Outlined</item>
        <item name="textInputStyle">@style/Harvana.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Harvana.Card</item>
        <item name="borderlessButtonStyle">@style/HarvanaButton.Text</item>
        <!-- one back arrow for every screen -->
        <item name="homeAsUpIndicator">@drawable/ic_nav_back</item>
        <!-- Plain TextViews (titles, subtitles) use the primary text colour instead of a washed-out default -->
        <item name="android:textViewStyle">@style/HarvanaTextView</item>
        <item name="appBarColor">@color/colorBackground</item>
        <item name="onAppBarColor">@color/colorTextPrimary</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorTextOnAccent</item>
        <item name="colorPrimaryVariant">@color/colorAccentDark</item>
        <item name="colorSecondaryVariant">@color/colorAccentDark</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorTextPrimaryWhite</item>
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="colorControlNormal">@color/colorControlNormal</item>
        <item name="colorControlHighlight">@color/colorAccentRipple</item>
        <item name="android:textColorHighlight">@color/colorAccentStroke</item>
        <item name="android:textColorLink">@color/colorAccentStrong</item>
        <item name="android:editTextColor">@color/colorTextPrimary</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorPrimaryDark">@color/colorAccentStrong</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnPrimary">@color/colorTextOnAccent</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/colorTextTertiary</item>
        <item name="android:statusBarColor">?attr/appBarColor</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="alertDialogTheme">@style/HarvanaAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/HarvanaAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/HarvanaBottomSheetDialog</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <!-- text and icons follow the bar color (charcoal on orange by day, light on charcoal by night) -->
        <item name="android:textColorPrimary">?attr/onAppBarColor</item>
        <item name="android:textColorSecondary">?attr/onAppBarColor</item>
        <item name="colorControlNormal">?attr/onAppBarColor</item>
        <item name="colorOnSurface">?attr/onAppBarColor</item>
    </style>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="popupMenuStyle">@style/HarvanaPopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/HarvanaPopupMenu</item>
    </style>
    <style name="AppTheme.DebugActivity" parent="AppTheme" />
    <!-- For a step that only opens other screens and shows nothing itself (the group picture picker). -->
    <style name="AppTheme.Transparent" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- One button look for the whole app: 12dp corners, 48dp tall, bold sentence-case text. Filled = accent, outlined = accent edge. -->
    <style name="HarvanaButton" parent="Widget.MaterialComponents.Button">
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="android:textColor">@color/colorTextOnAccent</item>
    </style>

    <style name="HarvanaButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="strokeColor">@color/colorAccent</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/colorAccent</item>
    </style>

    <style name="HarvanaSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@color/colorSurface</item>
        <item name="android:dropDownSelector">@color/colorAccentRipple</item>
    </style>

    <style name="WhiteSpinnerTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="colorControlNormal">@color/colorTextPrimary</item>
        <item name="spinnerStyle">@style/HarvanaSpinner</item>
    </style>

    <!-- colorPrimary is ALWAYS the accent. Night used to map it to
         colorSurface so Material Confirm/Cancel text vanished. -->
    <style name="HarvanaAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnPrimary">@color/colorTextOnAccent</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="buttonBarPositiveButtonStyle">@style/HarvanaDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/HarvanaDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/HarvanaDialogButton</item>
    </style>

    <style name="HarvanaDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="HarvanaBottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnPrimary">@color/colorTextOnAccent</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="bottomSheetStyle">@style/HarvanaBottomSheetStyle</item>
    </style>

    <style name="HarvanaBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="shapeAppearanceOverlay">@style/HarvanaBottomSheetShape</item>
    </style>

    <style name="HarvanaBottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- P2P uses the same page, card and accent colours as every other screen (its tokens are aliases of the core ones). -->
    <style name="P2pTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/colorP2pBg</item>
        <item name="colorSurface">@color/colorP2pSurface</item>
        <item name="colorOnSurface">@color/colorP2pTextPrimary</item>
        <item name="colorOnBackground">@color/colorP2pTextPrimary</item>
        <item name="colorOnSurfaceVariant">@color/colorP2pTextSecondary</item>
        <item name="android:textColorPrimary">@color/colorP2pTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorP2pTextSecondary</item>
        <item name="android:textColorHint">@color/colorP2pTextMuted</item>
        <item name="colorPrimary">@color/colorP2pAccent</item>
        <item name="colorAccent">@color/colorP2pAccent</item>
        <item name="colorSecondary">@color/colorP2pAccent</item>
        <item name="colorOnSecondary">@color/colorP2pOnAccent</item>
        <item name="colorControlActivated">@color/colorP2pAccent</item>
        <item name="android:navigationBarColor">@color/colorP2pBg</item>
        <item name="colorOnPrimary">@color/colorP2pOnAccent</item>
        <item name="alertDialogTheme">@style/HarvanaP2pAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/HarvanaP2pAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/HarvanaP2pBottomSheetDialog</item>
    </style>

    <style name="HarvanaP2pAlertDialog" parent="HarvanaAlertDialog">
        <item name="colorPrimary">@color/colorP2pAccent</item>
        <item name="colorAccent">@color/colorP2pAccent</item>
        <item name="colorSurface">@color/colorP2pSurface</item>
        <item name="colorOnPrimary">@color/colorP2pOnAccent</item>
        <item name="colorOnSurface">@color/colorP2pTextPrimary</item>
        <item name="android:textColorPrimary">@color/colorP2pTextPrimary</item>
        <item name="android:windowBackground">@color/colorP2pSurface</item>
        <item name="buttonBarPositiveButtonStyle">@style/HarvanaP2pDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/HarvanaP2pDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/HarvanaP2pDialogButton</item>
    </style>

    <style name="HarvanaP2pDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorP2pAccent</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="HarvanaP2pBottomSheetDialog" parent="HarvanaBottomSheetDialog">
        <item name="colorPrimary">@color/colorP2pAccent</item>
        <item name="colorAccent">@color/colorP2pAccent</item>
        <item name="colorSurface">@color/colorP2pSurface</item>
        <item name="colorOnPrimary">@color/colorP2pOnAccent</item>
        <item name="colorOnSurface">@color/colorP2pTextPrimary</item>
        <item name="colorOnSurfaceVariant">@color/colorP2pTextSecondary</item>
        <item name="android:textColorPrimary">@color/colorP2pTextPrimary</item>
        <item name="bottomSheetStyle">@style/HarvanaP2pBottomSheetStyle</item>
    </style>

    <style name="HarvanaP2pBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/colorP2pSurface</item>
        <item name="shapeAppearanceOverlay">@style/HarvanaBottomSheetShape</item>
    </style>

    <style name="P2pSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/colorP2pTextPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="P2pFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/colorP2pTextSecondary</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="P2pAmountChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_p2p_chip</item>
        <item name="android:textColor">@color/colorP2pTextPrimary</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="P2pCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_p2p_card</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="P2pSummaryRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="P2pSummaryKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/colorP2pTextSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="P2pSummaryVal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/colorP2pTextPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="P2pSettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/bg_p2p_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="P2pSettingsValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/colorP2pTextPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="P2pDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/colorP2pBorder</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="HarvanaTextView" parent="android:Widget.TextView">
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <!-- Menus: a different shade from the page, with an edge and a soft shadow. -->
    <style name="HarvanaPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">10dp</item>
    </style>

    <!-- The avatar scale: three sizes, then stop. 24 in lists, 32 in headers, 40 on profiles. -->
    <style name="Avatar.Initials" parent="android:Widget.TextView">
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Avatar.Initials.List">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="Avatar.Initials.Header">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Avatar.Initials.Profile">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Material look everywhere: one style per widget, used by every screen through the theme. -->
    <style name="HarvanaButton.Tonal">
        <item name="backgroundTint">@color/colorAccentSoft</item>
        <item name="android:textColor">@color/colorAccentStrong</item>
    </style>

    <style name="HarvanaButton.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorAccentStrong</item>
        <item name="rippleColor">@color/colorAccentRipple</item>
    </style>

    <style name="Harvana.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/colorCardStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/colorAccentRipple</item>
    </style>

    <style name="Harvana.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/colorAccent</item>
        <item name="hintTextColor">@color/colorAccent</item>
        <item name="android:textColorHint">@color/colorTextTertiary</item>
    </style>
    <style name="Harvana.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="useMaterialThemeColors">false</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="android:minHeight">40dp</item>
    </style>
    <!-- One option in a segmented choice (MaterialButtonToggleGroup): filled accent when chosen, soft inset colour otherwise. -->
    <style name="Harvana.Segment" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="strokeColor">@color/colorCardStroke</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/toggle_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
    <style name="Harvana.Tab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Harvana.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextAppearance">@style/Harvana.ToolbarTitle</item>
        <item name="subtitleTextAppearance">@style/Harvana.ToolbarSubtitle</item>
        <item name="contentInsetStartWithNavigation">4dp</item>
        <item name="titleTextColor">?attr/onAppBarColor</item>
        <item name="subtitleTextColor">?attr/onAppBarColor</item>
    </style>
    <style name="Harvana.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Harvana.ToolbarSubtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Widget.Harvana.Loader" parent="android:Widget.ProgressBar">
        <item name="android:indeterminateDrawable">@drawable/avd_harvana_loader</item>
        <item name="android:indeterminateDuration">1100</item>
    </style>

</resources>
