rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/GROUPS/$(groupId)).data;
    }

    function memberDoc(groupId) {
      return get(/databases/$(database)/documents/GROUPS/$(groupId)/members/$(request.auth.uid)).data;
    }

    function isGroupCreator(groupId) {
      return signedIn() && groupDoc(groupId).creatorId == request.auth.uid;
    }

    function isActiveMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/GROUPS/$(groupId)/members/$(request.auth.uid))
        && memberDoc(groupId).status == 'ACTIVE';
    }

    function isCreatorOrMember(groupId) {
      return isGroupCreator(groupId) || isActiveMember(groupId);
    }

    // Who invited this member (referral by username). Set once, at sign-up or the first time it is added, to someone
    // else who exists; after that it cannot be changed or removed. The referral only counts on the network once that
    // person has confirmed it too (REFERRAL_ASKS below, and the node checks both signatures).
    function referrerSetOk() {
      return !('referred_by_uid' in request.resource.data)
        || (request.resource.data.referred_by_uid is string
            && request.resource.data.referred_by_uid != request.auth.uid
            && exists(/databases/$(database)/documents/USERS/$(request.resource.data.referred_by_uid)));
    }

    function referrerUnchangedOrNew() {
      return ('referred_by_uid' in resource.data)
        ? (request.resource.data.get('referred_by_uid', '') == resource.data.referred_by_uid
            && request.resource.data.get('referred_by_username', '') == resource.data.get('referred_by_username', ''))
        : referrerSetOk();
    }

    function pidLinkOwned(pid) {
      return exists(/databases/$(database)/documents/PIDS/$(pid))
        && get(/databases/$(database)/documents/PIDS/$(pid)).data.uid == request.auth.uid;
    }

    function paymentConfirmOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'txRef', 'confirmedAt']);
    }

    // A2: personal fields now live in USERS/{uid}/private/kyc (below). Once every account has been
    // opened once on the new app build they are gone from this document. Narrowing this read to the
    // owner is a later step: other screens still read names and icons from here.
    match /USERS/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && referrerSetOk();
      allow update: if isSelf(uid) && referrerUnchangedOrNew();
      allow delete: if false;
    }

    // A2 fix: date of birth, BVN/NIN, phone, email, address, GPS and next of kin live here, not in
    // USERS/{uid}. Only the owner can read or write it. The app (UserProfileManager) moves old
    // accounts' fields here on their next profile load. DEPLOY THIS RULE BEFORE the app update:
    // without it, new sign-ups cannot save their profile.
    match /USERS/{uid}/private/{doc} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }

    // Published Learn Hub articles. Only the node's review service (server credentials) creates
    // or removes these; the app can read them and bump the view counter.
    match /LEARN_CONTENT/{contentId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    // Reactions and comments on a published article. One reaction per person (the document id is the uid).
    // Reactions and comments on a published article. One reaction per person (the document id is the uid).
    match /LEARN_CONTENT/{contentId}/reactions/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /LEARN_CONTENT/{contentId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.at is number;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Submissions waiting for the node's automatic review. The author creates one (always PENDING) and
    // can read their own verdict; only the node changes status (APPROVED / REJECTED / NEEDS_REVIEW).
    match /LEARN_SUBMISSIONS/{submissionId} {
      allow read: if request.auth != null && resource.data.authorUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 600
        && request.resource.data.category is string
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('^https://.*')
        && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    match /GROUPS/{groupId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.keys().hasAll(['groupName', 'creatorId', 'groupType']);

      // Creator edits anything. Any ACTIVE member may only refresh the member counter
      // (written by whoever admits/leaves).
      allow update: if isGroupCreator(groupId)
        || (isActiveMember(groupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membersCount']));
      allow delete: if isGroupCreator(groupId);

      // Wallet Access Card backup (ciphertext only; the passphrase never leaves the admin).
      // Members read; only the group creator writes; never deleted.
      match /private/{docId} {
        allow read: if isCreatorOrMember(groupId);
        allow create, update: if isGroupCreator(groupId);
        allow delete: if isGroupCreator(groupId); // only when the whole group is deleted
      }

      match /members/{memberUid} {
        allow read: if signedIn();

        // A1/A6 fix: the creator may add anyone; a user may add only THEMSELVES, as a plain
        // MEMBER, and only if the group does not require approval or their join request
        // was APPROVED.
        allow create: if signedIn()
          && request.resource.data.status == 'ACTIVE'
          && (
            isGroupCreator(groupId)
            || ( request.auth.uid == memberUid
                 && request.resource.data.role == 'MEMBER'
                 && groupDoc(groupId).get('status', 'Active') != 'Closed'
                 && ( groupDoc(groupId).requireApprovalToJoin == false
                      || ( exists(/databases/$(database)/documents/GROUPS/$(groupId)/joinRequests/$(memberUid))
                           && get(/databases/$(database)/documents/GROUPS/$(groupId)/joinRequests/$(memberUid)).data.status == 'APPROVED' ) ) )
          );

        // THE UPGRADE: added 'status' to the self-update whitelist so a
        // member can mark their own membership as LEFT (Leave Group).
        // 'role' deliberately stays out of this list — the one place a
        // member's own role gets self-updated (Transfer Admin's old
        // admin demoting themselves) happens while they're still
        // isGroupCreator, which already authorizes it independently, so
        // no self-service path for changing your own role is needed or
        // wanted here.
        allow update: if isGroupCreator(groupId)
          || (isSelf(memberUid)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['walletAddress', 'wallet_address', 'status']));

        allow delete: if isGroupCreator(groupId);
      }

      match /joinRequests/{requesterUid} {
        allow read: if signedIn();

        allow create: if isSelf(requesterUid)
          && groupDoc(groupId).get('status', 'Active') != 'Closed'
          && request.resource.data.status == 'PENDING';

        // A3 fix: members may only add a vote; only the creator changes status/slot.
        // NOTE: this pauses member-vote approvals until the node/Cloud Function resolves them.
        allow update: if isGroupCreator(groupId)
          || (isActiveMember(groupId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']));

        allow delete: if isGroupCreator(groupId) || isSelf(requesterUid);
      }

      match /payments/{paymentId} {
        allow read: if isCreatorOrMember(groupId);

        allow create: if isCreatorOrMember(groupId)
          && request.resource.data.keys().hasAny(['type', 'status', 'amountHarv', 'timestamp']);

        allow update: if isCreatorOrMember(groupId)
          && paymentConfirmOnly()
          && resource.data.status == 'PENDING'
          && request.resource.data.status == 'CONFIRMED';

        allow delete: if isGroupCreator(groupId);
      }

      match /loans/{loanId} {
        allow read: if isCreatorOrMember(groupId);

        allow create: if isActiveMember(groupId)
          && request.resource.data.status == 'PENDING'
          && request.resource.data.borrowerUid == request.auth.uid;

        allow update: if isGroupCreator(groupId)
          || (isSelf(resource.data.borrowerUid)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['repaidAmountHarv', 'lastRepayAt', 'lastRepayTxRef', 'status', 'repaidAt', 'txRepayRef'])
              && (request.resource.data.status == resource.data.status
                  || request.resource.data.status == 'REPAID'));

        allow delete: if isGroupCreator(groupId);
      }

      match /payoutRequests/{requestId} {
        allow read: if isCreatorOrMember(groupId);

        allow create: if isActiveMember(groupId)
          && request.resource.data.status == 'PENDING'
          && request.resource.data.requesterUid == request.auth.uid;

        allow update: if isGroupCreator(groupId)
          && request.resource.data.status in ['APPROVED', 'REJECTED'];

        allow delete: if isGroupCreator(groupId);
      }

      match /notices/{noticeId} {
        allow read: if isCreatorOrMember(groupId);

        allow create: if isGroupCreator(groupId)
          && request.resource.data.type == 'ANNOUNCEMENT'
          && request.resource.data.creatorId == request.auth.uid;

        allow create: if isCreatorOrMember(groupId)
          && request.resource.data.type == 'SYSTEM'
          && request.resource.data.system == true;

        allow create: if isCreatorOrMember(groupId)
          && !('type' in request.resource.data.keys());

        allow update, delete: if isGroupCreator(groupId);
      }
    }

    // Group invitations, keyed by the invitee's email. The creator (or, if the group allows it, an
    // active member) may invite. Only the invitee - with a VERIFIED email matching the invite - may read
    // it or answer it, and only status/respondedAt may change.
    match /INVITES/{inviteId} {
      function inviteeIsMe() {
        return signedIn()
          && (resource.data.get('inviteeUid', '') == request.auth.uid
              || (request.auth.token.email_verified == true
                  && resource.data.get('inviteeEmail', '') == request.auth.token.email.lower()));
      }
      allow create: if signedIn()
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && (isGroupCreator(request.resource.data.groupId)
            || (isActiveMember(request.resource.data.groupId)
                && groupDoc(request.resource.data.groupId).membersCanInvite == true));
      allow read: if signedIn() && (resource.data.inviterUid == request.auth.uid || inviteeIsMe());
      allow update: if inviteeIsMe()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['ACCEPTED', 'DECLINED'];
      allow delete: if signedIn() && resource.data.inviterUid == request.auth.uid;
    }

    // ── People: usernames, friends, contact cards ─────────────────────
    // Usernames are unique. A name can be looked up one at a time (get) but never listed, so there is no
    // member directory to scrape.
    match /USERNAMES/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == name
        && name.matches('^[a-z][a-z0-9_.]{2,19}$');
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // A pinch: a nudge to someone you follow. One document per sender and person (the id is the sender), so the same
    // friend can pinch the same person only once an hour. The time is the server's. Only the receiver can read them.
    // The receiver's phone looks the sender's name up from their profile, so a pinch cannot pose as someone else.
    match /PINCHES/{to}/from/{sender} {
      allow read: if signedIn() && request.auth.uid == to;
      allow create: if signedIn() && request.auth.uid == sender && sender != to
        && request.resource.data.keys().hasOnly(['from', 'at'])
        && request.resource.data.from == sender
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/FOLLOWERS/$(to)/list/$(sender));
      allow update: if signedIn() && request.auth.uid == sender
        && request.resource.data.keys().hasOnly(['from', 'at'])
        && request.resource.data.from == sender
        && request.resource.data.at == request.time
        && resource.data.at < request.time - duration.value(1, 'h');
      allow delete: if signedIn() && request.auth.uid == to;
    }

    // Referral requests. The new member leaves one for the person they named (their profile must name that person);
    // the person named reads it and confirms it by adding a signed consent, or declines by deleting it.
    match /REFERRAL_ASKS/{referrer}/from/{referred} {
      allow read: if signedIn() && (request.auth.uid == referrer || request.auth.uid == referred);
      allow create: if signedIn() && request.auth.uid == referred
        && request.resource.data.keys().hasOnly(['from', 'referredAddress', 'at'])
        && request.resource.data.from == referred
        && request.resource.data.referredAddress is string
        && request.resource.data.referredAddress.matches('^HV0x[0-9a-fA-F]{40}$')
        && get(/databases/$(database)/documents/USERS/$(referred)).data.get('referred_by_uid', '') == referrer;
      allow update: if signedIn() && request.auth.uid == referrer
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consent_address', 'consent_pub', 'consent_sig', 'status'])
        && request.resource.data.status == 'CONSENTED';
      allow delete: if signedIn() && (request.auth.uid == referrer || request.auth.uid == referred);
    }

    // Chat on a P2P trade. The document id is {orderId}_{uidA}_{uidB} with the two uids in order, so nobody can take over the chat of
    // a trade they are not in by creating its document first. Only the two members can read or write. Messages are kept for 30
    // days after the last one (expiresAt) and either person may delete an expired chat; there is no server job to do it.
    match /P2P_CHATS/{chatId} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt', 'lastAt', 'lastFrom', 'expiresAt'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && chatId.matches('^.+_' + request.resource.data.members[0] + '_' + request.resource.data.members[1] + '$')
        && request.resource.data.expiresAt is number;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.keys().hasOnly(['members', 'createdAt', 'lastAt', 'lastFrom', 'expiresAt'])
        && request.resource.data.lastFrom == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid in resource.data.members
        && resource.data.expiresAt < request.time.toMillis();

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/P2P_CHATS/$(chatId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/P2P_CHATS/$(chatId)).data.members
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/P2P_CHATS/$(chatId)).data.members
          && get(/databases/$(database)/documents/P2P_CHATS/$(chatId)).data.expiresAt < request.time.toMillis();
      }
    }

    // People I follow: private to me.
    match /FRIENDS/{owner}/list/{friend} {
      allow read, write: if signedIn() && request.auth.uid == owner;
    }

    // Who follows {owner}: the follower writes their own row; the owner reads and may remove rows.
    match /FOLLOWERS/{owner}/list/{follower} {
      allow read: if signedIn() && request.auth.uid == owner;
      allow create: if signedIn() && request.auth.uid == follower && request.resource.data.uid == follower;
      allow update: if false;
      allow delete: if signedIn() && (request.auth.uid == follower || request.auth.uid == owner);
    }

    // Phone number and chat links. Readable by the owner and by people who follow each other with the owner.
    match /CONTACTS/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (exists(/databases/$(database)/documents/FRIENDS/$(uid)/list/$(request.auth.uid))
            && exists(/databases/$(database)/documents/FRIENDS/$(request.auth.uid)/list/$(uid))));
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Contact discovery (opt-in). Keys are SHA-256 of a phone number / verified email, so the index holds nothing
    // readable. Entries are read by exact key (get, or a small "in" query); paging through everything is capped.
    match /PHONE_INDEX/{key} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 10;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /EMAIL_INDEX/{key} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 10;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /P2P_PAYMENT_DETAILS/{listingId} {
      allow create: if signedIn()
  && request.auth.uid == request.resource.data.sellerUid
  && request.resource.data.keys().hasAll(['listingId', 'paymentMethods', 'accountName', 'sellerUid', 'createdAtMs'])
  && request.resource.data.listingId == listingId;

      allow read: if signedIn()
        && (request.auth.uid == resource.data.sellerUid
            || exists(/databases/$(database)/documents/P2P_PAYMENT_DETAILS/$(listingId)/authorizedBuyers/$(request.auth.uid)));

      allow update, delete: if false;

      match /authorizedBuyers/{buyerUid} {
        allow create: if signedIn()
          && request.auth.uid == buyerUid
          && request.resource.data.keys().hasAll(['orderId', 'claimedAtMs']);

        allow read: if signedIn()
          && (request.auth.uid == buyerUid
              || request.auth.uid == get(/databases/$(database)/documents/P2P_PAYMENT_DETAILS/$(listingId)).data.sellerUid);

        allow update, delete: if false;
      }
    }

    // GROUND-UP (Sept 2026) — completed-trade reputation events. Written
    // ONLY by the node, via its own service-account credential — that
    // path authenticates through Google Cloud IAM and bypasses these
    // rules entirely, so "allow write: if false" here has zero effect on
    // it. This block exists purely to guarantee no client (modded,
    // scripted, or otherwise) can ever write here directly — that
    // client-writable path was the actual vulnerability this closes.
    match /P2P_COMPLETED_TRADES/{txHash} {
      // Public reputation data, deliberately not restricted to "your own"
      // — the Express match card and the insurance-criteria checklist
      // both need to read a COUNTERPARTY's stats, not just your own.
      allow read: if signedIn();
      allow write: if false;
    }

    // GROUND-UP (Sept 17 2026) — the fulfilling seller's chosen bank/
    // mobile-money account for one specific order against a BUY listing
    // (a BUY listing's poster has nowhere to pre-set this, since they're
    // the one paying, not receiving — see P2pSellOrderActivity's class
    // doc). Contains real account details, so unlike P2P_COMPLETED_TRADES
    // this is NOT publicly readable — only the two real parties to this
    // specific order, proven by uid match, not by anyone claiming to be
    // one of them.
    match /P2P_ORDER_PAYMENT_DETAILS/{orderId} {
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.sellerUid
        && request.resource.data.keys().hasAll(['orderId', 'sellerUid', 'buyerUid', 'primaryField', 'accountIdentifier', 'accountName', 'createdAtMs'])
        && request.resource.data.orderId == orderId;

      allow read: if signedIn()
        && (request.auth.uid == resource.data.sellerUid
            || request.auth.uid == resource.data.buyerUid);

      allow update, delete: if false;
    }

    match /MEMBER_REPORTS/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update, delete: if false;
    }

    match /REPORTS/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update, delete: if false;
    }

    match /TRANSACTIONS/{txId} {
      allow read: if signedIn();
      // A5 fix: clients no longer create transaction records (the app has no writer).
      allow create, update, delete: if false;
    }

    // Node copies. The service account writes these and skips these rules.
    // A signed-in phone may read them. It cannot create, change, or delete them.
    match /REPUTATION/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /GROUP_TRUST/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /GROUP_STATE/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /GROUP_MEMBERS/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /STAKING_INFO/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /STAKING/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /WALLET_LINKS/{docId} {
      allow read, write: if false;
    }

    // What the member did in the app. They may add their own rows and read them.
    // This does not change the 0–26 score. The network half is REPUTATION, written by the node.
    match /USERS/{uid}/ACTIVITY/{eventId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['kind', 'title', 'detail', 'at', 'source'])
        && request.resource.data.source == 'app'
        && request.resource.data.kind is string
        && request.resource.data.kind.size() > 0
        && request.resource.data.kind.size() <= 32
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 120
        && request.resource.data.at is number
        && request.resource.data.at > 0;
      allow update, delete: if false;
    }

    // Permanent 10-digit id → owner. Clients never read this. Rules do,
    // to check that the signed-in user owns the PID they are writing.
    match /PIDS/{pid} {
      allow read: if false;
      allow create: if signedIn()
        && pid.matches('^[0-9]{10}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Public card. No date of birth, ID number, address, phone or next of kin.
    //
    // Trust: trust_percent, trust_tier, trust_updated and wallet are written by the node only (its service account skips these
    // rules). A user can create or edit their card but cannot add those fields, change them, or remove them, so the
    // score on a profile is read-only for its owner and cannot be hidden. The old client-writable trust_score is gone.
    // Public profile card. Besides the node-written trust fields it holds what the member chooses to show: country and state
    // (always shown), city and age (only when the member turns them on; the phone removes them otherwise), a short bio, and counts
    // (groups, cycles, loans, pending loans) with no amounts. The counts are written by the member's own phone.
    match /PROFILES/{pid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && pidLinkOwned(pid)
        && request.resource.data.pid == pid
        && request.resource.data.keys().hasOnly(['pid', 'first_name', 'last_name', 'username', 'icon', 'tier', 'country', 'state', 'city', 'age', 'show_age', 'show_city', 'bio', 'member_since', 'groups_count', 'cycles_completed', 'loans_count', 'loans_pending', 'stats_updated']);
      allow update: if signedIn()
        && pidLinkOwned(pid)
        && request.resource.data.pid == pid
        && request.resource.data.keys().hasOnly(
          ['pid', 'first_name', 'last_name', 'username', 'icon', 'tier', 'trust_percent', 'trust_tier', 'trust_updated', 'wallet',
           'country', 'state', 'city', 'age', 'show_age', 'show_city', 'bio', 'member_since', 'groups_count', 'cycles_completed', 'loans_count', 'loans_pending', 'stats_updated'])
        && request.resource.data.get('trust_percent', null) == resource.data.get('trust_percent', null)
        && request.resource.data.get('trust_tier', null) == resource.data.get('trust_tier', null)
        && request.resource.data.get('trust_updated', null) == resource.data.get('trust_updated', null)
        && request.resource.data.get('wallet', null) == resource.data.get('wallet', null);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
