rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/GROUPS/$(groupId)).data;
    }

    function memberDoc(groupId) {
      return get(/databases/$(database)/documents/GROUPS/$(groupId)/members/$(request.auth.uid)).data;
    }

    function isGroupCreator(groupId) {
      return signedIn() && groupDoc(groupId).creatorId == request.auth.uid;
    }

    function isActiveMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/GROUPS/$(groupId)/members/$(request.auth.uid))
        && memberDoc(groupId).status == 'ACTIVE';
    }

    function isCreatorOrMember(groupId) {
      return isGroupCreator(groupId) || isActiveMember(groupId);
    }

    function paymentConfirmOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'txRef', 'confirmedAt']);
    }

    function userDoc() {
      return get(/databases/$(database)/documents/USERS/$(request.auth.uid)).data;
    }

    // First claim, or at least 30 days since the last one. get() sees the
    // document from before this write, so the same transaction can stamp now.
    function usernameChangeDue() {
      return !exists(/databases/$(database)/documents/USERS/$(request.auth.uid))
        || !('usernameChangedAt' in userDoc())
        || request.time > userDoc().usernameChangedAt + duration.value(30, 'd');
    }

    // A released name stays with its previous owner for 90 days.
    function usernameHeldBySomeoneElse(name) {
      return exists(/databases/$(database)/documents/USERNAME_HOLDS/$(name))
        && get(/databases/$(database)/documents/USERNAME_HOLDS/$(name)).data.uid != request.auth.uid
        && request.time < get(/databases/$(database)/documents/USERNAME_HOLDS/$(name)).data.releasedAt + duration.value(90, 'd');
    }

    function pidLinkOwned(pid) {
      return exists(/databases/$(database)/documents/PIDS/$(pid))
        && get(/databases/$(database)/documents/PIDS/$(pid)).data.uid == request.auth.uid;
    }

    // OPEN ITEM (A2): any signed-in user can still read every profile. New accounts
    // also write PROFILES/{pid} (name, photo, username, tier only). Narrow this
    // read to the owner once every other screen reads the public card by PID.
    match /USERS/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && (!('pid' in request.resource.data)
            || (request.resource.data.pid.matches('^[0-9]{10}$') && pidLinkOwned(request.resource.data.pid)))
        && (!('usernameChangedAt' in request.resource.data)
            || request.resource.data.usernameChangedAt == request.time);
      allow update: if isSelf(uid)
        && (
          (!('usernameChangedAt' in resource.data) && !('usernameChangedAt' in request.resource.data))
          || (!('usernameChangedAt' in resource.data) && request.resource.data.usernameChangedAt == request.time)
          || ('usernameChangedAt' in resource.data
              && 'usernameChangedAt' in request.resource.data
              && (request.resource.data.usernameChangedAt == request.time
                  || request.resource.data.usernameChangedAt == resource.data.usernameChangedAt))
        )
        && (
          (!('pid' in resource.data) && !('pid' in request.resource.data))
          || ('pid' in resource.data && request.resource.data.pid == resource.data.pid)
          || (!('pid' in resource.data)
              && request.resource.data.pid.matches('^[0-9]{10}$')
              && pidLinkOwned(request.resource.data.pid))
        );
      allow delete: if false;
    }

    // Published Learn Hub articles. Only the node's review service (server credentials) creates
    // or removes these; the app can read them and bump the view counter.
    match /LEARN_CONTENT/{contentId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    // Submissions waiting for the node's automatic review. The author creates one (always PENDING) and
    // can read their own verdict; only the node changes status (APPROVED / REJECTED / NEEDS_REVIEW).
    match /LEARN_SUBMISSIONS/{submissionId} {
      allow read: if request.auth != null && resource.data.authorUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 600
        && request.resource.data.category is string
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('^https://.*')
        && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    match /GROUPS/{groupId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.keys().hasAll(['groupName', 'creatorId', 'groupType']);

      // Creator edits anything. Any ACTIVE member may only refresh the member counter
      // (written by whoever admits/leaves).
      allow update: if isGroupCreator(groupId)
        || (isActiveMember(groupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membersCount']));
      allow delete: if isGroupCreator(groupId);

      // Wallet Access Card backup (ciphertext only; the passphrase never leaves the admin).
      // Members read; only the group creator writes; never deleted.
      match /private/{docId} {
        allow read: if isCreatorOrMember(groupId);
        allow create, update: if isGroupCreator(groupId);
        allow delete: if isGroupCreator(groupId); // only when the whole group is deleted
      }

      match /members/{memberUid} {
        allow read: if signedIn();

        // A1/A6 fix: the creator may add anyone; a user may add only THEMSELVES, as a plain
        // MEMBER, and only if the group does not require approval or their join request
        // was APPROVED.
        allow create: if signedIn()
          && request.resource.data.status == 'ACTIVE'
          && (
            isGroupCreator(groupId)
            || ( request.auth.uid == memberUid
                 && request.resource.data.role == 'MEMBER'
                 && groupDoc(groupId).get('status', 'Active') != 'Closed'
                 && ( groupDoc(groupId).requireApprovalToJoin == false
                      || ( exists(/databases/$(database)/documents/GROUPS/$(groupId)/joinRequests/$(memberUid))
                           && get(/databases/$(database)/documents/GROUPS/$(groupId)/joinRequests/$(memberUid)).data.status == 'APPROVED' ) ) )
          );

        // THE UPGRADE: added 'status' to the self-update whitelist so a
        // member can mark their own membership as LEFT (Leave Group).
        // 'role' deliberately stays out of this list — the one place a
        // member's own role gets self-updated (Transfer Admin's old
        // admin demoting themselves) happens while they're still
        // isGroupCreator, which already authorizes it independently, so
        // no self-service path for changing your own role is needed or
        // wanted here.
        allow update: if isGroupCreator(groupId)
          || (isSelf(memberUid)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['walletAddress', 'wallet_address', 'status']));

        allow delete: if isGroupCreator(groupId);
      }

      match /joinRequests/{requesterUid} {
        allow read: if signedIn();

        allow create: if isSelf(requesterUid)
          && groupDoc(groupId).get('status', 'Active') != 'Closed'
          && request.resource.data.status == 'PENDING';

        // A3 fix: members may only add a vote; only the creator changes status/slot.
        // NOTE: this pauses member-vote approvals until the node/Cloud Function resolves them.
        allow update: if isGroupCreator(groupId)
          || (isActiveMember(groupId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']));

        allow delete: if isGroupCreator(groupId) || isSelf(requesterUid);
      }

      match /payments/{paymentId} {
        allow read: if isCreatorOrMember(groupId);

        // A member can only open a PENDING row. CONFIRMED / REJECTED ledger
        // rows are written by the group creator (payout, loan, month close).
        // A member must not create a payment that already says CONFIRMED.
        allow create: if isCreatorOrMember(groupId)
          && request.resource.data.keys().hasAny(['type', 'status', 'amountHarv', 'timestamp'])
          && (
            request.resource.data.status == 'PENDING'
            || (isGroupCreator(groupId)
                && request.resource.data.status in ['CONFIRMED', 'REJECTED', 'PENDING_ADMIN_TRANSFER'])
          );

        // A4: only the group creator may move PENDING → CONFIRMED, and only
        // those three fields. Any other member used to be able to do this.
        allow update: if isGroupCreator(groupId)
          && paymentConfirmOnly()
          && resource.data.status == 'PENDING'
          && request.resource.data.status == 'CONFIRMED';

        allow delete: if isGroupCreator(groupId);
      }

      match /loans/{loanId} {
        allow read: if isCreatorOrMember(groupId);

        allow create: if isActiveMember(groupId)
          && request.resource.data.status == 'PENDING'
          && request.resource.data.borrowerUid == request.auth.uid;

        allow update: if isGroupCreator(groupId)
          || (isSelf(resource.data.borrowerUid)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['repaidAmountHarv', 'lastRepayAt', 'lastRepayTxRef', 'status', 'repaidAt', 'txRepayRef'])
              && (request.resource.data.status == resource.data.status
                  || request.resource.data.status == 'REPAID'));

        allow delete: if isGroupCreator(groupId);
      }

      match /payoutRequests/{requestId} {
        allow read: if isCreatorOrMember(groupId);

        allow create: if isActiveMember(groupId)
          && request.resource.data.status == 'PENDING'
          && request.resource.data.requesterUid == request.auth.uid;

        allow update: if isGroupCreator(groupId)
          && request.resource.data.status in ['APPROVED', 'REJECTED'];

        allow delete: if isGroupCreator(groupId);
      }

      match /notices/{noticeId} {
        allow read: if isCreatorOrMember(groupId);

        allow create: if isGroupCreator(groupId)
          && request.resource.data.type == 'ANNOUNCEMENT'
          && request.resource.data.creatorId == request.auth.uid;

        allow create: if isCreatorOrMember(groupId)
          && request.resource.data.type == 'SYSTEM'
          && request.resource.data.system == true;

        allow create: if isCreatorOrMember(groupId)
          && !('type' in request.resource.data.keys());

        allow update, delete: if isGroupCreator(groupId);
      }
    }

    // Group invitations, keyed by the invitee's email. The creator (or, if the group allows it, an
    // active member) may invite. Only the invitee - with a VERIFIED email matching the invite - may read
    // it or answer it, and only status/respondedAt may change.
    match /INVITES/{inviteId} {
      function inviteeIsMe() {
        return signedIn()
          && (resource.data.get('inviteeUid', '') == request.auth.uid
              || (request.auth.token.email_verified == true
                  && resource.data.get('inviteeEmail', '') == request.auth.token.email.lower()));
      }
      allow create: if signedIn()
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && (isGroupCreator(request.resource.data.groupId)
            || (isActiveMember(request.resource.data.groupId)
                && groupDoc(request.resource.data.groupId).membersCanInvite == true));
      allow read: if signedIn() && (resource.data.inviterUid == request.auth.uid || inviteeIsMe());
      allow update: if inviteeIsMe()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['ACCEPTED', 'DECLINED'];
      allow delete: if signedIn() && resource.data.inviterUid == request.auth.uid;
    }

    // ── People: usernames, friends, contact cards ─────────────────────
    // Usernames are unique. A name can be looked up one at a time (get) but never listed, so there is no
    // member directory to scrape.
    match /USERNAMES/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == name
        && name.matches('^[a-z][a-z0-9_.]{2,19}$')
        && usernameChangeDue()
        && !usernameHeldBySomeoneElse(name);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Old usernames, held for 90 days so a stranger cannot take one over.
    // releasedAt must be the server time of this write, not a client clock.
    match /USERNAME_HOLDS/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'releasedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.releasedAt == request.time
        && exists(/databases/$(database)/documents/USERNAMES/$(name))
        && get(/databases/$(database)/documents/USERNAMES/$(name)).data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'releasedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.releasedAt == request.time;
      allow delete: if signedIn()
        && request.time > resource.data.releasedAt + duration.value(90, 'd');
    }

    // Permanent 10-digit id → owner. Clients never read this. Rules do,
    // to check that the signed-in user owns the PID they are writing.
    match /PIDS/{pid} {
      allow read: if false;
      allow create: if signedIn()
        && pid.matches('^[0-9]{10}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Public card. No date of birth, ID number, address, phone or next of kin.
    match /PROFILES/{pid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && pidLinkOwned(pid)
        && request.resource.data.pid == pid
        && request.resource.data.keys().hasOnly(
          ['pid', 'first_name', 'last_name', 'username', 'icon', 'tier', 'trust_score']);
      allow delete: if false;
    }

    // People I follow: private to me.
    match /FRIENDS/{owner}/list/{friend} {
      allow read, write: if signedIn() && request.auth.uid == owner;
    }

    // Who follows {owner}: the follower writes their own row; the owner reads and may remove rows.
    match /FOLLOWERS/{owner}/list/{follower} {
      allow read: if signedIn() && request.auth.uid == owner;
      allow create: if signedIn() && request.auth.uid == follower && request.resource.data.uid == follower;
      allow update: if false;
      allow delete: if signedIn() && (request.auth.uid == follower || request.auth.uid == owner);
    }

    // Phone number and chat links. Readable by the owner and by people who follow each other with the owner.
    match /CONTACTS/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (exists(/databases/$(database)/documents/FRIENDS/$(uid)/list/$(request.auth.uid))
            && exists(/databases/$(database)/documents/FRIENDS/$(request.auth.uid)/list/$(uid))));
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Contact discovery (opt-in). Keys are SHA-256 of a phone number / verified email, so the index holds nothing
    // readable. Entries are read by exact key (get, or a small "in" query); paging through everything is capped.
    match /PHONE_INDEX/{key} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 10;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /EMAIL_INDEX/{key} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 10;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /P2P_PAYMENT_DETAILS/{listingId} {
      allow create: if signedIn()
  && request.auth.uid == request.resource.data.sellerUid
  && request.resource.data.keys().hasAll(['listingId', 'paymentMethods', 'accountName', 'sellerUid', 'createdAtMs'])
  && request.resource.data.listingId == listingId;

      allow read: if signedIn()
        && (request.auth.uid == resource.data.sellerUid
            || exists(/databases/$(database)/documents/P2P_PAYMENT_DETAILS/$(listingId)/authorizedBuyers/$(request.auth.uid)));

      allow update, delete: if false;

      match /authorizedBuyers/{buyerUid} {
        allow create: if signedIn()
          && request.auth.uid == buyerUid
          && request.resource.data.keys().hasAll(['orderId', 'claimedAtMs']);

        allow read: if signedIn()
          && (request.auth.uid == buyerUid
              || request.auth.uid == get(/databases/$(database)/documents/P2P_PAYMENT_DETAILS/$(listingId)).data.sellerUid);

        allow update, delete: if false;
      }
    }

    // GROUND-UP (Sept 2026) — completed-trade reputation events. Written
    // ONLY by the node, via its own service-account credential — that
    // path authenticates through Google Cloud IAM and bypasses these
    // rules entirely, so "allow write: if false" here has zero effect on
    // it. This block exists purely to guarantee no client (modded,
    // scripted, or otherwise) can ever write here directly — that
    // client-writable path was the actual vulnerability this closes.
    match /P2P_COMPLETED_TRADES/{txHash} {
      // Public reputation data, deliberately not restricted to "your own"
      // — the Express match card and the insurance-criteria checklist
      // both need to read a COUNTERPARTY's stats, not just your own.
      allow read: if signedIn();
      allow write: if false;
    }

    // GROUND-UP (Sept 17 2026) — the fulfilling seller's chosen bank/
    // mobile-money account for one specific order against a BUY listing
    // (a BUY listing's poster has nowhere to pre-set this, since they're
    // the one paying, not receiving — see P2pSellOrderActivity's class
    // doc). Contains real account details, so unlike P2P_COMPLETED_TRADES
    // this is NOT publicly readable — only the two real parties to this
    // specific order, proven by uid match, not by anyone claiming to be
    // one of them.
    match /P2P_ORDER_PAYMENT_DETAILS/{orderId} {
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.sellerUid
        && request.resource.data.keys().hasAll(['orderId', 'sellerUid', 'buyerUid', 'primaryField', 'accountIdentifier', 'accountName', 'createdAtMs'])
        && request.resource.data.orderId == orderId;

      allow read: if signedIn()
        && (request.auth.uid == resource.data.sellerUid
            || request.auth.uid == resource.data.buyerUid);

      allow update, delete: if false;
    }

    match /MEMBER_REPORTS/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update, delete: if false;
    }

    match /REPORTS/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update, delete: if false;
    }

    match /TRANSACTIONS/{txId} {
      allow read: if signedIn();
      // A5 fix: clients no longer create transaction records (the app has no writer).
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
