// Harvana Firestore rules. This file is identical in:
//   Harvana/docs/firestore.rules
//   capital-oracle-projects/docs/MERGED_FIRESTORE_RULES.rules
//   capital-oracle-projects/firestore.rules
// Publish this text. Do not keep a second, older copy.
// Firestore rules are additive: an allow in any matching block grants access, so there is no
// default-deny line and no wildcard block may allow a write. Every collection names its own rules.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/GROUPS/$(groupId)).data;
    }

    function memberDoc(groupId) {
      return get(/databases/$(database)/documents/GROUPS/$(groupId)/members/$(request.auth.uid)).data;
    }

    function isGroupCreator(groupId) {
      return signedIn() && groupDoc(groupId).creatorId == request.auth.uid;
    }

    function isActiveMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/GROUPS/$(groupId)/members/$(request.auth.uid))
        && memberDoc(groupId).status == 'ACTIVE';
    }

    function isCreatorOrMember(groupId) {
      return isGroupCreator(groupId) || isActiveMember(groupId);
    }

    function referrerSetOk() {
      return !('referred_by_uid' in request.resource.data)
        || (request.resource.data.referred_by_uid is string
            && request.resource.data.referred_by_uid != request.auth.uid
            && exists(/databases/$(database)/documents/USERS/$(request.resource.data.referred_by_uid)));
    }

    function referrerUnchangedOrNew() {
      return ('referred_by_uid' in resource.data)
        ? (request.resource.data.get('referred_by_uid', '') == resource.data.referred_by_uid
            && request.resource.data.get('referred_by_username', '') == resource.data.get('referred_by_username', ''))
        : referrerSetOk();
    }

    function pidLinkOwned(pid) {
      return exists(/databases/$(database)/documents/PIDS/$(pid))
        && get(/databases/$(database)/documents/PIDS/$(pid)).data.uid == request.auth.uid;
    }

    // A Harvana moderator. MODERATORS/{uid} documents are created in the Firebase console
    // only (the rule for that collection denies client writes). Same pattern as the
    // P2P_CHATS update rule that adds a moderator to a disputed trade.
    function isModerator(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/MODERATORS/$(uid))
        && get(/databases/$(database)/documents/MODERATORS/$(uid)).data.active == true;
    }

    // Fields that must never appear in the public USERS/{uid} document. They are owner-only and
    // live in USERS/{uid}/private/kyc (see PrivateProfile.FIELDS in the Android client). The list
    // is kept in sync with the client; if a field is added on the client, add it here in the
    // same commit and call it out in docs/UPDATES.md.
    function privateProfileFields() {
      return [
        'dob', 'v_type', 'bvn', 'nin',
        'phone', 'email', 'address', 'occupation',
        'gps_lat', 'gps_long', 'kin', 'city'
      ];
    }
    // True when the new document state contains none of the private profile fields. Used on
    // create (the document did not exist, so affectedKeys() is not available).
    function publicProfileOnly() {
      return !request.resource.data.keys().hasAny(privateProfileFields());
    }
    // True when an update to the document touches none of the private profile fields. This is
    // the graceful-degradation path: a legacy user whose main USERS/{uid} doc still has private
    // fields from before the split can still update their public fields, and the next
    // saveProfile / updateProfileFields call will migrate the private fields to private/kyc
    // (UserProfileManager routes them in a single batch).
    function publicProfileUpdateOnly() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(privateProfileFields());
    }

    // A ledger row may say money moved only when it carries the network's transaction hash (txRef or nodeTxHash):
    // a member cannot write a CONFIRMED payment, or mark a loan REPAID, without a transaction behind it.
    function txProof(d) {
      return (d.get('txRef', '') is string && d.get('txRef', '').size() >= 16)
          || (d.get('nodeTxHash', '') is string && d.get('nodeTxHash', '').size() >= 16);
    }
    function repayProof(d) {
      return (d.get('txRepayRef', '') is string && d.get('txRepayRef', '').size() >= 16)
          || (d.get('lastRepayTxRef', '') is string && d.get('lastRepayTxRef', '').size() >= 16);
    }

    function paymentConfirmOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'txRef', 'confirmedAt']);
    }

    match /USERS/{uid} {
      allow read: if signedIn();
      // create / update must keep private profile fields (DOB, ID, phone, address, GPS, next of
      // kin) out of the public document. They live in USERS/{uid}/private/kyc instead; the
      // Android client routes them there in one batch (PrivateProfile.split + UserProfileManager).
      allow create: if isSelf(uid) && referrerSetOk() && publicProfileOnly();
      allow update: if isSelf(uid) && referrerUnchangedOrNew() && publicProfileUpdateOnly();
      allow delete: if false;
    }

    match /USERS/{uid}/private/{doc} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /USERS/{uid}/ACTIVITY/{eventId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['kind', 'title', 'detail', 'at', 'source'])
        && request.resource.data.source == 'app'
        && request.resource.data.kind is string
        && request.resource.data.kind.size() > 0
        && request.resource.data.kind.size() <= 32
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 120
        && request.resource.data.at is number
        && request.resource.data.at > 0;
      allow update, delete: if false;
    }

    // Learn Hub adverts. Added and edited by the owner in the Firebase console only. The app reads them and may add
    // one to "views" or "clicks"; nothing else can change.
    match /LEARN_ADS/{adId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'clicks'])
        && (!('views' in request.resource.data) || request.resource.data.views == resource.data.get('views', 0) + 1
            || request.resource.data.views == resource.data.get('views', 0))
        && (!('clicks' in request.resource.data) || request.resource.data.clicks == resource.data.get('clicks', 0) + 1
            || request.resource.data.clicks == resource.data.get('clicks', 0));
    }

    match /LEARN_CONTENT/{contentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 8000
        && request.resource.data.category is string
        && request.resource.data.imageUrl is string
        && (request.resource.data.imageUrl == '' || request.resource.data.imageUrl.matches('^https://.*'))
        && request.resource.data.get('videoUrl', '') is string
        && request.resource.data.get('videoUrl', '').size() <= 400
        && (request.resource.data.get('videoUrl', '') == '' || request.resource.data.videoUrl.matches('^https://.*'))
        && request.resource.data.createdAt is number
        && request.resource.data.views == 0
        && request.resource.data.get('authorWallet', '') is string
        && request.resource.data.get('authorWallet', '').size() <= 80;
      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
      allow update: if request.auth != null
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          || (resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'visibility', 'editedAt'])
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
            && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 8000
            && request.resource.data.get('visibility', 'public') in ['public', 'followers', 'private']));
    }

    match /LEARN_CONTENT/{contentId}/reactions/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    
    match /LEARN_CONTENT/{contentId}/gifts/{txHash} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'to', 'amount', 'txHash', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.txHash == txHash;
      allow update, delete: if false;
    }
    
    match /LEARN_CONTENT/{contentId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.at is number;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /LEARN_SUBMISSIONS/{submissionId} {
      allow read: if request.auth != null && resource.data.authorUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 600
        && request.resource.data.category is string
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('^https://.*')
        && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    match /GROUPS/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.keys().hasAll(['groupName', 'creatorId', 'groupType']);
      allow update: if isGroupCreator(groupId)
        || (isActiveMember(groupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membersCount']));
      allow delete: if isGroupCreator(groupId);

      match /private/{docId} {
        allow read: if isCreatorOrMember(groupId);
        allow create, update, delete: if isGroupCreator(groupId);
      }

      match /members/{memberUid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.status == 'ACTIVE'
          && (
            isGroupCreator(groupId)
            || ( request.auth.uid == memberUid
                 && request.resource.data.role == 'MEMBER'
                 && groupDoc(groupId).get('status', 'Active') != 'Closed'
                 && ( groupDoc(groupId).get('requireApprovalToJoin', false) == false
                      || ( exists(/databases/$(database)/documents/GROUPS/$(groupId)/joinRequests/$(memberUid))
                           && get(/databases/$(database)/documents/GROUPS/$(groupId)/joinRequests/$(memberUid)).data.status == 'APPROVED' ) ) )
          );
        allow update: if isGroupCreator(groupId)
          || (isSelf(memberUid)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['walletAddress', 'wallet_address', 'status']));
        allow delete: if isGroupCreator(groupId);
      }

      match /joinRequests/{requesterUid} {
        allow read: if signedIn();
        allow create: if isSelf(requesterUid)
          && groupDoc(groupId).get('status', 'Active') != 'Closed'
          && request.resource.data.status == 'PENDING';
        allow update: if isGroupCreator(groupId)
          || (isActiveMember(groupId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']));
        allow delete: if isGroupCreator(groupId) || isSelf(requesterUid);
      }

      match /payments/{paymentId} {
        allow read: if isCreatorOrMember(groupId);
        allow create: if isCreatorOrMember(groupId)
          && request.resource.data.keys().hasAny(['type', 'status', 'amountHarv', 'timestamp'])
          && (request.resource.data.get('status', '') != 'CONFIRMED' || txProof(request.resource.data));
        allow update: if isCreatorOrMember(groupId)
          && paymentConfirmOnly()
          && resource.data.status == 'PENDING'
          && request.resource.data.status == 'CONFIRMED'
          && txProof(request.resource.data);
        allow delete: if isGroupCreator(groupId);
      }

      match /loans/{loanId} {
        allow read: if isCreatorOrMember(groupId);
        allow create: if isActiveMember(groupId)
          && request.resource.data.status == 'PENDING'
          && request.resource.data.borrowerUid == request.auth.uid;
        // Turning a loan REPAID, by anyone, needs the repayment's transaction hash; so does a borrower raising
        // what they have repaid.
        allow update: if (request.resource.data.get('status', '') != 'REPAID'
                          || resource.data.get('status', '') == 'REPAID'
                          || repayProof(request.resource.data))
          && (isGroupCreator(groupId)
          || (isSelf(resource.data.borrowerUid)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['repaidAmountHarv', 'lastRepayAt', 'lastRepayTxRef', 'status', 'repaidAt', 'txRepayRef'])
              && (request.resource.data.status == resource.data.status
                  || request.resource.data.status == 'REPAID')
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['repaidAmountHarv'])
                  || repayProof(request.resource.data))));
        allow delete: if isGroupCreator(groupId);
      }

      match /payoutRequests/{requestId} {
        allow read: if isCreatorOrMember(groupId);
        allow create: if isActiveMember(groupId)
          && request.resource.data.status == 'PENDING'
          && request.resource.data.requesterUid == request.auth.uid;
        allow update: if isGroupCreator(groupId)
          && request.resource.data.status in ['APPROVED', 'REJECTED'];
        allow delete: if isGroupCreator(groupId);
      }

      match /notices/{noticeId} {
        allow read: if isCreatorOrMember(groupId);
        allow create: if isGroupCreator(groupId)
          && request.resource.data.type == 'ANNOUNCEMENT'
          && request.resource.data.creatorId == request.auth.uid;
        allow create: if isCreatorOrMember(groupId)
          && request.resource.data.type == 'SYSTEM'
          && request.resource.data.system == true;
        allow create: if isCreatorOrMember(groupId)
          && !('type' in request.resource.data.keys());
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/GROUPS/$(groupId)/joinRequests/$(request.auth.uid))
          && request.resource.data.type == 'SYSTEM'
          && request.resource.data.system == true
          && request.resource.data.title == 'Join request'
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if isGroupCreator(groupId);
      }

      match /invites/{inviteId} {
        allow read: if isCreatorOrMember(groupId);
        allow create, update, delete: if isGroupCreator(groupId);
      }

      match /disputes/{disputeId} {
        allow read: if isCreatorOrMember(groupId);
        allow create: if isActiveMember(groupId)
          && request.resource.data.openedBy == request.auth.uid;
        allow update: if isCreatorOrMember(groupId);
        allow delete: if isGroupCreator(groupId);
      }

      match /privateRecords/{recordId} {
        allow read: if isCreatorOrMember(groupId);
        allow create, update, delete: if isGroupCreator(groupId);
      }

      match /governance/{docId} {
        allow read: if isCreatorOrMember(groupId);
        allow create, update, delete: if isGroupCreator(groupId);
      }
    }

    match /INVITES/{inviteId} {
      function inviteeIsMe() {
        return signedIn()
          && (resource.data.get('inviteeUid', '') == request.auth.uid
              || (request.auth.token.email_verified == true
                  && resource.data.get('inviteeEmail', '') == request.auth.token.email.lower()));
      }
      allow create: if signedIn()
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && (isGroupCreator(request.resource.data.groupId)
            || (isActiveMember(request.resource.data.groupId)
                && groupDoc(request.resource.data.groupId).membersCanInvite == true));
      allow read: if signedIn() && (resource.data.inviterUid == request.auth.uid || inviteeIsMe()
        || isGroupCreator(resource.data.groupId));
      allow update: if inviteeIsMe()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['ACCEPTED', 'DECLINED'];
      allow delete: if signedIn() && (resource.data.inviterUid == request.auth.uid || isGroupCreator(resource.data.groupId));
    }

    match /DELETED/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'path', 'data', 'deletedBy', 'deletedAt', 'purgeAt'])
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.kind is string && request.resource.data.path is string
        && request.resource.data.data is map
        && request.resource.data.deletedAt == request.time
        && request.resource.data.purgeAt is timestamp
        && request.resource.data.purgeAt > request.time + duration.value(364, 'd')
        && request.resource.data.purgeAt < request.time + duration.value(366, 'd');
      allow read, update, delete: if false;
    }

    match /USERNAMES/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == name
        && name.matches('^[a-z][a-z0-9_.]{2,19}$')
        && (!exists(/databases/$(database)/documents/USERNAME_HOLDS/$(name))
            || get(/databases/$(database)/documents/USERNAME_HOLDS/$(name)).data.uid == request.auth.uid
            || request.time > get(/databases/$(database)/documents/USERNAME_HOLDS/$(name)).data.releasedAt + duration.value(90, 'd'));
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /USERNAME_HOLDS/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'releasedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.releasedAt == request.time
        && get(/databases/$(database)/documents/USERNAMES/$(name)).data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /PINCHES/{to}/from/{sender} {
      allow read: if signedIn() && request.auth.uid == to;
      allow create: if signedIn() && request.auth.uid == sender && sender != to
        && request.resource.data.keys().hasOnly(['from', 'at'])
        && request.resource.data.from == sender
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/FOLLOWERS/$(to)/list/$(sender));
      allow update: if signedIn() && request.auth.uid == sender
        && request.resource.data.keys().hasOnly(['from', 'at'])
        && request.resource.data.from == sender
        && request.resource.data.at == request.time
        && resource.data.at < request.time - duration.value(1, 'h');
      allow delete: if signedIn() && request.auth.uid == to;
    }

    match /REFERRAL_ASKS/{referrer}/from/{referred} {
      allow read: if signedIn() && (request.auth.uid == referrer || request.auth.uid == referred);
      allow create: if signedIn() && request.auth.uid == referred
        && request.resource.data.keys().hasOnly(['from', 'referredAddress', 'at'])
        && request.resource.data.from == referred
        && request.resource.data.referredAddress is string
        && request.resource.data.referredAddress.matches('^HV0x[0-9a-fA-F]{40}$')
        && get(/databases/$(database)/documents/USERS/$(referred)).data.get('referred_by_uid', '') == referrer;
      allow update: if signedIn() && request.auth.uid == referrer
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consent_address', 'consent_pub', 'consent_sig', 'status'])
        && request.resource.data.status == 'CONSENTED';
      allow delete: if signedIn() && (request.auth.uid == referrer || request.auth.uid == referred);
    }

    // A Harvana moderator account. Create the document in the Firebase console only
    // (this file denies client writes): MODERATORS/{firebaseUid} with active: true and a name.
    // An appeal adds that uid as the third member of the trade chat. Until a document exists, appeals still open and the two traders keep talking.
    match /MODERATORS/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // The chat id is "{orderId}_{uidA}_{uidB}" with the two ids sorted. Compared as text, not as a
    // regular expression, so a uid that contains "." or "+" cannot break the check.
    function p2pChatFor(id, a, b) {
      return a is string && b is string && a.size() > 0 && b.size() > 0
        && id.size() > a.size() + b.size() + 2
        && id[id.size() - (a.size() + b.size() + 2):id.size()] == '_' + a + '_' + b;
    }

    function p2pChatKeys() {
      return request.resource.data.keys().hasOnly(
        ['members', 'createdAt', 'lastAt', 'lastFrom', 'expiresAt', 'orderId', 'appeal', 'moderator']);
    }

    match /P2P_CHATS/{chatId} {
      // A missing chat has no resource. Reading resource.data there is a refusal, and the app
      // used to stop before it could create the chat. A signed-in user may see that it is absent.
      // An existing chat is visible to its members: the two traders, and a moderator once an appeal adds one.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && p2pChatKeys()
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && p2pChatFor(chatId, request.resource.data.members[0], request.resource.data.members[1])
        && request.resource.data.expiresAt is number
        && (!('orderId' in request.resource.data) || (request.resource.data.orderId is string && request.resource.data.orderId.size() < 80))
        && (!('appeal' in request.resource.data) || request.resource.data.appeal == false)
        && (!('moderator' in request.resource.data) || request.resource.data.moderator == '');
      // A member may touch the clocks, mark the appeal, or add exactly one active moderator as the third member.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && p2pChatKeys()
        && request.resource.data.expiresAt is number
        && (
          (request.resource.data.members == resource.data.members
            && request.resource.data.lastFrom == request.auth.uid
            && request.resource.data.get('appeal', false) == resource.data.get('appeal', false)
            && request.resource.data.get('moderator', '') == resource.data.get('moderator', '')
            && request.resource.data.get('orderId', '') == resource.data.get('orderId', ''))
          || (request.resource.data.members == resource.data.members
            && resource.data.get('appeal', false) != true
            && request.resource.data.appeal == true
            && request.resource.data.get('moderator', '') == resource.data.get('moderator', '')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appeal', 'orderId', 'lastAt', 'expiresAt']))
          || (resource.data.members.size() == 2
            && request.resource.data.members.size() == 3
            && request.resource.data.members[0] == resource.data.members[0]
            && request.resource.data.members[1] == resource.data.members[1]
            && request.resource.data.appeal == true
            && request.resource.data.moderator == request.resource.data.members[2]
            && request.auth.uid != request.resource.data.members[2]
            && exists(/databases/$(database)/documents/MODERATORS/$(request.resource.data.members[2]))
            && get(/databases/$(database)/documents/MODERATORS/$(request.resource.data.members[2])).data.active == true)
        );
      allow delete: if signedIn() && request.auth.uid in resource.data.members
        && resource.data.expiresAt < request.time.toMillis();

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/P2P_CHATS/$(chatId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/P2P_CHATS/$(chatId)).data.members
          && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'image', 'file', 'fileName'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.at == request.time
          && (!('image' in request.resource.data)
              || (request.resource.data.image is string && request.resource.data.image.matches('^https://.+')
                  && request.resource.data.image.size() <= 1000))
          && (!('file' in request.resource.data)
              || (request.resource.data.file is string && request.resource.data.file.matches('^https://.+')
                  && request.resource.data.file.size() <= 1000))
          && (!('fileName' in request.resource.data)
              || (request.resource.data.fileName is string && request.resource.data.fileName.size() > 0
                  && request.resource.data.fileName.size() <= 80));
        allow update: if false;
        allow delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/P2P_CHATS/$(chatId)).data.members
          && get(/databases/$(database)/documents/P2P_CHATS/$(chatId)).data.expiresAt < request.time.toMillis();
      }

      // A phone number one trader chooses to leave on this trade. Only the two members can read it. Only you can write your own.
      match /reach/{uid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/P2P_CHATS/$(chatId)).data.members;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/P2P_CHATS/$(chatId)).data.members
          && request.resource.data.keys().hasOnly(['phone', 'updatedAt'])
          && request.resource.data.phone is string
          && request.resource.data.phone.matches('^\\+[0-9]{8,15}$')
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /FRIENDS/{owner}/list/{friend} {
      allow read, write: if signedIn() && request.auth.uid == owner;
    }

    match /BLOCKS/{owner}/list/{blocked} {
      allow read, write: if signedIn() && request.auth.uid == owner;
    }
    match /FOLLOWERS/{owner}/list/{follower} {
      allow read: if signedIn() && request.auth.uid == owner;
      allow create: if signedIn() && request.auth.uid == follower && request.resource.data.uid == follower
        && !exists(/databases/$(database)/documents/BLOCKS/$(owner)/list/$(follower));
      allow update: if false;
      allow delete: if signedIn() && (request.auth.uid == follower || request.auth.uid == owner);
    }

    match /CONTACTS/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (exists(/databases/$(database)/documents/FRIENDS/$(uid)/list/$(request.auth.uid))
            && exists(/databases/$(database)/documents/FRIENDS/$(request.auth.uid)/list/$(uid))));
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /PHONE_INDEX/{key} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 10;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /EMAIL_INDEX/{key} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 10;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /P2P_LISTINGS_PUBLIC/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.sellerUid
        && request.resource.data.listingId == listingId
        && request.resource.data.keys().hasOnly(['listingId', 'pricingType', 'unitPrice', 'marginPercent', 'paymentWindowMinutes',
             'termsOfTrade', 'reqAccountAgeDays', 'maxOrderHarv', 'currency', 'sellerUid', 'createdAtMs', 'paymentMethodNames']);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == resource.data.sellerUid;
    }

    match /P2P_PAYMENT_DETAILS/{listingId} {
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.sellerUid
        && request.resource.data.keys().hasAll(['listingId', 'paymentMethods', 'accountName', 'sellerUid', 'createdAtMs'])
        && request.resource.data.listingId == listingId;

      allow read: if signedIn()
        && (request.auth.uid == resource.data.sellerUid
            || exists(/databases/$(database)/documents/P2P_PAYMENT_DETAILS/$(listingId)/authorizedBuyers/$(request.auth.uid)));

      allow update, delete: if false;

      match /authorizedBuyers/{buyerUid} {
        allow create: if signedIn()
          && request.auth.uid == buyerUid
          && request.resource.data.keys().hasAll(['orderId', 'claimedAtMs']);
        allow read: if signedIn()
          && (request.auth.uid == buyerUid
              || request.auth.uid == get(/databases/$(database)/documents/P2P_PAYMENT_DETAILS/$(listingId)).data.sellerUid);
        allow update, delete: if false;
      }
    }

    match /P2P_COMPLETED_TRADES/{txHash} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /P2P_ORDER_PAYMENT_DETAILS/{orderId} {
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.sellerUid
        && request.resource.data.keys().hasAll(['orderId', 'sellerUid', 'buyerUid', 'primaryField', 'accountIdentifier', 'accountName', 'createdAtMs'])
        && request.resource.data.orderId == orderId;
      allow read: if signedIn()
        && (request.auth.uid == resource.data.sellerUid
            || request.auth.uid == resource.data.buyerUid);
      allow update, delete: if false;
    }

    match /MEMBER_REPORTS/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update, delete: if false;
    }

    match /REPORTS/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update, delete: if false;
    }

    match /TRANSACTIONS/{txId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /REPUTATION/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /GROUP_TRUST/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /GROUP_STATE/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /GROUP_MEMBERS/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /STAKING_INFO/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /STAKING/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /WALLET_LINKS/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /PIDS/{pid} {
      allow read: if false;
      allow create: if signedIn()
        && pid.matches('^[0-9]{10}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /PROFILES/{pid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && pidLinkOwned(pid)
        && request.resource.data.pid == pid
        && request.resource.data.keys().hasOnly(['pid', 'first_name', 'last_name', 'username', 'icon', 'tier', 'country', 'state', 'city', 'age', 'show_age', 'show_city', 'bio', 'member_since', 'groups_count', 'cycles_completed', 'loans_count', 'loans_pending', 'stats_updated']);
      allow update: if signedIn()
        && pidLinkOwned(pid)
        && request.resource.data.pid == pid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pid', 'icon', 'first_name', 'last_name', 'username', 'country', 'state', 'city', 'age',
          'show_age', 'show_city', 'bio', 'member_since', 'groups_count', 'cycles_completed',
          'loans_count', 'loans_pending', 'stats_updated'])
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 140))
        && (!('show_age' in request.resource.data) || request.resource.data.show_age is bool)
        && (!('show_city' in request.resource.data) || request.resource.data.show_city is bool);
      allow delete: if false;
    }

    // CRASH_LOGS: written by every Harvana app (wallet, miner, node) when an uncaught
    // exception is caught. The original `if true` rule let any client read or rewrite
    // every other user's crash data, and let a buggy or hostile client fill the
    // collection. A crash report must now carry the canonical fields the wallet's
    // CrashReportManager writes (kind, severity, status, fixed, timestamp, app) and
    // the two largest fields are capped. Reads, updates and deletes are moderator-only.
    match /CRASH_LOGS/{logId} {
      allow create: if
        request.resource.data.kind is string
        && request.resource.data.kind.size() > 0
        && request.resource.data.kind.size() <= 32
        && request.resource.data.severity is string
        && request.resource.data.severity in ['CRITICAL', 'ERROR', 'WARNING', 'INFO']
        && request.resource.data.status == 'OPEN'
        && request.resource.data.fixed == false
        && request.resource.data.timestamp is number
        && request.resource.data.timestamp > 0
        && request.resource.data.app is string
        && request.resource.data.app.size() > 0
        && request.resource.data.app.size() <= 32
        && (!('message' in request.resource.data)
            || (request.resource.data.message is string
                && request.resource.data.message.size() <= 2000))
        && (!('stack' in request.resource.data)
            || (request.resource.data.stack is string
                && request.resource.data.stack.size() <= 8000));
      allow read, update, delete: if isModerator(request.auth.uid);
    }

    // OFFICIAL_KEYS: public key directory used by the app to verify Harvana-issued
    // artifacts. Readable by any signed-in client; only moderators can add, rotate or
    // retire a key.
    match /OFFICIAL_KEYS/{keyId} {
      allow read: if signedIn();
      allow write: if isModerator(request.auth.uid);
    }

    // SYSTEM_MITIGATIONS: runtime directives the moderator dashboard pushes to clients
    // (feature toggles, kill-switches, rate caps). Clients read; moderators write.
    match /SYSTEM_MITIGATIONS/{mitigationId} {
      allow read: if signedIn();
      allow write: if isModerator(request.auth.uid);
    }

    // Support desk. A member reads and writes only their own ticket. A moderator
    // document (written by the node after the key sign-in) can read every ticket
    // and reply under their own name. Messages are never edited.
    // Escalation chain (owner, 20 Oct 2026): support → agent → moderator → super admin. A ticket's `level` is who
    // holds it (no level = SUPPORT). Staff act only on tickets at or below their own tier (MODERATORS/{uid}.tier,
    // written by the node at staff sign-in; a record without one counts as SUPPORT) and escalate one step up only.
    function staffTier(uid) {
      return get(/databases/$(database)/documents/MODERATORS/$(uid)).data.get('tier', 'SUPPORT');
    }
    function tierRank(t) {
      return t == 'SUPPORT' ? 1 : t == 'AGENT' ? 2 : t == 'MODERATOR' ? 3 : t == 'SUPER_ADMIN' ? 4 : 0;
    }
    function nextLevel(t) {
      return t == 'SUPPORT' ? 'AGENT' : t == 'AGENT' ? 'MODERATOR' : t == 'MODERATOR' ? 'SUPER_ADMIN' : '';
    }
    function ticketEscalationOk(uid) {
      return tierRank(resource.data.get('level', 'SUPPORT')) <= tierRank(staffTier(uid))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['level'])
            || (nextLevel(staffTier(uid)) != '' && request.resource.data.level == nextLevel(staffTier(uid))
                && request.resource.data.escalatedBy == uid));
    }

    match /SUPPORT_TICKETS/{ticketId} {
      allow get: if signedIn() && (
        resource.data.ownerUid == request.auth.uid || isModerator(request.auth.uid)
      );
      allow list: if signedIn() && (
        isModerator(request.auth.uid) || resource.data.ownerUid == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'OPEN'
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.ownerAddress is string
        && request.resource.data.ownerAddress.size() <= 80
        && (!('category' in request.resource.data) || (request.resource.data.category is string && request.resource.data.category.size() <= 40))
        && (!('priority' in request.resource.data) || request.resource.data.priority in ['LOW', 'NORMAL', 'HIGH', 'URGENT'])
        && (!('lastFrom' in request.resource.data) || request.resource.data.lastFrom == 'MEMBER');
      allow update: if signedIn() && (
        (request.auth.uid == resource.data.ownerUid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastFrom', 'updatedAt', 'status', 'rating'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastFrom']) || request.resource.data.lastFrom == 'MEMBER')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['OPEN', 'WAITING_FOR_SUPPORT'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating']) || (request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
        )
        || (isModerator(request.auth.uid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastFrom', 'updatedAt', 'status', 'staffName', 'staffUid', 'priority', 'assignedAgentId', 'resolvedAt', 'closedAt', 'resolutionSummary', 'category', 'closedBy', 'level', 'escalatedBy', 'escalatedByName', 'escalatedAt', 'escalationReason'])
          && ticketEscalationOk(request.auth.uid)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastFrom']) || request.resource.data.lastFrom == 'STAFF')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['OPEN', 'ASSIGNED', 'IN_PROGRESS', 'WAITING_FOR_USER', 'WAITING_FOR_SUPPORT', 'ESCALATED', 'RESOLVED', 'CLOSED'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['priority']) || request.resource.data.priority in ['LOW', 'NORMAL', 'HIGH', 'URGENT'])
        )
      );

      match /messages/{messageId} {
        function ticket() {
          return get(/databases/$(database)/documents/SUPPORT_TICKETS/$(ticketId)).data;
        }
        allow read: if signedIn() && (
          ticket().ownerUid == request.auth.uid || isModerator(request.auth.uid)
        );
        allow create: if signedIn()
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && (
            request.resource.data.body.size() > 0
            || (request.resource.data.image is string && request.resource.data.image.size() > 20 && request.resource.data.image.size() <= 250000)
          )
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at is number
          && (!('image' in request.resource.data) || (request.resource.data.image is string && request.resource.data.image.size() <= 250000))
          && (
            (ticket().ownerUid == request.auth.uid && request.resource.data.from == 'MEMBER')
            || (isModerator(request.auth.uid)
                && request.resource.data.from == 'STAFF'
                && request.resource.data.staffName is string
                && request.resource.data.staffName.size() > 0
                && request.resource.data.staffName.size() <= 80)
          );
        allow update, delete: if false;
      }

      match /notes/{noteId} {
        allow read: if isModerator(request.auth.uid);
        allow create: if isModerator(request.auth.uid)
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at is number;
        allow update, delete: if false;
      }
    }

    match /LOAN_GUARDIAN_SIGS/{sigId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.guardianUid == request.auth.uid
        && request.resource.data.guardianAddress is string
        && request.resource.data.source == 'node';
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
